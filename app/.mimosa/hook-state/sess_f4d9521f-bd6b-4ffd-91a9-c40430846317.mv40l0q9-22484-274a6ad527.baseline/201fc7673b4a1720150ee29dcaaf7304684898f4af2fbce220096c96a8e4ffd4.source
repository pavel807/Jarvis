import { computed } from "vue";
import { store } from "./store";

/**
 * Единое описание состояния ассистента.
 *
 * Одна и та же фраза идёт в плашку верхней панели и в подпись под сферой —
 * раньше эти надписи жили в разных файлах и расходились.
 *
 * tone: off — не слушает, idle — ждёт команду, live — слушает,
 * busy — идёт работа без звука (загрузка моделей, распознавание, генерация),
 * speaking — Джарвис сейчас говорит.
 */
export type Tone = "off" | "idle" | "live" | "busy" | "speaking";

/**
 * Ассистент работает с фразой: распознаёт сказанное или готовит ответ.
 *
 * Важно для визуализации: в этой фазе звука уже нет, но спектрограмма должна
 * продолжать двигаться, иначе пауза выглядит как зависший интерфейс.
 */
export const assistantBusy = computed(
  () =>
    (!store.speaking && store.engineState === "processing") ||
    (!store.speaking && store.processing) ||
    (!store.speaking && store.chat.busy),
);

export const assistant = computed<{ tone: Tone; short: string; full: string }>(() => {
  if (!store.status.engineRunning) {
    return { tone: "busy", short: "Запускаюсь…", full: "Загружаю модели — это займёт минуту" };
  }
  if (store.status.paused) {
    return { tone: "off", short: "На паузе", full: "Прослушивание на паузе" };
  }
  // Речь важнее остальных фаз: пока Джарвис говорит, он не «готов».
  if (store.speaking) {
    return { tone: "speaking", short: "Говорю", full: "Отвечаю…" };
  }
  if (store.status.llmStatus === "loading") {
    return { tone: "busy", short: "Запускаюсь…", full: "Загружаю модель ответов" };
  }
  if (store.chat.busy) {
    return { tone: "busy", short: "Думаю…", full: "Готовлю ответ…" };
  }
  if (assistantBusy.value) {
    return { tone: "busy", short: "Разбираю…", full: "Разбираю сказанное…" };
  }
  if (store.engineState === "listening") {
    return { tone: "live", short: "Слушаю", full: "Слушаю вас" };
  }
  return { tone: "idle", short: "Готов", full: "Скажите «Джарвис»" };
});

/** Состояние сферы: она реагирует на голос, на паузу и на обработку фразы. */
export const sphereState = computed<"disconnected" | "idle" | "active">(() => {
  if (!store.status.engineRunning || store.status.paused) return "disconnected";
  if (store.speaking || assistantBusy.value || store.engineState === "listening") return "active";
  return "idle";
});

/**
 * Уровень звука для сферы: учитываем источник. Речь пользователя показываем
 * как есть, а собственную речь Джарвиса — приглушённо, чтобы сцена не
 * выглядела так, будто он перебивает сам себя.
 */
export const sphereLevel = computed(() =>
  store.audioSource === "tts" ? store.audioLevel * 0.75 : store.audioLevel,
);
