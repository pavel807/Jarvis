<file path="app/src/pages/Chat.svelte">
<script lang="ts">
  import { tick } from "svelte";
  import { invoke } from "@tauri-apps/api/core";
  import { store } from "../store.svelte";
  import AppIcon from "../components/AppIcon.svelte";

  interface Turn {
    q: string;
    a: string;
  }

  let question = $state("");
  let history = $state<Turn[]>([]);
  /** Вопрос, который ждёт ответа: по нему собираем пару в историю. */
  let pending = $state("");
  let scrollBox = $state<HTMLElement | null>(null);

  $effect(() => {
    const done = store.chat.done;
    if (!pending || !done) return;
    history.push({ q: pending, a: done });
    pending = "";
    store.chat.question = "";
  });

  // Движок сообщил об ошибке, пока ждали ответ: вместо вечно крутящейся
  // «Думаю…» — понятная реплика, после которой можно спросить снова.
  $effect(() => {
    const error = store.chat.error;
    if (!pending || !error) return;
    history.push({ q: pending, a: `Не удалось получить ответ: ${error}` });
    pending = "";
    store.chat.question = "";
    store.chat.error = "";
  });

  $effect(() => {
    if (!history.length) return;
    void tick().then(() => {
      scrollBox?.scrollTo({ top: scrollBox.scrollHeight, behavior: "smooth" });
    });
  });

  async function ask() {
    const text = question.trim();
    if (!text || store.chat.busy) return;
    pending = text;
    store.chat.question = text;
    store.chat.done = "";
    store.chat.streaming = "";
    store.chat.error = "";
    store.chat.busy = true;
    question = "";
    await invoke("llm_ask", { prompt: text });
  }

  function stop() {
    void invoke("llm_cancel");
  }
</script>

<div class="chat">
  <p class="page-hint">
    То же самое, что спросить голосом, только с клавиатуры. Ответы готовятся на этом компьютере.
  </p>

  <div bind:this={scrollBox} class="thread">
    {#if !history.length && !store.chat.busy}
      <div class="empty">
        <AppIcon name="chat" size={26} />
        Задайте любой вопрос —<br />история сохранится до закрытия окна.
      </div>
    {/if}

    {#each history as turn, i (i)}
      <div class="bubble bubble--me">{turn.q}</div>
      <div class="bubble bubble--ai">{turn.a}</div>
    {/each}

    {#if store.resumedTopic}
      <p class="resume-note">
        <AppIcon name="brain" size={14} />
        Вернулись к теме: {store.resumedTopic}
      </p>
    {/if}

    {#if store.chat.busy || store.chat.question || store.chat.error}
      {#if store.chat.question}
        <div class="bubble bubble--me">{store.chat.question}</div>
      {/if}
      <div class="bubble bubble--ai">
        {#if store.chat.streaming}
          {store.chat.streaming}
        {:else if store.chat.error}
          <span class="bubble-error">{store.chat.error}</span>
        {:else}
          <span class="thinking"><span class="spinner"></span>Думаю…</span>
        {/if}
      </div>
    {/if}
  </div>

  <div class="composer">
    <input
      bind:value={question}
      class="input"
      placeholder="Спросите что-нибудь…"
      aria-label="Ваш вопрос"
      onkeydown={(event) => {
        if (event.key === "Enter") ask();
      }}
    />
    {#if store.chat.busy}
      <button class="btn btn--secondary" title="Остановить" aria-label="Остановить" onclick={stop}>
        <AppIcon name="stop" size={18} />
      </button>
    {:else}
      <button
        class="btn btn--primary"
        disabled={!question.trim()}
        title="Спросить"
        aria-label="Спросить"
        onclick={ask}
      >
        <AppIcon name="arrowUp" size={18} />
      </button>
    {/if}
  </div>
</div>

