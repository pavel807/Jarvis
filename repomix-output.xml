//! Диагностика wake word на этой машине: какой движок выбран (метрический
//! .jref или DTW .rpw), грузится ли эталон и как распределяются счёты
//! эталонных сэмплов из train-каталога (позитивы [jarvis] против негативов).
//! Запуск: cargo run -p jarvis-core --example wake_check
//! Модели ищутся в системной папке моделей (JARVIS_MODELS_DIR переопределяет).

use anyhow::{Context, Result};

fn main() -> Result<()> {
    jarvis_core::init_tuning();
    let stt = std::sync::Arc::new(std::sync::Mutex::new(jarvis_core::stt::Stt::load(
        &jarvis_core::paths::models_dir(),
    )?));
    let threshold = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())
        .map(|s| s.wake_threshold)
        .unwrap_or(0.6);
    let ww = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())
        .map(|s| s.wakeword_model)
        .unwrap_or_default();

    let (mode, word, window_ms) =
        jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())
            .map(|s| (s.wake_detector, s.wake_word, s.wake_window_ms))
            .unwrap_or_else(|_| ("ctc".to_string(), "Джарвис".to_string(), 1200));
    jarvis_core::wake::create_engine(&stt, &ww, threshold, &mode, &word, window_ms)?;
    println!("✅ Движок wake word создан");

    // Эталонные записи из train-каталога: позитивы должны давать счёт выше
    // порога эталона, негативы — ниже.
    let (train_dir, _) = jarvis_core::wake_train::sample_dirs();
    if !train_dir.exists() {
        println!(
            "ℹ️ Записей для самопроверки нет ({}) — запиши сэмплы в приложении",
            train_dir.display()
        );
        return Ok(());
    }
    let read_window = |path: &std::path::Path| -> Result<Vec<f32>> {
        let mut reader = hound::WavReader::open(path)?;
        let spec = reader.spec();
        let raw: Vec<f32> = reader
            .samples::<i32>()
            .map(|s| s.unwrap() as f32 / (1 << (spec.bits_per_sample - 1)) as f32)
            .collect();
        let mono: Vec<f32> = if spec.channels == 1 {
            raw
        } else {
            raw.chunks(spec.channels as usize)
                .map(|c| c.iter().sum::<f32>() / spec.channels as f32)
                .collect()
        };
        Ok(jarvis_core::audio::resample_audio(
            &mono,
            spec.sample_rate as usize,
            16_000,
        ))
    };

    for entry in std::fs::read_dir(&train_dir)?.flatten() {
        let path = entry.path();
        if path
            .extension()
            .is_none_or(|e| !e.eq_ignore_ascii_case("wav"))
        {
            continue;
        }
        let name = path
            .file_name()
            .unwrap_or_default()
            .to_string_lossy()
            .to_string();
        let label = jarvis_core::tts::label_of_sample(&name);
        let mut audio = read_window(&path).with_context(|| name.clone())?;
        // Окно 1.2 с, идемпотентно (см. wake_verify): файл уже окно — как есть.
        let window = 16_000 * 12 / 10;
        audio.resize(window, 0.0);
        match jarvis_core::wake::score_reference(&stt, &audio) {
            Some(s) => println!("   [{label}] {name}: счёт {s:.3}"),
            None => println!("   [{label}] {name}: эталон не загружен"),
        }
    }
    Ok(())
}
</file>

<file path="crates/jarvis-core/src/agent.rs">
//! Контракты агентного исполнения: статусы, верификация, реестр инструментов.
//!
//! Это единственный источник метаданных об инструментах: канонические имена
//! ([`known_names`]), уровень риска, таймаут и положенный тип постусловия
//! ([`ToolSpec`]). Модель не может вызвать инструмент вне реестра; аргументы
//! проверяются до выполнения (см. `tools::build_call`); результат проверки
//! ([`VerificationResult`]) — основа честного ответа пользователю: успех
//! не объявляется без подтверждённого факта.

use std::time::Duration;

/// Уровень риска операции — определяет необходимость подтверждения.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum RiskLevel {
    /// Чтение и локальные безопасные операции.
    Low,
    /// Изменение пользовательских данных, запуск приложений, shell.
    Medium,
    /// Удаление данных, массовые и системные операции.
    High,
}

/// Какой тип постусловия положен инструменту — чем результат подтверждается.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Postcondition {
    /// Проверка процесса/приложения (open_app, quit_app).
    ProcessState,
    /// Код возврата и stderr (shell, applescript).
    ExitCode,
    /// Чтение файла обратно после записи (file_write, file_append, file_edit).
    FileContent,
    /// Проверка существования артефакта (screenshot → файл).
    EvidenceFile,
    /// Чтение фактического состояния через системный API (volume, brightness,
    /// music_control) — эталон честности.
    StateReadback,
    /// Постусловие невозможно: статус остаётся неподтверждённым, и ответ
    /// обязан это отражать (open_url — «браузер запущен», а не «сайт открыт»).
    None,
    /// Отчёт замкнутого GUI-цикла (ui_task): подтверждение — Termination::Done
    /// по свежему скриншоту; проверяется в самой реализации цикла.
    AgentReport,
}

/// Спецификация инструмента: метаданные реестра.
#[derive(Debug, Clone)]
pub struct ToolSpec {
    /// Каноническое имя (совпадает с `ToolCall`-вариантом и событиями).
    pub name: String,
    pub risk: RiskLevel,
    /// Разумный лимит исполнения; зависшие операции прерываются.
    pub timeout: Duration,
    pub postcondition: Postcondition,
    /// Платформы, где инструмент реализован; на остальных — честный
    /// `Unsupported`, а не выдуманный результат.
    pub platforms: &'static [&'static str],
}

mod platforms {
    pub const ALL: &[&str] = &["macos", "linux", "windows"];
    pub const MACOS_ONLY: &[&str] = &["macos"];
}

/// Канонические имена инструментов — единственный список, по которому
/// парсится и валидируется вызов модели (см. `tools::parse`).
///
/// Реестр полный: модель может и открывать приложения/ссылки, и управлять
/// окнами. Детерминированный планировщик (`router::plan_system_command`)
/// перехватывает типовые фразы «открой/закрой…» до модели — это быстрый
/// путь, а не запрет для модели.
pub const KNOWN_NAMES: &[&str] = &[
    "shell",
    "open_app",
    "quit_app",
    "open_url",
    "open_path",
    "window",
    "desktop_input",
    "set_timer",
    "set_alarm",
    "timer_stop",
    "alarm_stop",
    "open_utils",
    "close_utils",
    "play_reactor_intro",
    "set_volume",
    "set_brightness",
    "screenshot",
    "lock_screen",
    "sleep",
    "notify",
    "clipboard_read",
    "clipboard_write",
    "applescript",
    "system_info",
    "file_read",
    "file_write",
    "file_append",
    "file_edit",
    "file_list",
    "file_search",
    "file_glob",
    "task_add",
    "task_list",
    "task_done",
    "task_remove",
    "task_run",
    "task_open",
    "web_search",
    "wait",
    "run_command",
    "send_message",
    "add_note",
    "create_event",
    "music_control",
    "ui_read",
    "ui_click",
    "ui_type",
    "ui_menu",
    "remember",
    "schedule_add",
    "schedule_list",
    "schedule_remove",
    "mcp_call",
];

const FIVE_SECONDS: Duration = Duration::from_secs(5);
const THIRTY_SECONDS: Duration = Duration::from_secs(30);

/// Спецификация по каноническому имени. `None` — имя вне реестра: вызов
/// отклоняется до выполнения.
pub fn spec_for(name: &str) -> Option<ToolSpec> {
    // Спецификация выдаётся только для канонических имён реестра: parse
    // нормализует алиасы до вызова, так что сюда приходят именно они.
    if !KNOWN_NAMES.contains(&name) {
        return None;
    }
    // Группы инструментов делят риск/таймаут/постусловие; имя — всегда
    // каноническое имя запроса (тест every_known_name_has_spec ловит
    // расхождение группового arm'а с реестром).
    let (risk, timeout, postcondition, platforms) = match name {
        "shell" | "applescript" => (
            RiskLevel::Medium,
            THIRTY_SECONDS,
            Postcondition::ExitCode,
            if name == "applescript" {
                platforms::MACOS_ONLY
            } else {
                platforms::ALL
            },
        ),
        "open_app" | "quit_app" => (
            RiskLevel::Medium,
            Duration::from_secs(10),
            Postcondition::ProcessState,
            platforms::ALL,
        ),
        "open_url" | "open_path" => (
            RiskLevel::Medium,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "set_timer" | "set_alarm" | "timer_stop" | "alarm_stop" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::StateReadback,
            platforms::ALL,
        ),
        "open_utils" | "close_utils" | "play_reactor_intro" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "set_volume" | "set_brightness" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::StateReadback,
            platforms::ALL,
        ),
        "screenshot" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::EvidenceFile,
            platforms::ALL,
        ),
        "lock_screen" | "sleep" | "notify" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::ExitCode,
            platforms::ALL,
        ),
        "clipboard_read" | "clipboard_write" | "system_info" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "ui_read" => (
            // Чтение дерева элементов: macOS (Accessibility), Linux (AT-SPI) —
            // только смотрите, ничего не меняете.
            RiskLevel::Low,
            Duration::from_secs(20),
            Postcondition::None,
            platforms::ALL,
        ),
        "ui_click" | "ui_menu" => (
            // Клик/меню меняют состояние приложения: средний риск, результат
            // подтверждается перечитыванием экрана внутри исполнителя.
            RiskLevel::Medium,
            Duration::from_secs(30),
            Postcondition::None,
            platforms::ALL,
        ),
        "ui_type" => (
            // Ввод текста в чужое поле: средний риск, верификация — readback
            // значения поля (в исполнителе, честный fail при расхождении).
            RiskLevel::Medium,
            Duration::from_secs(30),
            Postcondition::None,
            platforms::ALL,
        ),
        "remember" | "schedule_list" => (
            // Запись в локальные файлы памяти/расписания.
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "schedule_add" | "schedule_remove" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "mcp_call" => (
            // Внешний процесс: код не наш, лимит времени generous, риск средний.
            RiskLevel::Medium,
            Duration::from_secs(70),
            Postcondition::None,
            platforms::ALL,
        ),
        "file_read" | "file_list" | "file_search" | "file_glob" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "file_write" | "file_append" | "file_edit" => (
            RiskLevel::Medium,
            FIVE_SECONDS,
            Postcondition::FileContent,
            platforms::ALL,
        ),
        "task_add" | "task_done" | "task_remove" | "task_open" | "task_list" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "task_run" => (
            RiskLevel::Medium,
            Duration::from_secs(300),
            Postcondition::ExitCode,
            platforms::ALL,
        ),
        "web_search" => (
            RiskLevel::Low,
            Duration::from_secs(20),
            Postcondition::None,
            platforms::ALL,
        ),
        "window" => (
            RiskLevel::Medium,
            FIVE_SECONDS,
            Postcondition::StateReadback,
            platforms::ALL,
        ),
        "desktop_input" => (
            RiskLevel::Medium,
            THIRTY_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "wait" => (
            RiskLevel::Low,
            THIRTY_SECONDS,
            Postcondition::None,
            platforms::ALL,
        ),
        "run_command" => (
            RiskLevel::Medium,
            Duration::from_secs(15),
            Postcondition::ProcessState,
            platforms::ALL,
        ),
        "send_message" | "add_note" | "create_event" => (
            RiskLevel::Medium,
            FIVE_SECONDS,
            Postcondition::None,
            platforms::MACOS_ONLY,
        ),
        "music_control" => (
            RiskLevel::Low,
            FIVE_SECONDS,
            Postcondition::StateReadback,
            platforms::ALL,
        ),
        _ => return None,
    };
    Some(ToolSpec {
        name: name.to_string(),
        risk,
        timeout,
        postcondition,
        platforms,
    })
}

/// Итоговый статус исполнения. Успех ставится только после подтверждения
/// постусловия; без возможности проверки — `Unknown`/`PartiallySucceeded`,
/// но никогда не `Succeeded` ради красивого ответа.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ExecutionStatus {
    Succeeded,
    Failed,
    NeedsConfirmation,
    Unsupported,
    Cancelled,
    TimedOut,
    PartiallySucceeded,
    Unknown,
}

impl ExecutionStatus {
    /// Мост от текущего `ToolOutcome` (ok/detail) — статусов в нём ещё нет,
    /// поэтому ok=true даёт `Succeeded` только для инструментов, чьё
    /// постусловие фактически проверено движком (см. verification).
    pub fn from_verified(verified: bool, had_error: bool) -> Self {
        if verified {
            Self::Succeeded
        } else if had_error {
            Self::Failed
        } else {
            Self::Unknown
        }
    }

    pub fn as_str(self) -> &'static str {
        match self {
            Self::Succeeded => "succeeded",
            Self::Failed => "failed",
            Self::NeedsConfirmation => "needs_confirmation",
            Self::Unsupported => "unsupported",
            Self::Cancelled => "cancelled",
            Self::TimedOut => "timed_out",
            Self::PartiallySucceeded => "partially_succeeded",
            Self::Unknown => "unknown",
        }
    }
}

/// Результат проверки постусловия: что именно подтверждено и чем.
#[derive(Debug, Clone)]
pub struct VerificationResult {
    pub verified: bool,
    pub message: String,
    /// Доказательство для диагностики: имя процесса, код возврата,
    /// размер файла, фактическое значение настройки.
    pub evidence: Option<String>,
}

impl VerificationResult {
    pub fn verified(message: impl Into<String>, evidence: impl Into<String>) -> Self {
        Self {
            verified: true,
            message: message.into(),
            evidence: Some(evidence.into()),
        }
    }

    /// Выполнено без возможности проверить — не успех.
    pub fn unverified(message: impl Into<String>) -> Self {
        Self {
            verified: false,
            message: message.into(),
            evidence: None,
        }
    }

    pub fn failed(message: impl Into<String>, evidence: impl Into<String>) -> Self {
        Self {
            verified: false,
            message: message.into(),
            evidence: Some(evidence.into()),
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn every_known_name_has_spec() {
        for name in KNOWN_NAMES {
            let spec = spec_for(name).unwrap_or_else(|| panic!("нет спецификации для {name}"));
            assert_eq!(spec.name, *name);
        }
    }

    #[test]
    fn unknown_name_has_no_spec() {
        assert!(spec_for("delete_everything").is_none());
        assert!(spec_for("").is_none());
    }

    #[test]
    fn shell_and_applescript_are_medium_risk() {
        assert_eq!(spec_for("shell").unwrap().risk, RiskLevel::Medium);
        assert_eq!(spec_for("applescript").unwrap().risk, RiskLevel::Medium);
    }

    #[test]
    fn music_control_requires_state_readback() {
        assert_eq!(
            spec_for("music_control").unwrap().postcondition,
            Postcondition::StateReadback
        );
    }

    #[test]
    fn file_writes_verify_content() {
        for name in ["file_write", "file_append", "file_edit"] {
            assert_eq!(
                spec_for(name).unwrap().postcondition,
                Postcondition::FileContent
            );
        }
    }

    #[test]
    fn status_from_verified() {
        assert_eq!(
            ExecutionStatus::from_verified(true, false),
            ExecutionStatus::Succeeded
        );
        assert_eq!(
            ExecutionStatus::from_verified(false, true),
            ExecutionStatus::Failed
        );
        // Без проверки и без ошибки — не успех.
        assert_eq!(
            ExecutionStatus::from_verified(false, false),
            ExecutionStatus::Unknown
        );
    }
}
</file>

<file path="crates/jarvis-core/src/audio.rs">
//! Аудио: захват с микрофона, даунмикс, ресемплинг, воспроизведение WAV.

use anyhow::{Context, Result, bail};
use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};
use hound::WavReader;
use std::path::Path;
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::mpsc::SyncSender;
use std::sync::{Arc, Mutex};
use std::time::Duration;

/// macOS-разрешение на микрофон (TCC).
///
/// При запрете macOS не возвращает ошибку cpal: HAL молча отдаёт тишину —
/// wake word не срабатывает, индикатор микрофона не горит, интерфейс выглядит
/// живым. Проверяем статус через AVFoundation, при первом запуске сами
/// показываем системный запрос, при запрете падаем с внятным сообщением.
#[cfg(target_os = "macos")]
mod mic_permission {
    // Грузим фреймворк в процесс, иначе класса AVCaptureDevice в рантайме нет.
    #[link(name = "AVFoundation", kind = "framework")]
    unsafe extern "C" {}

    use block2::RcBlock;
    use objc2::runtime::{AnyClass, Bool};
    use objc2_foundation::NSString;
    use std::ffi::c_void;
    use std::sync::atomic::{AtomicBool, Ordering};

    // GCD: системный TCC-диалог надёжно показывается только из главного
    // потока GUI-приложения — запрос из фонового потока может молча не
    // появиться (наблюдалось на macOS 26). dispatch живёт в libSystem.
    unsafe extern "C" {
        static _dispatch_main_q: u8;
        fn dispatch_async(queue: *mut c_void, work: *mut c_void);
    }

    /// AVAuthorizationStatus.
    const NOT_DETERMINED: isize = 0;
    const RESTRICTED: isize = 1;
    const DENIED: isize = 2;
    const AUTHORIZED: isize = 3;

    /// Запрос уже отправляли: системный диалог показывается один раз,
    /// дальше только опрашиваем статус.
    static REQUEST_FIRED: AtomicBool = AtomicBool::new(false);

    fn status() -> Option<isize> {
        let cls = AnyClass::get(c"AVCaptureDevice")?;
        // AVMediaTypeAudio — FourCC "soun" в виде NSString.
        let media = NSString::from_str("soun");
        Some(unsafe { objc2::msg_send![cls, authorizationStatusForMediaType: &*media] })
    }

    /// Показывает системный диалог «разрешить доступ к микрофону?».
    /// Ответ читаем опросом статуса — блок нужен только формально.
    /// Уходит в главный поток через GCD.
    fn fire_request() {
        let Some(cls) = AnyClass::get(c"AVCaptureDevice") else {
            return;
        };
        let media = NSString::from_str("soun");
        let block = RcBlock::new(move || {
            let handler = RcBlock::new(|_granted: Bool| {});
            unsafe {
                let _: () = objc2::msg_send![
                    cls,
                    requestAccessForMediaType: &*media,
                    completionHandler: &*handler
                ];
            }
        });
        unsafe {
            dispatch_async(
                std::ptr::addr_of!(_dispatch_main_q) as *mut c_void,
                &*block as *const _ as *mut c_void,
            );
        }
    }

    /// Шаг конечного автомата доступа: true — доступ есть, false — ждём
    /// ответа пользователя или запрещено. Вызывается из цикла запуска
    /// движка; при первом notDetermined показывает системный запрос.
    pub fn access_step() -> bool {
        let Some(st) = status() else {
            return true; // не смогли определить — не блокируем запуск
        };
        match st {
            AUTHORIZED => true,
            NOT_DETERMINED => {
                if !REQUEST_FIRED.swap(true, Ordering::SeqCst) {
                    fire_request();
                }
                false
            }
            DENIED | RESTRICTED => false,
            _ => false, // новые значения статуса трактует консервативно
        }
    }

    /// Для диагностики: true — authorized, false — denied или ждём ответа,
    /// None — статус не определился.
    pub fn authorized() -> Option<bool> {
        status().map(|st| st == AUTHORIZED)
    }

    /// Статус строкой для UI: authorized | denied | pending | unknown.
    pub fn status_str() -> &'static str {
        match status() {
            Some(AUTHORIZED) => "authorized",
            Some(NOT_DETERMINED) => "pending",
            Some(DENIED | RESTRICTED) => "denied",
            _ => "unknown",
        }
    }

    /// Повторный запрос из Настроек: не завязан на REQUEST_FIRED, поэтому
    /// показывает системный диалог снова, если статус notDetermined.
    /// После отказа macOS диалог не показывает — вернётся "denied",
    /// и вызывающий откроет Системные настройки.
    pub fn request_access() -> &'static str {
        if status() == Some(NOT_DETERMINED) {
            fire_request();
            "pending"
        } else {
            status_str()
        }
    }
}

/// Гейт перед открытием входного потока: при явном запрете — ошибка с
/// инструкцией, а не тишина в канале.
#[cfg(target_os = "macos")]
fn ensure_mic_permission() -> Result<()> {
    match mic_permission::authorized() {
        Some(true) => Ok(()),
        Some(false) => bail!(
            "Нет доступа к микрофону — macOS запрещает запись. Открой Системные настройки → \
             Конфиденциальность и безопасность → Микрофон, включи Jarvis (или свой терминал), \
             затем перезапусти приложение."
        ),
        None => Ok(()),
    }
}

/// Шаг автомата доступа к микрофону для цикла запуска движка: true —
/// доступ есть, false — ждём ответа пользователя (системный запрос
/// показан) или запрещено.
#[cfg(target_os = "macos")]
pub fn mic_access_step() -> bool {
    mic_permission::access_step()
}

/// Текущий статус доступа к микрофону: Some(true) — разрешён,
/// Some(false) — запрещён или ждём ответа, None — не удалось определить.
/// Публичный для диагностики (пример mic_check).
#[cfg(target_os = "macos")]
pub fn mic_authorized() -> Option<bool> {
    mic_permission::authorized()
}

/// Статус доступа для UI настроек: "authorized" | "denied" | "pending" |
/// "unknown" (pending — системный запрос показан и не отвечен).
#[cfg(target_os = "macos")]
pub fn mic_status() -> &'static str {
    mic_permission::status_str()
}

/// Повторный запрос доступа из Настроек. При notDetermined показывает
/// системный диалог снова; после отказа macOS диалог уже не показывает —
/// вызывающий открывает Системные настройки.
#[cfg(target_os = "macos")]
pub fn mic_request_access() -> &'static str {
    mic_permission::request_access()
}

#[cfg(not(target_os = "macos"))]
pub fn mic_status() -> &'static str {
    "unknown"
}

#[cfg(not(target_os = "macos"))]
pub fn mic_request_access() -> &'static str {
    "unknown"
}

pub fn calculate_rms(samples: &[f32]) -> f32 {
    if samples.is_empty() {
        return 0.0;
    }
    let sum_sq: f32 = samples.iter().map(|&s| s * s).sum();
    (sum_sq / samples.len() as f32).sqrt()
}

pub fn downmix_f32(data: &[f32], channels: usize) -> Vec<f32> {
    if channels == 1 {
        return data.to_vec();
    }
    data.chunks(channels)
        .map(|c| c.iter().copied().sum::<f32>() / channels as f32)
        .collect()
}

pub fn downmix_i16(data: &[i16], channels: usize) -> Vec<f32> {
    data.chunks(channels)
        .map(|c| c.iter().map(|&x| x as f32 / 32768.0).sum::<f32>() / channels as f32)
        .collect()
}

pub fn downmix_u16(data: &[u16], channels: usize) -> Vec<f32> {
    data.chunks(channels)
        .map(|c| {
            c.iter()
                .map(|&x| (x as f32 - 32768.0) / 32768.0)
                .sum::<f32>()
                / channels as f32
        })
        .collect()
}

/// Линейная интерполяция без антиалиасинга — для речи достаточно.
pub fn resample_audio(samples: &[f32], src_rate: usize, target_rate: usize) -> Vec<f32> {
    if src_rate == target_rate || samples.is_empty() {
        return samples.to_vec();
    }

    let ratio = target_rate as f32 / src_rate as f32;
    let target_length = (samples.len() as f32 * ratio) as usize;
    let last_idx = samples.len() - 1;

    let mut resampled = Vec::with_capacity(target_length);

    for i in 0..target_length {
        let src_idx_float = i as f32 / ratio;
        let idx_low = src_idx_float.floor() as usize;
        let idx_high = (idx_low + 1).min(last_idx);
        let weight = src_idx_float - idx_low as f32;

        let sample = samples[idx_low] * (1.0 - weight) + samples[idx_high] * weight;
        resampled.push(sample);
    }

    resampled
}

/// Открывает микрофон по умолчанию и шлёт моно-f32 чанки в канал.
pub fn spawn_stream(tx: SyncSender<Vec<f32>>) -> Result<(cpal::Stream, usize)> {
    println!("🔍 Поиск аудиоустройств...");

    #[cfg(target_os = "macos")]
    ensure_mic_permission()?;

    let host = cpal::default_host();

    // Перебираем ВСЕ устройства ввода (default первым): «default» может
    // указывать на профиль, который сейчас недоступен (наушники переключили
    // профиль, USB-гарнитура занята), при этом остальные устройства живы.
    let mut names: Vec<String> = Vec::new();
    let mut devices: Vec<cpal::Device> = Vec::new();
    if let Ok(list) = host.input_devices() {
        for d in list {
            let name = d
                .description()
                .map(|desc| desc.name().to_string())
                .unwrap_or_else(|_| "?".into());
            names.push(name.clone());
            devices.push(d);
        }
    }
    if devices.is_empty() {
        bail!("❌ В системе не найдено ни одного устройства ввода.");
    }
    // Default — первым кандидатом.
    if let Some(def) = host.default_input_device() {
        let def_name = def
            .description()
            .map(|desc| desc.name().to_string())
            .unwrap_or_default();
        let pos = devices.iter().position(|d| {
            d.description()
                .map(|desc| desc.name() == def_name)
                .unwrap_or(false)
        });
        if let Some(pos) = pos {
            let d = devices.remove(pos);
            devices.insert(0, d);
        } else {
            devices.insert(0, def);
        }
    }

    let mut last_error: Option<String> = None;
    for dev in devices {
        let name = dev
            .description()
            .map(|desc| desc.name().to_string())
            .unwrap_or_else(|_| "?".into());
        let sup = match dev.default_input_config() {
            Ok(sup) => sup,
            Err(e) => {
                last_error = Some(format!("{name}: {e}"));
                continue;
            }
        };
        let ch = sup.channels() as usize;
        let sr = sup.sample_rate() as usize;
        let mut cfg: cpal::StreamConfig = sup.into();
        // Сначала фиксированный буфер, при отказе — дефолтный размер.
        for buffer in [cpal::BufferSize::Fixed(4096), cpal::BufferSize::Default] {
            cfg.buffer_size = buffer.clone();
            let built = match sup.sample_format() {
                cpal::SampleFormat::F32 => dev.build_input_stream(
                    cfg.clone(),
                    {
                        let tx = tx.clone();
                        move |d: &[f32], _| {
                            let _ = tx.send(downmix_f32(d, ch));
                        }
                    },
                    |e| eprintln!("❌ Ошибка входного потока: {e}"),
                    None,
                ),
                cpal::SampleFormat::I16 => dev.build_input_stream(
                    cfg.clone(),
                    {
                        let tx = tx.clone();
                        move |d: &[i16], _| {
                            let _ = tx.send(downmix_i16(d, ch));
                        }
                    },
                    |e| eprintln!("❌ Ошибка входного потока: {e}"),
                    None,
                ),
                cpal::SampleFormat::U16 => dev.build_input_stream(
                    cfg.clone(),
                    {
                        let tx = tx.clone();
                        move |d: &[u16], _| {
                            let _ = tx.send(downmix_u16(d, ch));
                        }
                    },
                    |e| eprintln!("❌ Ошибка входного потока: {e}"),
                    None,
                ),
                f => bail!("Неподдерживаемый формат микрофона: {f:?}"),
            };
            match built {
                Ok(stream) => {
                    println!(
                        "🎙️ Микрофон: «{name}» ({}ch {}Hz {:?}, буфер {:?})",
                        ch, sr, sup.sample_format(), buffer
                    );
                    println!("✅ Аудиопоток микрофона создан");
                    return Ok((stream, sr));
                }
                Err(e) => {
                    last_error = Some(format!("«{name}»: {e}"));
                }
            }
        }
    }

    bail!(
        "❌ Ни одно устройство ввода не открылось. Устройства: {}. Последняя причина: {}",
        names.join(", "),
        last_error.unwrap_or_else(|| "неизвестно".into())
    )
}

/// Блокирующее воспроизведение WAV-файла с проверкой флага остановки.
///
/// Используется разовыми сценариями (тесты, UI-проверки); плеер движка
/// работает через [`OutputPlayer`] — один постоянный стрим.
/// Один постоянный выходной поток: WAV декодируется в буфер, колбэк устройства
/// непрерывно его вычитывает. Никаких лагов на пересоздание стрима между фразами.
///
/// Поддерживает потоковую подачу: [`OutputPlayer::enqueue`] дописывает сэмплы
/// в очередь по мере готовности, [`OutputPlayer::wait_drain`] дожидается конца.
pub struct OutputPlayer {
    queue: Arc<Mutex<Vec<f32>>>,
    consumed: Arc<std::sync::atomic::AtomicUsize>,
    /// Сколько interleaved-сэмплов выдвинуто в очередь всего (монотонно).
    pushed: std::sync::atomic::AtomicUsize,
    /// Держим стрим живым: колбэк работает, пока существует структура.
    _stream: cpal::Stream,
    sample_rate: usize,
    channels: usize,
}

impl OutputPlayer {
    pub fn new() -> Result<Self> {
        let host = cpal::default_host();
        let device = host
            .default_output_device()
            .context("Нет устройства вывода звука")?;
        let default_config = device.default_output_config()?;

        let sample_rate = default_config.sample_rate() as usize;
        let channels = default_config.channels() as usize;

        let queue: Arc<Mutex<Vec<f32>>> = Arc::new(Mutex::new(Vec::new()));
        let consumed = Arc::new(std::sync::atomic::AtomicUsize::new(0));

        let cb_queue = Arc::clone(&queue);
        let cb_consumed = Arc::clone(&consumed);

        let config = cpal::StreamConfig {
            channels: default_config.channels(),
            sample_rate: default_config.sample_rate(),
            buffer_size: cpal::BufferSize::Default,
        };

        let stream = device.build_output_stream(
            config,
            move |data: &mut [f32], _| {
                // Zero-copy: пишем прямо в буфер устройства, без
                // промежуточного Vec на каждый вызов колбэка.
                let mut q = cb_queue.lock().unwrap_or_else(|e| e.into_inner());
                let take = data.len().min(q.len());
                data[..take].copy_from_slice(&q[..take]);
                q.drain(..take);
                drop(q);
                cb_consumed.fetch_add(take, Ordering::Relaxed);
                for c in data[take..].iter_mut() {
                    *c = 0.0;
                }
            },
            move |err| eprintln!("Output stream error: {err}"),
            None,
        )?;

        stream.play()?;

        Ok(Self {
            queue,
            consumed,
            pushed: std::sync::atomic::AtomicUsize::new(0),
            _stream: stream,
            sample_rate,
            channels,
        })
    }

    /// Частота выходного устройства (сэмплы для [`OutputPlayer::enqueue`]).
    pub fn device_sample_rate(&self) -> usize {
        self.sample_rate
    }

    /// Дописывает моно-сэмплы (уже в частоте устройства) в очередь вывода.
    /// Не блокируется: воспроизведение идёт параллельно через колбэк.
    pub fn enqueue(&self, mono: &[f32]) {
        if mono.is_empty() {
            return;
        }
        let out_channels = self.channels;
        let n = mono.len() * out_channels;
        {
            // Zero-copy для моно (наш случай): данные уходят в очередь
            // одним extend, без промежуточного interleaved-вектора.
            let mut q = self.queue.lock().unwrap_or_else(|e| e.into_inner());
            if out_channels == 1 {
                q.extend_from_slice(mono);
            } else {
                q.reserve(n);
                for &s in mono {
                    q.extend(std::iter::repeat_n(s, out_channels));
                }
            }
        }
        self.pushed.fetch_add(n, Ordering::SeqCst);
    }

    /// Сбрасывает очередь вывода (используется при остановке речи).
    pub fn clear(&self) {
        let pushed = self.pushed.load(Ordering::SeqCst);
        self.queue.lock().unwrap_or_else(|e| e.into_inner()).clear();
        // Счётчики должны сойтись, иначе wait_drain решит, что всё уже сыграно.
        self.consumed.store(pushed, Ordering::SeqCst);
    }

    /// Ждёт, пока устройство вычитает всё выдвинутое в очередь, либо не придёт стоп.
    pub fn wait_drain(&self, stop_flag: &AtomicBool) {
        loop {
            if stop_flag.load(Ordering::SeqCst) {
                self.clear();
                return;
            }
            if self.consumed.load(Ordering::Relaxed) >= self.pushed.load(Ordering::SeqCst) {
                return;
            }
            std::thread::sleep(Duration::from_millis(10));
        }
    }

    /// Декодирует WAV, даунмиксит, ресемплирует под выходное устройство
    /// и проигрывает целиком.
    pub fn play_wav(&self, path: &str, stop_flag: &AtomicBool) -> Result<()> {
        if !Path::new(path).exists() {
            bail!("Файл звука не найден: {path}");
        }

        let mut reader = WavReader::open(path)?;
        let spec = reader.spec();

        let raw: Vec<f32> = match spec.sample_format {
            hound::SampleFormat::Int => reader
                .samples::<i16>()
                .filter_map(|s| s.ok())
                .map(|s| s as f32 / 32768.0)
                .collect(),
            hound::SampleFormat::Float => reader.samples::<f32>().filter_map(|s| s.ok()).collect(),
        };

        let mono = downmix_f32(&raw, spec.channels as usize);
        let final_samples = if spec.sample_rate as usize != self.sample_rate {
            resample_audio(&mono, spec.sample_rate as usize, self.sample_rate)
        } else {
            mono
        };

        self.enqueue(&final_samples);
        self.wait_drain(stop_flag);
        Ok(())
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn resample_keeps_length_and_dc() {
        let src = vec![0.5f32; 1600]; // 0.1s @ 16k
        let out = resample_audio(&src, 16_000, 48_000);
        assert_eq!(out.len(), 4800);
        assert!(out.iter().all(|&s| (s - 0.5).abs() < 1e-6));
    }

    #[test]
    fn resample_same_rate_is_clone() {
        let src = vec![0.1f32, 0.2, 0.3];
        let out = resample_audio(&src, 16_000, 16_000);
        assert_eq!(out, src);
    }

    #[test]
    fn downmix_stereo_averages() {
        let out = downmix_f32(&[0.0, 1.0, 0.5, 0.5], 2);
        assert_eq!(out, vec![0.5, 0.5]);
    }

    #[test]
    fn downmix_i16_normalizes() {
        let out = downmix_i16(&[i16::MAX], 1);
        assert!((out[0] - 1.0).abs() < 1e-4);
    }

    #[test]
    fn rms_zero_and_nonzero() {
        assert_eq!(calculate_rms(&[]), 0.0);
        assert_eq!(calculate_rms(&[0.0; 100]), 0.0);
        assert!(calculate_rms(&[0.5; 100]) > 0.49);
    }
}
