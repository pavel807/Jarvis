<file path="app/src/pages/Dashboard.svelte">
<script lang="ts">
  import { invoke } from "@tauri-apps/api/core";
  import { store, go } from "../store.svelte";
  import {
    assistantBusy,
    getAssistant,
    getSphereLevel,
    getSphereState,
  } from "../assistant";
  import ArcReactor from "../components/ArcReactor.svelte";
  import AppIcon from "../components/AppIcon.svelte";

  const assistant = $derived(getAssistant());
  const sphereState = $derived(getSphereState());
  const sphereLevel = $derived(getSphereLevel());

  /**
   * Реактор переходит в режим «размышления», как только ассистент начал
   * разбирать фразу, — не дожидаясь ответа модели. Иначе в паузе на
   * распознавание картинка замирает.
   */
  const thinking = $derived(assistantBusy() || store.status.llmStatus === "loading");

  /** Что показать под реактором: ответ целиком или то, что уже наговорил Джарвис. */
  const replyText = $derived(store.dialog.reply || store.chat.streaming);

  /**
   * Подсказка под реактором зависит от фазы. Раньше она была статичной и в
   * фазе «Слушаю» продолжала советовать сказать «Джарвис» — это сбивало.
   */
  const hintText = $derived.by(() => {
    switch (assistant.tone) {
      case "live":
        return "Говорите — я слушаю. Замолчите на миг, и я отвечу.";
      case "busy":
        return "Разбираю услышанное — ещё пара секунд.";
      case "speaking":
        return "Перебить можно словом «замолчи» или кнопкой «Замолчать».";
      default:
        return "Скажите «Джарвис», дождитесь отклика и говорите команду или вопрос.";
    }
  });

  const hasDialog = $derived(Boolean(store.dialog.heard || replyText || store.transcript));

  /**
   * Состояние подсистем человеческими словами: без имён моделей и аббревиатур.
   * Раньше это была таблица на пол-экрана — она съедала место у сцены, хотя
   * нужна только когда что-то не работает, поэтому теперь это строка чипов.
   */
  const health = $derived.by(() => {
    const rows: { name: string; ok: boolean; warn: boolean }[] = [];
    const running = store.status.engineRunning;
    const paused = store.status.paused;

    // Пауза — не поломка, но и не «зелёный» микрофон: тот же латунный язык,
    // что у плашки и главного переключателя.
    rows.push({ name: "Микрофон", ok: running && !paused, warn: !running || paused });

    const llm = store.status.llmStatus;
    rows.push({
      name: "Ответы",
      ok: llm === "ready",
      warn: llm !== "ready" && llm !== "error",
    });

    rows.push({ name: "Голос", ok: store.status.ttsReady, warn: !store.status.ttsReady });

    if (store.wakeScore > 0) {
      rows.push({ name: `«Джарвис» ${Math.round(store.wakeScore * 100)}%`, ok: true, warn: false });
    }

    return rows;
  });

  async function togglePause() {
    const next = !store.status.paused;
    await invoke("set_paused", { paused: next });
    store.status.paused = next;
  }

  /** Перебить ответ: и озвучку, и генерацию. */
  async function hush() {
    try {
      await invoke("llm_cancel");
    } catch {
      // движок ещё не поднят — перебивать нечего
    }
  }
</script>

<div class={`hero card hero--${assistant.tone}`}>
  <div class="hero__stage">
    <!-- Приборная рамка сцены: HUD-скобы по углам, как на экранах в башне Старка -->
    <div class="stage-frame" aria-hidden="true"></div>
    <ArcReactor
      state={sphereState}
      level={sphereLevel}
      thinking={thinking}
      speaking={assistant.tone === "speaking"}
    />
  </div>
  <div class="hero__state" class:is-live={assistant.tone === "live"}>
    {assistant.full}
  </div>

  <!--
    Живая строка диалога: что услышал Джарвис и что он отвечает. Раньше
    распознанный текст не показывался нигде, и интерфейс выглядел мёртвым
    даже когда всё работало.
  -->
  {#if hasDialog}
    <div class="dialog" class:is-answering={assistant.tone === "speaking"}>
      {#if store.dialog.heard || store.transcript}
        <p class="dialog__me">
          {store.dialog.heard || store.transcript}
        </p>
      {/if}
      {#if replyText}
        <p class="dialog__ai" class:is-action={store.dialog.fromAction}>
          {replyText}
        </p>
      {/if}
    </div>
