<file path="examples/nn_verify.rs">
//! Сверка candle-реализаций с onnxruntime: одна и та же модель, одни входы.
//! Запуск: cargo run --release --example nn_verify -p jarvis-core

use anyhow::{Context, Result};
use candle_core::Device;
use jarvis_core::nn::distilbert::{DistilBertClassifier, DistilBertConfig};
use jarvis_core::nn::roformer::{RoFormer, RoFormerConfig};
use jarvis_core::stress::RuStress;
use ort::session::{Session, SessionInputValue, SessionInputs};
use ort::value::{Tensor, Value};
use std::borrow::Cow;
use std::path::Path;
use tokenizers::Tokenizer;

fn run_ort(session: &mut Session, inputs: Vec<(String, Vec<i64>, [usize; 2])>) -> Result<Vec<f32>> {
    let vals: Vec<(Cow<'static, str>, SessionInputValue<'static>)> = inputs
        .into_iter()
        .map(|(name, data, shape)| {
            let t = Tensor::from_array((shape, data)).unwrap();
            (Cow::Owned(name), SessionInputValue::Owned(Value::from(t)))
        })
        .collect();
    let outputs = session.run(SessionInputs::from(vals))?;
    let (_s, logits) = outputs[0].try_extract_tensor::<f32>()?;
    Ok(logits.to_vec())
}

fn max_diff(a: &[f32], b: &[f32]) -> f32 {
    a.iter()
        .zip(b)
        .map(|(x, y)| (x - y).abs())
        .fold(0.0f32, f32::max)
}

/// Скачивает ONNX, если его нет: файлы нужны только для этой сверки,
/// в рантайме движок их не читает.
fn ensure_onnx(url: &str, path: &str) -> Result<()> {
    let path = std::path::Path::new(path);
    if path.exists() {
        return Ok(());
    }
    println!("📥 {url}");
    if let Some(dir) = path.parent() {
        std::fs::create_dir_all(dir)?;
    }
    let response = ureq::get(url).call()?;
    let mut reader = response.into_body().into_reader();
    let mut file = std::fs::File::create(path)?;
    std::io::copy(&mut reader, &mut file)?;
    Ok(())
}

fn main() -> Result<()> {
    let device = Device::Cpu;
    ensure_onnx(
        "https://huggingface.co/TigreGotico/stressonnx-models/resolve/main/ru_ruaccent/nn_accent/model.onnx",
        "models/stress-ru/accent.onnx",
    )?;
    ensure_onnx(
        "https://huggingface.co/ruaccent/accentuator/resolve/main/nn/nn_omograph/tiny2/model.onnx",
        "models/stress-ru/omograph/model.onnx",
    )?;

    // ---------- омографы: DistilBERT ----------
    println!("=== омографы (DistilBERT) ===");
    let tokenizer = Tokenizer::from_file("models/stress-ru/omograph/tokenizer.json")
        .map_err(|e| anyhow::anyhow!("{e}"))?;
    let distil = DistilBertClassifier::load(
        Path::new("models/stress-ru/omograph/model.safetensors"),
        DistilBertConfig::default(),
        &device,
    )?;
    let mut ort_omo = Session::builder()?
        .commit_from_file("models/stress-ru/omograph/model.onnx")
        .context("omograph onnx")?;

    let pairs = [
        (" <w>замок</w> стоит на горе.", "з+амок"),
        (" <w>замок</w> стоит на горе.", "зам+ок"),
        ("он закрыл дверь на <w>замок</w> .", "зам+ок"),
        ("мама купила <w>муку</w> .", "мук+у"),
        ("это была настоящая <w>мука</w> .", "м+ука"),
        ("как <w>дела</w> , павел ?", "дел+а"),
        ("у меня нет <w>дела</w> до этого .", "д+ела"),
        ("сколько <w>стоит</w> эта книга ?", "ст+оит"),
        ("дом <w>стоит</w> на берегу реки .", "сто+ит"),
        ("я не <w>поняла</w> , что ты имеешь в виду .", "понял+а"),
    ];
    let mut worst = 0.0f32;
    let mut decision_match = 0;
    for (sent, hyp) in pairs {
        let enc = tokenizer
            .encode((sent, hyp), true)
            .map_err(|e| anyhow::anyhow!("{e}"))?;
        let ids: Vec<i64> = enc.get_ids().iter().map(|&x| x as i64).collect();
        let mask: Vec<i64> = enc.get_attention_mask().iter().map(|&x| x as i64).collect();
        let n = ids.len();
        let uids: Vec<u32> = ids.iter().map(|&x| x as u32).collect();
        let umask: Vec<u32> = mask.iter().map(|&x| x as u32).collect();
        let candle = distil.logits(&uids, &umask)?;
        let ort = run_ort(
            &mut ort_omo,
            vec![
                ("input_ids".into(), ids.clone(), [1, n]),
                ("attention_mask".into(), mask, [1, n]),
            ],
        )?;
        let d = max_diff(&candle, &ort);
        worst = worst.max(d);
        let c_arg = usize::from(candle[1] > candle[0]);
        let o_arg = usize::from(ort[1] > ort[0]);
        if c_arg == o_arg {
            decision_match += 1;
        }
        println!(
            "  {hyp:10} candle=[{:.4},{:.4}] ort=[{:.4},{:.4}] Δ={d:.4} {}",
            candle[0],
            candle[1],
            ort[0],
            ort[1],
            if c_arg == o_arg {
                "ok"
            } else {
                "РАСХОЖДЕНИЕ"
            }
        );
    }
    println!(
        "  худшее Δ={worst:.4}, решения совпали {decision_match}/{}",
        pairs.len()
    );

    // ---------- ударитель: RoFormer ----------
    println!("\n=== ударитель (RoFormer) ===");
    let roformer = RoFormer::load(
        Path::new("models/stress-ru/accent.safetensors"),
        RoFormerConfig::default(),
        &device,
    )?;
    let mut ort_acc = Session::builder()?
        .commit_from_file("models/stress-ru/accent.onnx")
        .context("accent onnx")?;
    let stress = RuStress::load()?;

    let words = [
        "дела",
        "стоит",
        "замок",
        "муку",
        "начала",
        "звонит",
        "щавель",
        "договор",
        "каталог",
        "красивее",
        "километр",
        "магазин",
        "поняла",
        "градусов",
        "какая",
        "сегодня",
        "погода",
        "компьютер",
        "интернет",
        "освободишься",
        "музыка",
        "клала",
        "окно",
        "окна",
        "окне",
        "стекло",
        "письмо",
        "весна",
        "страна",
        "число",
        "слово",
        "место",
        "небо",
    ];
    let mut worst = 0.0f32;
    let mut mismatch = 0;
    for w in words {
        let ids = stress.debug_ids(w);
        let n = ids.len();
        let tt: Vec<i64> = vec![0; n];
        let am: Vec<i64> = vec![1; n];
        let uids: Vec<u32> = ids.iter().map(|&x| x as u32).collect();
        let utt: Vec<u32> = tt.iter().map(|&x| x as u32).collect();
        let uam: Vec<u32> = am.iter().map(|&x| x as u32).collect();
        let candle = roformer.logits(&uids, &utt, &uam)?;
        let ort = run_ort(
            &mut ort_acc,
            vec![
                ("input_ids".into(), ids.clone(), [1, n]),
                ("attention_mask".into(), am, [1, n]),
                ("token_type_ids".into(), tt, [1, n]),
            ],
        )?;
        let ort_rows: Vec<Vec<f32>> = ort.chunks(3).map(|c| c.to_vec()).collect();
        let mut d = 0.0f32;
        for (a, b) in candle.iter().zip(&ort_rows) {
            d = d.max(max_diff(a, b));
        }
        worst = worst.max(d);
        // решение: порядковый номер ударной гласной
        // Правило как в stress.rs: гласная с максимальной вероятностью STRESS_PRIMARY.
        let pick = |rows: &Vec<Vec<f32>>| -> Option<usize> {
            let chars: Vec<char> = w.chars().collect();
            let mut best: Option<(usize, f32)> = None;
            for i in 1..=chars.len() {
                let row = rows.get(i)?;
                let max = row.iter().cloned().fold(f32::NEG_INFINITY, f32::max);
                let exps: Vec<f32> = row.iter().map(|v| (v - max).exp()).collect();
                let sum: f32 = exps.iter().sum();
                let (arg, p) = exps
                    .iter()
                    .enumerate()
                    .map(|(k, v)| (k, v / sum))
                    .max_by(|a, b| a.1.total_cmp(&b.1))?;
                if p < 0.55 || arg != 1 {
                    continue;
                }
                if !jarvis_core::stress::is_ru_vowel(chars[i - 1]) {
                    continue;
                }
                if best.is_none_or(|(_, bp)| p > bp) {
                    best = Some((i, p));
                }
            }
            let (pos, _) = best?;
            Some(
                w.chars()
                    .take(pos)
                    .filter(|c| jarvis_core::stress::is_ru_vowel(*c))
                    .count(),
            )
        };
        let c = pick(&candle);
        let o = pick(&ort_rows);
        if c != o {
            mismatch += 1;
        }
        println!(
            "  {w:14} candle={c:?} ort={o:?} Δ={d:.4} {}",
            if c == o {
                "ok"
            } else {
                "РАСХОЖДЕНИЕ"
            }
        );
    }
    println!(
        "  худшее Δ={worst:.4}, решения совпали {}/{}",
        words.len() - mismatch,
        words.len()
    );
    Ok(())
}
</file>

<file path="examples/prompt_size.rs">
//! Замер размера промптов в токенах: сколько стоит префилл под конкретную
//! просьбу. Печатает таблицу, чтобы правки промпта не раздували отклик.
//!
//! Запуск: JARVIS_HOME=. cargo run --release --example prompt_size -p jarvis-core

use anyhow::Result;
use tokenizers::Tokenizer;

fn tokens(tok: &Tokenizer, text: &str) -> Result<usize> {
    let encoding = tok
        .encode(text, false)
        .map_err(|e| anyhow::anyhow!("encode: {e}"))?;
    Ok(encoding.get_ids().len())
}

fn main() -> Result<()> {
    let dir = jarvis_core::paths::models_dir().join(jarvis_core::llm::config::model_name());
    let tok =
        Tokenizer::from_file(dir.join("tokenizer.json")).map_err(|e| anyhow::anyhow!("{e}"))?;

    let chat = jarvis_core::llm::CHAT_SYSTEM_PROMPT;
    let web = jarvis_core::llm::WEB_SYSTEM_PROMPT;
    let catalog = jarvis_core::commands::prompt_catalog();

    println!("{:<34} {:>7} {:>6}", "промпт", "символы", "токены");
    println!("{}", "-".repeat(50));
    let row = |name: &str, text: &str| -> Result<()> {
        println!(
            "{:<34} {:>7} {:>6}",
            name,
            text.chars().count(),
            tokens(&tok, text)?
        );
        Ok(())
    };

    row("chat", chat)?;
    row("web", web)?;
    row("каталог команд", &catalog)?;
    println!("{}", "-".repeat(50));
    for (name, prompt) in [
        ("действие: без среза", ""),
        ("действие: сверни зум", "сверни зум"),
        ("действие: таймер", "поставь таймер на 10 минут"),
        ("действие: открой хром", "открой хром"),
        ("действие: напиши сообщение", "отправь сообщение маме"),
        (
            "действие: много срезов",
            "сверни зум, поставь таймер и отправь сообщение",
        ),
    ] {
        row(name, &jarvis_core::router::action_prompt_for(prompt))?;
    }
    Ok(())
}
</file>

<file path="examples/qa_battery.rs">
//! Батарея разнообразных вопросов через полный `llm::ask` — ресёрч качества
//! ответов универсального помощника: игры, факты, свежие данные, вычисления,
//! действия на компьютере, творческие и разговорные вопросы.
//!
//! Запуск: cargo run --release -p jarvis-core --example qa_battery

use anyhow::Result;
use jarvis_core::events::JarvisEvent;
use jarvis_core::llm::{self, SharedLlmState};
use jarvis_core::tts::AudioMessage;
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::mpsc::channel;
use std::sync::{Arc, Condvar, Mutex};
use std::time::{Duration, Instant};

const QUESTIONS: &[&str] = &[
    // --- игры ---
    "во что поиграть с другом на вечер, если есть только колода карт",
    "сколько человек нужно для игры в монополию",
    "что сложнее: шахматы или го",
    // --- факты ---
    "когда вышел первый айфон",
    "кто такой Илон Маск",
    "какая столица Австралии",
    // --- свежие данные ---
    "какая погода в москве",
    // --- вычисления ---
    "сколько будет 15 процентов от 2400",
    // --- действия на компьютере ---
    "сколько свободного места на диске",
    "открой калькулятор",
    // --- творческое и разговорное ---
    "расскажи короткий анекдот про программиста",
    "объясни, что такое квантовая запутанность, простыми словами",
    "что ты умеешь",
    "спасибо",
];

fn main() -> Result<()> {
    let settings = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())?;
    settings.apply();

    let (events_tx, events_rx) = channel::<JarvisEvent>();
    let (audio_tx, audio_rx) = channel::<AudioMessage>();
    std::thread::spawn(move || for _ in audio_rx {});

    // Флаг завершения вопроса: LlmDone или Error.
    let done = Arc::new((Mutex::new(false), Condvar::new()));
    {
        let done = Arc::clone(&done);
        std::thread::spawn(move || {
            for ev in events_rx {
                match ev {
                    JarvisEvent::LlmDone { text } => {
                        println!("✅ ОТВЕТ: {text}");
                        let (lock, cvar) = &*done;
                        *lock.lock().unwrap() = true;
                        cvar.notify_all();
                    }
                    JarvisEvent::Error { message } => {
                        println!("❗ ОШИБКА: {message}");
                        let (lock, cvar) = &*done;
                        *lock.lock().unwrap() = true;
                        cvar.notify_all();
                    }
                    JarvisEvent::ActionStarted { tool, summary } => {
                        println!("▶️ {tool}: {summary}")
                    }
                    JarvisEvent::ActionResult { ok, summary } => {
                        println!("🔧 [{}] {}", ok, summary)
                    }
                    JarvisEvent::Log { message } => println!("ℹ️  {message}"),
                    JarvisEvent::LlmStatus { status } => println!("🧠 {status}"),
                    _ => {}
                }
            }
        });
    }

    let shared = Arc::new(SharedLlmState::new());
    llm::spawn_llm_loader(&shared, &events_tx);
    let history = Arc::new(Mutex::new(Vec::new()));
    let cancel = Arc::new(AtomicBool::new(false));

    for q in QUESTIONS {
        println!("\n========== ❓ {q}");
        let started = Instant::now();
        // Зеркало llm_ask (текстовый чат): свежие данные — сразу веб-флоу.
        let explicit_web = jarvis_core::router::explicit_web_request(q);
        let fresh_info = jarvis_core::web::looks_like_fresh_info(q)
            && !jarvis_core::router::calendar_question(q);
        let mut system = llm::CHAT_SYSTEM_PROMPT;
        let mut prompt = (*q).to_string();
        if explicit_web || fresh_info {
            let query = jarvis_core::router::web_query_from(q).unwrap_or_else(|| q.to_string());
            println!("🌐 веб-флоу: {query}");
            if let Ok(hits) = jarvis_core::web::search(&query, 5)
                && let Some(web_prompt) = jarvis_core::web::build_summary_prompt(&query, &hits)
            {
                system = llm::WEB_SYSTEM_PROMPT;
                prompt = web_prompt;
            }
        }
        llm::ask(
            Arc::clone(&shared),
            system,
            prompt,
            Arc::clone(&history),
            audio_tx.clone(),
            events_tx.clone(),
            Arc::clone(&cancel),
        );
        let (lock, cvar) = &*done;
        let guard = lock.lock().unwrap();
        let (mut guard, timeout) = cvar
            .wait_timeout_while(guard, Duration::from_secs(60), |finished| !*finished)
            .unwrap();
        if timeout.timed_out() {
            println!("⏱ ТАЙМАУТ 60 c");
        } else {
            println!("⏱ {:.1?}", started.elapsed());
        }
        *guard = false;
        std::thread::sleep(Duration::from_millis(300));
    }

    // История диалога — видно, что реально запомнилось.
    println!("\n========== ИСТОРИЯ");
    for (q, a) in history.lock().unwrap().iter() {
        println!("Q: {q}\nA: {}\n", a.chars().take(120).collect::<String>());
    }
    let _ = Ordering::SeqCst; // silence unused-import lint in some toolchains
    Ok(())
}
</file>

<file path="examples/qwen35_chat.rs">
//! Запуск Qwen3.5-0.8B на чистом candle (Metal, с откатом на CPU).
//!
//! Модель берётся из `models/qwen3.5-0.8b/` (уже скачана с Hugging Face:
//! config.json, tokenizer.json и safetensors-веса).
//!
//! Режимы:
//! ```text
//! cargo run -p jarvis-core --example qwen35_chat -- chat   # диалог в терминале
//! cargo run -p jarvis-core --example qwen35_chat -- bench  # замер скорости
//! cargo run -p jarvis-core --example qwen35_chat -- bench "свой промпт"
//! ```

use anyhow::{Context, Result};
use candle_core::{DType, Device, IndexOp};
use jarvis_core::llm::qwen35::{self, Qwen35Model};
use jarvis_core::llm::sampler;
use std::io::{BufRead, Write};
use std::path::PathBuf;
use std::time::Instant;
use tokenizers::Tokenizer;

const SYSTEM_PROMPT: &str =
    "Ты Джарвис — голосовой ассистент. Отвечай кратко на русском, 1-3 предложения.";

/// Рекомендации Qwen для не-thinking режима.
const TEMPERATURE: f64 = 0.7;
const TOP_P: f64 = 0.8;
const REPEAT_PENALTY: f32 = 1.05;
const REPEAT_WINDOW: usize = 64;

fn models_dir() -> PathBuf {
    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../models")
}

fn pick_device() -> Device {
    match Device::new_metal(0) {
        Ok(d) => {
            println!("✅ Устройство: Metal");
            d
        }
        Err(e) => {
            eprintln!("⚠️ Metal недоступен ({e}), работаем на CPU");
            Device::Cpu
        }
    }
}

struct Runner {
    model: Qwen35Model,
    tokenizer: Tokenizer,
    eos_ids: Vec<u32>,
}

impl Runner {
    fn load() -> Result<Self> {
        let dir = models_dir().join(qwen35::LOCAL_DIR_NAME);
        let device = pick_device();

        let model = Qwen35Model::load(&dir, &device)
            .with_context(|| format!("Не удалось загрузить модель из {}", dir.display()))?;
        let tokenizer = Tokenizer::from_file(dir.join("tokenizer.json"))
            .map_err(|e| anyhow::anyhow!("Не удалось загрузить токенизатор: {e}"))?;

        // EOS: из конфига (<|endoftext|>) плюс терминатор ChatML-шаблона.
        let mut eos_ids = model.config.eos_ids.clone();
        for special in ["<|endoftext|>", "<|im_end|>"] {
            if let Some(id) = tokenizer.token_to_id(special)
                && !eos_ids.contains(&id)
            {
                eos_ids.push(id);
            }
        }
        println!("   EOS-токены: {eos_ids:?}");

        Ok(Self {
            model,
            tokenizer,
            eos_ids,
        })
    }

    /// Генерация со стримингом. Возвращает текст и метрики (мс префилла,
    /// мс/токен декода).
    fn generate(
        &self,
        prompt: &str,
        max_tokens: usize,
        mut on_token: impl FnMut(&str),
    ) -> Result<(String, f64, f64)> {
        let encoding = self
            .tokenizer
            .encode(prompt, false)
            .map_err(|e| anyhow::anyhow!("Ошибка токенизации: {e}"))?;
        let prompt_tokens: Vec<u32> = encoding.get_ids().to_vec();
        if prompt_tokens.is_empty() {
            anyhow::bail!("Пустой промпт");
        }
        let mut context = prompt_tokens.clone();

        let mut cache = self.model.new_cache();
        let t0 = Instant::now();
        let mut logits = self.model.forward(&prompt_tokens, 0, &mut cache)?;
        let _ = self.model.device().synchronize();
        let prefill_ms = t0.elapsed().as_secs_f64() * 1e3;

        let prompt_len = context.len();
        let t_decode = Instant::now();
        let mut text = String::new();
        let mut suppress_think = false;
        let mut rng = rand::thread_rng();

        let debug = std::env::var("QWEN35_DEBUG").is_ok();
        for step in 0..max_tokens {
            let last = logits.dim(0)? - 1;
            let mut row: Vec<f32> = logits
                .i((last, ..))?
                .to_dtype(DType::F32)?
                .flatten_all()?
                .to_vec1()?;

            if debug && step < 8 {
                let mut idx: Vec<u32> = (0..row.len() as u32).collect();
                idx.select_nth_unstable_by(4, |&a, &b| row[b as usize].total_cmp(&row[a as usize]));
                idx.truncate(5);
                idx.sort_unstable_by(|&a, &b| row[b as usize].total_cmp(&row[a as usize]));
                for &i in &idx {
                    let s = self.tokenizer.decode(&[i], true).unwrap_or_default();
                    println!("   🔍 top{:?} {}: {:.4} {:?}", step, i, row[i as usize], s);
                }
            }

            sampler::apply_repeat_penalty(&mut row, REPEAT_PENALTY, &context, REPEAT_WINDOW);
            let tok = sampler::sample_top_p(&row, TEMPERATURE, TOP_P, &mut rng);
            if self.eos_ids.contains(&tok) {
                break;
            }
            context.push(tok);

            let piece = self
                .tokenizer
                .decode(&[tok], true)
                .map_err(|e| anyhow::anyhow!("Ошибка декодирования: {e}"))?;
            let piece = strip_think(&piece, &mut suppress_think);
            if !piece.is_empty() {
                text.push_str(&piece);
                on_token(&piece);
            }

            logits = self.model.forward(&[tok], prompt_len + step, &mut cache)?;
        }
        let _ = self.model.device().synchronize();
        let decoded = context.len() - prompt_len;
        let ms_per_token = t_decode.elapsed().as_secs_f64() * 1e3 / decoded.max(1) as f64;
        Ok((text, prefill_ms, ms_per_token))
    }
}

/// Простейшее отсечение рассуждений, если модель начала их писать
/// вопреки закрытому `<think>` в промпте.
fn strip_think(piece: &str, suppress: &mut bool) -> String {
    const OPEN: &str = "<think>";
    const CLOSE: &str = "</think>";
    let mut out = String::new();
    let mut rest = piece;
    loop {
        if *suppress {
            match rest.find(CLOSE) {
                Some(i) => {
                    rest = &rest[i + CLOSE.len()..];
                    *suppress = false;
                }
                None => break,
            }
        } else {
            match rest.find(OPEN) {
                Some(i) => {
                    out.push_str(&rest[..i]);
                    rest = &rest[i + OPEN.len()..];
                    *suppress = true;
                }
                None => {
                    out.push_str(rest);
                    break;
                }
            }
        }
    }
    out
}

fn bench(prompt: &str, max_tokens: usize) -> Result<()> {
    let runner = Runner::load()?;
    println!("\n▶ Промпт: {prompt:?}");
    let started = Instant::now();
    let (text, prefill_ms, ms_per_token) = runner.generate(prompt, max_tokens, |piece| {
        print!("{piece}");
        std::io::stdout().flush().ok();
    })?;
    println!(
        "\n\n📊 Префилл {prefill_ms:.0} мс; декод {ms_per_token:.1} мс/токен \
              ({:.0} ток/с); всего {:.1?}",
        1000.0 / ms_per_token,
        started.elapsed(),
    );
    println!("---\n{text}");
    Ok(())
}

fn chat() -> Result<()> {
    let runner = Runner::load()?;
    let mut history: Vec<(String, String)> = Vec::new();
    println!("Диалог с Qwen3.5-0.8B. Пустая строка или Ctrl-D — выход.\n");
    let stdin = std::io::stdin();
    loop {
        print!("Вы > ");
        std::io::stdout().flush().ok();
        let mut line = String::new();
        if stdin.lock().read_line(&mut line).unwrap_or(0) == 0 {
            break;
        }
        let user = line.trim();
        if user.is_empty() {
            break;
        }

        let prompt = qwen35::build_chat_prompt(SYSTEM_PROMPT, &history, user);
        let started = Instant::now();
        let result = runner.generate(&prompt, 256, |piece| {
            print!("{piece}");
            std::io::stdout().flush().ok();
        });
        println!();
        match result {
            Ok((text, prefill_ms, ms_per_token)) => {
                println!(
                    "   [{:.1?}: префилл {:.0} мс, {:.1} мс/токен]",
                    started.elapsed(),
                    prefill_ms,
                    ms_per_token
                );
                history.push((user.to_string(), text));
                let excess = history.len().saturating_sub(6);
                history.drain(..excess);
            }
            Err(e) => eprintln!("⚠️ {e:#}"),
        }
    }
    Ok(())
}

/// Отладка: логиты префилла на фиксированном промпте → /tmp/qwen35_rust_logits.bin
/// (f32, все позиции) для сверки с python-референсом.
fn dump_logits() -> Result<()> {
    let runner = Runner::load()?;
    let prompt = qwen35::build_chat_prompt(SYSTEM_PROMPT, &[], "Привет");
    let encoding = runner
        .tokenizer
        .encode(prompt.as_str(), false)
        .map_err(|e| anyhow::anyhow!("Ошибка токенизации: {e}"))?;
    let ids: Vec<u32> = encoding.get_ids().to_vec();
    println!("ids ({}){:?}...", ids.len(), &ids[..ids.len().min(12)]);

    type LayerDumps = std::sync::Arc<std::sync::Mutex<Vec<(usize, Vec<f32>)>>>;

    let mut cache = runner.model.new_cache();
    let dumps: LayerDumps = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
    let d = std::sync::Arc::clone(&dumps);
    let logits = runner
        .model
        .forward_with_inspector(&ids, 0, &mut cache, &mut |i, t| {
            let v: Vec<f32> = t
                .to_dtype(DType::F32)
                .and_then(|t| t.flatten_all())
                .and_then(|t| t.to_vec1())
                .unwrap_or_default();
            d.lock().unwrap().push((i, v));
        })?;
    {
        let dumps = dumps.lock().unwrap();
        for (i, v) in dumps.iter() {
            let name = if *i == usize::MAX {
                "embed".to_string()
            } else if *i == usize::MAX - 1 {
                "final".to_string()
            } else {
                format!("layer{i:02}")
            };
            let bytes: Vec<u8> = v.iter().flat_map(|f: &f32| f.to_le_bytes()).collect();
            std::fs::write(format!("/tmp/qwen35_rust_{name}.bin"), &bytes)?;
        }
        println!("слоёв сохранено: {}", dumps.len());
    }
    let _ = runner.model.device().synchronize();
    let rows: Vec<f32> = logits.to_dtype(DType::F32)?.flatten_all()?.to_vec1()?;
    let bytes: Vec<u8> = rows.iter().flat_map(|f: &f32| f.to_le_bytes()).collect();
    std::fs::write("/tmp/qwen35_rust_logits.bin", &bytes)?;
    println!(
        "сохранено /tmp/qwen35_rust_logits.bin: {} значений",
        rows.len()
    );

    let last = &rows[rows.len() - runner.model.config.vocab_size..];
    let mut idx: Vec<u32> = (0..last.len() as u32).collect();
    idx.select_nth_unstable_by(9, |&a, &b| last[b as usize].total_cmp(&last[a as usize]));
    idx.truncate(10);
    idx.sort_unstable_by(|&a, &b| last[b as usize].total_cmp(&last[a as usize]));
    for &i in &idx {
        println!(
            "   top {}: {:.4} {:?}",
            i,
            last[i as usize],
            runner.tokenizer.decode(&[i], true).unwrap_or_default()
        );
    }
    Ok(())
}

fn main() -> Result<()> {
    let mode = std::env::args().nth(1).unwrap_or_else(|| "chat".into());
    match mode.as_str() {
        "chat" => chat(),
        "bench" => {
            let prompt = std::env::args().nth(2).unwrap_or_else(|| {
                "Привет! Расскажи коротко, чем знаменит Санкт-Петербург.".into()
            });
            bench(&prompt, 96)
        }
        "dump" => dump_logits(),
        other => {
            anyhow::bail!("Неизвестный режим {other:?}: используй chat, bench или dump");
        }
    }
}
</file>

<file path="examples/silero_verify.rs">
//! Верификация candle-реализации против эталона PyTorch (silero_ref).
//! Запуск: cargo run --release --example silero_verify -p jarvis-core

use anyhow::Result;
use jarvis_core::tts_silero::SileroEngine;

fn main() -> Result<()> {
    let engine = SileroEngine::new_no_stress("ru_eduard")?;
    let audio = engine.synthesize("Привет! Как дела?", 1.0)?;
    let rms = (audio.iter().map(|s| s * s).sum::<f32>() / audio.len() as f32).sqrt();
    println!("audio: {} сэмплов, RMS {:.4}", audio.len(), rms);

    let stages = engine.debug_stages("Привет! Как дела?", 1.0)?;
    let ref_st: serde_json::Value =
        serde_json::from_str(&std::fs::read_to_string("models/silero/ref_stages.json")?)?;
    println!("--- стадии ---");
    for (name, data, _shape) in &stages {
        if let Some(rd) = ref_st.get(name).and_then(|v| v.as_array()) {
            if rd.len() == data.len() {
                let md = data
                    .iter()
                    .zip(rd)
                    .map(|(a, b)| (a - b.as_f64().unwrap_or(0.0) as f32).abs())
                    .fold(0.0f32, f32::max);
                println!("  {:<12} maxdiff {:.6}", name, md);
            } else {
                println!("  {:<12} размер {} против {}", name, data.len(), rd.len());
            }
        }
    }
    let ref_json = std::fs::read_to_string("models/silero/ref.json")?;
    let ref_data: serde_json::Value = serde_json::from_str(&ref_json)?;
    let ref_audio: Vec<f32> = ref_data["audio"]
        .as_array()
        .ok_or_else(|| anyhow::anyhow!("нет audio"))?
        .iter()
        .map(|v| v.as_f64().unwrap_or(0.0) as f32)
        .collect();
    let ref_durs: Vec<i32> = ref_data["durs"]
        .as_array()
        .ok_or_else(|| anyhow::anyhow!("нет durs"))?
        .iter()
        .map(|v| v.as_f64().unwrap_or(0.0) as i32)
        .collect();
    let mel_json = std::fs::read_to_string("models/silero/ref_mel.json")?;
    let mel_data: serde_json::Value = serde_json::from_str(&mel_json)?;
    let ref_mel: Vec<f32> = mel_data["mel"]
        .as_array()
        .ok_or_else(|| anyhow::anyhow!("нет mel"))?
        .iter()
        .map(|v| v.as_f64().unwrap_or(0.0) as f32)
        .collect();

    let my_durs = engine.debug_durations("Привет! Как дела?", 1.0)?;
    println!("my  durs: {:?}", my_durs);
    let ref_voc: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(
        "models/silero/ref_voc_stages.json",
    )?)?;
    let voc_stages = engine.debug_voc_from(&ref_mel)?;
    println!("--- вокодер ---");
    for (name, data, _shape) in &voc_stages {
        if let Some(rd) = ref_voc.get(name).and_then(|v| v.as_array()) {
            if rd.len() == data.len() {
                let md = data
                    .iter()
                    .zip(rd)
                    .map(|(a, b)| (a - b.as_f64().unwrap_or(0.0) as f32).abs())
                    .fold(0.0f32, f32::max);
                println!("  {:<10} maxdiff {:.6}", name, md);
            } else {
                println!("  {:<10} размер {} против {}", name, data.len(), rd.len());
            }
        }
    }

    let (my_mel, ch, n) = engine.debug_mel("Привет! Как дела?", 1.0)?;
    if my_mel.len() == ref_mel.len() {
        let md = my_mel
            .iter()
            .zip(&ref_mel)
            .map(|(a, b)| (a - b).abs())
            .fold(0.0f32, f32::max);
        let mmean = my_mel
            .iter()
            .zip(&ref_mel)
            .map(|(a, b)| (a - b).abs())
            .sum::<f32>()
            / my_mel.len() as f32;
        println!("mel [{},{}]: maxdiff {:.5}, mean {:.5}", ch, n, md, mmean);
    } else {
        println!("⚠️ mel размеры: {} против {}", my_mel.len(), ref_mel.len());
    }
    println!("ref durs: {:?}", ref_durs);

    if audio.len() == ref_audio.len() {
        let diffs: Vec<f32> = audio
            .iter()
            .zip(&ref_audio)
            .map(|(a, b)| (a - b).abs())
            .collect();
        let big = diffs.iter().filter(|d| **d > 0.1).count();
        let mean = diffs.iter().sum::<f32>() / diffs.len() as f32;
        let max = diffs.iter().cloned().fold(0.0f32, f32::max);
        println!(
            "diff: mean {:.5}, max {:.5}, >0.1: {} из {}",
            mean,
            max,
            big,
            diffs.len()
        );
        let json_out = serde_json::json!({ "rust_audio": audio, "ref_audio": ref_audio });
        std::fs::write("models/silero/diff_dump.json", json_out.to_string())?;
        if max < 0.05 {
            println!("✅ VERIFIED: candle совпадает с PyTorch");
        } else {
            println!("✗ расхождение есть");
        }
    } else {
        println!(
            "⚠️ длина не совпадает: {} против {}",
            audio.len(),
            ref_audio.len()
        );
    }
    Ok(())
}
</file>

<file path="examples/stress_audio.rs">
//! Диагностика ударений: печатает токены («+» = id 5) и пишет два WAV —
//! со стрессором и без, чтобы сравнить на слух.
//!
//! Запуск: cargo run --release --example stress_audio -p jarvis-core

use jarvis_core::tts_silero::{SAMPLE_RATE, SileroEngine};

const TEXT: &str = "Слушаю вас, Павел. Привет, как дела? У меня всё хорошо. \
Сейчас две тысячи двадцать шестой год. Замок стоит на горе.";

fn write_wav(path: &str, samples: &[f32]) -> Result<(), Box<dyn std::error::Error>> {
    let spec = hound::WavSpec {
        channels: 1,
        sample_rate: SAMPLE_RATE,
        bits_per_sample: 16,
        sample_format: hound::SampleFormat::Int,
    };
    let mut w = hound::WavWriter::create(path, spec)?;
    for &s in samples {
        let v = (s.clamp(-1.0, 1.0) * 32767.0) as i16;
        w.write_sample(v)?;
    }
    w.finalize()?;
    Ok(())
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let with = SileroEngine::new("ru_bogdan")?;
    let without = SileroEngine::new_no_stress("ru_bogdan")?;

    let tokens_with = with.debug_tokens(TEXT)?;
    let tokens_without = without.debug_tokens(TEXT)?;
    println!(
        "знак «+» (id 5): {} шт. с ударениями, {} шт. без",
        tokens_with.iter().filter(|&&t| t == 5).count(),
        tokens_without.iter().filter(|&&t| t == 5).count(),
    );

    let a = with.synthesize(TEXT, 0.95)?;
    let b = without.synthesize(TEXT, 0.95)?;
    let n = a.len().min(b.len());
    let diff: f32 = (0..n).map(|i| (a[i] - b[i]).abs()).sum::<f32>() / n as f32;
    write_wav("build/tts_with_stress.wav", &a)?;
    write_wav("build/tts_without_stress.wav", &b)?;
    println!("средняя |разница| = {diff:.5}");
    println!("→ build/tts_with_stress.wav / build/tts_without_stress.wav");
    Ok(())
}
</file>

<file path="examples/stress_check.rs">
//! Проверка точности ударителя: набор слов-ловушек с эталонным ударением.
//! Печатает вердикт по каждому слову и общую точность.
//!
//! Запуск: cargo run --release --example stress_check -p jarvis-core

use jarvis_core::stress::RuStress;

/// (слово, порядковый номер ударной гласной, ожидаемое произношение).
const CASES: &[(&str, usize, &str)] = &[
    // Жалобы пользователя
    ("дела", 1, "де́ла"),
    ("градусов", 1, "гр́адусов"),
    ("градуса", 1, "гр́адуса"),
    ("какая", 2, "каќая"),
    ("какие", 2, "каќие"),
    ("какое", 2, "каќое"),
    ("такая", 2, "таќая"),
    ("такие", 2, "таќие"),
    // Классические ловушки
    ("звонит", 2, "звон́ит"),
    ("торты", 1, "т́орты"),
    ("щавель", 2, "щав́ель"),
    ("договор", 3, "догов́ор"),
    ("каталог", 3, "катал́ог"),
    ("красивее", 2, "крас́ивее"),
    ("километр", 3, "килом́етр"),
    ("магазин", 3, "магазин́"),
    ("свёкла", 1, "св́ёкла"),
    ("жалюзи", 3, "жалюз́и"),
    ("облегчит", 3, "облегч́ит"),
    // Глаголы прошедшего времени с ударной основой (жен. род)
    ("поняла", 3, "понял́а"),
    ("приняла", 3, "принял́а"),
    ("заняла", 3, "занял́а"),
    ("отдала", 3, "отдал́а"),
    ("продала", 3, "продал́а"),
    ("начала", 2, "начал́а"),
    ("кралась", 1, "кр́алась"),
    ("клала", 2, "клал́а"), // единственный известный промах NN (слова нет в словаре)
    // Обычная речь
    ("погода", 2, "поѓода"),
    ("ассистент", 3, "ассист́ент"),
    ("голосовой", 4, "голосов́ой"),
    ("сейчас", 2, "сейч́ас"),
    ("открываю", 3, "открыв́аю"),
    ("музыка", 1, "м́узыка"),
    ("компьютер", 2, "компь́ютер"),
    ("интернет", 3, "интерн́ет"),
];

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let stress = RuStress::load()?;

    let mut ok = 0usize;
    let mut bad: Vec<String> = Vec::new();

    println!(
        "{:<18} {:>8} {:>8}  произношение",
        "слово", "ожидал", "получил"
    );
    println!("{}", "-".repeat(56));
    for (word, expected, spoken) in CASES {
        let got = stress.stressed_vowel_ordinal(word);
        let verdict = match got {
            Some(o) if o == *expected => {
                ok += 1;
                "✓".to_string()
            }
            Some(o) => {
                bad.push(format!("{word} (ожидался слог {expected}, получен {o})"));
                format!("✗ слог {o}")
            }
            None => {
                bad.push(format!("{word} (не определено)"));
                "✗ нет".to_string()
            }
        };
        println!("{word:<18} {expected:>8} {verdict:>8}  {spoken}");
    }

    let total = CASES.len();
    println!(
        "\nТочность: {ok}/{total} = {:.1}%",
        100.0 * ok as f64 / total as f64
    );
    if !bad.is_empty() {
        println!("\nОшибки:");
        for b in &bad {
            println!("  - {b}");
        }
    }

    Ok(())
}
</file>

<file path="examples/stress_text.rs">
//! Печатает текст с расставленными «+» (как его видит движок) и пишет WAV.
//! Запуск: cargo run --release --example stress_text -p jarvis-core -- "текст"
//!         [выходной wav]

use jarvis_core::tts_silero::{SAMPLE_RATE, SileroEngine};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut args = std::env::args().skip(1);
    let text = args
        .next()
        .unwrap_or_else(|| "проверка ударений".to_string());
    let out = args.next();

    let engine = SileroEngine::new("ru_bogdan")?;
    let tokens = engine.debug_tokens(&text)?;

    // Декодируем токены обратно в строку через алфавит.
    let alphabet: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(
        jarvis_core::paths::models_dir().join("silero/alphabet.json"),
    )?)?;
    let id2sym: std::collections::HashMap<i64, char> = alphabet["id_to_symbol"]
        .as_object()
        .map(|m| {
            m.iter()
                .filter_map(|(k, v)| {
                    let id: i64 = k.parse().ok()?;
                    let c = v.as_str()?.chars().next()?;
                    Some((id, c))
                })
                .collect()
        })
        .unwrap_or_default();

    let accented: String = tokens
        .iter()
        .filter_map(|t| id2sym.get(t))
        .collect::<String>()
        .trim_matches(|c| c == '|' || c == '~')
        .to_string();
    println!("ACCENTED:{accented}");

    if let Some(path) = out {
        let audio = engine.synthesize(&text, 1.0)?;
        let spec = hound::WavSpec {
            channels: 1,
            sample_rate: SAMPLE_RATE,
            bits_per_sample: 16,
            sample_format: hound::SampleFormat::Int,
        };
        let mut w = hound::WavWriter::create(&path, spec)?;
        for &s in &audio {
            w.write_sample((s.clamp(-1.0, 1.0) * 32767.0) as i16)?;
        }
        w.finalize()?;
        println!("WROTE:{path} {} samples", audio.len());
    }
    Ok(())
}
</file>

<file path="examples/tool_probe.rs">
//! Проверка одного инструмента на живой машине: разбирает tool-блок и
//! выполняет его, печатая итог так, как его услышит пользователь.
//!
//! Нужно, чтобы проверять действия без голоса и без моделей:
//!
//! ```text
//! JARVIS_HOME=. cargo run --release -p jarvis-core --example tool_probe -- \
//!   '<tool>{"name":"music_control","args":{"action":"pause"}}</tool>'
//! ```

use std::sync::mpsc::channel;

fn main() {
    let arg = std::env::args().nth(1).unwrap_or_default();
    if arg.trim().is_empty() {
        eprintln!("Использование: tool_probe '<tool>{{...}}</tool>'");
        std::process::exit(1);
    }

    match jarvis_core::tools::parse_lenient(&arg) {
        jarvis_core::tools::ToolParse::Call(call) => {
            let (audio_tx, audio_rx) = channel();
            let (events, _events_rx) = channel();
            let outcome = jarvis_core::tools::execute(call, &audio_tx, &events);
            println!("ок:      {}", outcome.ok);
            println!("скажет:  {}", outcome.speech);
            if !outcome.detail.trim().is_empty() {
                println!("детали:  {}", outcome.detail.replace('\n', " ⏎ "));
            }
            // Аудио в этом режиме не проигрываем: пробуем инструмент, а не голос.
            let _ = audio_rx.try_recv();
        }
        jarvis_core::tools::ToolParse::Failed(reason) => {
            eprintln!("вызов не разобран: {reason}");
            std::process::exit(2);
        }
        jarvis_core::tools::ToolParse::None => {
            eprintln!("в аргументе нет tool-блока");
            std::process::exit(2);
        }
    }
}
</file>

<file path="examples/web_bench.rs">
//! Замер скорости поиска: «как было» (новый агент на каждый запрос, без
//! прогрева и кэша) против текущей реализации.
//!
//! Запуск: cargo run --release --example web_bench -p jarvis-core

use anyhow::Result;
use std::time::{Duration, Instant};

const SEARCH_URL: &str = "https://lite.duckduckgo.com/lite/";
const USER_AGENT: &str = "JarvisVoiceAssistant/2.0 (personal assistant)";

/// Старое поведение: свежий агент и таймаут 6 с на каждый запрос.
fn legacy_search(query: &str) -> Result<usize> {
    let agent = ureq::Agent::config_builder()
        .timeout_global(Some(Duration::from_secs(6)))
        .build()
        .new_agent();
    let url = format!("{}?q={}", SEARCH_URL, urlencoding::encode(query));
    let response = agent
        .get(&url)
        .header("User-Agent", USER_AGENT)
        .header("Accept-Language", "ru-RU,ru;q=0.9,en;q=0.8")
        .call()?;
    let html = response.into_body().read_to_string()?;
    Ok(html.len())
}

fn main() -> Result<()> {
    let query = "какая сегодня погода в москве";

    println!("--- старое поведение (новый агент каждый раз) ---");
    for i in 1..=3 {
        let t = Instant::now();
        let n = legacy_search(query)?;
        println!("  запрос {i}: {:.0?} ({} байт HTML)", t.elapsed(), n);
    }

    println!("\n--- прогрев ---");
    let t = Instant::now();
    jarvis_core::web::warm_up();
    std::thread::sleep(Duration::from_millis(1200));
    println!("  warm_up вызван за {:.0?} (фон)", t.elapsed());

    println!("\n--- новое поведение ---");
    for i in 1..=3 {
        let t = Instant::now();
        let hits = jarvis_core::web::search(query, 5)?;
        println!(
            "  запрос {i}: {:.0?} ({} результатов)",
            t.elapsed(),
            hits.len()
        );
    }

    // Другой запрос — проверяем, что кэш не мешает свежим
    let t = Instant::now();
    let hits = jarvis_core::web::search("курс доллара к рублю", 5)?;
    println!(
        "\n  новый запрос: {:.0?} ({} результатов)",
        t.elapsed(),
        hits.len()
    );
    Ok(())
}
</file>

<file path="src/asr/config.rs">
//! Конфигурация FastConformer — читается из `config.json` (полный копия
//! `model_config.yaml` из чекпоинта, см. `tools/convert_fastconformer.py`).
//!
//! Приоритет всегда у конфигурации конкретного checkpoint; значения,
//! которых в нём нет (preemph, log guard), берутся из эталонного
//! препроцессора onnx-asr (istupakov), с которым проведена численная
//! верификация.

use anyhow::{Context, Result};
use serde::Deserialize;
use std::path::Path;

#[derive(Debug, Clone, Copy)]
pub struct PreprocessorConfig {
    pub sample_rate: usize,
    /// Число mel-полос (features).
    pub n_mels: usize,
    pub n_fft: usize,
    /// Длина окна в семплах (window_size * sample_rate = 0.025 * 16000 = 400).
    pub win_length: usize,
    /// Шаг окна в семплах (window_stride * sample_rate = 0.01 * 16000 = 160).
    pub hop_length: usize,
    /// Предыскажение сигнала.
    pub preemph: f32,
    /// Слагаемое внутри log(x + guard) — защита от log(0).
    pub log_guard: f32,
}

impl Default for PreprocessorConfig {
    fn default() -> Self {
        Self {
            sample_rate: 16_000,
            n_mels: 80,
            n_fft: 512,
            win_length: 400,
            hop_length: 160,
            preemph: 0.97,
            // 2**-24: значение из эталонного препроцессора onnx-asr.
            log_guard: 2f32.powi(-24),
        }
    }
}

#[derive(Debug, Clone, Copy)]
pub struct EncoderConfig {
    pub d_model: usize,
    pub n_layers: usize,
    pub n_heads: usize,
    pub feat_in: usize,
    /// Коэффициент сжатия pre-encode (8× = три свёртки stride 2).
    pub subsampling_factor: usize,
    /// Расширение FFN (ff_expansion_factor * d_model = 2048).
    pub ff_dim: usize,
    /// Ядро свёрточного модуля (9).
    pub conv_kernel_size: usize,
    /// Максимальная длина относительной позиционной таблицы (2*5000-1 = 9999).
    pub pos_emb_max_len: usize,
}

#[derive(Debug, Clone, Copy)]
pub struct DecoderConfig {
    /// Размер словаря SentencePiece (1024) без blank.
    pub vocab_size: usize,
    /// Скрытый размер prediction network (640).
    pub pred_hidden: usize,
    /// Число рекуррентных слоёв prediction network.
    pub pred_rnn_layers: usize,
    /// Скрытый размер joint network (640).
    pub joint_hidden: usize,
    /// Максимальное число токенов на один шаг времени RNNT.
    pub max_symbols_per_step: usize,
}

/// Полная конфигурация модели. Blank-токен всегда последний: id = vocab_size.
#[derive(Debug, Clone, Copy)]
pub struct FastConformerConfig {
    pub preprocessor: PreprocessorConfig,
    pub encoder: EncoderConfig,
    pub decoder: DecoderConfig,
    pub blank_id: usize,
}

impl Default for FastConformerConfig {
    fn default() -> Self {
        Self {
            preprocessor: PreprocessorConfig::default(),
            encoder: EncoderConfig {
                d_model: 512,
                n_layers: 17,
                n_heads: 8,
                feat_in: 80,
                subsampling_factor: 8,
                ff_dim: 2048,
                conv_kernel_size: 9,
                pos_emb_max_len: 5000,
            },
            decoder: DecoderConfig {
                vocab_size: 1024,
                pred_hidden: 640,
                pred_rnn_layers: 1,
                joint_hidden: 640,
                max_symbols_per_step: 10,
            },
            blank_id: 1024,
        }
    }
}

// Поля config.json, которые реально читаем; остальное игнорируется.
#[derive(Debug, Deserialize)]
struct RawConfig {
    preprocessor: Option<RawPreprocessor>,
    encoder: Option<RawEncoder>,
    #[serde(rename = "decoder")]
    rnnt_decoder: Option<RawRnntDecoder>,
}

#[derive(Debug, Deserialize)]
struct RawPreprocessor {
    sample_rate: Option<usize>,
    features: Option<usize>,
    n_fft: Option<usize>,
    window_size: Option<f64>,
    window_stride: Option<f64>,
}

#[derive(Debug, Deserialize)]
struct RawEncoder {
    d_model: Option<usize>,
    n_layers: Option<usize>,
    n_heads: Option<usize>,
    feat_in: Option<usize>,
    subsampling_factor: Option<usize>,
    ff_expansion_factor: Option<usize>,
    conv_kernel_size: Option<usize>,
    pos_emb_max_len: Option<usize>,
}

#[derive(Debug, Deserialize)]
struct RawRnntDecoder {
    #[allow(dead_code)]
    #[serde(rename = "_target_")]
    target: Option<String>,
    vocab_size: Option<usize>,
    prednet: Option<RawPrednet>,
    #[serde(rename = "jointnet")]
    jointnet: Option<RawJointnet>,
}

#[derive(Debug, Deserialize)]
struct RawPrednet {
    pred_hidden: Option<usize>,
    pred_rnn_layers: Option<usize>,
}

#[derive(Debug, Deserialize)]
struct RawJointnet {
    joint_hidden: Option<usize>,
}

/// Загружает конфигурацию из `config.json`. Отсутствующие поля — дефолты
/// (зафиксированы для stt_ru_fastconformer_hybrid_large_pc).
pub fn load(path: &Path) -> Result<FastConformerConfig> {
    let raw: RawConfig = serde_json::from_str(
        &std::fs::read_to_string(path)
            .with_context(|| format!("Не удалось прочитать {path:?}"))?,
    )
    .with_context(|| format!("Не удалось разобрать {path:?}"))?;

    let mut cfg = FastConformerConfig::default();
    if let Some(p) = &raw.preprocessor {
        let prep = &mut cfg.preprocessor;
        if let Some(v) = p.sample_rate {
            prep.sample_rate = v;
        }
        if let Some(v) = p.features {
            prep.n_mels = v;
        }
        if let Some(v) = p.n_fft {
            prep.n_fft = v;
        }
        if let Some(v) = p.window_size {
            prep.win_length = (v * prep.sample_rate as f64).round() as usize;
        }
        if let Some(v) = p.window_stride {
            prep.hop_length = (v * prep.sample_rate as f64).round() as usize;
        }
    }
    if let Some(e) = &raw.encoder {
        let enc = &mut cfg.encoder;
        if let Some(v) = e.d_model {
            enc.d_model = v;
        }
        if let Some(v) = e.n_layers {
            enc.n_layers = v;
        }
        if let Some(v) = e.n_heads {
            enc.n_heads = v;
        }
        if let Some(v) = e.feat_in {
            enc.feat_in = v;
        }
        if let Some(v) = e.subsampling_factor {
            enc.subsampling_factor = v;
        }
        if let Some(v) = e.ff_expansion_factor {
            enc.ff_dim = v * enc.d_model;
        }
        if let Some(v) = e.conv_kernel_size {
            enc.conv_kernel_size = v;
        }
        if let Some(v) = e.pos_emb_max_len {
            enc.pos_emb_max_len = v;
        }
    }
    if let Some(d) = &raw.rnnt_decoder {
        let dec = &mut cfg.decoder;
        if let Some(v) = d.vocab_size {
            dec.vocab_size = v;
        }
        if let Some(pn) = &d.prednet {
            if let Some(v) = pn.pred_hidden {
                dec.pred_hidden = v;
            }
            if let Some(v) = pn.pred_rnn_layers {
                dec.pred_rnn_layers = v;
            }
        }
        if let Some(jn) = &d.jointnet {
            if let Some(v) = jn.joint_hidden {
                dec.joint_hidden = v;
            }
        }
    }
    cfg.blank_id = cfg.decoder.vocab_size;
    Ok(cfg)
}
