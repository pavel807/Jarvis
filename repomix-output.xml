<file path="crates/jarvis-core/examples/fc_verify.rs">
//! Численная верификация candle-реализации FastConformer против ONNX-эталона.
//!
//! Фикстуры готовит `tools/fastconformer_fixtures.py` (истина —
//! encoder/decoder_joint-model.onnx istupakov + его NumPy-препроцессор):
//! для каждого wav сравниваются поэтапно:
//! 1. mel-фичи (Rust DFT+нормализация vs NumPy);
//! 2. выход энкодера (candle 17 блоков vs ONNX);
//! 3. жадный CTC-декод (ids);
//! 4. жадный RNNT-декод (ids и текст).
//!
//! Запуск: cargo run --release --example fc_verify -p jarvis-core
//! (требует models/fastconformer и build/fastconformer/fixtures).

use anyhow::{Context, Result};
use jarvis_core::asr::model::FastConformer;
use jarvis_core::asr::{ctc, rnnt};
use std::path::Path;

fn maxdiff(a: &[Vec<f32>], b: &[Vec<f32>]) -> (f32, usize, usize) {
    let mut max = 0f32;
    let (rows, cols) = (a.len().min(b.len()), a.first().map(|r| r.len()).unwrap_or(0));
    let cols = cols.min(b.first().map(|r| r.len()).unwrap_or(0));
    for (ra, rb) in a.iter().zip(b.iter()).take(rows) {
        for (va, vb) in ra.iter().zip(rb.iter()).take(cols) {
            max = max.max((va - vb).abs());
        }
    }
    (max, rows, cols)
}

fn main() -> Result<()> {
    let fixtures_dir = Path::new("build/fastconformer/fixtures");
    let files: Vec<_> = std::fs::read_dir(fixtures_dir)
        .with_context(|| format!("Нет каталога фикстур {fixtures_dir:?} — запусти tools/fastconformer_fixtures.py"))?
        .filter_map(|e| e.ok())
        .filter(|e| e.path().extension().is_some_and(|x| x == "json"))
        .map(|e| e.path())
        .collect();

    let model = FastConformer::load(&jarvis_core::paths::models_dir())?;
    println!(
        "=== верификация: {} фикстур, устройство: {} ===",
        files.len(),
        if model.is_metal() { "Metal" } else { "CPU" }
    );

    let blank = model.cfg.blank_id;
    let mut failures = 0;

    for fx in files {
        let raw = std::fs::read_to_string(&fx)?;
        let fx: serde_json::Value = serde_json::from_str(&raw)?;
        let name = fx["wav"].as_str().unwrap_or("?").to_string();
        let audio: Vec<f32> = fx["audio"]
            .as_array()
            .expect("audio")
            .iter()
            .map(|v| v.as_f64().unwrap() as f32)
            .collect();

        // 1. Mel-фронтенд.
        let (mel, length) = model.frontend.compute(&audio, &model.device)?;
        let my_mel = mel.squeeze(0)?.to_vec2::<f32>()?;
        let ref_mel: Vec<Vec<f32>> = fx["mel"]
            .as_array()
            .expect("mel")
            .iter()
            .map(|r| r.as_array().unwrap().iter().map(|v| v.as_f64().unwrap() as f32).collect())
            .collect();
        let (mel_diff, rows, cols) = maxdiff(&ref_mel, &my_mel);

        // 2. Энкодер.
        let (enc, t_valid) = model.encoder.forward(&mel, length)?;
        let my_enc = enc.squeeze(0)?.to_vec2::<f32>()?;
        let ref_enc: Vec<Vec<f32>> = fx["enc_out"][0]
            .as_array()
            .expect("enc_out")
            .iter()
            .map(|r| r.as_array().unwrap().iter().map(|v| v.as_f64().unwrap() as f32).collect())
            .collect();
        // Сравниваем только ВАЛИДНЫЕ кадры (0..t_valid) — это контракт
        // модели. Хвостовые кадры за t_valid ONNX маскирует (Where -10000),
        // реализация считает их без маски: на транскрипт они не влияют
        // (декодер идёт по t_valid кадрам).
        let t_ref = fx["enc_valid"].as_u64().unwrap() as usize;
        let (enc_diff, erows, ecols) = maxdiff(
            &ref_enc[..t_ref.min(ref_enc.len())],
            &my_enc[..t_ref.min(my_enc.len())],
        );
        let enc_len_match = t_ref == t_valid
            && ref_enc.len() >= t_ref
            && my_enc.len() >= t_ref;

        // 3. CTC greedy.
        let logits = model.ctc_head.logits(&enc)?;
        let (frames, vout) = (logits.dim(1)?, logits.dim(2)?);
        let flat = logits.reshape((frames * vout,))?.to_vec1::<f32>()?;
        let my_ctc = ctc::greedy(&flat, frames, vout, blank);
        let ref_ctc: Vec<usize> = fx["ctc_ids"]
            .as_array()
            .expect("ctc_ids")
            .iter()
            .map(|v| v.as_u64().unwrap() as usize)
            .collect();
        let ctc_match = my_ctc == ref_ctc;

        // 4. RNNT greedy.
        let my_rnnt = rnnt::greedy(&enc, t_valid, &model.predictor, &model.joint, blank, model.cfg.decoder.max_symbols_per_step)?;
        let ref_rnnt: Vec<usize> = fx["rnnt_ids"]
            .as_array()
            .expect("rnnt_ids")
            .iter()
            .map(|v| v.as_u64().unwrap() as usize)
            .collect();
        let rnnt_match = my_rnnt == ref_rnnt;
        let my_rnnt_text = model.tokenizer.decode(&my_rnnt);
        let ref_rnnt_text = fx["rnnt_text"].as_str().unwrap_or("").to_string();

        let ok = enc_len_match && ctc_match && rnnt_match && mel_diff < 1e-2 && enc_diff < 1e-2;
        if !ok {
            failures += 1;
        }
        println!(
            "{icon} {name}: mel Δ{mel_diff:.2e} ({rows}×{cols}) | enc Δ{enc_diff:.2e} ({erows}×{ecols}, len={t_valid} match={enc_len_match}) | CTC {ctc_match} | RNNT {rnnt_match}",
            icon = if ok { "✅" } else { "❌" }
        );
        if !rnnt_match {
            println!("   RNNT эталон: «{ref_rnnt_text}»");
            println!("   RNNT наш:    «{my_rnnt_text}»");
            let n = my_rnnt.len().min(ref_rnnt.len());
            if let Some(i) = (0..n).find(|&i| my_rnnt[i] != ref_rnnt[i]) {
                println!(
                    "   первое расхождение: кадр-токен #{i}: мой {} ({:?}) vs эталон {} ({:?}), всего мой {} vs эталон {}",
                    my_rnnt[i],
                    model.tokenizer.piece(my_rnnt[i]),
                    ref_rnnt[i],
                    model.tokenizer.piece(ref_rnnt[i]),
                    my_rnnt.len(),
                    ref_rnnt.len()
                );
            }
        }
    }

    if failures > 0 {
        anyhow::bail!("{failures} фикстур не прошли верификацию");
    }
    println!("🎉 Все фикстуры сошлись с ONNX-эталоном");
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/fc_wer.rs">
//! Замер точности (WER/CER/точные совпадения команд) и скорости (RTF,
//! латентность по этапам) FastConformer на тестовых русских записях.
//!
//! Тестовый набор: build/fastconformer/wavs — голосовые команды («Проиграй
//! музыку», «Открой Premiere Pro», …), длинное предложение, быстрая фраза.
//! Эталоны — тексты, которыми записи сгенерированы.
//!
//! Запуск: cargo run --release --example fc_wer -p jarvis-core
//! Декодер задаётся аргументом: rnnt (по умолчанию) | ctc | ctc_beam.

use jarvis_core::asr::model::{Decoder, FastConformer};
use std::time::Instant;

/// (файл, эталонный текст, это короткая команда?)
const CASES: &[(&str, &str, bool)] = &[
    ("cmd1.wav", "Джарвис, проиграй музыку", true),
    ("cmd2.wav", "Открой Premiere Pro", true),
    ("cmd3.wav", "Поставь музыку на паузу", true),
    ("cmd4.wav", "Переключи следующий трек", true),
    ("slow1.wav", "Останови воспроизведение", true),
    (
        "long1.wav",
        "Сегодня на улице двадцать пять градусов тепла, вероятность дождя шестьдесят процентов, а вечером ожидается усиление ветра до пятнадцати метров в секунду.",
        false,
    ),
];

/// Нормализация для WER/CER: lowercase, без пунктуации, одиночные пробелы.
fn normalize_words(text: &str) -> Vec<String> {
    text.chars()
        .map(|c| if c.is_alphanumeric() { c } else { ' ' })
        .collect::<String>()
        .to_lowercase()
        .split_whitespace()
        .map(String::from)
        .collect()
}

fn levenshtein(a: &[String], b: &[String]) -> usize {
    let mut prev: Vec<usize> = (0..=b.len()).collect();
    for (i, ai) in a.iter().enumerate() {
        let mut cur = vec![i + 1];
        for (j, bj) in b.iter().enumerate() {
            cur.push((prev[j] + 1).min(cur[j] + 1).min(prev[j] + (ai != bj) as usize));
        }
        prev = cur;
    }
    prev[b.len()]
}

/// Набор голосов Silero TTS (движок самого Jarvis): один текст, 8 голосов.
/// build/voice_compare_16k/*.wav; эталон — текст генерации.
const TTS_REFERENCE: &str = "Слушаю вас, Павел. Все системы в норме: процессор загружен на тридцать процентов, оперативной памяти свободно двенадцать гигабайт. Открываю премьер про. Похоже, сегодня будет дождь — взять с собой зонт? До связи.";

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut args = std::env::args().skip(1);
    let decoder = match args.next().as_deref() {
        Some("ctc") => Decoder::CtcGreedy,
        Some("ctc_beam") => Decoder::CtcBeam { width: 8 },
        _ => Decoder::Rnnt,
    };
    let set = args.next().unwrap_or_else(|| "say".into());
    let tts_set = set == "tts";
    let model = FastConformer::load(&jarvis_core::paths::models_dir())?;
    // Словарь Jarvis для ctc_beam: триггеры команд + русские формы
    // произношения (как в движке).
    let dict = (decoder == Decoder::CtcBeam { width: 8 })
        .then(|| {
            let cfg = jarvis_core::commands::CommandsConfig::load(&jarvis_core::paths::commands_file()).ok()?;
            let phrases: Vec<String> = cfg
                .commands
                .iter()
                .filter(|c| c.enabled)
                .flat_map(|c| {
                    let mut variants = c.trigger_words.clone();
                    for w in &c.trigger_words {
                        let ru = jarvis_core::tts_normalizer::apply_tech_pronunciation(&w.to_lowercase());
                        if ru != w.to_lowercase() && !variants.contains(&ru) {
                            variants.push(ru);
                        }
                    }
                    variants
                })
                .collect();
            model.jarvis_dictionary(&phrases).ok()
        })
        .flatten();
    println!(
        "=== fc_wer: декодер {:?}, устройство {} ===",
        decoder,
        if model.is_metal() { "Metal" } else { "CPU" }
    );

    let mut total_ref_words = 0usize;
    let mut total_word_errors = 0usize;
    let mut total_ref_chars = 0usize;
    let mut total_char_errors = 0usize;
    let mut command_total = 0usize;
    let mut command_exact = 0usize;
    let mut audio_secs = 0f64;
    let mut proc_secs = 0f64;
    let mut first_chunk_ms = Vec::new();

    if tts_set {
        // Голоса Silero: один эталон на все файлы каталога.
        let mut voices: Vec<String> = std::fs::read_dir("build/voice_compare_16k")?
            .filter_map(|e| e.ok())
            .filter(|e| e.path().extension().is_some_and(|x| x == "wav"))
            .map(|e| e.file_name().to_string_lossy().to_string())
            .collect();
        voices.sort();
        let mut total_wer = 0usize;
        let mut total_words = 0usize;
        for voice in &voices {
            let wav = format!("build/voice_compare_16k/{voice}");
            let (samples, sr) = crate_read_wav(&wav)?;
            assert_eq!(sr, 16_000, "ожидаю 16 кГц в {voice}");
            let t = model.transcribe_with(&samples, decoder, dict.as_ref())?;
            let got = normalize_words(&t.text);
            let want = normalize_words(TTS_REFERENCE);
            let wer = levenshtein(&got, &want);
            total_wer += wer;
            total_words += want.len();
            println!(
                "{voice}: WER {wer}/{} | «{}»",
                want.len(),
                t.text
            );
        }
        println!("─────");
        println!(
            "Silero TTS (8 голосов): WER {:.1}%  — декодер {:?}, устройство {}",
            100.0 * total_wer as f64 / total_words.max(1) as f64,
            decoder,
            if model.is_metal() { "Metal" } else { "CPU" }
        );
        return Ok(());
    }

    for (file, reference, is_command) in CASES {
        let wav = format!("build/fastconformer/wavs/{file}");
        let (samples, sr) = crate_read_wav(&wav)?;
        assert_eq!(sr, 16_000, "ожидаю 16 кГц в {file}");
        audio_secs += samples.len() as f64 / 16_000.0;

        let started = Instant::now();
        let t = model.transcribe_with(&samples, decoder, dict.as_ref())?;
        let elapsed = started.elapsed();
        proc_secs += elapsed.as_secs_f64();
        first_chunk_ms.push((t.mel_ms, t.encoder_ms, t.decode_ms));

        let got = normalize_words(&t.text);
        let want = normalize_words(reference);
        let wer = levenshtein(&got, &want);
        let cer = levenshtein(
            &got.concat().chars().map(String::from).collect::<Vec<_>>(),
            &want.concat().chars().map(String::from).collect::<Vec<_>>(),
        );
        total_ref_words += want.len();
        total_word_errors += wer;
        total_ref_chars += want.concat().chars().count();
        total_char_errors += cer;
        if *is_command {
            command_total += 1;
            if got == want {
                command_exact += 1;
            }
        }

        println!(
            "{file}: «{text}»\n    эталон: «{reference}»\n    WER {wer}/{n_w} CER {cer}/{n_c} | {:.2?} (RTF {:.2})",
            elapsed,
            elapsed.as_secs_f64() / (samples.len() as f64 / 16_000.0),
            text = t.text,
            n_w = want.len(),
            n_c = want.concat().chars().count(),
        );
    }

    let n = first_chunk_ms.len() as f64;
    let (mel, enc, dec) = first_chunk_ms
        .iter()
        .fold((0.0, 0.0, 0.0), |acc, x| (acc.0 + x.0, acc.1 + x.1, acc.2 + x.2));
    println!("─────");
    println!(
        "Итог: WER {:.1}%  CER {:.1}%  точные команды {command_exact}/{command_total}",
        100.0 * total_word_errors as f64 / total_ref_words.max(1) as f64,
        100.0 * total_char_errors as f64 / total_ref_chars.max(1) as f64,
    );
    println!(
        "Скорость: аудио {audio_secs:.1} с, обработка {proc_secs:.2} с, RTF {:.2} | средние этапы: mel {:.0} мс, encoder {:.0} мс, decode {:.0} мс",
        proc_secs / audio_secs.max(1e-9),
        mel / n,
        enc / n,
        dec / n,
    );
    Ok(())
}

/// Минимальный WAV-ридер: 16 кГц, mono, PCM16.
fn crate_read_wav(path: &str) -> Result<(Vec<f32>, u32), Box<dyn std::error::Error>> {
    let mut reader = hound::WavReader::open(path)?;
    let spec = reader.spec();
    let samples: Vec<f32> = reader
        .samples::<i16>()
        .map(|s| s.unwrap() as f32 / 32768.0)
        .collect();
    Ok((samples, spec.sample_rate))
}
</file>

<file path="crates/jarvis-core/examples/llm_bench.rs">
//! Замер LLM: префилл и время до первого куска речи (то, что слышит
//! пользователь). Сравнивает короткий чат-промпт и веб-сводку из 5/3
//! результатов — видно, сколько стоит контекст поиска.
//!
//! Запуск: cargo run --release --example llm_bench -p jarvis-core
//! Бэкенд и модель берутся из settings.toml (`llm_backend`, `llm_model`);
//! первые два аргумента переопределяют их для сравнения:
//! `... --example llm_bench -- uzu qwen3.5-0.8b`.

use anyhow::Result;
use jarvis_core::llm::{self, ChatTurn, SharedLlmState, config::GenerationParams};
use std::sync::Arc;
use std::sync::atomic::AtomicBool;
use std::time::Instant;

fn web_prompt(hits: usize, snippet_chars: usize) -> String {
    let mut context = String::new();
    for i in 0..hits {
        let snippet = "В Москве сегодня облачно, температура около минус трёх градусов, ветер пять метров в секунду, к вечеру похолодает до минус семи."
            .chars()
            .take(snippet_chars)
            .collect::<String>();
        context.push_str(&format!(
            "[{}] Погода в Москве на сегодня — прогноз\n{}\n\n",
            i + 1,
            snippet
        ));
    }
    format!(
        "Результаты поиска в интернете по запросу «какая сегодня погода в москве»:\n\n{context}На основе этих результатов ответь на вопрос пользователя. Кратко: 1-3 предложения, только суть, на русском языке."
    )
}

fn run(engine: &mut llm::LlmEngine, name: &str, prompt: &str) -> Result<()> {
    let started = Instant::now();
    let mut first_chunk: Option<std::time::Duration> = None;
    let mut chunks = 0usize;
    let cancel = AtomicBool::new(false);
    let text = engine.generate_streaming_with_params(
        llm::WEB_SYSTEM_PROMPT,
        &[] as &[ChatTurn],
        prompt,
        Some(GenerationParams {
            temperature: 0.2,
            top_p: 0.9,
            max_tokens: 120,
            ..Default::default()
        }),
        &cancel,
        |chunk| {
            chunks += 1;
            if first_chunk.is_none() {
                first_chunk = Some(started.elapsed());
                println!(
                    "   первый кусок TTS: {:?} ({} симв.)",
                    started.elapsed(),
                    chunk.chars().count()
                );
            }
        },
        |_| {},
    )?;
    println!(
        "  {name}: всего {:?}, кусков TTS {chunks}, ответ {} симв.: {}",
        started.elapsed(),
        text.chars().count(),
        text.chars().take(90).collect::<String>()
    );
    Ok(())
}

fn main() -> Result<()> {
    // Настройки из settings.toml, затем необязательные переопределения
    // аргументами: `llm_bench [backend] [model]`.
    let settings = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())?;
    settings.apply();
    let mut args = std::env::args().skip(1);
    if let Some(backend) = args.next() {
        llm::config::set_backend(&backend);
    }
    if let Some(model) = args.next() {
        llm::config::set_model_name(&model);
    }
    println!(
        "ℹ️  llm_backend = {}, llm_model = {}",
        llm::config::backend(),
        llm::config::model_name()
    );

    let shared: llm::SharedLlm = Arc::new(SharedLlmState::new());
    let (tx, _rx) = std::sync::mpsc::channel();
    llm::spawn_llm_loader(&shared, &tx);
    println!("⏳ жду модель...");
    let t = Instant::now();
    let mut guard = loop {
        let guard = shared.engine.lock().unwrap_or_else(|e| e.into_inner());
        if guard.is_some() {
            break guard;
        }
        if shared.failed.load(std::sync::atomic::Ordering::SeqCst) {
            anyhow::bail!("модель не загрузилась");
        }
        drop(guard);
        std::thread::sleep(std::time::Duration::from_millis(200));
    };
    println!("модель готова за {:?}", t.elapsed());
    let engine = guard.as_mut().expect("модель");

    // Прогревающий прогон (прогрев Metal/кэшей)
    run(engine, "прогрев", "Скажи одно слово: привет.")?;

    run(engine, "чат (короткий промпт)", "Как дела?")?;
    run(engine, "веб 5×220 симв.", &web_prompt(5, 220))?;
    run(engine, "веб 3×140 симв.", &web_prompt(3, 140))?;
    run(engine, "веб 3×90 симв.", &web_prompt(3, 90))?;
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/prompt_size.rs">
//! Замер размера промптов в токенах: сколько стоит префилл под конкретную
//! просьбу. Печатает таблицу, чтобы правки промпта не раздували отклик.
//!
//! Запуск: JARVIS_HOME=. cargo run --release --example prompt_size -p jarvis-core

use anyhow::Result;
use tokenizers::Tokenizer;

fn tokens(tok: &Tokenizer, text: &str) -> Result<usize> {
    let encoding = tok
        .encode(text, false)
        .map_err(|e| anyhow::anyhow!("encode: {e}"))?;
    Ok(encoding.get_ids().len())
}

fn main() -> Result<()> {
    let dir = jarvis_core::paths::models_dir().join(jarvis_core::llm::config::model_name());
    let tok =
        Tokenizer::from_file(dir.join("tokenizer.json")).map_err(|e| anyhow::anyhow!("{e}"))?;

    let chat = jarvis_core::llm::CHAT_SYSTEM_PROMPT;
    let web = jarvis_core::llm::WEB_SYSTEM_PROMPT;
    let catalog = jarvis_core::commands::prompt_catalog();

    println!("{:<34} {:>7} {:>6}", "промпт", "символы", "токены");
    println!("{}", "-".repeat(50));
    let row = |name: &str, text: &str| -> Result<()> {
        println!(
            "{:<34} {:>7} {:>6}",
            name,
            text.chars().count(),
            tokens(&tok, text)?
        );
        Ok(())
    };

    row("chat", chat)?;
    row("web", web)?;
    row("каталог команд", &catalog)?;
    println!("{}", "-".repeat(50));
    for (name, prompt) in [
        ("действие: без среза", ""),
        ("действие: сверни зум", "сверни зум"),
        ("действие: таймер", "поставь таймер на 10 минут"),
        ("действие: открой хром", "открой хром"),
        ("действие: напиши сообщение", "отправь сообщение маме"),
        (
            "действие: много срезов",
            "сверни зум, поставь таймер и отправь сообщение",
        ),
    ] {
        row(name, &jarvis_core::router::action_prompt_for(prompt))?;
    }
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/qa_battery.rs">
//! Батарея разнообразных вопросов через полный `llm::ask` — ресёрч качества
//! ответов универсального помощника: игры, факты, свежие данные, вычисления,
//! действия на компьютере, творческие и разговорные вопросы.
//!
//! Запуск: cargo run --release -p jarvis-core --example qa_battery

use anyhow::Result;
use jarvis_core::events::JarvisEvent;
use jarvis_core::llm::{self, SharedLlmState};
use jarvis_core::tts::AudioMessage;
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::mpsc::channel;
use std::sync::{Arc, Condvar, Mutex};
use std::time::{Duration, Instant};

const QUESTIONS: &[&str] = &[
    // --- игры ---
    "во что поиграть с другом на вечер, если есть только колода карт",
    "сколько человек нужно для игры в монополию",
    "что сложнее: шахматы или го",
    // --- факты ---
    "когда вышел первый айфон",
    "кто такой Илон Маск",
    "какая столица Австралии",
    // --- свежие данные ---
    "какая погода в москве",
    // --- вычисления ---
    "сколько будет 15 процентов от 2400",
    // --- действия на компьютере ---
    "сколько свободного места на диске",
    "открой калькулятор",
    // --- творческое и разговорное ---
    "расскажи короткий анекдот про программиста",
    "объясни, что такое квантовая запутанность, простыми словами",
    "что ты умеешь",
    "спасибо",
];

fn main() -> Result<()> {
    let settings = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())?;
    settings.apply();

    let (events_tx, events_rx) = channel::<JarvisEvent>();
    let (audio_tx, audio_rx) = channel::<AudioMessage>();
    std::thread::spawn(move || for _ in audio_rx {});

    // Флаг завершения вопроса: LlmDone или Error.
    let done = Arc::new((Mutex::new(false), Condvar::new()));
    {
        let done = Arc::clone(&done);
        std::thread::spawn(move || {
            for ev in events_rx {
                match ev {
                    JarvisEvent::LlmDone { text } => {
                        println!("✅ ОТВЕТ: {text}");
                        let (lock, cvar) = &*done;
                        *lock.lock().unwrap() = true;
                        cvar.notify_all();
                    }
                    JarvisEvent::Error { message } => {
                        println!("❗ ОШИБКА: {message}");
                        let (lock, cvar) = &*done;
                        *lock.lock().unwrap() = true;
                        cvar.notify_all();
                    }
                    JarvisEvent::ActionStarted { tool, summary } => {
                        println!("▶️ {tool}: {summary}")
                    }
                    JarvisEvent::ActionResult { ok, summary } => {
                        println!("🔧 [{}] {}", ok, summary)
                    }
                    JarvisEvent::Log { message } => println!("ℹ️  {message}"),
                    JarvisEvent::LlmStatus { status } => println!("🧠 {status}"),
                    _ => {}
                }
            }
        });
    }

    let shared = Arc::new(SharedLlmState::new());
    llm::spawn_llm_loader(&shared, &events_tx);
    let history = Arc::new(Mutex::new(Vec::new()));
    let cancel = Arc::new(AtomicBool::new(false));

    for q in QUESTIONS {
        println!("\n========== ❓ {q}");
        let started = Instant::now();
        // Зеркало llm_ask (текстовый чат): свежие данные — сразу веб-флоу.
        let explicit_web = jarvis_core::router::explicit_web_request(q);
        let fresh_info = jarvis_core::web::looks_like_fresh_info(q)
            && !jarvis_core::router::calendar_question(q);
        let mut system = llm::CHAT_SYSTEM_PROMPT;
        let mut prompt = (*q).to_string();
        if explicit_web || fresh_info {
            let query = jarvis_core::router::web_query_from(q).unwrap_or_else(|| q.to_string());
            println!("🌐 веб-флоу: {query}");
            if let Ok(hits) = jarvis_core::web::search(&query, 5)
                && let Some(web_prompt) = jarvis_core::web::build_summary_prompt(&query, &hits)
            {
                system = llm::WEB_SYSTEM_PROMPT;
                prompt = web_prompt;
            }
        }
        llm::ask(
            Arc::clone(&shared),
            system,
            prompt,
            Arc::clone(&history),
            audio_tx.clone(),
            events_tx.clone(),
            Arc::clone(&cancel),
        );
        let (lock, cvar) = &*done;
        let guard = lock.lock().unwrap();
        let (mut guard, timeout) = cvar
            .wait_timeout_while(guard, Duration::from_secs(60), |finished| !*finished)
            .unwrap();
        if timeout.timed_out() {
            println!("⏱ ТАЙМАУТ 60 c");
        } else {
            println!("⏱ {:.1?}", started.elapsed());
        }
        *guard = false;
        std::thread::sleep(Duration::from_millis(300));
    }

    // История диалога — видно, что реально запомнилось.
    println!("\n========== ИСТОРИЯ");
    for (q, a) in history.lock().unwrap().iter() {
        println!("Q: {q}\nA: {}\n", a.chars().take(120).collect::<String>());
    }
    let _ = Ordering::SeqCst; // silence unused-import lint in some toolchains
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/qwen35_chat.rs">
//! Запуск Qwen3.5-0.8B на чистом candle (Metal, с откатом на CPU).
//!
//! Модель берётся из `models/qwen3.5-0.8b/` (уже скачана с Hugging Face:
//! config.json, tokenizer.json и safetensors-веса).
//!
//! Режимы:
//! ```text
//! cargo run -p jarvis-core --example qwen35_chat -- chat   # диалог в терминале
//! cargo run -p jarvis-core --example qwen35_chat -- bench  # замер скорости
//! cargo run -p jarvis-core --example qwen35_chat -- bench "свой промпт"
//! ```

use anyhow::{Context, Result};
use candle_core::{DType, Device, IndexOp};
use jarvis_core::llm::qwen35::{self, Qwen35Model};
use jarvis_core::llm::sampler;
use std::io::{BufRead, Write};
use std::path::PathBuf;
use std::time::Instant;
use tokenizers::Tokenizer;

const SYSTEM_PROMPT: &str =
    "Ты Джарвис — голосовой ассистент. Отвечай кратко на русском, 1-3 предложения.";

/// Рекомендации Qwen для не-thinking режима.
const TEMPERATURE: f64 = 0.7;
const TOP_P: f64 = 0.8;
const REPEAT_PENALTY: f32 = 1.05;
const REPEAT_WINDOW: usize = 64;

fn models_dir() -> PathBuf {
    PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("../../models")
}

fn pick_device() -> Device {
    match Device::new_metal(0) {
        Ok(d) => {
            println!("✅ Устройство: Metal");
            d
        }
        Err(e) => {
            eprintln!("⚠️ Metal недоступен ({e}), работаем на CPU");
            Device::Cpu
        }
    }
}

struct Runner {
    model: Qwen35Model,
    tokenizer: Tokenizer,
    eos_ids: Vec<u32>,
}

impl Runner {
    fn load() -> Result<Self> {
        let dir = models_dir().join(qwen35::LOCAL_DIR_NAME);
        let device = pick_device();

        let model = Qwen35Model::load(&dir, &device)
            .with_context(|| format!("Не удалось загрузить модель из {}", dir.display()))?;
        let tokenizer = Tokenizer::from_file(dir.join("tokenizer.json"))
            .map_err(|e| anyhow::anyhow!("Не удалось загрузить токенизатор: {e}"))?;

        // EOS: из конфига (<|endoftext|>) плюс терминатор ChatML-шаблона.
        let mut eos_ids = model.config.eos_ids.clone();
        for special in ["<|endoftext|>", "<|im_end|>"] {
            if let Some(id) = tokenizer.token_to_id(special)
                && !eos_ids.contains(&id)
            {
                eos_ids.push(id);
            }
        }
        println!("   EOS-токены: {eos_ids:?}");

        Ok(Self {
            model,
            tokenizer,
            eos_ids,
        })
    }

    /// Генерация со стримингом. Возвращает текст и метрики (мс префилла,
    /// мс/токен декода).
    fn generate(
        &self,
        prompt: &str,
        max_tokens: usize,
        mut on_token: impl FnMut(&str),
    ) -> Result<(String, f64, f64)> {
        let encoding = self
            .tokenizer
            .encode(prompt, false)
            .map_err(|e| anyhow::anyhow!("Ошибка токенизации: {e}"))?;
        let prompt_tokens: Vec<u32> = encoding.get_ids().to_vec();
        if prompt_tokens.is_empty() {
            anyhow::bail!("Пустой промпт");
        }
        let mut context = prompt_tokens.clone();

        let mut cache = self.model.new_cache();
        let t0 = Instant::now();
        let mut logits = self.model.forward(&prompt_tokens, 0, &mut cache)?;
        let _ = self.model.device().synchronize();
        let prefill_ms = t0.elapsed().as_secs_f64() * 1e3;

        let prompt_len = context.len();
        let t_decode = Instant::now();
        let mut text = String::new();
        let mut suppress_think = false;
        let mut rng = rand::thread_rng();

        let debug = std::env::var("QWEN35_DEBUG").is_ok();
        for step in 0..max_tokens {
            let last = logits.dim(0)? - 1;
            let mut row: Vec<f32> = logits
                .i((last, ..))?
                .to_dtype(DType::F32)?
                .flatten_all()?
                .to_vec1()?;

            if debug && step < 8 {
                let mut idx: Vec<u32> = (0..row.len() as u32).collect();
                idx.select_nth_unstable_by(4, |&a, &b| row[b as usize].total_cmp(&row[a as usize]));
                idx.truncate(5);
                idx.sort_unstable_by(|&a, &b| row[b as usize].total_cmp(&row[a as usize]));
                for &i in &idx {
                    let s = self.tokenizer.decode(&[i], true).unwrap_or_default();
                    println!("   🔍 top{:?} {}: {:.4} {:?}", step, i, row[i as usize], s);
                }
            }

            sampler::apply_repeat_penalty(&mut row, REPEAT_PENALTY, &context, REPEAT_WINDOW);
            let tok = sampler::sample_top_p(&row, TEMPERATURE, TOP_P, &mut rng);
            if self.eos_ids.contains(&tok) {
                break;
            }
            context.push(tok);

            let piece = self
                .tokenizer
                .decode(&[tok], true)
                .map_err(|e| anyhow::anyhow!("Ошибка декодирования: {e}"))?;
            let piece = strip_think(&piece, &mut suppress_think);
            if !piece.is_empty() {
                text.push_str(&piece);
                on_token(&piece);
            }

            logits = self.model.forward(&[tok], prompt_len + step, &mut cache)?;
        }
        let _ = self.model.device().synchronize();
        let decoded = context.len() - prompt_len;
        let ms_per_token = t_decode.elapsed().as_secs_f64() * 1e3 / decoded.max(1) as f64;
        Ok((text, prefill_ms, ms_per_token))
    }
}

/// Простейшее отсечение рассуждений, если модель начала их писать
/// вопреки закрытому `<think>` в промпте.
fn strip_think(piece: &str, suppress: &mut bool) -> String {
    const OPEN: &str = "<think>";
    const CLOSE: &str = "</think>";
    let mut out = String::new();
    let mut rest = piece;
    loop {
        if *suppress {
            match rest.find(CLOSE) {
                Some(i) => {
                    rest = &rest[i + CLOSE.len()..];
                    *suppress = false;
                }
                None => break,
            }
        } else {
            match rest.find(OPEN) {
                Some(i) => {
                    out.push_str(&rest[..i]);
                    rest = &rest[i + OPEN.len()..];
                    *suppress = true;
                }
                None => {
                    out.push_str(rest);
                    break;
                }
            }
        }
    }
    out
}

fn bench(prompt: &str, max_tokens: usize) -> Result<()> {
    let runner = Runner::load()?;
    println!("\n▶ Промпт: {prompt:?}");
    let started = Instant::now();
    let (text, prefill_ms, ms_per_token) = runner.generate(prompt, max_tokens, |piece| {
        print!("{piece}");
        std::io::stdout().flush().ok();
    })?;
    println!(
        "\n\n📊 Префилл {prefill_ms:.0} мс; декод {ms_per_token:.1} мс/токен \
              ({:.0} ток/с); всего {:.1?}",
        1000.0 / ms_per_token,
        started.elapsed(),
    );
    println!("---\n{text}");
    Ok(())
}

fn chat() -> Result<()> {
    let runner = Runner::load()?;
    let mut history: Vec<(String, String)> = Vec::new();
    println!("Диалог с Qwen3.5-0.8B. Пустая строка или Ctrl-D — выход.\n");
    let stdin = std::io::stdin();
    loop {
        print!("Вы > ");
        std::io::stdout().flush().ok();
        let mut line = String::new();
        if stdin.lock().read_line(&mut line).unwrap_or(0) == 0 {
            break;
        }
        let user = line.trim();
        if user.is_empty() {
            break;
        }

        let prompt = qwen35::build_chat_prompt(SYSTEM_PROMPT, &history, user);
        let started = Instant::now();
        let result = runner.generate(&prompt, 256, |piece| {
            print!("{piece}");
            std::io::stdout().flush().ok();
        });
        println!();
        match result {
            Ok((text, prefill_ms, ms_per_token)) => {
                println!(
                    "   [{:.1?}: префилл {:.0} мс, {:.1} мс/токен]",
                    started.elapsed(),
                    prefill_ms,
                    ms_per_token
                );
                history.push((user.to_string(), text));
                let excess = history.len().saturating_sub(6);
                history.drain(..excess);
            }
            Err(e) => eprintln!("⚠️ {e:#}"),
        }
    }
    Ok(())
}

/// Отладка: логиты префилла на фиксированном промпте → /tmp/qwen35_rust_logits.bin
/// (f32, все позиции) для сверки с python-референсом.
fn dump_logits() -> Result<()> {
    let runner = Runner::load()?;
    let prompt = qwen35::build_chat_prompt(SYSTEM_PROMPT, &[], "Привет");
    let encoding = runner
        .tokenizer
        .encode(prompt.as_str(), false)
        .map_err(|e| anyhow::anyhow!("Ошибка токенизации: {e}"))?;
    let ids: Vec<u32> = encoding.get_ids().to_vec();
    println!("ids ({}){:?}...", ids.len(), &ids[..ids.len().min(12)]);

    type LayerDumps = std::sync::Arc<std::sync::Mutex<Vec<(usize, Vec<f32>)>>>;

    let mut cache = runner.model.new_cache();
    let dumps: LayerDumps = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
    let d = std::sync::Arc::clone(&dumps);
    let logits = runner
        .model
        .forward_with_inspector(&ids, 0, &mut cache, &mut |i, t| {
            let v: Vec<f32> = t
                .to_dtype(DType::F32)
                .and_then(|t| t.flatten_all())
                .and_then(|t| t.to_vec1())
                .unwrap_or_default();
            d.lock().unwrap().push((i, v));
        })?;
    {
        let dumps = dumps.lock().unwrap();
        for (i, v) in dumps.iter() {
            let name = if *i == usize::MAX {
                "embed".to_string()
            } else if *i == usize::MAX - 1 {
                "final".to_string()
            } else {
                format!("layer{i:02}")
            };
            let bytes: Vec<u8> = v.iter().flat_map(|f: &f32| f.to_le_bytes()).collect();
            std::fs::write(format!("/tmp/qwen35_rust_{name}.bin"), &bytes)?;
        }
        println!("слоёв сохранено: {}", dumps.len());
    }
    let _ = runner.model.device().synchronize();
    let rows: Vec<f32> = logits.to_dtype(DType::F32)?.flatten_all()?.to_vec1()?;
    let bytes: Vec<u8> = rows.iter().flat_map(|f: &f32| f.to_le_bytes()).collect();
    std::fs::write("/tmp/qwen35_rust_logits.bin", &bytes)?;
    println!(
        "сохранено /tmp/qwen35_rust_logits.bin: {} значений",
        rows.len()
    );

    let last = &rows[rows.len() - runner.model.config.vocab_size..];
    let mut idx: Vec<u32> = (0..last.len() as u32).collect();
    idx.select_nth_unstable_by(9, |&a, &b| last[b as usize].total_cmp(&last[a as usize]));
    idx.truncate(10);
    idx.sort_unstable_by(|&a, &b| last[b as usize].total_cmp(&last[a as usize]));
    for &i in &idx {
        println!(
            "   top {}: {:.4} {:?}",
            i,
            last[i as usize],
            runner.tokenizer.decode(&[i], true).unwrap_or_default()
        );
    }
    Ok(())
}

fn main() -> Result<()> {
    let mode = std::env::args().nth(1).unwrap_or_else(|| "chat".into());
    match mode.as_str() {
        "chat" => chat(),
        "bench" => {
            let prompt = std::env::args().nth(2).unwrap_or_else(|| {
                "Привет! Расскажи коротко, чем знаменит Санкт-Петербург.".into()
            });
            bench(&prompt, 96)
        }
        "dump" => dump_logits(),
        other => {
            anyhow::bail!("Неизвестный режим {other:?}: используй chat, bench или dump");
        }
    }
}
</file>

<file path="crates/jarvis-core/examples/stress_audio.rs">
//! Диагностика ударений: печатает токены («+» = id 5) и пишет два WAV —
//! со стрессором и без, чтобы сравнить на слух.
//!
//! Запуск: cargo run --release --example stress_audio -p jarvis-core

use jarvis_core::tts_silero::{SAMPLE_RATE, SileroEngine};

const TEXT: &str = "Слушаю вас, Павел. Привет, как дела? У меня всё хорошо. \
Сейчас две тысячи двадцать шестой год. Замок стоит на горе.";

fn write_wav(path: &str, samples: &[f32]) -> Result<(), Box<dyn std::error::Error>> {
    let spec = hound::WavSpec {
        channels: 1,
        sample_rate: SAMPLE_RATE,
        bits_per_sample: 16,
        sample_format: hound::SampleFormat::Int,
    };
    let mut w = hound::WavWriter::create(path, spec)?;
    for &s in samples {
        let v = (s.clamp(-1.0, 1.0) * 32767.0) as i16;
        w.write_sample(v)?;
    }
    w.finalize()?;
    Ok(())
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let with = SileroEngine::new("ru_bogdan")?;
    let without = SileroEngine::new_no_stress("ru_bogdan")?;

    let tokens_with = with.debug_tokens(TEXT)?;
    let tokens_without = without.debug_tokens(TEXT)?;
    println!(
        "знак «+» (id 5): {} шт. с ударениями, {} шт. без",
        tokens_with.iter().filter(|&&t| t == 5).count(),
        tokens_without.iter().filter(|&&t| t == 5).count(),
    );

    let a = with.synthesize(TEXT, 0.95)?;
    let b = without.synthesize(TEXT, 0.95)?;
    let n = a.len().min(b.len());
    let diff: f32 = (0..n).map(|i| (a[i] - b[i]).abs()).sum::<f32>() / n as f32;
    write_wav("build/tts_with_stress.wav", &a)?;
    write_wav("build/tts_without_stress.wav", &b)?;
    println!("средняя |разница| = {diff:.5}");
    println!("→ build/tts_with_stress.wav / build/tts_without_stress.wav");
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/stress_text.rs">
//! Печатает текст с расставленными «+» (как его видит движок) и пишет WAV.
//! Запуск: cargo run --release --example stress_text -p jarvis-core -- "текст"
//!         [выходной wav]

use jarvis_core::tts_silero::{SAMPLE_RATE, SileroEngine};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut args = std::env::args().skip(1);
    let text = args
        .next()
        .unwrap_or_else(|| "проверка ударений".to_string());
    let out = args.next();

    let engine = SileroEngine::new("ru_bogdan")?;
    let tokens = engine.debug_tokens(&text)?;

    // Декодируем токены обратно в строку через алфавит.
    let alphabet: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(
        jarvis_core::paths::models_dir().join("silero/alphabet.json"),
    )?)?;
    let id2sym: std::collections::HashMap<i64, char> = alphabet["id_to_symbol"]
        .as_object()
        .map(|m| {
            m.iter()
                .filter_map(|(k, v)| {
                    let id: i64 = k.parse().ok()?;
                    let c = v.as_str()?.chars().next()?;
                    Some((id, c))
                })
                .collect()
        })
        .unwrap_or_default();

    let accented: String = tokens
        .iter()
        .filter_map(|t| id2sym.get(t))
        .collect::<String>()
        .trim_matches(|c| c == '|' || c == '~')
        .to_string();
    println!("ACCENTED:{accented}");

    if let Some(path) = out {
        let audio = engine.synthesize(&text, 1.0)?;
        let spec = hound::WavSpec {
            channels: 1,
            sample_rate: SAMPLE_RATE,
            bits_per_sample: 16,
            sample_format: hound::SampleFormat::Int,
        };
        let mut w = hound::WavWriter::create(&path, spec)?;
        for &s in &audio {
            w.write_sample((s.clamp(-1.0, 1.0) * 32767.0) as i16)?;
        }
        w.finalize()?;
        println!("WROTE:{path} {} samples", audio.len());
    }
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/stt_smoke.rs">
//! Диагностика STT на этой машине: грузит FastConformer и расшифровывает
//! wav-файл (16 кГц mono или любой, который hound прочитает — приводится
//! к 16 кГц mono f32, как микрофонный поток).
//! Запуск: cargo run -p jarvis-core --example stt_smoke -- resources/audio/ok1.wav
//! Модель ищется в системной папке моделей (JARVIS_MODELS_DIR переопределяет).

use anyhow::{Context, Result};

fn main() -> Result<()> {
    jarvis_core::init_tuning();
    let wav = std::env::args()
        .nth(1)
        .unwrap_or_else(|| "resources/audio/ok1.wav".into());
    let started = std::time::Instant::now();
    let mut stt = jarvis_core::stt::Stt::load(&jarvis_core::paths::models_dir())?;
    println!("✅ FastConformer загружен за {:.1?}", started.elapsed());

    let mut reader = hound::WavReader::open(&wav)
        .with_context(|| format!("не удалось открыть {wav}"))?;
    let spec = reader.spec();
    let samples: Vec<f32> = reader
        .samples::<i32>()
        .map(|s| s.unwrap() as f32 / (1 << (spec.bits_per_sample - 1)) as f32)
        .collect();
    let mono: Vec<f32> = if spec.channels == 1 {
        samples
    } else {
        samples
            .chunks(spec.channels as usize)
            .map(|c| c.iter().sum::<f32>() / spec.channels as f32)
            .collect()
    };
    let audio_16k = jarvis_core::audio::resample_audio(&mono, spec.sample_rate as usize, 16_000);

    let started = std::time::Instant::now();
    let text = stt.transcribe(&audio_16k)?;
    println!(
        "✅ Расшифровка ({:.1} сек звука за {:.1?}): «{}»",
        audio_16k.len() as f32 / 16_000.0,
        started.elapsed(),
        text
    );
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/tool_probe.rs">
//! Проверка одного инструмента на живой машине: разбирает tool-блок и
//! выполняет его, печатая итог так, как его услышит пользователь.
//!
//! Нужно, чтобы проверять действия без голоса и без моделей:
//!
//! ```text
//! JARVIS_HOME=. cargo run --release -p jarvis-core --example tool_probe -- \
//!   '<tool>{"name":"music_control","args":{"action":"pause"}}</tool>'
//! ```

use std::sync::mpsc::channel;

fn main() {
    let arg = std::env::args().nth(1).unwrap_or_default();
    if arg.trim().is_empty() {
        eprintln!("Использование: tool_probe '<tool>{{...}}</tool>'");
        std::process::exit(1);
    }

    match jarvis_core::tools::parse_lenient(&arg) {
        jarvis_core::tools::ToolParse::Call(call) => {
            let (audio_tx, audio_rx) = channel();
            let (events, _events_rx) = channel();
            let outcome = jarvis_core::tools::execute(call, &audio_tx, &events);
            println!("ок:      {}", outcome.ok);
            println!("скажет:  {}", outcome.speech);
            if !outcome.detail.trim().is_empty() {
                println!("детали:  {}", outcome.detail.replace('\n', " ⏎ "));
            }
            // Аудио в этом режиме не проигрываем: пробуем инструмент, а не голос.
            let _ = audio_rx.try_recv();
        }
        jarvis_core::tools::ToolParse::Failed(reason) => {
            eprintln!("вызов не разобран: {reason}");
            std::process::exit(2);
        }
        jarvis_core::tools::ToolParse::None => {
            eprintln!("в аргументе нет tool-блока");
            std::process::exit(2);
        }
    }
}
</file>

<file path="crates/jarvis-core/examples/voice_compare.rs">
//! Сравнение мужских голосов Silero v5 для профиля «Джарвис»: одинаковые
//! фразы для каждого голоса, мужской тембр, спокойная подача.
//!
//! Кандидаты — все мужские голоса набора v5_cis_base; для финального выбора
//! прослушать сгенерированные WAV. Профиль Jarvis: скорость 0.9 (умеренно
//! медленно), ударения и омографы включены.
//!
//! Запуск: cargo run --release --example voice_compare -p jarvis-core
//! Результат: build/voice_compare/<voice>.wav

use jarvis_core::tts_silero::{SAMPLE_RATE, SileroEngine};

/// Фразы покрывают типовые роли голоса: приветствие, статус, числа,
/// технические названия (Premiere Pro), вопрос, спокойное завершение.
const PHRASES: &str = "Слушаю вас, Павел. Все системы в норме: процессор загружен на тридцать процентов, \
оперативной памяти свободно двенадцать гигабайт. Открываю премьер про. \
Похоже, сегодня будет дождь — взять с собой зонт? До связи.";

/// Мужские голоса v5.
const CANDIDATES: &[&str] = &[
    "ru_eduard",
    "ru_dmitriy",
    "ru_alexandr",
    "ru_bogdan",
    "ru_igor",
    "ru_marat",
    "ru_roman",
    "ru_gamat",
];

/// Скорость профиля Jarvis: умеренно медленная, уверенная подача.
const JARVIS_SPEED: f32 = 0.9;

fn write_wav(path: &str, samples: &[f32]) -> Result<(), Box<dyn std::error::Error>> {
    let spec = hound::WavSpec {
        channels: 1,
        sample_rate: SAMPLE_RATE,
        bits_per_sample: 16,
        sample_format: hound::SampleFormat::Int,
    };
    let mut w = hound::WavWriter::create(path, spec)?;
    for &s in samples {
        let v = (s.clamp(-1.0, 1.0) * 32767.0) as i16;
        w.write_sample(v)?;
    }
    w.finalize()?;
    Ok(())
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    std::fs::create_dir_all("build/voice_compare")?;
    for voice in CANDIDATES {
        let engine = SileroEngine::new(voice)?;
        let started = std::time::Instant::now();
        let samples = engine.synthesize(PHRASES, JARVIS_SPEED)?;
        let path = format!("build/voice_compare/{voice}.wav");
        write_wav(&path, &samples)?;
        println!(
            "🎙 {voice}: {:.1} с речи за {:.1?} синтеза → {path}",
            samples.len() as f32 / SAMPLE_RATE as f32,
            started.elapsed()
        );
    }
    println!("Прослушай build/voice_compare/ и выбери голос в settings.toml (tts_voice).");
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/wake_ctc_probe.rs">
//! Замер: wake word по CTC-постерам против метрического детектора.
//!
//! Печатает разделение классов на одном и том же корпусе, что и
//! `wake_verify`: позитивы — записи [jarvis], негативы — [none].
//! Слово задаётся аргументом: `cargo run -p jarvis-core --example wake_ctc_probe -- Джарвис`
//!
//! Запуск: JARVIS_HOME=~/.local/share/Jarvis cargo run -p jarvis-core --example wake_ctc_probe

use anyhow::{Context, Result};

fn read_window(path: &std::path::Path) -> Result<Vec<f32>> {
    let mut reader = hound::WavReader::open(path)?;
    let spec = reader.spec();
    let raw: Vec<f32> = reader
        .samples::<i32>()
        .map(|s| s.unwrap() as f32 / (1 << (spec.bits_per_sample - 1)) as f32)
        .collect();
    let mono: Vec<f32> = if spec.channels == 1 {
        raw
    } else {
        raw.chunks(spec.channels as usize)
            .map(|c| c.iter().sum::<f32>() / c.len() as f32)
            .collect()
    };
    let mono = jarvis_core::audio::resample_audio(&mono, spec.sample_rate as usize, 16_000);
    let window = 16_000 * 12 / 10;
    match mono.len().cmp(&window) {
        std::cmp::Ordering::Equal => Ok(mono),
        std::cmp::Ordering::Greater => {
            let extra = mono.len() - window;
            Ok(mono[extra / 2..extra / 2 + window].to_vec())
        }
        std::cmp::Ordering::Less => {
            let mut out = vec![0_f32; window];
            let start = (window - mono.len()) / 2;
            out[start..start + mono.len()].copy_from_slice(&mono);
            Ok(out)
        }
    }
}

fn main() -> Result<()> {
    jarvis_core::init_tuning();
    let word = std::env::args()
        .nth(1)
        .unwrap_or_else(|| "Джарвис".to_string());
    let stt = std::sync::Arc::new(std::sync::Mutex::new(jarvis_core::stt::Stt::load(
        &jarvis_core::paths::models_dir(),
    )?));

    // Переиспользуемые буферы декода: в горячем пути аллокаций нет.
    let mut scratch = jarvis_core::wake_ctc::CtcScratch::default();

    let target = jarvis_core::wake_ctc::encode_word(&stt, &word)
        .with_context(|| format!("не закодировать слово «{word}»"))?;
    let pieces: Vec<String> = {
        let guard = stt.lock().unwrap();
        target
            .iter()
            .map(|&id| {
                guard
                    .model()
                    .tokenizer
                    .piece(id)
                    .map(|p| p.to_string())
                    .unwrap_or_else(|| format!("#{id}"))
            })
            .collect()
    };
    println!("🎯 слово «{word}» → {} токенов: {pieces:?}", target.len());

    // Синтетические шумовые негативы: тишина, белый шум, бытовой гул,
    // «не-речь» (шум с формантной модуляцией). Настоящего фона комнаты
    // на машине нет — эти случаи хоть как-то проверяют ложные срабатывания.
    let window_len = 16_000 * 12 / 10;
    let mut seed: u64 = 0x9E37_79B9_7F4A_7C15;
    let mut rnd = || {
        seed ^= seed << 13;
        seed ^= seed >> 7;
        seed ^= seed << 17;
        (seed % 20_000) as f32 / 20_000.0 - 0.5
    };
    let mut noise_cases: Vec<(&str, Vec<f32>)> = Vec::new();
    noise_cases.push(("тишина", vec![0_f32; window_len]));
    noise_cases.push(("белый шум", (0..window_len).map(|_| rnd()).collect()));
    noise_cases.push((
        "бытовой гул",
        (0..window_len)
            .map(|i| 0.03 * ((i as f32 * 0.037).sin() + (i as f32 * 0.011).cos()))
            .collect(),
    ));
    noise_cases.push((
        "шум с формантной модуляцией",
        (0..window_len)
            .map(|i| {
                let t = i as f32 / 16_000.0;
                0.02 * (2.0 * std::f32::consts::PI * 220.0 * t).sin()
                    * (0.5 + 0.5 * (2.0 * std::f32::consts::PI * 3.0 * t).sin())
            })
            .collect(),
    ));

    // Режим --synth: синтезируем САМО слово разными дикторами Silero и
    // меряем recall на нём. Это и есть проверка «любого активационного
    // слова»: эталон — текст, переобучение и синтез эталона не нужны.
    let synth = std::env::args().any(|a| a == "--synth");
    if synth {
        let voices = [
            "ru_aigul",
            "ru_albina",
            "ru_alexandr",
            "ru_dmitriy",
            "ru_eduard",
            "ru_ekaterina",
            "ru_igor",
            "ru_karina",
            "ru_marat",
            "ru_oksana",
        ];
        let engine = jarvis_core::tts_silero::SileroEngine::new_no_stress("ru_eduard")?;
        let mut hits = 0usize;
        let mut total = 0usize;
        let mut worst = f32::INFINITY;
        for voice in voices {
            for speed in [0.95f32, 1.0, 1.05] {
                let Ok(audio) = engine.synthesize_with(voice, &word, speed) else {
                    continue;
                };
                let mono = jarvis_core::audio::resample_audio(&audio, 48_000, 16_000);
                let mut w = vec![0_f32; window_len];
                let start = (window_len - mono.len().min(window_len / 2)) / 2;
                for (i, s) in mono.iter().take(window_len - start).enumerate() {
                    w[start + i] = *s;
                }
                if jarvis_core::wake_ctc::ctc_frames(&stt, &w, &mut scratch).is_none() {
                    continue;
                }
                total += 1;
                let m = jarvis_core::wake_ctc::match_word_text(&stt, &mut scratch, &word);
                match m {
                    Some(m) => {
                        hits += 1;
                        worst = worst.min(m.score);
                    }
                    None => {
                        jarvis_core::wake_ctc::greedy_stream(&scratch.frames, &mut scratch.stream);
                        let pieces: Vec<String> = {
                            let guard = stt.lock().unwrap();
                            scratch
                                .stream
                                .iter()
                                .map(|(id, _, _)| {
                                    guard
                                        .model()
                                        .tokenizer
                                        .piece(*id)
                                        .map(|p| p.to_string())
                                        .unwrap_or_default()
                                })
                                .collect()
                        };
                        println!("   промах: {voice} @ {speed} → CTC «{pieces:?}»");
                    }
                }
            }
        }
        println!("🎚 синтез слова «{word}»: recall {hits}/{total}, худший счёт {worst:.4}");
    }

    let (train_dir, _) = jarvis_core::wake_train::sample_dirs();
    let mut pos: Vec<(String, f32)> = Vec::new();
    let mut neg: Vec<(String, f32)> = Vec::new();
    let mut samples_printed = 0;

    for entry in std::fs::read_dir(&train_dir)?.flatten() {
        let path = entry.path();
        if path
            .extension()
            .is_none_or(|e| !e.eq_ignore_ascii_case("wav"))
        {
            continue;
        }
        let name = path
            .file_name()
            .unwrap_or_default()
            .to_string_lossy()
            .to_string();
        let label = jarvis_core::tts::label_of_sample(&name);
        let window = read_window(&path)?;
        if jarvis_core::wake_ctc::ctc_frames(&stt, &window, &mut scratch).is_none() {
            eprintln!("⚠️ {name}: постеры не посчитались");
            continue;
        }
        let m = jarvis_core::wake_ctc::match_word_text(&stt, &mut scratch, &word);
        let score = m.as_ref().map(|m| m.score).unwrap_or(f32::NEG_INFINITY);
        if samples_printed < 3 {
            jarvis_core::wake_ctc::greedy_stream(&scratch.frames, &mut scratch.stream);
            let decoded: String = {
                let guard = stt.lock().unwrap();
                let ids: Vec<usize> = scratch.stream.iter().map(|(id, _, _)| *id).collect();
                guard.model().tokenizer.decode(&ids)
            };
            println!(
                "   {name}: CTC-декод «{decoded}» | совпадение: {:?}",
                m.as_ref().map(|m| (m.score, m.span_frames, m.tokens))
            );
            samples_printed += 1;
        }
        match label.as_str() {
            "jarvis" => pos.push((name, score)),
            "none" => neg.push((name, score)),
            _ => {}
        }
    }

    // Шумовые случаи: считаем отдельно от корпуса.
    for (title, w) in &noise_cases {
        if jarvis_core::wake_ctc::ctc_frames(&stt, w, &mut scratch).is_none() {
            eprintln!("⚠️ {title}: постеры не посчитались");
            continue;
        }
        let m = jarvis_core::wake_ctc::match_word_text(&stt, &mut scratch, &word);
        jarvis_core::wake_ctc::greedy_stream(&scratch.frames, &mut scratch.stream);
        let decoded: String = {
            let guard = stt.lock().unwrap();
            let ids: Vec<usize> = scratch.stream.iter().map(|(id, _, _)| *id).collect();
            guard.model().tokenizer.decode(&ids)
        };
        println!(
            "   шум «{title}»: CTC-декод «{decoded}» | совпадение: {:?}",
            m.as_ref().map(|m| (m.score, m.span_frames, m.tokens))
        );
    }

    let missed: Vec<String> = pos
        .iter()
        .filter(|(_, s)| !s.is_finite())
        .map(|(n, _)| n.clone())
        .collect();
    if !missed.is_empty() {
        println!("   без вхождения слова: {}", missed.join(", "));
    }

    // Режим --stream: сквозная проверка потокового детектора. Корпус
    // подаётся как живой поток (чанками по 160 сэмплов) — проверяются
    // окно, VAD, min_hits и cooldown, а не только сопоставление слова.
    if std::env::args().any(|a| a == "--diag") {
        // Диагностика окон: как модель декодит слово, когда оно накрыто
        // окном целиком, с полями и обрезано.
        let wav_arg = std::env::args()
            .find(|a| a.ends_with(".wav"))
            .unwrap_or_else(|| "[jarvis]_default_ru_eduard_1.wav".to_string());
        let body = read_window(&train_dir.join(&wav_arg))?;
        let mut stream = vec![0_f32; 16_000 / 2];
        stream.extend_from_slice(&body);
        stream.extend(std::iter::repeat(0_f32).take(16_000 * 2));
        for w in [1200usize, 1600, 2000] {
            println!("── окно {w} мс ──");
            let mut det = jarvis_core::wake_ctc::CtcWakeEngine::new(
                std::sync::Arc::clone(&stt),
                &word,
                jarvis_core::wake_ctc::CtcConfig {
                    window_ms: w,
                    hop_ms: 240,
                    min_hits: 1,
                    ..Default::default()
                },
            );
            let mut at = 0usize;
            for chunk in stream.chunks(160) {
                at += chunk.len();
                det.process(chunk);
                if let Some(diag) = det.last_diag() {
                    if diag.encoder_ran {
                        println!(
                            "   t={:5.2} c: декод «{}» счёт {:?}",
                            at as f32 / 16_000.0,
                            diag.decoded,
                            diag.score
                        );
                    }
                }
            }
        }
    }

    // Фон микрофона: тихий шум вместо цифровой тишины.
    let mut floor_seed: u64 = 0x243F_6A88_85A3_08D3;
    let mut floor_noise = |n: usize| -> Vec<f32> {
        let mut out = Vec::with_capacity(n);
        for _ in 0..n {
            floor_seed ^= floor_seed << 13;
            floor_seed ^= floor_seed >> 7;
            floor_seed ^= floor_seed << 17;
            out.push((floor_seed % 20_000) as f32 / 20_000.0 - 0.5);
        }
        out
    };

    if std::env::args().any(|a| a == "--sweep") {
        // Свип конфигурации окна: сколько позиций скользящего окна накрывают
        // слово целиком — (окно − слово) / шаг. От этого зависит, наберётся
        // ли min_hits на живом потоке.
        let configs = [
            (1200usize, 160usize, 2usize),
            (1200, 240, 1),
            (1600, 160, 2),
            (1000, 160, 2),
        ];
        for (w, h, hits) in configs {
            let mut det = jarvis_core::wake_ctc::CtcWakeEngine::new(
                std::sync::Arc::clone(&stt),
                &word,
                jarvis_core::wake_ctc::CtcConfig {
                    window_ms: w,
                    hop_ms: h,
                    min_hits: hits,
                    ..Default::default()
                },
            );
            let mut fired = 0usize;
            let mut total = 0usize;
            let mut fp = 0usize;
            for entry in std::fs::read_dir(&train_dir)?.flatten() {
                let path = entry.path();
                if path
                    .extension()
                    .is_none_or(|e| !e.eq_ignore_ascii_case("wav"))
                {
                    continue;
                }
                let name = path
                    .file_name()
                    .unwrap_or_default()
                    .to_string_lossy()
                    .to_string();
                let label = jarvis_core::tts::label_of_sample(&name);
                let body = read_window(&path)?;
                let mut stream = floor_noise(16_000 / 2);
                stream.extend_from_slice(&body);
                stream.extend(floor_noise(16_000 * 3 / 2));
                det.reset();
                let mut n = 0;
                for chunk in stream.chunks(160) {
                    if det.process(chunk).is_some() {
                        n += 1;
                    }
                }
                total += 1;
                if label == "jarvis" {
                    if n > 0 {
                        fired += 1;
                    }
                } else if label == "none" && n > 0 {
                    fp += 1;
                }
            }
            // Шумовые потоки — в счёт ложных срабатываний.
            let mut fp_noise = 0usize;
            for (_, w) in &noise_cases {
                let mut stream = floor_noise(16_000 / 2);
                stream.extend_from_slice(w);
                stream.extend(floor_noise(16_000 * 3 / 2));
                det.reset();
                for chunk in stream.chunks(160) {
                    if det.process(chunk).is_some() {
                        fp_noise += 1;
                        break;
                    }
                }
            }
            println!(
                "   окно {w} мс / шаг {h} мс / min_hits {hits}: recall {fired}/{total}, ложных {fp} (+{fp_noise} на шуме)"
            );
        }
    }

    if std::env::args().any(|a| a == "--stream") {
        let mut det = jarvis_core::wake_ctc::CtcWakeEngine::new(
            std::sync::Arc::clone(&stt),
            &word,
            jarvis_core::wake_ctc::CtcConfig::default(),
        );
        let mut fired = 0usize;
        let mut total = 0usize;
        let mut fp = 0usize;
        for entry in std::fs::read_dir(&train_dir)?.flatten() {
            let path = entry.path();
            if path
                .extension()
                .is_none_or(|e| !e.eq_ignore_ascii_case("wav"))
            {
                continue;
            }
            let name = path
                .file_name()
                .unwrap_or_default()
                .to_string_lossy()
                .to_string();
            let label = jarvis_core::tts::label_of_sample(&name);
            let window = read_window(&path)?;
            // Живой поток: тишина перед словом и после — окно должно
            // проскользить по фразе, как в микрофоне.
            let mut stream = vec![0_f32; 16_000 / 2];
            stream.extend_from_slice(&window);
            stream.extend(std::iter::repeat(0_f32).take(16_000 * 3 / 2));
            det.reset();
            let mut hits = 0;
            for chunk in stream.chunks(160) {
                if det.process(chunk).is_some() {
                    hits += 1;
                }
            }
            total += 1;
            if label == "jarvis" {
                if hits > 0 {
                    fired += 1;
                } else {
                    println!("   не сработало: {name}");
                }
            } else if label == "none" && hits > 0 {
                fp += 1;
                println!("   ЛОЖНОЕ срабатывание: {name}");
            }
        }
        println!("🎚 поток: recall {fired}/{total}, ложных срабатываний на негативах: {fp}");
    }

    let stat = |v: &[(String, f32)]| {
        let vals: Vec<f32> = v
            .iter()
            .map(|(_, s)| *s)
            .filter(|s| s.is_finite())
            .collect();
        let hits = vals.len();
        (
            vals.iter().cloned().fold(f32::INFINITY, f32::min),
            vals.iter().cloned().fold(f32::NEG_INFINITY, f32::max),
            if hits > 0 {
                vals.iter().sum::<f32>() / hits as f32
            } else {
                f32::NAN
            },
            hits,
        )
    };
    let (pmin, pmax, pmean, phits) = stat(&pos);
    let (nmin, nmax, nmean, nhits) = stat(&neg);
    println!("\n=== CTC wake word: слово «{word}» ===");
    println!(
        "позитивы ({} всего, {} со словом): min {pmin:.3} / mean {pmean:.3} / max {pmax:.3}",
        pos.len(),
        phits
    );
    println!(
        "негативы ({} всего, {} со словом): min {nmin:.3} / mean {nmean:.3} / max {nmax:.3}",
        neg.len(),
        nhits
    );
    // Разделение: порог посередине между худшим позитивом и лучшим негативом.
    if phits > 0 && nhits > 0 {
        let threshold = (pmin + nmax) / 2.0;
        let fnr = pos.iter().filter(|(_, s)| *s < threshold).count();
        let fpr = neg.iter().filter(|(_, s)| *s >= threshold).count();
        println!(
            "порог {threshold:.3}: FNR {fnr}/{}, FPR {fpr}/{}, запас {:.3}",
            pos.len(),
            neg.len(),
            pmin - nmax
        );
    }
    Ok(())
}
