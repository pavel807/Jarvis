}

pub fn clipboard_write(text: &str) -> bool {
    let script = format!(
        "Set-Clipboard -Value ([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('{}'))); 'OK'",
        b64(text)
    );
    matches!(ps_run(&script).as_deref(), Ok("OK"))
