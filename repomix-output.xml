pub struct Stt {
    model: FastConformer,
}

impl Stt {
    /// Скачивает модель при необходимости и загружает её (Metal на macOS).
    pub fn load(models_dir: &Path) -> Result<Self> {
        let model = FastConformer::load(models_dir)?;
        Ok(Self { model })
    }

