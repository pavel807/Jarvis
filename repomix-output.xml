#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn base64_encodes_utf8() {
        assert_eq!(b64("hello"), "aGVsbG8=");
        assert_eq!(b64(""), "");
        assert_eq!(b64("hi!"), "aGkh");
        // Кириллица — два байта UTF-8 на букву: «ё» → 0xD1 0x91 → «0ZE=».
