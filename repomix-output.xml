//! Пользовательские настройки ассистента (settings.toml) с hot-reload.

use anyhow::{Context, Result};
use serde::{Deserialize, Serialize};
use std::fs;
use std::path::{Path, PathBuf};
use std::sync::{Arc, RwLock};
use std::time::{Duration, SystemTime};

#[derive(Serialize, Deserialize, Debug, Clone)]
#[serde(default)]
pub struct Settings {
    // --- Детекция фразы ---
    /// Порог RMS для отделения речи от тишины.
    pub silence_rms_threshold: f32,
    /// Сколько секунд тишины завершают фразу.
    pub silence_timeout_secs: f32,
    /// Минимальная длительность фразы (отсекает щелчки и шорохи).
    pub min_command_duration_secs: f32,
    /// Максимальная длительность фразы.
    pub max_command_duration_secs: f32,
    /// Окно прямого слушания после wake word/команды.
    pub followup_window_secs: u64,

    // --- Wake word ---
    /// Порог срабатывания детектора RustPotter.
    pub wake_threshold: f32,
    /// Имя файла активной модели wake word внутри `models/`.
    pub wakeword_model: String,

    // --- LLM ---
    pub llm_enabled: bool,
    /// Бэкенд LLM: "uzu" — движок Mirai на Metal (только macOS, модель
    /// скачивается сама) или "candle" — собственные реализации на candle.
    /// Применяется при следующем запуске движка.
    pub llm_backend: String,
    /// Каталог модели LLM внутри `models/`: "qwen3.5-0.8b" (гибрид
    /// Gated DeltaNet + attention, ~1.7 ГБ BF16) или "minicpm5-1b-ru".
    /// Для бэкенда uzu — имя из каталога Mirai: "qwen3.5-2b-mirai-m"
    /// (4-бит), "qwen3.5-2b-mirai-l" (8-бит) и т.д.
    /// Применяется при следующем запуске движка.
    pub llm_model: String,
    /// Автоматически искать в интернете, когда вопрос про свежие данные.
    pub web_search_auto: bool,
    /// Нейро-нормализация текста перед озвучкой (числа и единицы через LLM).
    pub llm_normalize: bool,
    pub llm_temperature: f64,
    /// Страховочный лимит длины ответа LLM в токенах. `0` — без лимита:
    /// ответы и команды досказываются до конца, обрывы держат только защита
    /// от зацикливания и конец контекста модели.
    pub llm_max_tokens: usize,

    // --- TTS ---
    /// Голос Silero v5: ru_eduard | ru_dmitriy | ru_alexandr | ru_bogdan | ... (29 голосов).
    pub tts_voice: String,
    /// Скорость речи: 1.0 — естественно, меньше — медленнее.
    pub tts_speed: f32,

    // --- Отклик ---
    /// Звук-подтверждение перед ответом LLM. Выключен по умолчанию:
    /// он стоит в очереди плеера перед речью и отодвигает первый звук ответа.
    pub ack_before_llm: bool,

    // --- Память ---
    /// Помнить темы между сессиями и возвращаться к ушедшей по просьбе
    /// («мы это забыли»).
    pub topic_memory: bool,
}

impl Default for Settings {
    fn default() -> Self {
        Self {
            silence_rms_threshold: 0.018,
            silence_timeout_secs: 0.6,
            min_command_duration_secs: 0.5,
            max_command_duration_secs: 8.0,
            followup_window_secs: 8,
            wake_threshold: 0.6,
            wakeword_model: "jarvis_model_2.rpw".to_string(),
            llm_enabled: true,
            llm_backend: if cfg!(target_os = "macos") {
                "uzu".to_string()
            } else {
                "candle".to_string()
            },
            llm_model: "qwen3.5-0.8b".to_string(),
            web_search_auto: true,
            llm_normalize: true,
            llm_temperature: 0.6,
            // 0 — без искусственного лимита (длинные ответы не обрываются).
            llm_max_tokens: 0,
            tts_voice: "ru_eduard".to_string(),
            tts_speed: 1.0,
            ack_before_llm: false,
            topic_memory: true,
        }
    }
}

impl Settings {
    pub fn load(path: &Path) -> Result<Self> {
        match fs::read_to_string(path) {
            Ok(raw) => toml::from_str(&raw).with_context(|| format!("Ошибка парсинга {:?}", path)),
            Err(_) => Ok(Self::default()),
        }
    }

    pub fn save(&self, path: &Path) -> Result<()> {
        let content = toml::to_string_pretty(self).context("Не удалось сериализовать настройки")?;
        if let Some(parent) = path.parent() {
            fs::create_dir_all(parent)?;
        }
        let tmp = path.with_extension("toml.tmp");
        fs::write(&tmp, content)?;
        fs::rename(&tmp, path)?;
        Ok(())
    }

    /// Применяет настройки к подсистемам (голос TTS, параметры LLM).
    pub fn apply(&self) {
        crate::tts::set_current_voice(self.tts_voice.clone());
        crate::tts::set_current_speed(self.tts_speed);
        crate::llm::config::set_backend(&self.llm_backend);
        crate::llm::config::set_model_name(&self.llm_model);
        crate::llm::config::update_generation_params(self.llm_params());
    }

    /// Применяет настройки, безопасные на живую (hot-reload settings.toml):
    /// скорость речи и параметры генерации LLM. Голос и бэкенд не трогаем:
    /// смена голоса требует перезагрузки Silero-движка (её делает UI-команда
    /// сохранения), бэкенд/модель — перезапуска движка.
    pub fn apply_hot(&self) {
        crate::tts::set_current_speed(self.tts_speed);
        crate::llm::config::update_generation_params(self.llm_params());
    }

    fn llm_params(&self) -> crate::llm::config::GenerationParams {
        crate::llm::config::GenerationParams {
            temperature: self.llm_temperature,
            top_p: 0.95,
            repeat_penalty: 1.1,
            repeat_window: 64,
            max_tokens: self.llm_max_tokens,
        }
    }
}

/// Горячая перезагрузка settings.toml раз в секунду.
pub fn spawn_settings_watcher(settings_path: PathBuf, settings: Arc<RwLock<Settings>>) {
    std::thread::spawn(move || {
        let mut last_modified = fs::metadata(&settings_path)
            .and_then(|m| m.modified())
            .unwrap_or(SystemTime::UNIX_EPOCH);

        loop {
            std::thread::sleep(Duration::from_secs(1));

            if let Ok(metadata) = fs::metadata(&settings_path)
                && let Ok(modified) = metadata.modified()
                && modified > last_modified
            {
                match Settings::load(&settings_path) {
                    Ok(new_cfg) => {
                        let mut lock = settings.write().unwrap_or_else(|e| e.into_inner());
                        *lock = new_cfg.clone();
                        drop(lock);
                        // Применяем горячие настройки сразу: без этого правка
                        // settings.toml вручную (например, llm_max_tokens = 0)
                        // обновляла только копию в памяти, а движок до
                        // перезапуска работал по старым параметрам.
                        new_cfg.apply_hot();
                        println!("⚡ Настройки перезагружены");
                    }
                    Err(e) => eprintln!("❌ Ошибка обновления настроек: {e}"),
                }
                last_modified = modified;
            }
        }
    });
}

#[cfg(test)]
mod tests {
    use super::Settings;

    #[test]
    fn zero_max_tokens_stays_uncapped_in_llm_params() {
        // 0 — без лимита: не подменяется дефолтом и не клампится.
        let uncapped = Settings {
            llm_max_tokens: 0,
            ..Settings::default()
        };
        assert_eq!(uncapped.llm_params().max_tokens, 0);

        // Ненулевое — страховочный кап, проходит как есть.
        let capped = Settings {
            llm_max_tokens: 256,
            ..Settings::default()
        };
        assert_eq!(capped.llm_params().max_tokens, 256);
    }
}
</file>

<file path="app/src-tauri/src/lib.rs">
//! Tauri-бэкенд Jarvis: запускает движок из jarvis-core, мостит события в UI
//! и предоставляет IPC-команды (команды, настройки, wake word, TTS, LLM).

use jarvis_core::commands::{CommandsConfig, spawn_config_watcher};
use jarvis_core::engine::{EngineHandles, run_engine};
use jarvis_core::events::JarvisEvent;
use jarvis_core::llm::{self, ChatTurn, SharedLlmState, spawn_llm_loader};
use jarvis_core::paths;
use jarvis_core::settings::{Settings, spawn_settings_watcher};
use jarvis_core::stt::{self, Stt};
use jarvis_core::tts::{self, AudioMessage, SharedTtsState};
use jarvis_core::wake_train;
use std::collections::VecDeque;
use std::path::{Path, PathBuf};
use std::sync::atomic::{AtomicBool, Ordering};
use std::sync::mpsc::channel;
use std::sync::{Arc, Mutex, RwLock};
use std::time::Duration;
use tauri::{AppHandle, Emitter, Manager, State};

/// Сколько последних записей журнала держим для UI.
const LOG_CAPACITY: usize = 400;

pub struct Shared {
    pub commands: Arc<RwLock<CommandsConfig>>,
    pub settings: Arc<RwLock<Settings>>,
    pub shared_tts: Arc<SharedTtsState>,
    pub tts_failed: Arc<AtomicBool>,
    pub shared_llm: Arc<SharedLlmState>,
    pub is_speaking: Arc<AtomicBool>,
    pub stop_audio_flag: Arc<AtomicBool>,
    pub paused: Arc<AtomicBool>,
    pub wakeword_reload: Arc<AtomicBool>,
    /// Отмена голосовой генерации LLM (команда «замолчи»).
    pub llm_cancel: Arc<AtomicBool>,
    /// Токен отмены текущего запроса из чата UI.
    pub chat_cancel: Mutex<Option<Arc<AtomicBool>>>,
    /// История диалога чата UI.
    pub chat_history: Arc<Mutex<Vec<ChatTurn>>>,
    pub record_cancel: Arc<AtomicBool>,
    pub engine_running: Arc<AtomicBool>,
    pub audio_tx: std::sync::mpsc::Sender<AudioMessage>,
    /// Канал событий движка: нужен хабу таймеров для окна «Утилиты».
    pub utils_events: Mutex<Option<std::sync::mpsc::Sender<JarvisEvent>>>,
    logs: Mutex<VecDeque<String>>,
}

impl Shared {
    #[allow(clippy::too_many_arguments)]
    pub fn with_parts(
        audio_tx: std::sync::mpsc::Sender<AudioMessage>,
        shared_tts: Arc<SharedTtsState>,
        tts_failed: Arc<AtomicBool>,
        is_speaking: Arc<AtomicBool>,
        stop_audio_flag: Arc<AtomicBool>,
        shared_llm: Arc<SharedLlmState>,
        settings: Arc<RwLock<Settings>>,
    ) -> Self {
        let commands = CommandsConfig::load(&paths::commands_file()).unwrap_or_else(|e| {
            eprintln!("⚠️ {e:#}; использую пустой список команд");
            CommandsConfig::default()
        });
        commands.apply_ringtones();

        Self {
            commands: Arc::new(RwLock::new(commands)),
            settings,
            shared_tts,
            tts_failed,
            shared_llm,
            is_speaking,
            stop_audio_flag,
            paused: Arc::new(AtomicBool::new(false)),
            wakeword_reload: Arc::new(AtomicBool::new(false)),
            llm_cancel: Arc::new(AtomicBool::new(false)),
            chat_cancel: Mutex::new(None),
            chat_history: Arc::new(Mutex::new(Vec::new())),
            record_cancel: Arc::new(AtomicBool::new(false)),
            engine_running: Arc::new(AtomicBool::new(false)),
            audio_tx,
            utils_events: Mutex::new(None),
            logs: Mutex::new(VecDeque::with_capacity(LOG_CAPACITY)),
        }
    }

    fn push_log(&self, line: String) {
        let mut logs = self.logs.lock().unwrap_or_else(|e| e.into_inner());
        if logs.len() >= LOG_CAPACITY {
            logs.pop_front();
        }
        logs.push_back(line);
    }

    fn logs(&self) -> Vec<String> {
        self.logs
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .iter()
            .cloned()
            .collect()
    }

    fn llm_status(&self) -> String {
        if self.shared_llm.failed.load(Ordering::SeqCst) {
            "failed".into()
        } else if self
            .shared_llm
            .engine
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .is_some()
        {
            "ready".into()
        } else {
            "loading".into()
        }
    }
}

/// Распаковывает подготовленный архив из ресурсов приложения в каталог данных
/// при первом запуске (звуки, конфиги, крошечные wake word-модели).
/// Тяжёлые модели (LLM/STT/TTS) в архив не входят и качаются отдельно при
/// первом обращении. Идемпотентно по файлу-маркеру.
fn provision_data(events: &std::sync::mpsc::Sender<JarvisEvent>, resource_dir: Option<&Path>) {
    let home = paths::base_dir();
    // Маркер — собственная метка, которую ставим после успешной распаковки.
    // Привязываться к файлу модели нельзя: тяжёлые модели больше не в архиве
    // (качаются при первом запуске), а сам архив — это звуки, конфиги и
    // крошечные wake word-модели.
    let marker = home.join(".jarvis_provisioned");
    if marker.exists() {
        return;
    }
    let Some(payload) = find_payload(resource_dir) else {
        return;
    };

    let _ = events.send(JarvisEvent::Log {
        message: "Первый запуск: распаковываю ресурсы (один раз)…".into(),
    });
    if let Err(e) = std::fs::create_dir_all(&home) {
        let _ = events.send(JarvisEvent::Error {
            message: format!("Не удалось создать {}: {e}", home.display()),
        });
        return;
    }

    match std::process::Command::new("/usr/bin/tar")
        .arg("-xzf")
        .arg(&payload)
        .arg("-C")
        .arg(&home)
        .status()
    {
        Ok(s) if s.success() => {
            let _ = std::fs::write(&marker, "1");
            let _ = events.send(JarvisEvent::Log {
                message: "Ресурсы распакованы.".into(),
            });
        }
        other => {
            let _ = events.send(JarvisEvent::Error {
                message: format!("Распаковка не удалась: {other:?}"),
            });
        }
    }
}

/// Ищет подготовленный архив в `Contents/Resources/payload`.
fn find_payload(resource_dir: Option<&Path>) -> Option<PathBuf> {
    let candidate = resource_dir?.join("payload/jarvis-data.tar.gz");
    candidate.exists().then_some(candidate)
}

/// Загружает модели и запускает движок ассистента в фоновом потоке.
fn spawn_engine(
    shared: &Arc<Shared>,
    events_tx: std::sync::mpsc::Sender<JarvisEvent>,
    resource_dir: Option<PathBuf>,
) {
    let shared_engine = Arc::clone(shared);

    spawn_config_watcher(paths::commands_file(), Arc::clone(&shared_engine.commands));
    spawn_settings_watcher(paths::settings_file(), Arc::clone(&shared_engine.settings));

    std::thread::spawn(move || {
        // Канал для хаба таймеров: окно «Утилиты» получает события.
        *shared_engine
            .utils_events
            .lock()
            .unwrap_or_else(|e| e.into_inner()) = Some(events_tx.clone());

        provision_data(&events_tx, resource_dir.as_deref());

        // Конфиги могли появиться только что из архива — перечитываем их.
        if let Ok(cfg) = CommandsConfig::load(&paths::commands_file()) {
            cfg.apply_ringtones();
            *shared_engine
                .commands
                .write()
                .unwrap_or_else(|e| e.into_inner()) = cfg;
        }
        if let Ok(s) = Settings::load(&paths::settings_file()) {
            s.apply();
            *shared_engine
                .settings
                .write()
                .unwrap_or_else(|e| e.into_inner()) = s;
        }

        stt::init_env();

        let tts_voice = {
            let s = shared_engine
                .settings
                .read()
                .unwrap_or_else(|e| e.into_inner());
            s.apply();
            s.tts_voice.clone()
        };

        tts::spawn_tts_loader(
            &shared_engine.shared_tts,
            &shared_engine.tts_failed,
            &tts_voice,
        );

        let _ = events_tx.send(JarvisEvent::Log {
            message: "TTS-сборка: silero v5 + нейро-ударитель, голос «{voice}»"
                .replace("{voice}", &tts_voice),
        });
        spawn_llm_loader(&shared_engine.shared_llm, &events_tx);

        let models_dir = paths::models_dir();
        let Ok(model) = Stt::load(&models_dir) else {
            shared_engine.engine_running.store(false, Ordering::SeqCst);
            let _ = events_tx.send(JarvisEvent::Error {
                message: "Не удалось загрузить STT-модель".into(),
            });
            return;
        };

        // Клон канала для ошибки после moves: events_tx уезжает в handles,
        // а причина падения движка должна дойти до UI.
        let error_tx = events_tx.clone();
        let handles = EngineHandles {
            commands: Arc::clone(&shared_engine.commands),
            settings: Arc::clone(&shared_engine.settings),
            audio_tx: shared_engine.audio_tx.clone(),
            is_speaking: Arc::clone(&shared_engine.is_speaking),
            stop_audio_flag: Arc::clone(&shared_engine.stop_audio_flag),
            paused: Arc::clone(&shared_engine.paused),
            wakeword_reload: Arc::clone(&shared_engine.wakeword_reload),
            llm_cancel: Arc::clone(&shared_engine.llm_cancel),
            llm_history: Arc::clone(&shared_engine.chat_history),
            llm: Arc::clone(&shared_engine.shared_llm),
            events: events_tx,
        };

        shared_engine.engine_running.store(true, Ordering::SeqCst);
        if let Err(e) = run_engine(model, handles) {
            eprintln!("❌ Движок остановился: {e:#}");
            shared_engine.engine_running.store(false, Ordering::SeqCst);
            // Раньше причина уходила только в stderr терминала: при падении
            // аудио-потока (например, macOS молча забрал доступ к микрофону
            // после пересборки) интерфейс выглядел живым, а микрофон не
            // работал. Показываем причину и в журнале UI.
            let _ = error_tx.send(JarvisEvent::Error {
                message: format!("Движок остановился: {e:#}"),
            });
        }
    });
}

