<file path="app/src/pages/SettingsPage.svelte">
<script lang="ts">
  import { onMount } from "svelte";
  import { invoke } from "@tauri-apps/api/core";
  import { settings, patchSettings, toast, go, store } from "../store.svelte";
  import { voiceName } from "../voices";
  import SwitchRow from "../components/SwitchRow.svelte";
  import AppIcon from "../components/AppIcon.svelte";

  /**
   * Тонкие параметры (пороги тишины, температура модели, лимиты) намеренно
   * не выведены в интерфейс: они нужны редко и пугают. Их можно править
   * в settings.toml — файл перечитывается на лету.
   */
  let autostart = $state(false);
  let autostartSupported = $state(true);

  // ---------- Микрофон ----------

  type MicStatus = "authorized" | "denied" | "pending" | "unknown";
  let micStatus = $state<MicStatus>("unknown");
  let micBusy = $state(false);

  const MIC_STATUS_TEXT: Record<MicStatus, string> = {
    authorized: "Разрешён — Джарвис тебя слышит",
    denied: "Запрещён macOS — включи вручную в Системных настройках",
    pending: "Ждёт ответа на системный запрос",
    unknown: "Не удалось определить",
  };

  const micStatusText = $derived(MIC_STATUS_TEXT[micStatus]);

  async function refreshMicStatus() {
    try {
      micStatus = await invoke<MicStatus>("mic_status");
    } catch {
      // движок ещё не поднят — статус остаётся прежним
    }
  }

  /** Повторный запрос доступа: системный диалог; после отказа — Системные настройки. */
  async function requestMic() {
    if (micBusy) return;
    micBusy = true;
    try {
      const status = await invoke<MicStatus>("mic_request");
      micStatus = status;
      if (status === "pending") {
        toast("Системный запрос показан — подтверди его (мог быть под окном)", "info");
      } else if (status === "authorized") {
        toast("Доступ к микрофону уже разрешён", "ok");
      } else if (status === "denied") {
        toast("macOS не показывает повторный запрос — включи в открывшихся настройках", "err");
      } else {
        toast("Статус определить не удалось — открой Системные настройки кнопкой ниже", "err");
      }
    } catch (e) {
      toast(`Не получилось: ${e}`, "err");
    } finally {
      micBusy = false;
    }
  }

  async function openMicSettings() {
    try {
      await invoke("open_mic_settings");
    } catch (e) {
      toast(`Не получилось: ${e}`, "err");
    }
  }

  // Движок сообщает о смене доступа — обновляем строку статуса.
  $effect(() => {
    const granted = store.micPermission;
    if (granted === true) micStatus = "authorized";
    else if (granted === false) micStatus = "pending";
  });

  /** Модели ответов: бэкенд + модель применяются после перезапуска движка. */
  const llmChoices = [
    {
      backend: "uzu",
      model: "qwen3.5-2b-mirai-m",
      title: "Умная — Qwen3.5 2B",
      hint: "Движок Uzu на Metal, 4-бит, ~1,1 ГБ. Скачивается при первом выборе.",
    },
    {
      backend: "uzu",
      model: "qwen3.5-0.8b",
      title: "Быстрая — Qwen3.5 0.8B",
      hint: "Движок Uzu на Metal, 4-бит, ~0,5 ГБ.",
    },
    {
      backend: "candle",
      model: "qwen3.5-0.8b",
      title: "Классическая — candle 0.8B",
      hint: "Собственная реализация без Uzu. Модель из папки models/.",
    },
  ];

  function llmPicked(choice: (typeof llmChoices)[number]): boolean {
    return settings.llm_backend === choice.backend && settings.llm_model === choice.model;
  }

  async function pickLlm(choice: (typeof llmChoices)[number]) {
    if (llmPicked(choice)) return;
    await patchSettings({ llm_backend: choice.backend, llm_model: choice.model });
    toast("Модель сменится после перезапуска Джарвиса", "ok");
  }

  onMount(async () => {
    void refreshMicStatus();
    try {
      const { isEnabled } = await import("@tauri-apps/plugin-autostart");
      autostart = await isEnabled();
    } catch {
      // В браузере и на сборках без плагина переключатель не показываем.
      autostartSupported = false;
    }
  });

  async function toggleAutostart(value: boolean) {
    autostart = value;
    try {
      const { enable, disable } = await import("@tauri-apps/plugin-autostart");
      await (value ? enable() : disable());
      toast(value ? "Будет запускаться при входе" : "Автозапуск выключен", "ok");
    } catch (e) {
      autostart = !value;
      toast(`Не получилось: ${e}`, "err");
    }
  }
</script>

<p class="page-hint">Как Джарвис отвечает и ведёт себя. Изменения применяются сразу.</p>

<div class="section-title">Ответы</div>
