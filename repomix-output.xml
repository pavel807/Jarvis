<file path="crates/jarvis-core/examples/silero_verify.rs">
//! Верификация candle-реализации против эталона PyTorch (silero_ref).
//! Запуск: cargo run --release --example silero_verify -p jarvis-core

use anyhow::Result;
use jarvis_core::tts_silero::SileroEngine;

fn main() -> Result<()> {
    let engine = SileroEngine::new_no_stress("ru_eduard")?;
    let audio = engine.synthesize("Привет! Как дела?", 1.0)?;
    let rms = (audio.iter().map(|s| s * s).sum::<f32>() / audio.len() as f32).sqrt();
    println!("audio: {} сэмплов, RMS {:.4}", audio.len(), rms);

    let stages = engine.debug_stages("Привет! Как дела?", 1.0)?;
    let ref_st: serde_json::Value =
        serde_json::from_str(&std::fs::read_to_string("models/silero/ref_stages.json")?)?;
    println!("--- стадии ---");
    for (name, data, _shape) in &stages {
        if let Some(rd) = ref_st.get(name).and_then(|v| v.as_array()) {
            if rd.len() == data.len() {
                let md = data
                    .iter()
                    .zip(rd)
                    .map(|(a, b)| (a - b.as_f64().unwrap_or(0.0) as f32).abs())
                    .fold(0.0f32, f32::max);
                println!("  {:<12} maxdiff {:.6}", name, md);
            } else {
                println!("  {:<12} размер {} против {}", name, data.len(), rd.len());
            }
        }
    }
    let ref_json = std::fs::read_to_string("models/silero/ref.json")?;
    let ref_data: serde_json::Value = serde_json::from_str(&ref_json)?;
    let ref_audio: Vec<f32> = ref_data["audio"]
        .as_array()
        .ok_or_else(|| anyhow::anyhow!("нет audio"))?
        .iter()
        .map(|v| v.as_f64().unwrap_or(0.0) as f32)
        .collect();
    let ref_durs: Vec<i32> = ref_data["durs"]
        .as_array()
        .ok_or_else(|| anyhow::anyhow!("нет durs"))?
        .iter()
        .map(|v| v.as_f64().unwrap_or(0.0) as i32)
        .collect();
    let mel_json = std::fs::read_to_string("models/silero/ref_mel.json")?;
    let mel_data: serde_json::Value = serde_json::from_str(&mel_json)?;
    let ref_mel: Vec<f32> = mel_data["mel"]
        .as_array()
        .ok_or_else(|| anyhow::anyhow!("нет mel"))?
        .iter()
        .map(|v| v.as_f64().unwrap_or(0.0) as f32)
        .collect();

    let my_durs = engine.debug_durations("Привет! Как дела?", 1.0)?;
    println!("my  durs: {:?}", my_durs);
    let ref_voc: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(
        "models/silero/ref_voc_stages.json",
    )?)?;
    let voc_stages = engine.debug_voc_from(&ref_mel)?;
    println!("--- вокодер ---");
    for (name, data, _shape) in &voc_stages {
        if let Some(rd) = ref_voc.get(name).and_then(|v| v.as_array()) {
            if rd.len() == data.len() {
                let md = data
                    .iter()
                    .zip(rd)
                    .map(|(a, b)| (a - b.as_f64().unwrap_or(0.0) as f32).abs())
                    .fold(0.0f32, f32::max);
                println!("  {:<10} maxdiff {:.6}", name, md);
            } else {
                println!("  {:<10} размер {} против {}", name, data.len(), rd.len());
            }
        }
    }

    let (my_mel, ch, n) = engine.debug_mel("Привет! Как дела?", 1.0)?;
    if my_mel.len() == ref_mel.len() {
        let md = my_mel
            .iter()
            .zip(&ref_mel)
            .map(|(a, b)| (a - b).abs())
            .fold(0.0f32, f32::max);
        let mmean = my_mel
            .iter()
            .zip(&ref_mel)
            .map(|(a, b)| (a - b).abs())
            .sum::<f32>()
            / my_mel.len() as f32;
        println!("mel [{},{}]: maxdiff {:.5}, mean {:.5}", ch, n, md, mmean);
    } else {
        println!("⚠️ mel размеры: {} против {}", my_mel.len(), ref_mel.len());
    }
    println!("ref durs: {:?}", ref_durs);

    if audio.len() == ref_audio.len() {
        let diffs: Vec<f32> = audio
            .iter()
            .zip(&ref_audio)
            .map(|(a, b)| (a - b).abs())
            .collect();
        let big = diffs.iter().filter(|d| **d > 0.1).count();
        let mean = diffs.iter().sum::<f32>() / diffs.len() as f32;
        let max = diffs.iter().cloned().fold(0.0f32, f32::max);
        println!(
            "diff: mean {:.5}, max {:.5}, >0.1: {} из {}",
            mean,
            max,
            big,
            diffs.len()
        );
        let json_out = serde_json::json!({ "rust_audio": audio, "ref_audio": ref_audio });
        std::fs::write("models/silero/diff_dump.json", json_out.to_string())?;
        if max < 0.05 {
            println!("✅ VERIFIED: candle совпадает с PyTorch");
        } else {
            println!("✗ расхождение есть");
        }
    } else {
        println!(
            "⚠️ длина не совпадает: {} против {}",
            audio.len(),
            ref_audio.len()
        );
    }
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/stress_check.rs">
//! Проверка точности ударителя: набор слов-ловушек с эталонным ударением.
//! Печатает вердикт по каждому слову и общую точность.
//!
//! Запуск: cargo run --release --example stress_check -p jarvis-core

use jarvis_core::stress::RuStress;

/// (слово, порядковый номер ударной гласной, ожидаемое произношение).
const CASES: &[(&str, usize, &str)] = &[
    // Жалобы пользователя
    ("дела", 1, "де́ла"),
    ("градусов", 1, "гр́адусов"),
    ("градуса", 1, "гр́адуса"),
    ("какая", 2, "каќая"),
    ("какие", 2, "каќие"),
    ("какое", 2, "каќое"),
    ("такая", 2, "таќая"),
    ("такие", 2, "таќие"),
    // Классические ловушки
    ("звонит", 2, "звон́ит"),
    ("торты", 1, "т́орты"),
    ("щавель", 2, "щав́ель"),
    ("договор", 3, "догов́ор"),
    ("каталог", 3, "катал́ог"),
    ("красивее", 2, "крас́ивее"),
    ("километр", 3, "килом́етр"),
    ("магазин", 3, "магазин́"),
    ("свёкла", 1, "св́ёкла"),
    ("жалюзи", 3, "жалюз́и"),
    ("облегчит", 3, "облегч́ит"),
    // Глаголы прошедшего времени с ударной основой (жен. род)
    ("поняла", 3, "понял́а"),
    ("приняла", 3, "принял́а"),
    ("заняла", 3, "занял́а"),
    ("отдала", 3, "отдал́а"),
    ("продала", 3, "продал́а"),
    ("начала", 2, "начал́а"),
    ("кралась", 1, "кр́алась"),
    ("клала", 2, "клал́а"), // единственный известный промах NN (слова нет в словаре)
    // Обычная речь
    ("погода", 2, "поѓода"),
    ("ассистент", 3, "ассист́ент"),
    ("голосовой", 4, "голосов́ой"),
    ("сейчас", 2, "сейч́ас"),
    ("открываю", 3, "открыв́аю"),
    ("музыка", 1, "м́узыка"),
    ("компьютер", 2, "компь́ютер"),
    ("интернет", 3, "интерн́ет"),
];

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let stress = RuStress::load()?;

    let mut ok = 0usize;
    let mut bad: Vec<String> = Vec::new();

    println!(
        "{:<18} {:>8} {:>8}  произношение",
        "слово", "ожидал", "получил"
    );
    println!("{}", "-".repeat(56));
    for (word, expected, spoken) in CASES {
        let got = stress.stressed_vowel_ordinal(word);
        let verdict = match got {
            Some(o) if o == *expected => {
                ok += 1;
                "✓".to_string()
            }
            Some(o) => {
                bad.push(format!("{word} (ожидался слог {expected}, получен {o})"));
                format!("✗ слог {o}")
            }
            None => {
                bad.push(format!("{word} (не определено)"));
                "✗ нет".to_string()
            }
        };
        println!("{word:<18} {expected:>8} {verdict:>8}  {spoken}");
    }

    let total = CASES.len();
    println!(
        "\nТочность: {ok}/{total} = {:.1}%",
        100.0 * ok as f64 / total as f64
    );
    if !bad.is_empty() {
        println!("\nОшибки:");
        for b in &bad {
            println!("  - {b}");
        }
    }

    Ok(())
}
</file>

<file path="crates/jarvis-core/src/auto/mod.rs">
//! Автоматизация экрана без модели зрения.
//!
//! Один контракт — системные примитивы каждой ОС:
//! - macOS: **Accessibility (System Events) + AppleScript** (`ax.rs`);
//! - Linux: **AT-SPI2** (`atspi_linux.rs`) — дерево доступности GTK/Qt
//!   через шину at-spi2-core, работает и на X11, и на Wayland.
//!
//! Вместо скриншота и нейросети-зрения основная LLM читает экран текстом
//! (приложение, окна, кнопки, поля) и действует по именам элементов: клик
//! по кнопке «Продолжить», ввод в поле «Поиск», пункт меню «Файл →
//! Сохранить». Результат каждого действия перечитывается из системы —
//! честная самопроверка вместо обещаний.
//!
//! Инструменты модели: [`ui_read`], [`ui_click`], [`ui_type`], [`ui_menu`]
//! (реализация в `tools.rs`, здесь — системные примитивы).
//!
//! Отмена: голосовое «стоп» вызывает [`request_cancel`]; каждый инструмент
//! проверяет флаг между шагами и останавливается, не трогая экран дальше.

use anyhow::Result;

/// Роли, которые перечисляет `ui_read` и принимает `ui_click`/`ui_type`.
/// Словарь один на все ОС: Linux переводит классы в свои роли AT-SPI
/// (`atspi_linux::atspi_roles`).
pub const ELEMENT_ROLES: &[&str] = &[
    "button",
    "checkbox",
    "radio button",
    "pop up button",
    "text field",
    "secure text field",
    "static text",
    "link",
    "slider",
];

/// Канонизация роли: русские и частые синонимы → класс словаря.
pub fn normalize_role(role: &str) -> String {
    match role.trim().to_lowercase().as_str() {
        "кнопка" | "кнопку" | "" => "button".into(),
        "флажок" | "чекбокс" | "галочка" => "checkbox".into(),
        "переключатель" => "radio button".into(),
        "список" | "выпадающий список" | "выпадашка" => "pop up button".into(),
        "поле" | "поле ввода" | "текстовое поле" => "text field".into(),
        "пароль" | "поле пароля" => "secure text field".into(),
        "надпись" | "текст" => "static text".into(),
        "ссылка" => "link".into(),
        "ползунок" => "slider".into(),
        "меню" | "пункт меню" | "menu bar item" => "menu bar item".into(),
        other => other.to_string(),
    }
}

#[cfg(target_os = "macos")]
pub mod ax;

#[cfg(target_os = "macos")]
pub use ax::{click_element, menu_path, read_screen, set_field_value, ScreenDump};

// Linux: полная реализация через AT-SPI2 (read/click/type/menu).
#[cfg(target_os = "linux")]
pub mod atspi_linux;

#[cfg(target_os = "linux")]
pub use atspi_linux::{
    click_element, describe_app, menu_path, read_screen, set_field_value, ScreenDump,
};

// Остальные ОС: честная причина невозможности — реализация не написана.
#[cfg(not(any(target_os = "macos", target_os = "linux")))]
fn ui_unavailable() -> anyhow::Error {
    anyhow::anyhow!(
        "Работа с элементами интерфейса (Accessibility) поддерживается на macOS и Linux"
    )
}

#[cfg(not(any(target_os = "macos", target_os = "linux")))]
#[derive(Debug, Clone, PartialEq, Default)]
pub struct ScreenDump {
    pub app: String,
    pub report: String,
}

#[cfg(not(any(target_os = "macos", target_os = "linux")))]
impl ScreenDump {
    pub fn to_text(&self) -> String {
        if self.report.trim().is_empty() {
            format!(
                "Активное приложение: {}. Элементов не видно (окно может быть пустым или защищённым).",
                self.app
            )
        } else {
            self.report.trim().to_string()
        }
    }
}

#[cfg(not(any(target_os = "macos", target_os = "linux")))]
pub fn read_screen() -> Result<ScreenDump> {
    Err(ui_unavailable())
}

#[cfg(not(any(target_os = "macos", target_os = "linux")))]
pub fn click_element(
    _app: Option<&str>,
    _role: &str,
    _name: &str,
    _window: Option<&str>,
) -> Result<String> {
    Err(ui_unavailable())
}

#[cfg(not(any(target_os = "macos", target_os = "linux")))]
pub fn set_field_value(
    _app: Option<&str>,
    _role: &str,
    _name: &str,
    _text: &str,
    _submit: bool,
    _window: Option<&str>,
) -> Result<String> {
    Err(ui_unavailable())
}

#[cfg(not(any(target_os = "macos", target_os = "linux")))]
pub fn menu_path(_app: Option<&str>, _path: &[&str]) -> Result<String> {
    Err(ui_unavailable())
}

/// Флаг отмены автоматизации: выставляется голосовым «стоп».
static CANCEL: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);

/// Запросить остановку автоматизации (голосовая команда «стоп»).
pub fn request_cancel() {
    CANCEL.store(true, std::sync::atomic::Ordering::SeqCst);
}

/// Снять флаг отмены: новый запрос пользователя начинает новую задачу.
pub fn clear_cancel() {
    CANCEL.store(false, std::sync::atomic::Ordering::SeqCst);
}

/// Автоматизация остановлена голосом?
pub fn is_cancelled() -> bool {
    CANCEL.load(std::sync::atomic::Ordering::SeqCst)
}

/// Человекочитаемое описание экрана для ответа «что на экране» и для
/// модели перед действием. Никаких скриншотов и нейросетей: только
/// дерево доступности активного приложения.
pub fn describe_screen() -> Result<String> {
    let dump = read_screen()?;
    Ok(dump.to_text())
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn cancel_flag_roundtrip() {
        clear_cancel();
        assert!(!is_cancelled());
        request_cancel();
        assert!(is_cancelled());
        clear_cancel();
        assert!(!is_cancelled());
    }

    #[test]
    fn normalize_role_maps_russian_and_synonyms() {
        assert_eq!(normalize_role("Кнопка"), "button");
        assert_eq!(normalize_role("чекбокс"), "checkbox");
        assert_eq!(normalize_role("поле ввода"), "text field");
        assert_eq!(normalize_role(""), "button");
        assert_eq!(normalize_role("button"), "button");
        assert_eq!(normalize_role("пункт меню"), "menu bar item");
    }
}
</file>

