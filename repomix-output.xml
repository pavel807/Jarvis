<file path="crates/jarvis-core/src/asr/model.rs">
//! Сборка FastConformer целиком: загрузка весов/конфига/токенизатора,
//! выбор декодера (RNNT greedy / CTC greedy / CTC beam search) и точки
//! входа распознавания.

use super::config::{self, FastConformerConfig};
use super::{conformer, ctc, frontend, rnnt, tokenizer};
use anyhow::{Context, Result};
use candle_core::{D, DType, Device};
use candle_nn::VarBuilder;
use std::path::{Path, PathBuf};
use std::time::Instant;

/// Выбор декодера.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Decoder {
    /// RNN-T жадный (по умолчанию: точнее на русской речи).
    Rnnt,
    /// CTC жадный.
    CtcGreedy,
    /// CTC beam search (width задаётся отдельно).
    CtcBeam { width: usize },
}

impl Default for Decoder {
    fn default() -> Self {
        Self::Rnnt
    }
}

/// Результат распознавания: текст и тайминги этапов.
#[derive(Debug, Clone)]
pub struct Transcript {
    pub text: String,
    pub ids: Vec<usize>,
    pub mel_ms: f64,
    pub encoder_ms: f64,
    pub decode_ms: f64,
}

pub struct FastConformer {
    pub device: Device,
    pub frontend: frontend::MelFrontend,
    pub encoder: conformer::Encoder,
    pub ctc_head: ctc::CtcHead,
    pub predictor: rnnt::Predictor,
    pub joint: rnnt::Joint,
    pub tokenizer: tokenizer::SpTokenizer,
    pub cfg: FastConformerConfig,
    /// Каталог модели (для словаря и отладки).
    pub dir: PathBuf,
}

impl FastConformer {
    /// Загружает модель из `models_dir/fastconformer`.
    ///
    /// Ожидаемые файлы (готовит `tools/convert_fastconformer.py` +
    /// `model_fetch::ensure_fastconformer`):
    /// `model.safetensors`, `config.json`, `tokenizer.vocab`.
    pub fn load(models_dir: &Path) -> Result<Self> {
        // Автозагрузка ассетов (веса ~460 МБ из релиза jarvis-models).
        if let Err(e) = crate::model_fetch::ensure_fastconformer() {
            eprintln!("⚠️ Не удалось скачать FastConformer: {e:#}");
        }
        let dir = models_dir.join("fastconformer");
        let safetensors = dir.join("model.safetensors");
        anyhow::ensure!(
            safetensors.exists(),
            "Файл весов не найден: {:?} — модель ещё не скачана",
            safetensors
        );

        let cfg = config::load(&dir.join("config.json"))?;
        let device = pick_device();

        let start = Instant::now();
        let vb = unsafe {
            VarBuilder::from_mmaped_safetensors(&[&safetensors], DType::F32, &device)
                .with_context(|| format!("Не удалось открыть {safetensors:?}"))?
        };

        // Фронтенд: окно и mel-фильтрбанк приходят из весов чекпоинта —
        // расхождения с эталонным препроцессором исключены.
        let window = vb.get(
            (cfg.preprocessor.win_length,),
            "preprocessor.featurizer.window",
        )?;
        let fb = vb.get(
            (1, cfg.preprocessor.n_mels, cfg.preprocessor.n_fft / 2 + 1),
            "preprocessor.featurizer.fb",
        )?;
        let frontend = frontend::MelFrontend::load(cfg.preprocessor, &window, &fb, &device)?;

        let encoder = conformer::Encoder::load(&vb, &cfg, &device)?;
        let ctc_head =
            ctc::CtcHead::load(vb.pp("ctc_decoder").pp("decoder_layers").pp("0"), cfg.encoder.d_model, cfg.decoder.vocab_size + 1)?;
        let predictor = rnnt::Predictor::load(
            vb.pp("decoder").pp("prediction"),
            cfg.decoder.vocab_size + 1,
            cfg.decoder.pred_hidden,
        )?;
        let joint = rnnt::Joint::load(
            vb.pp("joint"),
            cfg.encoder.d_model,
            cfg.decoder.pred_hidden,
            cfg.decoder.joint_hidden,
            cfg.decoder.vocab_size + 1,
        )?;
        let tokenizer =
            tokenizer::SpTokenizer::load(&dir.join("tokenizer.vocab"))?;

        let model = Self {
            device,
            frontend,
            encoder,
            ctc_head,
            predictor,
            joint,
            tokenizer,
            cfg,
            dir,
        };
        println!(
            "✅ FastConformer загружен за {:.2?} ({})",
            start.elapsed(),
            if model.device.is_metal() { "Metal" } else { "CPU" }
        );
        Ok(model)
    }

    /// Полное распознавание буфера 16 кГц mono f32 выбранным декодером.
    pub fn transcribe(&self, samples: &[f32]) -> Result<Transcript> {
        self.transcribe_with(samples, Decoder::Rnnt, None)
    }

    pub fn transcribe_with(
        &self,
        samples: &[f32],
        decoder: Decoder,
        dict: Option<&ctc::JarvisDictionary>,
    ) -> Result<Transcript> {
        // 1. Mel-фронтенд (DFT — matmul на устройстве модели).
        let t0 = Instant::now();
        let (mel, length) = self.frontend.compute(samples, &self.device)?;
        let mel_ms = t0.elapsed().as_secs_f64() * 1000.0;

        // 2. Энкодер (pre-encode + 17 Conformer-блоков).
        let t1 = Instant::now();
        let (enc, t_valid) = self.encoder.forward(&mel, length)?;
        let encoder_ms = t1.elapsed().as_secs_f64() * 1000.0;

        // 3. Декодер.
        let t2 = Instant::now();
        let ids = match decoder {
            Decoder::Rnnt => rnnt::greedy(
                &enc,
                t_valid,
                &self.predictor,
                &self.joint,
                self.cfg.blank_id,
                self.cfg.decoder.max_symbols_per_step,
            )?,
            Decoder::CtcGreedy => {
                let logits = self.ctc_head.logits(&enc)?; // [1, T, V]
                let (frames, vocab_out) = (logits.dim(1)?, logits.dim(2)?);
                let flat = logits.reshape((frames * vocab_out,))?.to_vec1::<f32>()?;
                ctc::greedy(&flat, frames, vocab_out, self.cfg.blank_id)
            }
            Decoder::CtcBeam { width } => {
                let logits = candle_nn::ops::log_softmax(&self.ctc_head.logits(&enc)?, D::Minus1)?;
                let (frames, vocab_out) = (logits.dim(1)?, logits.dim(2)?);
                let flat = logits.reshape((frames * vocab_out,))?.to_vec1::<f32>()?;
                ctc::beam_search(&flat, frames, vocab_out, self.cfg.blank_id, width, dict)
            }
        };
        let decode_ms = t2.elapsed().as_secs_f64() * 1000.0;

        let text = self.tokenizer.decode(&ids);
        Ok(Transcript {
            text,
            ids,
            mel_ms,
            encoder_ms,
            decode_ms,
        })
    }

    /// Словарь Jarvis для beam search (кодирование фраз токенизатором).
    pub fn jarvis_dictionary(&self, phrases: &[String]) -> Result<ctc::JarvisDictionary> {
        ctc::JarvisDictionary::new(phrases, &self.tokenizer, 0.3, 1.5)
    }

    pub fn is_metal(&self) -> bool {
        self.device.is_metal()
    }
}

/// Устройство ASR. По умолчанию CPU: замер fc_bench (M4 Pro) показал, что
/// энкодер на Metal стоит фиксированные ~720 мс на ЛЮБУЮ фразу (208 кадров —
/// 719 мс, 978 кадров — 729 мс): это чистый overhead командных буферов Metal
/// (~700 мелких операций с commit+wait на каждую), а не вычисления. На CPU
/// тот же энкодер (FP32, без квантизации) — 98 мс: короткая команда
/// распознаётся за ~130 мс вместо ~780. Metal включается переменной
/// окружения JARVIS_ASR_DEVICE=metal (для экспериментов и длинных потоков).
fn pick_device() -> Device {
    if std::env::var("JARVIS_ASR_DEVICE").as_deref() == Ok("metal") {
        #[cfg(target_os = "macos")]
        match Device::new_metal(0) {
            Ok(d) => return d,
            Err(e) => eprintln!("⚠️ Metal недоступен ({e}), ASR будет работать на CPU"),
        }
    }
    Device::Cpu
}
</file>

<file path="crates/jarvis-core/src/asr/rnnt.rs">
//! RNN-T ветка FastConformer: Prediction Network (Embedding + LSTM 640),
//! Joint Network и жадный транзьюсер-декодер.
//!
//! Поток (снят с графа decoder_joint-model.onnx эталона):
//! - prediction: embed(prev_token) → LSTM (один слой, hidden 640); перед
//!   первым кадром предсказатель обрабатывает blank (SOS), как в NeMo;
//! - joint: Linear(enc 512→640) + Linear(pred 640→640) → ReLU →
//!   Linear(640 → vocab+1); проекции считаются по отдельности и складываются,
//!   как в NeMo RNNTJoint;
//! - жадное декодирование: на каждый кадр энкодера — цикл до
//!   max_symbols_per_step: joint(enc[t], state) → argmax; blank — переход к
//!   следующему кадру, иначе токен эмитится и обновляется состояние LSTM.
//!
//! Состояние предсказателя (h, c) живёт между шагами декодирования всей
//! фразы — контекст накопленных токенов учитывается на каждом кадре.

use anyhow::Result;
use candle_core::{D, IndexOp, Tensor};
use candle_nn::{Embedding, Module, VarBuilder};
use candle_nn::rnn::{lstm, RNN, LSTM, LSTMConfig, LSTMState};

pub struct Predictor {
    embed: Embedding,
    lstm: LSTM,
}

impl Predictor {
    pub fn load(vb: VarBuilder, vocab_out: usize, pred_hidden: usize) -> Result<Self> {
        // Веса: decoder.prediction.embed.weight [vocab+1, pred_hidden],
        //       decoder.prediction.dec_rnn.lstm.{weight_ih_l0,...}.
        let embed = Embedding::new(vb.get((vocab_out, pred_hidden), "embed.weight")?, pred_hidden);
        let lstm = lstm(
            pred_hidden,
            pred_hidden,
            LSTMConfig::default(),
            vb.pp("dec_rnn").pp("lstm"),
        )?;
        Ok(Self { embed, lstm })
    }

    pub fn initial_state(&self) -> Result<LSTMState> {
        Ok(self.lstm.zero_state(1)?)
    }

    /// Один шаг предсказателя: id токена → новое состояние LSTM.
    pub fn step(&self, token: usize, state: &LSTMState) -> Result<LSTMState> {
        let device = state.h.device();
        let ids = Tensor::from_slice(&[token as u32], (1,), device)?;
        let e = self.embed.forward(&ids)?; // [1, pred_hidden]
        Ok(self.lstm.step(&e, state)?)
    }
}

pub struct Joint {
    enc_proj: candle_nn::Linear,  // d_model → joint_hidden
    pred_proj: candle_nn::Linear, // pred_hidden → joint_hidden
    out: candle_nn::Linear,       // joint_hidden → vocab+1
}

impl Joint {
    pub fn load(
        vb: VarBuilder,
        d_model: usize,
        pred_hidden: usize,
        joint_hidden: usize,
        vocab_out: usize,
    ) -> Result<Self> {
        Ok(Self {
            enc_proj: candle_nn::linear(d_model, joint_hidden, vb.pp("enc"))?,
            pred_proj: candle_nn::linear(pred_hidden, joint_hidden, vb.pp("pred"))?,
            out: candle_nn::linear(joint_hidden, vocab_out, vb.pp("joint_net").pp("2"))?,
        })
    }

    /// Логиты одной пары (кадр энкодера [1, d_model], состояние [1, pred_hidden]).
    pub fn logits(&self, enc_frame: &Tensor, state: &LSTMState) -> Result<Tensor> {
        let e = self.enc_proj.forward(enc_frame)?; // [1, joint_hidden]
        let p = self.pred_proj.forward(&state.h)?; // [1, joint_hidden]
        let h = (e + p)?.relu()?;
        Ok(self.out.forward(&h)?)
    }
}

/// Жадное RNNT-декодирование. enc_out: [1, T, d_model] на устройстве модели,
/// t_valid — число валидных кадров. Возвращает id токенов.
///
/// Семантика onnx-asr: каждый шаг встраивает ТЕКУЩИЙ контекст (`prev`) из
/// текущего состояния предсказателя. Состояние фиксируется только при
/// эмиссии токена — в него вошло встраивание старого контекста; при blank
/// откатывается, чтобы тот же токен не вошёл в LSTM дважды через границу
/// кадров (двойное продвижение ломало транскрипт: syllables выпадали).
pub fn greedy(
    enc_out: &Tensor,
    t_valid: usize,
    predictor: &Predictor,
    joint: &Joint,
    blank_id: usize,
    max_symbols_per_step: usize,
) -> Result<Vec<usize>> {
    let mut tokens = Vec::new();
    let mut state = predictor.initial_state()?;
    let mut prev = blank_id;

    for t in 0..t_valid {
        // Кадр энкодера [512] → [1, 512]: индексация даёт contiguous-срез.
        let frame = enc_out.i((0, t, ..))?.unsqueeze(0)?;
        let mut emitted = 0usize;
        loop {
            // Встраиваем текущий контекст из текущего состояния.
            let next_state = predictor.step(prev, &state)?;
            let logits = joint.logits(&frame, &next_state)?; // [1, vocab+1]
            // argmax даёт [1]: сжимаем до ранга 0 для to_scalar.
            let best = logits.argmax(D::Minus1)?.squeeze(0)?.to_scalar::<u32>()? as usize;
            if best == blank_id || emitted >= max_symbols_per_step {
                break; // blank: state не двигается — контекст не менялся
            }
            tokens.push(best);
            prev = best;
            state = next_state;
            emitted += 1;
        }
    }
    Ok(tokens)
}
