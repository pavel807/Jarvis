#!/usr/bin/env python3
"""Генерация сэмпла обученным голосом Джарвиса (Style-Bert-VITS2).

Запуск: /tmp/sbv2/bin/python scripts/voice-train/gen_sample.py [файл_модели.safetensors]
Без аргумента берётся последний safetensors из model_assets/jarvis_ru/.
Текст — транслитерация (та же схема, что в prepare_dataset.py).
"""

import sys
from pathlib import Path

sys.path.insert(0, "/tmp/sbvits2")

import numpy as np
import soundfile as sf
from style_bert_vits2.constants import Languages
from style_bert_vits2.tts_model import TTSModel

ASSETS = Path("/tmp/sbvits2/model_assets/jarvis_ru")
OUT = Path(__file__).resolve().parents[2] / "resources" / "voice_jarvis_ru" / "sample.wav"

SAMPLE_TEXT = (
    "Da, ser. Vse sistemy rabotayut v shtatnom rezhime. "
    "Zaryad batarei — dyevyanosto vosyem protsentov. "
    "Vsegda k vashim uslugam, ser."
)


def main() -> None:
    if len(sys.argv) > 1:
        model_file = Path(sys.argv[1])
    else:
        candidates = sorted(ASSETS.glob("G_*.safetensors"))
        if not candidates:
            sys.exit(f"нет safetensors в {ASSETS}")
        model_file = candidates[-1]

    model = TTSModel(
        model_path=model_file,
        config_path=ASSETS / "config.json",
        style_vec_path=ASSETS / "style_vectors.npy",
        device="cpu",
    )
    try:
        sr, audio = model.infer(SAMPLE_TEXT, language=Languages.EN, style="Neutral")
    except Exception:
        # Имя стиля зависит от style_vectors — fallback на дефолтный стиль.
        sr, audio = model.infer(SAMPLE_TEXT, language=Languages.EN)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    sf.write(OUT, np.asarray(audio), sr)
    print(f"сэмпл: {OUT}")


if __name__ == "__main__":
    main()
</file>

<file path="scripts/voice-train/prepare_dataset.py">
#!/usr/bin/env python3
"""Собирает датасет Style-Bert-VITS2 из корпуса голоса Джарвиса.

Вход:  resources/voice_jarvis_ru/transcripts.csv (см. transcribe_corpus.py)
Выход: /tmp/sbvits2/Data/jarvis_ru/
         wavs/NNNN.wav  — 44.1 кГц mono (формат модели)
         esd.list       — строки "wavs/NNNN.wav|jarvis_ru|EN|текст"

Русский текст транслитерируется в латиницу: у базовой модели в алфавите
нет кириллицы, и консистентная транслитерация — стандартный способ
обучать такую модель русскому (модель выучит маппинг при файнтюне).
"""

import csv
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CORPUS = ROOT / "resources" / "voice_jarvis_ru"
SBV2 = Path("/tmp/sbvits2")
DATASET = SBV2 / "Data" / "jarvis_ru"
WAVS = DATASET / "wavs"

MIN_DURATION_SEC = 0.7

RU2LAT = {
    "а": "a", "б": "b", "в": "v", "г": "g", "д": "d", "е": "e", "ё": "yo",
    "ж": "zh", "з": "z", "и": "i", "й": "y", "к": "k", "л": "l", "м": "m",
    "н": "n", "о": "o", "п": "p", "р": "r", "с": "s", "т": "t", "у": "u",
    "ф": "f", "х": "h", "ц": "ts", "ч": "ch", "ш": "sh", "щ": "shch",
    "ъ": "", "ы": "y", "ь": "", "э": "e", "ю": "yu", "я": "ya",
}


def translit(text: str) -> str:
    out = []
    for ch in text:
        low = ch.lower()
        if low in RU2LAT:
            t = RU2LAT[low]
            out.append(t.capitalize() if ch.isupper() else t)
        else:
            out.append(ch)
    return "".join(out)


def to_wav(src: Path, dst: Path) -> None:
    subprocess.run(
        ["ffmpeg", "-y", "-v", "error", "-i", str(src), "-ar", "44100", "-ac", "1",
         "-c:a", "pcm_s16le", str(dst)],
        check=True,
    )


def main() -> None:
    if DATASET.exists():
        shutil.rmtree(DATASET)
    WAVS.mkdir(parents=True)

    rows = list(csv.DictReader((CORPUS / "transcripts.csv").open(encoding="utf-8")))
    kept, skipped = 0, 0
    with (DATASET / "esd.list").open("w", encoding="utf-8") as esd:
        for i, r in enumerate(rows, 1):
            text = (r["text"] or "").strip()
            dur = float(r["duration_sec"] or 0)
            src = CORPUS / r["file"]
            if not text or text.startswith("<ERROR") or dur < MIN_DURATION_SEC or not src.exists():
                skipped += 1
                continue
            out = WAVS / f"{i:04d}.wav"
            to_wav(src, out)
            esd.write(f"wavs/{out.name}|jarvis_ru|EN|{translit(text)}\n")
            kept += 1

    total_sec = sum(
        float(r["duration_sec"] or 0)
        for r, _ in zip(rows, range(kept))
    )
    print(f"готово: {kept} записей (~{total_sec:.0f} с речи), пропущено {skipped}")
    print(f"датасет: {DATASET}")


if __name__ == "__main__":
    sys.exit(main())
</file>

<file path="scripts/voice-train/transcribe_corpus.py">
#!/usr/bin/env python3
"""Транскрибация корпуса голоса Джарвиса (faster-whisper, ru).

Запуск: /tmp/f5_env/bin/python scripts/voice-train/transcribe_corpus.py
Результат: resources/voice_jarvis_ru/transcripts.csv (file,duration,text)
"""

import csv
import subprocess
import sys
from pathlib import Path

import numpy as np
from faster_whisper import WhisperModel

ROOT = Path(__file__).resolve().parents[2]
CORPUS = ROOT / "resources" / "voice_jarvis_ru"
OUT_CSV = CORPUS / "transcripts.csv"
EXTS = {".mp3", ".wav", ".ogg", ".flac", ".m4a"}


def load16k(path: Path) -> np.ndarray:
    subprocess.run(
        ["ffmpeg", "-y", "-v", "error", "-i", str(path), "-ar", "16000", "-ac", "1",
         "-f", "s16le", "/tmp/aw.pcm"],
        check=True,
    )
    return np.fromfile("/tmp/aw.pcm", dtype=np.int16).astype(np.float32) / 32768.0


def duration(path: Path) -> float:
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(path)],
        capture_output=True, text=True,
    )
    try:
        return float(out.stdout.strip())
    except ValueError:
        return 0.0


def main() -> None:
    files = sorted(
        p for p in CORPUS.rglob("*")
        if p.suffix.lower() in EXTS and p.name != ".DS_Store"
    )
    print(f"файлов: {len(files)}", flush=True)

    model = WhisperModel("small", device="cpu", compute_type="int8")
    rows = []
    for i, p in enumerate(files, 1):
        rel = p.relative_to(CORPUS)
        dur = duration(p)
        try:
            audio = load16k(p)
            if dur < 0.3 or audio.shape[0] < 4000:
                text = ""
            else:
                segs, _ = model.transcribe(audio, language="ru", vad_filter=True)
                text = " ".join(s.text.strip() for s in segs).strip()
        except Exception as e:  # noqa: BLE001 — битые файлы не должны валить обход
            text = f"<ERROR: {e}>"
        rows.append((str(rel), dur, text))
        print(f"[{i}/{len(files)}] {rel} ({dur:.1f}s): {text[:80]}", flush=True)

    with OUT_CSV.open("w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["file", "duration_sec", "text"])
        w.writerows(rows)
    total = sum(r[1] for r in rows)
    print(f"готово: {OUT_CSV} ({len(rows)} файлов, {total:.1f}s речи)", flush=True)


if __name__ == "__main__":
    sys.exit(main())
</file>

<file path="scripts/build_macos.sh">
#!/usr/bin/env bash
# Собирает готовый macOS-дистрибутив Jarvis:
#   build/Jarvis-<версия>.dmg
#
# По умолчанию тяжёлые модели в .app не встраиваются — приложение скачивает их
# при первом запуске в ~/Library/Application Support/Jarvis/models (STT/stress/uzu
# из HF/Mirai, silero и Qwen3.5 — из релиза jarvis-models). Внутри архива —
# звуки, конфиги и крошечные wake word-модели. Офлайн-сборка с моделями:
# JARVIS_EMBED_MODELS=1.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_DIR="$ROOT/app"
TAURI_DIR="$APP_DIR/src-tauri"
BUILD_DIR="$ROOT/build"
CONF="$TAURI_DIR/tauri.conf.json"

VERSION="$(python3 -c "import json;print(json.load(open('$CONF'))['version'])")"
DMG_NAME="Jarvis-$VERSION"
echo "==> Jarvis $VERSION"

# 0. Иконки (icns нужен бандлеру macOS).
if [ ! -f "$TAURI_DIR/icons/icon.icns" ]; then
  echo "==> Генерирую иконки из icon.png"
  (cd "$APP_DIR" && bun tauri icon src-tauri/icons/icon.png)
fi

# 1. Сборка .app (release). Frontend собирается через beforeBuildCommand.
echo "==> Собираю .app (release)…"
(cd "$APP_DIR" && bun tauri build --bundles app)

APP="$(find "$ROOT/target" "$TAURI_DIR/target" -maxdepth 7 -type d -name 'Jarvis.app' 2>/dev/null | head -1 || true)"
if [ -z "$APP" ] || [ ! -d "$APP" ]; then
  echo "!! Не нашёл Jarvis.app после сборки" >&2
  exit 1
fi
echo "==> .app: $APP"

# 2. Архив данных внутрь приложения.
echo "==> Готовлю архив данных (звуки + конфиги)…"

# По умолчанию тяжёлые модели (LLM/STT/TTS, ~3 ГБ) НЕ встраиваются: приложение
# качает их при первом запуске в ~/Library/Application Support/Jarvis/models.
# Крошечные wake word-модели идут в архиве — своего источника у них нет.
# Офлайн-сборка со всем внутри: JARVIS_EMBED_MODELS=1.
EMBED_MODELS="${JARVIS_EMBED_MODELS:-0}"

mkdir -p "$APP/Contents/Resources/payload"
PAYLOAD="$APP/Contents/Resources/payload/jarvis-data.tar.gz"
rm -f "$PAYLOAD"

TAR_ITEMS=(resources/audio commands.toml settings.toml)
if [ "$EMBED_MODELS" = "1" ]; then
  echo "    JARVIS_EMBED_MODELS=1 — встраиваю models/ ($(du -sh "$ROOT/models" 2>/dev/null | cut -f1))"
  TAR_ITEMS=(models "${TAR_ITEMS[@]}")
else
  echo "    модели не встраиваются — скачаются при первом запуске"
  for f in models/jarvis_model.rpw models/jarvis_model_2.rpw; do
    [ -f "$ROOT/$f" ] && TAR_ITEMS+=("$f")
  done
fi

tar --exclude='.DS_Store' -czf "$PAYLOAD" -C "$ROOT" "${TAR_ITEMS[@]}"
echo "    архив: $(du -h "$PAYLOAD" | cut -f1)"

# Приблизительный объём распакованных данных — для Read Me.
DATA_GB="$(du -sm "$ROOT/models" "$ROOT/resources/audio" 2>/dev/null | awk '{s+=$1} END {printf "%d", s/1024 + 0.5}')"

# 3. Ad-hoc подпись (изменили содержимое бандла после сборки).
echo "==> Подписываю (ad-hoc)…"
codesign --force --deep --sign - "$APP" >/dev/null 2>&1 || echo "   (codesign недоступен, пропускаю)"

# 4. Содержимое DMG.
echo "==> Собираю образ…"
rm -rf "$BUILD_DIR/dmg"
mkdir -p "$BUILD_DIR/dmg/.background"
cp -R "$APP" "$BUILD_DIR/dmg/"
ln -s /Applications "$BUILD_DIR/dmg/Applications"
python3 "$ROOT/scripts/dmg_background.py" "$BUILD_DIR/dmg/.background/bg.png"

if [ -f "$TAURI_DIR/icons/icon.icns" ]; then
  cp "$TAURI_DIR/icons/icon.icns" "$BUILD_DIR/dmg/.VolumeIcon.icns"
fi

if [ "$EMBED_MODELS" = "1" ]; then
  STEP2="2. Запустите Jarvis. При первом старте он распакует модели (~${DATA_GB:-3} ГБ) в ~/Library/Application Support/Jarvis."
  FIRST="Первый запуск занимает около минуты — идёт распаковка моделей."
else
  STEP2="2. Запустите Jarvis. При первом старте он скачает модели (~${DATA_GB:-3} ГБ) в ~/Library/Application Support/Jarvis — нужен интернет."
  FIRST="Первый запуск занимает несколько минут — идёт загрузка моделей."
fi

cat > "$BUILD_DIR/dmg/Read Me.txt" <<EOF
Jarvis — локальный голосовой ассистент
======================================

1. Перетащите Jarvis в папку «Программы».
$STEP2
3. Разрешите доступ к микрофону, когда система спросит.

$FIRST
Скажите «Джарвис», затем команду или вопрос.

Приложение без подписи Apple: при первом запуске нажмите
правой кнопкой по Jarvis → «Открыть» → «Открыть».
EOF

# 5. Записываемый образ, настройка окна Finder, сжатие в UDZO.
TMP_DMG="$BUILD_DIR/$DMG_NAME.tmp.dmg"
FINAL_DMG="$BUILD_DIR/$DMG_NAME.dmg"
rm -f "$TMP_DMG" "$FINAL_DMG"
hdiutil create -volname "Jarvis" -srcfolder "$BUILD_DIR/dmg" -ov -format UDRW "$TMP_DMG" >/dev/null
ATTACH="$(hdiutil attach "$TMP_DMG" -nobrowse -readwrite)"
VOL="$(printf '%s\n' "$ATTACH" | grep -o '/Volumes/.*' | tail -1)"
if [ -z "$VOL" ]; then
  echo "!! Не удалось смонтировать образ" >&2
  exit 1
fi
echo "    том: $VOL"

osascript >/dev/null 2>&1 <<OSA || true
tell application "Finder"
  tell disk "Jarvis"
    open
    set current view of container window to icon view
    set toolbar visible of container window to false
    set statusbar visible of container window to false
    set the bounds of container window to {400, 120, 1000, 520}
    set vopt to the icon view options of container window
    set arrangement of vopt to not arranged
    set icon size of vopt to 120
    set background picture of vopt to file ".background:bg.png"
    set position of item "Jarvis.app" of container window to {150, 205}
    set position of item "Applications" of container window to {450, 205}
    try
      set position of item "Read Me.txt" of container window to {300, 330}
    end try
    update without registering applications
    delay 2
    close
  end tell
end tell
OSA

# Finder иногда убирает иконку тома — возвращаем и включаем её.
rm -rf "$VOL/.fseventsd"
cp "$TAURI_DIR/icons/icon.icns" "$VOL/.VolumeIcon.icns" 2>/dev/null || true
SetFile -a C "$VOL" 2>/dev/null || true
sync
hdiutil detach "$VOL" >/dev/null 2>&1 || hdiutil detach "$VOL" -force >/dev/null 2>&1 || true
hdiutil convert "$TMP_DMG" -format UDZO -imagekey zlib-level=9 -o "$FINAL_DMG" >/dev/null
rm -f "$TMP_DMG"

echo "==> Готово: $FINAL_DMG ($(du -h "$FINAL_DMG" | cut -f1))"
