<file path="jarvis-core/src/asr/model.rs">
//! Сборка FastConformer целиком: загрузка весов/конфига/токенизатора,
//! выбор декодера (RNNT greedy / CTC greedy / CTC beam search) и точки
//! входа распознавания.

use super::config::{self, FastConformerConfig};
use super::{conformer, ctc, frontend, rnnt, tokenizer};
use anyhow::{Context, Result};
use candle_core::{D, DType, Device};
use candle_nn::VarBuilder;
use std::path::{Path, PathBuf};
use std::time::Instant;

/// Выбор декодера.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Decoder {
    /// RNN-T жадный (по умолчанию: точнее на русской речи).
    Rnnt,
    /// CTC жадный.
    CtcGreedy,
    /// CTC beam search (width задаётся отдельно).
    CtcBeam { width: usize },
}

impl Default for Decoder {
    fn default() -> Self {
        Self::Rnnt
    }
}

/// Результат распознавания: текст и тайминги этапов.
#[derive(Debug, Clone)]
pub struct Transcript {
    pub text: String,
    pub ids: Vec<usize>,
    pub mel_ms: f64,
    pub encoder_ms: f64,
    pub decode_ms: f64,
}

pub struct FastConformer {
    pub device: Device,
    pub frontend: frontend::MelFrontend,
    pub encoder: conformer::Encoder,
    pub ctc_head: ctc::CtcHead,
    pub predictor: rnnt::Predictor,
    pub joint: rnnt::Joint,
    pub tokenizer: tokenizer::SpTokenizer,
    pub cfg: FastConformerConfig,
    /// Каталог модели (для словаря и отладки).
    pub dir: PathBuf,
}

impl FastConformer {
    /// Загружает модель из `models_dir/fastconformer`.
    ///
    /// Ожидаемые файлы (готовит `tools/convert_fastconformer.py` +
    /// `model_fetch::ensure_fastconformer`):
    /// `model.safetensors`, `config.json`, `tokenizer.vocab`.
    pub fn load(models_dir: &Path) -> Result<Self> {
        // Автозагрузка ассетов (веса ~460 МБ из релиза jarvis-models).
        if let Err(e) = crate::model_fetch::ensure_fastconformer() {
            eprintln!("⚠️ Не удалось скачать FastConformer: {e:#}");
        }
        let dir = models_dir.join("fastconformer");
        let safetensors = dir.join("model.safetensors");
        anyhow::ensure!(
            safetensors.exists(),
            "Файл весов не найден: {:?} — модель ещё не скачана",
            safetensors
        );

        let cfg = config::load(&dir.join("config.json"))?;
        let device = pick_device();

        let start = Instant::now();
        let vb = unsafe {
            VarBuilder::from_mmaped_safetensors(&[&safetensors], DType::F32, &device)
                .with_context(|| format!("Не удалось открыть {safetensors:?}"))?
        };

        // Фронтенд: окно и mel-фильтрбанк приходят из весов чекпоинта —
        // расхождения с эталонным препроцессором исключены.
        let window = vb.get(
            (cfg.preprocessor.win_length,),
            "preprocessor.featurizer.window",
        )?;
        let fb = vb.get(
            (1, cfg.preprocessor.n_mels, cfg.preprocessor.n_fft / 2 + 1),
            "preprocessor.featurizer.fb",
        )?;
        let frontend = frontend::MelFrontend::load(cfg.preprocessor, &window, &fb, &device)?;

        let encoder = conformer::Encoder::load(&vb, &cfg, &device)?;
        let ctc_head =
            ctc::CtcHead::load(vb.pp("ctc_decoder").pp("decoder_layers").pp("0"), cfg.encoder.d_model, cfg.decoder.vocab_size + 1)?;
        let predictor = rnnt::Predictor::load(
            vb.pp("decoder").pp("prediction"),
            cfg.decoder.vocab_size + 1,
            cfg.decoder.pred_hidden,
        )?;
        let joint = rnnt::Joint::load(
            vb.pp("joint"),
            cfg.encoder.d_model,
            cfg.decoder.pred_hidden,
            cfg.decoder.joint_hidden,
            cfg.decoder.vocab_size + 1,
        )?;
        let tokenizer =
            tokenizer::SpTokenizer::load(&dir.join("tokenizer.vocab"))?;

        let model = Self {
            device,
            frontend,
            encoder,
            ctc_head,
            predictor,
            joint,
            tokenizer,
            cfg,
            dir,
        };
        println!(
            "✅ FastConformer загружен за {:.2?} ({})",
            start.elapsed(),
            if model.device.is_metal() { "Metal" } else { "CPU" }
        );
        Ok(model)
    }

    /// Полное распознавание буфера 16 кГц mono f32 выбранным декодером.
    pub fn transcribe(&self, samples: &[f32]) -> Result<Transcript> {
        self.transcribe_with(samples, Decoder::Rnnt, None)
    }

    pub fn transcribe_with(
        &self,
        samples: &[f32],
        decoder: Decoder,
        dict: Option<&ctc::JarvisDictionary>,
    ) -> Result<Transcript> {
        // 1. Mel-фронтенд (DFT — matmul на устройстве модели).
        let t0 = Instant::now();
        let (mel, length) = self.frontend.compute(samples, &self.device)?;
        let mel_ms = t0.elapsed().as_secs_f64() * 1000.0;

        // 2. Энкодер (pre-encode + 17 Conformer-блоков).
        let t1 = Instant::now();
        let (enc, t_valid) = self.encoder.forward(&mel, length)?;
        let encoder_ms = t1.elapsed().as_secs_f64() * 1000.0;

        // 3. Декодер.
        let t2 = Instant::now();
        let ids = match decoder {
            Decoder::Rnnt => rnnt::greedy(
                &enc,
                t_valid,
                &self.predictor,
                &self.joint,
                self.cfg.blank_id,
                self.cfg.decoder.max_symbols_per_step,
            )?,
            Decoder::CtcGreedy => {
                let logits = self.ctc_head.logits(&enc)?; // [1, T, V]
                let (frames, vocab_out) = (logits.dim(1)?, logits.dim(2)?);
                let flat = logits.reshape((frames * vocab_out,))?.to_vec1::<f32>()?;
                ctc::greedy(&flat, frames, vocab_out, self.cfg.blank_id)
            }
            Decoder::CtcBeam { width } => {
                let logits = candle_nn::ops::log_softmax(&self.ctc_head.logits(&enc)?, D::Minus1)?;
                let (frames, vocab_out) = (logits.dim(1)?, logits.dim(2)?);
                let flat = logits.reshape((frames * vocab_out,))?.to_vec1::<f32>()?;
                ctc::beam_search(&flat, frames, vocab_out, self.cfg.blank_id, width, dict)
            }
        };
        let decode_ms = t2.elapsed().as_secs_f64() * 1000.0;

        let text = self.tokenizer.decode(&ids);
        Ok(Transcript {
            text,
            ids,
            mel_ms,
            encoder_ms,
            decode_ms,
        })
    }

    /// Словарь Jarvis для beam search (кодирование фраз токенизатором).
    pub fn jarvis_dictionary(&self, phrases: &[String]) -> Result<ctc::JarvisDictionary> {
        ctc::JarvisDictionary::new(phrases, &self.tokenizer, 0.3, 1.5)
    }

    pub fn is_metal(&self) -> bool {
        self.device.is_metal()
    }
}

/// Устройство ASR. По умолчанию CPU: замер fc_bench (M4 Pro) показал, что
/// энкодер на Metal стоит фиксированные ~720 мс на ЛЮБУЮ фразу (208 кадров —
/// 719 мс, 978 кадров — 729 мс): это чистый overhead командных буферов Metal
/// (~700 мелких операций с commit+wait на каждую), а не вычисления. На CPU
/// тот же энкодер (FP32, без квантизации) — 98 мс: короткая команда
/// распознаётся за ~130 мс вместо ~780. Metal включается переменной
/// окружения JARVIS_ASR_DEVICE=metal (для экспериментов и длинных потоков).
fn pick_device() -> Device {
    if std::env::var("JARVIS_ASR_DEVICE").as_deref() == Ok("metal") {
        #[cfg(target_os = "macos")]
        match Device::new_metal(0) {
            Ok(d) => return d,
            Err(e) => eprintln!("⚠️ Metal недоступен ({e}), ASR будет работать на CPU"),
        }
    }
    Device::Cpu
}
</file>

<file path="jarvis-core/src/asr/rnnt.rs">
//! RNN-T ветка FastConformer: Prediction Network (Embedding + LSTM 640),
//! Joint Network и жадный транзьюсер-декодер.
//!
//! Поток (снят с графа decoder_joint-model.onnx эталона):
//! - prediction: embed(prev_token) → LSTM (один слой, hidden 640); перед
//!   первым кадром предсказатель обрабатывает blank (SOS), как в NeMo;
//! - joint: Linear(enc 512→640) + Linear(pred 640→640) → ReLU →
//!   Linear(640 → vocab+1); проекции считаются по отдельности и складываются,
//!   как в NeMo RNNTJoint;
//! - жадное декодирование: на каждый кадр энкодера — цикл до
//!   max_symbols_per_step: joint(enc[t], state) → argmax; blank — переход к
//!   следующему кадру, иначе токен эмитится и обновляется состояние LSTM.
//!
//! Состояние предсказателя (h, c) живёт между шагами декодирования всей
//! фразы — контекст накопленных токенов учитывается на каждом кадре.

use anyhow::Result;
use candle_core::{D, IndexOp, Tensor};
use candle_nn::{Embedding, Module, VarBuilder};
use candle_nn::rnn::{lstm, RNN, LSTM, LSTMConfig, LSTMState};

pub struct Predictor {
    embed: Embedding,
    lstm: LSTM,
}

impl Predictor {
    pub fn load(vb: VarBuilder, vocab_out: usize, pred_hidden: usize) -> Result<Self> {
        // Веса: decoder.prediction.embed.weight [vocab+1, pred_hidden],
        //       decoder.prediction.dec_rnn.lstm.{weight_ih_l0,...}.
        let embed = Embedding::new(vb.get((vocab_out, pred_hidden), "embed.weight")?, pred_hidden);
        let lstm = lstm(
            pred_hidden,
            pred_hidden,
            LSTMConfig::default(),
            vb.pp("dec_rnn").pp("lstm"),
        )?;
        Ok(Self { embed, lstm })
    }

    pub fn initial_state(&self) -> Result<LSTMState> {
        Ok(self.lstm.zero_state(1)?)
    }

    /// Один шаг предсказателя: id токена → новое состояние LSTM.
    pub fn step(&self, token: usize, state: &LSTMState) -> Result<LSTMState> {
        let device = state.h.device();
        let ids = Tensor::from_slice(&[token as u32], (1,), device)?;
        let e = self.embed.forward(&ids)?; // [1, pred_hidden]
        Ok(self.lstm.step(&e, state)?)
    }
}

pub struct Joint {
    enc_proj: candle_nn::Linear,  // d_model → joint_hidden
    pred_proj: candle_nn::Linear, // pred_hidden → joint_hidden
    out: candle_nn::Linear,       // joint_hidden → vocab+1
}

impl Joint {
    pub fn load(
        vb: VarBuilder,
        d_model: usize,
        pred_hidden: usize,
        joint_hidden: usize,
        vocab_out: usize,
    ) -> Result<Self> {
        Ok(Self {
            enc_proj: candle_nn::linear(d_model, joint_hidden, vb.pp("enc"))?,
            pred_proj: candle_nn::linear(pred_hidden, joint_hidden, vb.pp("pred"))?,
            out: candle_nn::linear(joint_hidden, vocab_out, vb.pp("joint_net").pp("2"))?,
        })
    }

    /// Логиты одной пары (кадр энкодера [1, d_model], состояние [1, pred_hidden]).
    pub fn logits(&self, enc_frame: &Tensor, state: &LSTMState) -> Result<Tensor> {
        let e = self.enc_proj.forward(enc_frame)?; // [1, joint_hidden]
        let p = self.pred_proj.forward(&state.h)?; // [1, joint_hidden]
        let h = (e + p)?.relu()?;
        Ok(self.out.forward(&h)?)
    }
}

/// Жадное RNNT-декодирование. enc_out: [1, T, d_model] на устройстве модели,
/// t_valid — число валидных кадров. Возвращает id токенов.
///
/// Семантика onnx-asr: каждый шаг встраивает ТЕКУЩИЙ контекст (`prev`) из
/// текущего состояния предсказателя. Состояние фиксируется только при
/// эмиссии токена — в него вошло встраивание старого контекста; при blank
/// откатывается, чтобы тот же токен не вошёл в LSTM дважды через границу
/// кадров (двойное продвижение ломало транскрипт: syllables выпадали).
pub fn greedy(
    enc_out: &Tensor,
    t_valid: usize,
    predictor: &Predictor,
    joint: &Joint,
    blank_id: usize,
    max_symbols_per_step: usize,
) -> Result<Vec<usize>> {
    let mut tokens = Vec::new();
    let mut state = predictor.initial_state()?;
    let mut prev = blank_id;

    for t in 0..t_valid {
        // Кадр энкодера [512] → [1, 512]: индексация даёт contiguous-срез.
        let frame = enc_out.i((0, t, ..))?.unsqueeze(0)?;
        let mut emitted = 0usize;
        loop {
            // Встраиваем текущий контекст из текущего состояния.
            let next_state = predictor.step(prev, &state)?;
            let logits = joint.logits(&frame, &next_state)?; // [1, vocab+1]
            // argmax даёт [1]: сжимаем до ранга 0 для to_scalar.
            let best = logits.argmax(D::Minus1)?.squeeze(0)?.to_scalar::<u32>()? as usize;
            if best == blank_id || emitted >= max_symbols_per_step {
                break; // blank: state не двигается — контекст не менялся
            }
            tokens.push(best);
            prev = best;
            state = next_state;
            emitted += 1;
        }
    }
    Ok(tokens)
}
</file>

<file path="jarvis-core/src/asr/subsampling.rs">
//! Pre-encode энкодера: глубоко-свёрточное сжатие 8× (dw_striding).
//!
//! Структура снята с графа ONNX-эталона: [B, 80, T] → транспонирование в
//! [B, T, 80] → [B, 1, T, 80] →
//! conv 3×3 stride 2 (1→256) → ReLU →
//! depthwise 3×3 stride 2 (groups 256) → pointwise 1×1 → ReLU →
//! depthwise 3×3 stride 2 → pointwise 1×1 → ReLU →
//! [B, T', 2560] → Linear(2560 → d_model).
//!
//! BatchNorm в pre-encode отсутствует и в чекпоинте, и в эталоне.
//! Длина выхода: floor((len-1)/2)+1 на каждую stride-2 свёртку
//! (см. [`super::frontend::calc_length`]).

use anyhow::Result;
use candle_core::Tensor;
use candle_nn::{conv::Conv2dConfig, conv2d, Linear, Module, VarBuilder};

pub struct Subsampling {
    conv0: candle_nn::Conv2d,
    conv2: candle_nn::Conv2d,
    conv3: candle_nn::Conv2d,
    conv5: candle_nn::Conv2d,
    conv6: candle_nn::Conv2d,
    out: Linear,
}

impl Subsampling {
    pub fn load(vb: VarBuilder, d_model: usize) -> Result<Self> {
        // Веса: encoder.pre_encode.{conv.0,conv.2,conv.3,conv.5,conv.6,out}.
        let channels = 256;
        let stride2 = Conv2dConfig {
            padding: 1,
            stride: 2,
            dilation: 1,
            groups: 1,
            cudnn_fwd_algo: None,
        };
        let depthwise = Conv2dConfig {
            padding: 1,
            stride: 2,
            dilation: 1,
            groups: channels,
            cudnn_fwd_algo: None,
        };
        let pointwise = Conv2dConfig {
            padding: 0,
            stride: 1,
            dilation: 1,
            groups: 1,
            cudnn_fwd_algo: None,
        };
        let v = vb.pp("pre_encode");
        let conv = v.pp("conv");
        Ok(Self {
            // Вход — ОДИН канал: [B, 1, T, n_mels]; время и частота —
            // пространственные оси. Вес в чекпоинте [256, 1, 3, 3], group 1
            // (по графу ONNX-эталона).
            conv0: conv2d(1, channels, 3, stride2, conv.pp("0"))?,
            conv2: conv2d(channels, channels, 3, depthwise, conv.pp("2"))?,
            conv3: conv2d(channels, channels, 1, pointwise, conv.pp("3"))?,
            conv5: conv2d(channels, channels, 3, depthwise, conv.pp("5"))?,
            conv6: conv2d(channels, channels, 1, pointwise, conv.pp("6"))?,
            out: candle_nn::linear(channels * 10, d_model, v.pp("out"))?,
        })
    }

    /// mel: [B, feat_in, T] (например [1, 80, 101]) → [B, T', d_model].
    pub fn forward(&self, mel: &Tensor) -> Result<Tensor> {
        // [B, feat_in, T] -> [B, T, feat_in] -> [B, 1, T, feat_in]
        let (b, _feat, _t) = mel.dims3()?;
        let x = mel
            .t()? // [B, T, feat_in]
            .unsqueeze(1)?; // [B, 1, T, feat_in]

        let x = self.conv0.forward(&x)?.relu()?;
        let x = self.conv2.forward(&x)?;
        let x = self.conv3.forward(&x)?.relu()?;
        let x = self.conv5.forward(&x)?;
        let x = self.conv6.forward(&x)?.relu()?; // [B, 256, T', 10]

        // [B, 256, T', 10] -> [B, T', 2560] -> [B, T', d_model]
        let x = x.transpose(1, 2)?; // [B, T', 256, 10]
        let t_out = x.dim(1)?;
        let x = x.contiguous()?.reshape((b, t_out, 2560))?;
        Ok(self.out.forward(&x)?)
    }
}
</file>

<file path="jarvis-core/src/asr/tokenizer.rs">
//! Токенизатор FastConformer — оригинальный SentencePiece Unigram модели
//! (словарь 1024, unk id 0, blank добавляется NeMo как id 1024).
//!
//! Декодирование (id → текст) — прямое: склейка кусков с заменой "▁" на
//! пробел и постобработкой пробелов, идентичной эталону onnx-asr
//! (регулярка `\A\s|\s\B|(\s)\b`).
//!
//! Кодирование (текст → id) — Viterbi по Unigram-модели. Нормализация
//! соответствует spec'у SentencePiece модели: `nmt_nfkc`, add_dummy_prefix,
//! remove_extra_whitespaces, escape_whitespaces (все true). NFKC-часть
//! нормализатора воспроизводится крейтом `tokenizers` (`Normalizer::Nmt` —
//! это прямой порт charsmap nmt_nfkc из SentencePiece).

use anyhow::{Context, Result};
use std::path::Path;
use tokenizers::models::unigram::Unigram;
use tokenizers::Tokenizer;

pub struct SpTokenizer {
    /// Куски словаря по id: 0..<unk>, 1..vocab_size, blank = vocab_size
    /// (последний, из NeMo).
    vocab: Vec<String>,
    /// HF-токенизатор для кодирования текста (Unigram + Nmt + Metaspace).
    encoder: Tokenizer,
}

impl SpTokenizer {
    /// vocab_path — файл `tokenizer.vocab` (формат "piece\tscore", 1024 строк).
    pub fn load(vocab_path: &Path) -> Result<Self> {
        let text = std::fs::read_to_string(vocab_path)
            .with_context(|| format!("Не удалось прочитать {vocab_path:?}"))?;
        let mut pieces: Vec<(String, f64)> = Vec::new();
        let mut vocab: Vec<String> = Vec::new();
        for line in text.lines() {
            let (piece, score) = line
                .split_once('\t')
                .with_context(|| format!("Строка токенизатора без score: {line:?}"))?;
            vocab.push(piece.to_string());
            pieces.push((piece.to_string(), score.parse().unwrap_or(0.0)));
        }
        // unk id 0 (первая строка <unk>); blank NeMo добавляет в конце —
        // в Unigram-модель он не входит (не участвует в кодировании текста).
        let model = Unigram::from(pieces, Some(0), false)
            .map_err(|e| anyhow::anyhow!("Unigram: {e}"))?;
        let mut encoder = Tokenizer::new(model);
        encoder.with_normalizer(Some(tokenizers::normalizers::Nmt));
        encoder.with_pre_tokenizer(Some(
            tokenizers::pre_tokenizers::metaspace::Metaspace::default(),
        ));

        Ok(Self { vocab, encoder })
    }

    /// Кусок словаря по id (blank не входит в словарь токенизатора).
    pub fn piece(&self, id: usize) -> Option<&str> {
        self.vocab.get(id).map(String::as_str)
    }

    pub fn vocab_size(&self) -> usize {
        self.vocab.len()
    }

    /// Декодирование id → текст (blank и служебные id отфильтрованы).
    pub fn decode(&self, ids: &[usize]) -> String {
        let joined: String = ids
            .iter()
            .filter_map(|&id| self.vocab.get(id))
            .map(|piece| piece.replace('▁', " "))
            .collect();
        postprocess_spaces(&joined)
    }

    /// Кодирование текста → id (Viterbi Unigram; unk для неизвестного).
    pub fn encode(&self, text: &str) -> Result<Vec<usize>> {
        let encoding = self
            .encoder
            .encode(text, false)
            .map_err(|e| anyhow::anyhow!("Ошибка кодирования токенизатора: {e}"))?;
        Ok(encoding.get_ids().iter().map(|&id| id as usize).collect())
    }
}

/// Постобработка пробелов, идентичная эталону onnx-asr
/// (`re.sub(r"\A\s|\s\B|(\s)\b", ...)`): убрать ведущие пробелы, пробелы
/// перед не-словесными символами (пунктуацией) и задвоенные; одиночный
/// пробел между словами оставить.
pub fn postprocess_spaces(s: &str) -> String {
    let chars: Vec<char> = s.chars().collect();
    let mut out = String::with_capacity(s.len());
    for (i, &c) in chars.iter().enumerate() {
        if c.is_whitespace() {
            // \b сразу после пробела: следующий символ — словесный, пробел
            // не ведущий. Иначе (\A\s, \s\B) — убрать.
            let next_word = i + 1 < chars.len() && is_word(chars[i + 1]);
            if i > 0 && next_word {
                out.push(' ');
            }
        } else {
            out.push(c);
        }
    }
    out
}

fn is_word(c: char) -> bool {
    c.is_alphanumeric() || c == '_'
}

#[cfg(test)]
mod tests {
    use super::postprocess_spaces;

    #[test]
    fn spaces_follow_onnx_asr_pattern() {
        // На входе — уже склеенные куски с заменённым "▁": постобработка
        // получает обычные пробелы.
        assert_eq!(postprocess_spaces(" привет мир"), "привет мир");
        // Пробел перед пунктуацией уходит; задвоенные — тоже.
        assert_eq!(postprocess_spaces("раз , два"), "раз, два");
        assert_eq!(postprocess_spaces("a  b"), "a b");
        // Замыкающий пробел уходит.
        assert_eq!(postprocess_spaces("конец "), "конец");
    }
}
</file>

<file path="jarvis-core/src/llm/candle_backend.rs">
//! Candle-бэкенд LLM: MiniCPM5-1B-ru и Qwen3.5-0.8B, реализации архитектур
//! на чистом candle + Metal. Был единственным движком `LlmEngine`, теперь
//! стоит за диспетчером в `mod.rs` (второй бэкенд — uzu на macOS).

use super::config::{self, ModelConfig};
use super::streaming::{MAX_SENTENCE_CHARS, find_chunk_end, speakable, strip_think};
use super::template;
use anyhow::{Context, Result};
use candle_core::{DType, Device, IndexOp};
use std::sync::atomic::{AtomicBool, Ordering};
use std::time::Instant;
use tokenizers::Tokenizer;

/// Терминаторы ответа: добавляются к eos из конфига, если есть в словаре.
const EXTRA_STOP_TOKENS: &[&str] = &["<|eot_id|>", "<|im_end|>", "<|endoftext|>"];

fn pick_device() -> Device {
    // Metal есть только на macOS: на Linux и Windows считаем на CPU
    // (сначала пробуем его на всех ОС, чтобы не тащить cfg в горячий путь).
    #[cfg(target_os = "macos")]
    match Device::new_metal(0) {
        Ok(d) => {
            println!("✅ LLM: устройство Metal");
            return d;
        }
        Err(e) => {
            eprintln!("⚠️ Metal недоступен ({e}), LLM будет работать на CPU");
        }
    }
    Device::Cpu
}

/// Бюджет генерации: сколько токенов отведено ответу.
///
/// `max_tokens = 0` — **без искусственного лимита**: весь остаток контекста
/// модели; обрыв ответа по счётчику давал ложные «не могу» на длинные
/// команды, поэтому по умолчанию лимита нет. Ненулевое значение —
/// страховочный кап; контекст (rope) — жёсткая граница в любом случае.
fn generation_budget(rope_len: usize, prompt_len: usize, max_tokens: usize) -> usize {
    let headroom = rope_len.saturating_sub(prompt_len + 8);
    if max_tokens == 0 {
        headroom
    } else {
        max_tokens.min(headroom)
    }
}

/// Загруженная модель вместе с её (модельно-специфичным) кэшем.
enum CandleModel {
    /// MiniCPM5-1B-ru (Llama-архитектура, KV-кэш на каждый слой).
    Llama {
        model: super::model::LlamaModel,
        caches: Vec<super::model::KvCache>,
    },
    /// Qwen3.5-0.8B (гибрид Gated DeltaNet + gated attention).
    Qwen35 {
        model: super::qwen35::Qwen35Model,
        cache: super::qwen35::Qwen35Cache,
    },
}

impl CandleModel {
    fn forward(&mut self, ids: &[u32], start_pos: usize) -> Result<candle_core::Tensor> {
        match self {
            Self::Llama { model, caches } => model.forward(ids, start_pos, caches),
            Self::Qwen35 { model, cache } => model.forward(ids, start_pos, cache),
        }
    }

    fn rope_len(&self) -> usize {
        match self {
            Self::Llama { model, .. } => model.rope_len(),
            Self::Qwen35 { model, .. } => model.rope_len(),
        }
    }

    fn num_hidden_layers(&self) -> usize {
        match self {
            Self::Llama { model, .. } => model.config().num_hidden_layers,
            Self::Qwen35 { model, .. } => model.config.num_hidden_layers,
        }
    }

    fn vocab_size(&self) -> usize {
        match self {
            Self::Llama { model, .. } => model.config().vocab_size,
            Self::Qwen35 { model, .. } => model.config.vocab_size,
        }
    }

    fn reset_caches(&mut self) {
        match self {
            Self::Llama { caches, .. } => {
                for c in caches {
                    c.reset();
                }
            }
            Self::Qwen35 { model, cache } => {
                *cache = model.new_cache();
            }
        }
    }
}

/// Загружает модель из каталога по её config.json (qwen3_5_text → Qwen3.5,
/// иначе — Llama-семейство: MiniCPM5).
fn load_model_dir(
    models_dir: &std::path::Path,
) -> Result<(CandleModel, Tokenizer, Vec<u32>, bool, &'static str)> {
    let dir = models_dir.join(config::model_name());
    // Qwen3.5-0.8B не качается ни из HF, ни из Mirai — тянем из релиза
    // jarvis-models, если файлов ещё нет.
    if config::model_name() == super::qwen35::LOCAL_DIR_NAME {
        crate::model_fetch::ensure_qwen35(&dir)
            .with_context(|| format!("Не удалось подготовить Qwen3.5 в {}", dir.display()))?;
    }
    if super::qwen35::Qwen35Config::is_qwen35_config(&dir.join("config.json")) {
        let device = pick_device();
        let model = super::qwen35::Qwen35Model::load(&dir, &device)
            .with_context(|| format!("Не удалось загрузить Qwen3.5 из {}", dir.display()))?;
        let tokenizer = Tokenizer::from_file(dir.join("tokenizer.json"))
            .map_err(|e| anyhow::anyhow!("Не удалось загрузить токенизатор: {e}"))?;
        let mut eos_ids = model.config.eos_ids.clone();
        for stop in EXTRA_STOP_TOKENS {
            if let Some(id) = tokenizer.token_to_id(stop)
                && !eos_ids.contains(&id)
            {
                eos_ids.push(id);
            }
        }
        println!(
            "   LLM: модель {}/qwen3_5, eos_ids={:?}",
            config::model_name(),
            eos_ids
        );
        let cache = model.new_cache();
        Ok((
            CandleModel::Qwen35 { model, cache },
            tokenizer,
            eos_ids,
            false,
            template::QWEN_ASSISTANT_PREFIX,
        ))
    } else {
        let started = Instant::now();
        let files = config::ensure_model_downloaded(models_dir)?;
        let cfg = ModelConfig::load(&files.config)?;
        let eos_ids = cfg.eos_ids();
        let bos_id = cfg.bos_id();
        let prompt_bos = cfg.use_bos_in_template();

        let device = pick_device();
        let model = super::model::LlamaModel::load(&files, cfg, &device)
            .context("Не удалось загрузить веса MiniCPM5-1B")?;

        let tokenizer = Tokenizer::from_file(&files.tokenizer)
            .map_err(|e| anyhow::anyhow!("Не удалось загрузить токенизатор: {e}"))?;
        let mut eos_ids = eos_ids;
        for stop in EXTRA_STOP_TOKENS {
            if let Some(id) = tokenizer.token_to_id(stop)
                && !eos_ids.contains(&id)
            {
                eos_ids.push(id);
            }
        }
        println!(
            "   LLM: bos_id={:?}, eos_ids={:?}, слоёв={}, vocab={}",
            bos_id,
            eos_ids,
            model.config().num_hidden_layers,
            model.config().vocab_size
        );
        println!("✅ MiniCPM5-1B загружена за {:.1?}", started.elapsed());
        let caches = vec![super::model::KvCache::new(); model.config().num_hidden_layers];
        Ok((
            CandleModel::Llama { model, caches },
            tokenizer,
            eos_ids,
            prompt_bos,
            "",
        ))
    }
}

pub struct CandleEngine {
    engine: CandleModel,
    tokenizer: Tokenizer,
    eos_ids: Vec<u32>,
    prompt_bos: bool,
    /// Дописка после `<|im_start|>assistant\n`: у Qwen3.5 — принудительно
    /// закрытый блок рассуждений, у MiniCPM5 — пустая строка.
    assistant_prefix: &'static str,
    /// Токены, уже лежащие в KV-кэше (префикс последнего промпта + ответа).
    /// Следующий вызов с тем же префиксом префиллится только с дельты.
    prefix_cache: Vec<u32>,
}

impl CandleEngine {
    /// Загрузка модели из `models/` (каталог задаёт `llm_model` в settings.toml).
    pub fn load(models_dir: &std::path::Path) -> Result<Self> {
        let started = Instant::now();
        let (engine, tokenizer, eos_ids, prompt_bos, assistant_prefix) =
            load_model_dir(models_dir)?;

        println!(
            "   LLM: слоёв={}, vocab={}, потолок контекста={}",
            engine.num_hidden_layers(),
            engine.vocab_size(),
            engine.rope_len()
        );
        println!("✅ LLM загружена за {:.1?}", started.elapsed());

        Ok(Self {
            engine,
            tokenizer,
            eos_ids,
            prompt_bos,
            assistant_prefix,
            prefix_cache: Vec::new(),
        })
    }

    fn reset(&mut self) {
        self.engine.reset_caches();
        self.prefix_cache.clear();
    }

    pub fn generate_streaming(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        cancel: &AtomicBool,
        on_sentence: impl FnMut(&str),
        on_progress: impl FnMut(&str),
    ) -> Result<String> {
        self.generate_streaming_with_params(
            system,
            history,
            user,
            None,
            cancel,
            on_sentence,
            on_progress,
        )
    }

    #[allow(clippy::too_many_arguments)]
    pub fn generate_streaming_with_params(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        params_override: Option<config::GenerationParams>,
        cancel: &AtomicBool,
        on_sentence: impl FnMut(&str),
        on_progress: impl FnMut(&str),
    ) -> Result<String> {
        self.generate_streaming_inner(
            system,
            history,
            user,
            params_override,
            cancel,
            None,
            on_sentence,
            on_progress,
        )
    }

    /// Генерация с «вставленным началом ответа ассистента»: `prefill`
    /// дописывается в промпт сразу после заголовка `assistant`, и модель
    /// продолжает только его. Так она не тратит токены на рассуждения
    /// и не может выдать кривой JSON.
    #[allow(clippy::too_many_arguments)]
    pub fn generate_streaming_with_prefill(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        params_override: Option<config::GenerationParams>,
        cancel: &AtomicBool,
        prefill: &str,
        on_sentence: impl FnMut(&str),
        on_progress: impl FnMut(&str),
    ) -> Result<String> {
        self.generate_streaming_inner(
            system,
            history,
            user,
            params_override,
            cancel,
            Some(prefill),
            on_sentence,
            on_progress,
        )
    }

    #[allow(clippy::too_many_arguments)]
    pub(crate) fn generate_streaming_inner(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        params_override: Option<config::GenerationParams>,
        cancel: &AtomicBool,
        prefill: Option<&str>,
        mut on_sentence: impl FnMut(&str),
        mut on_progress: impl FnMut(&str),
    ) -> Result<String> {
        let mut prompt = template::build_chat_prompt(
            system,
            history,
            user,
            if self.prompt_bos {
                Some(template::MINICPM_BOS)
            } else {
                None
            },
            self.assistant_prefix,
        );
        if let Some(prefix) = prefill {
            prompt.push_str(prefix);
        }
        let encoding = self
            .tokenizer
            .encode(prompt, false)
            .map_err(|e| anyhow::anyhow!("Ошибка токенизации промпта: {e}"))?;
        let mut context: Vec<u32> = encoding.get_ids().to_vec();
        if context.is_empty() {
            anyhow::bail!("Промпт не дал токенов");
        }

        let params = params_override.unwrap_or_else(|| {
            config::generation_params()
                .read()
                .unwrap_or_else(|e| e.into_inner())
                .clone()
        });
        // Бюджет генерации: 0 — без искусственного лимита (весь остаток
        // контекста). Останов держат EOS, фильтр зацикливания, закрытый
        // tool-JSON и отмена — но не обрыв длинного ответа по счётчику.
        let token_budget =
            generation_budget(self.engine.rope_len(), context.len(), params.max_tokens);
        if token_budget == 0 {
            anyhow::bail!("Промпт слишком длинный: {} токенов", context.len());
        }

        // Префиксный кэш: если начало промпта уже посчитано в KV-кэше
        // (системный промпт + история + прошлые ходы агентного цикла),
        // префиллим только дельту.
        let cached_len = self.prefix_cache.len();
        let reusable = cached_len > 0
            && cached_len < context.len()
            && context[..cached_len] == self.prefix_cache[..];
        let prefill_from = if reusable {
            if context.len() - cached_len > 1 {
                println!(
                    "   LLM: префикс {} ток. в кэше, допрефилл {} ток.",
                    cached_len,
                    context.len() - cached_len
                );
            }
            cached_len
        } else {
            self.reset();
            0
        };
        let mut rng = rand::thread_rng();
        let prompt_len = context.len();
        let mut suppress_think = false;
        let mut loop_hits = 0u32;
        const LOOP_WINDOW: usize = 10;
        const LOOP_MAX_HITS: u32 = 3;

        let t_prefill = Instant::now();
        let mut logits = self
            .engine
            .forward(&context[prefill_from..], prefill_from)?;
        let mut next_pos = context.len();
        let t_prefill = t_prefill.elapsed();
        let t_decode = Instant::now();
        let mut text = String::new();
        let mut buf = String::new();

        // Флаг tool-call: если ответ начинается с <tool>, весь текст идёт
        // только в буфер, минуя TTS.
        let mut is_tool_call: Option<bool> = None;
        let mut tool_probe = String::new();
        if let Some(prefix) = prefill {
            text.push_str(prefix);
            tool_probe.push_str(prefix);
            is_tool_call = Some(prefix.trim_start().starts_with("<tool>"));
        }

        loop {
            if cancel.load(Ordering::SeqCst) {
                break;
            }

            let last = logits.dim(0)? - 1;
            let mut row: Vec<f32> = logits
                .i((last, ..))?
                .to_dtype(DType::F32)?
                .flatten_all()?
                .to_vec1()?;

            let penalty = params.repeat_penalty + 0.6 * loop_hits as f32;
            super::sampler::apply_repeat_penalty(&mut row, penalty, &context, params.repeat_window);

            let tok =
                super::sampler::sample_top_p(&row, params.temperature, params.top_p, &mut rng);
            if self.eos_ids.contains(&tok) {
                break;
            }

            context.push(tok);

            let generated = &context[prompt_len..];
            if generated.len() >= LOOP_WINDOW * 2
                && generated[generated.len() - LOOP_WINDOW..]
                    == generated[generated.len() - 2 * LOOP_WINDOW..generated.len() - LOOP_WINDOW]
            {
                loop_hits += 1;
                if loop_hits >= LOOP_MAX_HITS {
                    println!("🛑 LLM зациклилась — останавливаю генерацию");
                    break;
                }
            }

            let piece = self
                .tokenizer
                .decode(&[tok], true)
                .map_err(|e| anyhow::anyhow!("Ошибка декодирования токена: {e}"))?;

            let piece = strip_think(&piece, &mut suppress_think);
            if piece.is_empty() {
                if context.len() - prompt_len >= token_budget {
                    break;
                }
                logits = self.engine.forward(&[tok], next_pos)?;
                next_pos += 1;
                continue;
            }

            text.push_str(&piece);

            if is_tool_call.is_none() {
                tool_probe.push_str(&piece);
                if tool_probe.trim_start().len() >= 6 {
                    let trimmed = tool_probe.trim_start();
                    is_tool_call = Some(trimmed.starts_with("<tool>"));
                }
            }

            // JSON инструмента уже валиден — продолжать незачем.
            if is_tool_call == Some(true) && crate::tools::tool_json_complete(&text) {
                println!("   ⏹ tool-JSON закрыт — генерация остановлена");
                break;
            }

            if is_tool_call == Some(true) {
                if context.len() - prompt_len >= token_budget {
                    break;
                }
                logits = self.engine.forward(&[tok], next_pos)?;
                next_pos += 1;
                continue;
            }

            buf.push_str(&piece);

            while let Some(pos) = find_chunk_end(&buf) {
                let sentence: String = buf.drain(..pos).collect();
                if sentence.contains("<tool>") || sentence.contains("</tool>") {
                    continue;
                }
                if speakable(&sentence) {
                    on_sentence(&sentence);
                    on_progress(&text);
                }
            }

            if buf.chars().count() > MAX_SENTENCE_CHARS
                && let Some(pos) = buf.rfind(' ')
            {
                let piece_flush: String = buf.drain(..pos + 1).collect();
                if !piece_flush.contains("<tool>")
                    && !piece_flush.contains("</tool>")
                    && speakable(&piece_flush)
                {
                    on_sentence(&piece_flush);
                    on_progress(&text);
                }
            }

            if context.len() - prompt_len >= token_budget {
                break;
            }
            if cancel.load(Ordering::SeqCst) {
                break;
            }

            logits = self.engine.forward(&[tok], next_pos)?;
            next_pos += 1;
        }

        if is_tool_call != Some(true) && !cancel.load(Ordering::SeqCst) {
            let tail = std::mem::take(&mut buf);
            if !tail.contains("<tool>") && !tail.contains("</tool>") && speakable(&tail) {
                on_sentence(&tail);
            }
        }

        let decoded = context.len() - prompt_len;
        let decode_ms = t_decode.elapsed().as_millis() as f64;
        println!(
            "   LLM: префилл {} ток. за {:.0?}, декод {} ток. за {:.0?} ({:.1} мс/ток.)",
            prompt_len,
            t_prefill,
            decoded,
            decode_ms,
            if decoded > 0 {
                decode_ms / decoded as f64
            } else {
                0.0
            }
        );

        self.prefix_cache = context[..next_pos.min(context.len())].to_vec();

        Ok(text)
    }
}

#[cfg(test)]
mod tests {
    use super::generation_budget;

    #[test]
    fn zero_max_tokens_means_no_artificial_cap() {
        // 0 — весь остаток контекста (минус 8 токенов запаса на закрытие).
        assert_eq!(generation_budget(8192, 100, 0), 8084);
        // Ненулевое значение — страховочный кап.
        assert_eq!(generation_budget(8192, 100, 256), 256);
        // Контекст — жёсткая граница: кап не выходит за остаток.
        assert_eq!(generation_budget(8192, 8000, 256), 184);
        assert_eq!(generation_budget(8192, 8100, 0), 84);
        // Промпт занял весь контекст — бюджета нет (вызывающий даёт ошибку).
        assert_eq!(generation_budget(8192, 8192, 0), 0);
    }
}
