<file path="crates/jarvis-core/examples/chat_probe.rs">
//! Проба чат-ветки LLM: тот же системный промпт, что собирает `llm::ask`,
//! те же вопросы, на которых пользователь поймал отказы.
//!
//! Запуск: cargo run --release -p jarvis-core --example chat_probe [old] [l]
//! По умолчанию — промпт, который отправляет бэкенду uzu
//! (UZU_CHAT_SYSTEM_PROMPT); аргумент `old` — старый жёсткий промпт для
//! сравнения. Аргумент `l` переключает модель на 8-битную qwen3.5-2b-mirai-l.

use anyhow::Result;
use jarvis_core::events::JarvisEvent;
use jarvis_core::llm::config as llm_config;
use jarvis_core::llm::{self, SharedLlmState};
use std::sync::Arc;
use std::sync::atomic::AtomicBool;
use std::sync::mpsc::channel;
use std::time::Instant;

fn main() -> Result<()> {
    let args: Vec<String> = std::env::args().collect();
    let old_prompt = args.iter().any(|a| a == "old");
    let l8 = args.iter().any(|a| a == "l");

    let (events_tx, events_rx) = channel::<JarvisEvent>();
    std::thread::spawn(move || {
        for ev in events_rx {
            match ev {
                JarvisEvent::LlmStatus { status } => println!("🧠 LLM: {status}"),
                JarvisEvent::Log { message } => println!("ℹ️  {message}"),
                JarvisEvent::Error { message } => eprintln!("❗ {message}"),
                _ => {}
            }
        }
    });

    let settings = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())?;
    settings.apply();
    if l8 {
        jarvis_core::llm::config::set_model_name("qwen3.5-2b-mirai-l");
    }
    println!(
        "ℹ️  llm_backend = {}, llm_model = {}, промпт = {}",
        llm_config::backend(),
        llm_config::model_name(),
        if old_prompt {
            "old (CHAT_SYSTEM_PROMPT)"
        } else {
            "uzu (UZU_CHAT_SYSTEM_PROMPT)"
        }
    );

    let shared = Arc::new(SharedLlmState::new());
    llm::spawn_llm_loader(&shared, &events_tx);

    let cancel = Arc::new(AtomicBool::new(false));
    let mut turns: Vec<(String, String)> = Vec::new();

    let asked = |shared: &Arc<SharedLlmState>,
                 history: &[(String, String)],
                 question: &str,
                 cancel: &Arc<AtomicBool>|
     -> String {
        // Как в llm::ask: промпт честности выбирается под бэкенд; `old`
        // принуждает старый жёсткий вариант для сравнения.
        let base = if old_prompt {
            llm::CHAT_SYSTEM_PROMPT.to_string()
        } else {
            llm::UZU_CHAT_SYSTEM_PROMPT.to_string()
        };
        let system = format!(
            "{}\nСегодняшняя дата: {}.\nЕсли просьба совпадает с командой пользователя, \
             вызови run_command с её именем; иначе просто ответь.",
            base,
            jarvis_core::text::today_russian()
        );
        let started = Instant::now();
        let answer = llm::generate_blocking(shared, &system, history, question, cancel)
            .map_err(|e| eprintln!("❗ {e:#}"))
            .unwrap_or_default();
        println!("\n❓ {question}");
        println!("🤖 {answer}");
        println!("⏱  {:.1?}", started.elapsed());
        answer
    };

    for question in [
        "Что такое язык раст?",
        "Что такое Rust?",
        "Сколько будет восемь умножить на тринадцать?",
        "Кто написал «Мастера и Маргариту»?",
    ] {
        let answer = asked(&shared, &turns, question, &cancel);
        turns.push((question.to_string(), answer));
    }

    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/llm_bench.rs">
//! Замер LLM: префилл и время до первого куска речи (то, что слышит
//! пользователь). Сравнивает короткий чат-промпт и веб-сводку из 5/3
//! результатов — видно, сколько стоит контекст поиска.
//!
//! Запуск: cargo run --release --example llm_bench -p jarvis-core
//! Бэкенд и модель берутся из settings.toml (`llm_backend`, `llm_model`);
//! первые два аргумента переопределяют их для сравнения:
//! `... --example llm_bench -- uzu qwen3.5-0.8b`.

use anyhow::Result;
use jarvis_core::llm::{self, ChatTurn, SharedLlmState, config::GenerationParams};
use std::sync::Arc;
use std::sync::atomic::AtomicBool;
use std::time::Instant;

fn web_prompt(hits: usize, snippet_chars: usize) -> String {
    let mut context = String::new();
    for i in 0..hits {
        let snippet = "В Москве сегодня облачно, температура около минус трёх градусов, ветер пять метров в секунду, к вечеру похолодает до минус семи."
            .chars()
            .take(snippet_chars)
            .collect::<String>();
        context.push_str(&format!(
            "[{}] Погода в Москве на сегодня — прогноз\n{}\n\n",
            i + 1,
            snippet
        ));
    }
    format!(
        "Результаты поиска в интернете по запросу «какая сегодня погода в москве»:\n\n{context}На основе этих результатов ответь на вопрос пользователя. Кратко: 1-3 предложения, только суть, на русском языке."
    )
}

fn run(engine: &mut llm::LlmEngine, name: &str, prompt: &str) -> Result<()> {
    let started = Instant::now();
    let mut first_chunk: Option<std::time::Duration> = None;
    let mut chunks = 0usize;
    let cancel = AtomicBool::new(false);
    let text = engine.generate_streaming_with_params(
        llm::WEB_SYSTEM_PROMPT,
        &[] as &[ChatTurn],
        prompt,
        Some(GenerationParams {
            temperature: 0.2,
            top_p: 0.9,
            max_tokens: 120,
            ..Default::default()
        }),
        &cancel,
        |chunk| {
            chunks += 1;
            if first_chunk.is_none() {
                first_chunk = Some(started.elapsed());
                println!(
                    "   первый кусок TTS: {:?} ({} симв.)",
                    started.elapsed(),
                    chunk.chars().count()
                );
            }
        },
        |_| {},
    )?;
    println!(
        "  {name}: всего {:?}, кусков TTS {chunks}, ответ {} симв.: {}",
        started.elapsed(),
        text.chars().count(),
        text.chars().take(90).collect::<String>()
    );
    Ok(())
}

fn main() -> Result<()> {
    // Настройки из settings.toml, затем необязательные переопределения
    // аргументами: `llm_bench [backend] [model]`.
    let settings = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())?;
    settings.apply();
    let mut args = std::env::args().skip(1);
    if let Some(backend) = args.next() {
        llm::config::set_backend(&backend);
    }
    if let Some(model) = args.next() {
        llm::config::set_model_name(&model);
    }
    println!(
        "ℹ️  llm_backend = {}, llm_model = {}",
        llm::config::backend(),
        llm::config::model_name()
    );

    let shared: llm::SharedLlm = Arc::new(SharedLlmState::new());
    let (tx, _rx) = std::sync::mpsc::channel();
    llm::spawn_llm_loader(&shared, &tx);
    println!("⏳ жду модель...");
    let t = Instant::now();
    let mut guard = loop {
        let guard = shared.engine.lock().unwrap_or_else(|e| e.into_inner());
        if guard.is_some() {
            break guard;
        }
        if shared.failed.load(std::sync::atomic::Ordering::SeqCst) {
            anyhow::bail!("модель не загрузилась");
        }
        drop(guard);
        std::thread::sleep(std::time::Duration::from_millis(200));
    };
    println!("модель готова за {:?}", t.elapsed());
    let engine = guard.as_mut().expect("модель");

    // Прогревающий прогон (прогрев Metal/кэшей)
    run(engine, "прогрев", "Скажи одно слово: привет.")?;

    run(engine, "чат (короткий промпт)", "Как дела?")?;
    run(engine, "веб 5×220 симв.", &web_prompt(5, 220))?;
    run(engine, "веб 3×140 симв.", &web_prompt(3, 140))?;
    run(engine, "веб 3×90 симв.", &web_prompt(3, 90))?;
    Ok(())
}
</file>

<file path="crates/jarvis-core/examples/llm_smoke.rs">
//! Смоук-тест LLM-бэкенда из settings.toml: инициализация, (при первом
//! запуске — скачивание модели) и один вопрос-ответ.
//!
//! Запуск: cargo run --release -p jarvis-core --example llm_smoke

use anyhow::Result;
use jarvis_core::events::JarvisEvent;
use jarvis_core::llm::config as llm_config;
use jarvis_core::llm::{self, SharedLlmState};
use std::sync::Arc;
use std::sync::atomic::AtomicBool;
use std::sync::mpsc::channel;
use std::time::Instant;

fn main() -> Result<()> {
    let (events_tx, events_rx) = channel::<JarvisEvent>();
    std::thread::spawn(move || {
        for ev in events_rx {
            match ev {
                JarvisEvent::LlmStatus { status } => println!("🧠 LLM: {status}"),
                JarvisEvent::Log { message } => println!("ℹ️  {message}"),
                JarvisEvent::Error { message } => eprintln!("❗ {message}"),
                _ => {}
            }
        }
    });

    let settings = jarvis_core::settings::Settings::load(&jarvis_core::paths::settings_file())?;
    settings.apply();
    println!(
        "ℹ️  llm_backend = {}, llm_model = {}",
        llm_config::backend(),
        llm_config::model_name()
    );

    let shared = Arc::new(SharedLlmState::new());
    llm::spawn_llm_loader(&shared, &events_tx);

    let cancel = Arc::new(AtomicBool::new(false));
    // Два хода с настоящей историей: второй проверяет дельта-префилл сессии
    // (общий префикс system+история переиспользуется), третий — что модель
    // по инструкцией промпта выдаёт tool-блок в нашем формате.
    let mut turns: Vec<(String, String)> = Vec::new();
    let asked = |shared: &Arc<SharedLlmState>,
                 system: &'static str,
                 history: &[(String, String)],
                 question: &str,
                 cancel: &Arc<AtomicBool>|
     -> String {
        let started = Instant::now();
        let answer = llm::generate_blocking(shared, system, history, question, cancel)
            .map_err(|e| eprintln!("❗ {e:#}"))
            .unwrap_or_default();
        println!("\n❓ {question}");
        println!("🤖 {answer}");
        println!("⏱  {:.1?}", started.elapsed());
        answer
    };

    let a1 = asked(
        &shared,
        llm::CHAT_SYSTEM_PROMPT,
        &turns,
        "Привет! Кто ты?",
        &cancel,
    );
    turns.push(("Привет! Кто ты?".to_string(), a1.clone()));
    let a2 = asked(
        &shared,
        llm::CHAT_SYSTEM_PROMPT,
        &turns,
        "Что я только что спросил? Ответь одной фразой.",
        &cancel,
    );
    turns.push((
        "Что я только что спросил? Ответь одной фразой.".to_string(),
        a2,
    ));
    let a3 = asked(
        &shared,
        llm::CHAT_SYSTEM_PROMPT,
        &turns,
        "Поставь таймер на 5 минут",
        &cancel,
    );
    println!("🔧 tool-блок в ответе: {}", a3.contains("<tool>"));

    Ok(())
}
