$os=Get-CimInstance Win32_OperatingSystem;
('OS:{0} {1}, Arch:{2}' -f $os.Caption.Trim(), $os.Version, $env:PROCESSOR_ARCHITECTURE)
"#;
    ps_run(script).unwrap_or_else(|_| "Информация недоступна".to_string())
}

