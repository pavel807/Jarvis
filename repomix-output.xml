pub fn set_volume(percent: u8) -> bool {
    let scalar = (percent as f32 / 100.0).clamp(0.0, 1.0);
    let script = format!("{VOLUME_CS}[JA.VolumeControl]::Set({scalar:.2}f); 'OK'");
    matches!(ps_run(&script).as_deref(), Ok("OK"))
}

