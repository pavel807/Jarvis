        assert_eq!(media_vk("next"), 0xB0);
        assert_eq!(media_vk("previous"), 0xB1);
        assert_eq!(media_vk("stop"), 0xB2);
        assert_eq!(media_vk("pause"), 0xB3);
        assert_eq!(media_vk("play"), 0xB3);
    }
