$m=@(Get-CimInstance -Namespace root/WMI -ClassName WmiMonitorBrightnessMethods -ErrorAction Stop);
if ($m.Count -eq 0) {{ throw 'нет управляемого дисплея' }};
$m | ForEach-Object {{ $null = $_.WmiSetBrightness(1, {percent}) }};
