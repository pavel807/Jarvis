  /** Пять разделов нижней панели — больше в окно 400px не помещается осмысленно. */
  const TABS = [
    { key: "dashboard", title: "Главная", icon: "home" },
    { key: "commands", title: "Команды", icon: "commands" },
    { key: "voice", title: "Голос", icon: "speaker" },
    { key: "settings", title: "Настройки", icon: "gear" },
    { key: "more", title: "Ещё", icon: "more" },
  ];

  const TITLES: Record<string, string> = {
    dashboard: "J.A.R.V.I.S.",
    commands: "Команды",
    voice: "Голос",
    settings: "Настройки",
    more: "Ещё",
    chat: "Текстовый чат",
    wakeword: "Обучение «Джарвис»",
    help: "Помощь",
  };

  const assistant = $derived(getAssistant());
  const isSubPage = $derived(SUB_PAGES.includes(store.page));
  /** Подразделы подсвечивают вкладку «Ещё» — так понятно, где вы находитесь. */
  const activeTab = $derived(isSubPage ? "more" : store.page);
  const isLive = $derived(
    assistant.tone === "live" || assistant.tone === "busy" || assistant.tone === "speaking",
  );

  /** Перебить Джарвиса можно в один клик, а не только голосом «замолчи». */
  async function hush() {
    try {
      await invoke("llm_cancel");
    } catch {
      // движок ещё не поднят — перебивать нечего
    }
  }

  /** Кнопка в меню доступа к микрофону — сразу на нужную панель настроек. */
  async function openMicSettings() {
    try {
      await invoke("open_mic_settings");
    } catch {
      toast("Не удалось открыть Системные настройки", "err");
    }
  }

  const toastIcon = { ok: "check", err: "alert", info: "info" } as const;

  onMount(() => {
    void initEvents();
  });
</script>

