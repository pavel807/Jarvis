      </div>
      <button class="btn btn--primary btn--block" disabled={!engineReady} onclick={() => (step = 1)}>
        {engineReady ? "Дальше" : "Жду готовности…"}
      </button>
    {:else if step === 1}
      <h1 class="ob-title">Кто будет отвечать?</h1>
      <p class="ob-sub">
