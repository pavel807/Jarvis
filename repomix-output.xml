        assert!(!p.starts_with('~'));
        assert!(p.contains("Documents"));
    }

    #[test]
    fn humanize_basic() {
        assert_eq!(humanize_seconds(10), "10 секунд");
        assert_eq!(humanize_seconds(60), "1 минуту");
        assert_eq!(humanize_seconds(600), "10 минут");
        assert_eq!(humanize_seconds(3600), "1 час");
    }

    /// Регрессия на живой случай: «поставь на паузу» при пустой «Музыке»
    /// отвечало «Поставил на паузу», хотя музыка продолжала играть в браузере.
    /// Ложный успех недопустим — лучше честное «останавливать нечего».
    #[cfg(target_os = "macos")]
    #[test]
    fn music_control_never_fakes_success() {
        // Если что-то играет (или источник не читается), проверять ложный
        // успех нельзя: тест не должен трогать чужую музыку.
        match current_music_target() {
            Ok(None) => {}
            Ok(Some(target)) => {
                eprintln!("⚠️ играет {target:?} — проверка ложного успеха пропущена");
                return;
            }
            Err(reason) => {
                eprintln!("⚠️ источник не читается ({reason}) — проверка пропущена");
                return;
            }
        }
        let pause = music_control_impl("pause");
        assert!(!pause.ok, "пауза без музыки не может быть успехом");
        assert!(
            pause.speech.contains("нечего"),
            "нужна честная причина, получено: {}",
            pause.speech
        );
        let stop = music_control_impl("stop");
        assert!(!stop.ok, "стоп без музыки не может быть успехом");
    }

    #[test]
    fn browser_media_script_matches_the_browser() {
        // Chromium-браузеры получают javascript в активной вкладке, Safari —
        // другой синтаксис и приведение к тексту (иначе osascript отдаёт объект).
        let chrome = Browser::Chrome.script("return 1");
        assert!(chrome.contains("Google Chrome"), "{chrome}");
        assert!(chrome.contains("active tab javascript"), "{chrome}");
        let safari = Browser::Safari.script("return 1");
        assert!(safari.contains("do JavaScript"), "{safari}");
        assert!(safari.contains("as text"), "{safari}");
        // Firefox управлять так нельзя — скрипта нет, и мы обязаны это знать.
        assert!(Browser::Firefox.script("return 1").is_empty());
    }

    #[test]
    fn media_control_skips_browsers_that_are_not_running() {
        // Не запущенный браузер = None: osascript не зовём и чужую музыку
        // не трогаем, даже если она играет где-то ещё.
        if !is_app_running("Safari") {
            assert!(control_browser_media(Browser::Safari, "pause").is_none());
        }
        // Firefox не управляется никогда, даже если запущен.
        assert!(control_browser_media(Browser::Firefox, "pause").is_none());
    }

    #[test]
    fn read_lines_are_numbered_and_paged() {
        let content = "a\nb\nc\nd\n";
        assert_eq!(read_lines(content, None, None), "1| a\n2| b\n3| c\n4| d");
        // Вторая страница по две строки: модель видит, откуда продолжать.
        let page = read_lines(content, None, Some(2));
        assert!(page.starts_with("1| a\n2| b"), "{page}");
        assert!(page.contains("offset=3"), "{page}");
        assert_eq!(read_lines(content, Some(3), Some(2)), "3| c\n4| d");
        assert_eq!(read_lines("", None, None), "Файл пустой");
        // Строка длиннее лимита обрезается, а не рвёт вывод.
        let long = "x".repeat(500);
        let out = read_lines(&long, None, None);
        assert!(out.ends_with('…'), "длинная строка должна обрезаться");
    }

    #[test]
    fn apply_edit_refuses_to_guess() {
        let content = "fn main() {\n    println!(\"привет\");\n}\n";
        // Точная замена работает.
        let (updated, count) = apply_edit(content, "привет", "пока", false).unwrap();
        assert_eq!(count, 1);
        assert!(updated.contains("пока"));
        // Отсутствующий фрагмент — честная ошибка, а не молчаливый «успех».
        let missing = apply_edit(content, "нет такого", "x", false).unwrap_err();
        assert!(missing.contains("не найден"), "{missing}");
        // Неоднозначный фрагмент без all=true тоже отклоняется.
        let ambiguous = apply_edit("a a", "a", "b", false).unwrap_err();
        assert!(ambiguous.contains("2 раз"), "{ambiguous}");
        let (all, count) = apply_edit("a a", "a", "b", true).unwrap();
        assert_eq!((all.as_str(), count), ("b b", 2));
        // Пустой old — защита от затирания файла целиком.
        assert!(apply_edit(content, "", "x", false).is_err());
    }

