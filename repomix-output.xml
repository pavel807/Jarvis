    ("open_link", "open_url"),
    ("open_website", "open_url"),
    ("open_site", "open_url"),
    ("open_web", "open_url"),
    ("browse", "open_url"),
    ("browse_url", "open_url"),
    ("go_to", "open_url"),
    ("goto", "open_url"),
    ("navigate", "open_url"),
