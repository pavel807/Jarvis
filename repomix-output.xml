                    };
                    DesktopAction::Scroll { direction, amount: arg_u64(args, &["amount", "steps", "количество"]).unwrap_or(3).min(50) as u8 }
                }
                other => return Err(format!("неизвестное действие desktop_input: {other}")),
            };
            ToolCall::DesktopInput { action }
