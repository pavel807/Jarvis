                        .ok_or_else(|| format!("для клика указаны не все координаты: {CLICK_HINT}"))?;
                    let button = match arg_str(args, &["button", "кнопка"]).unwrap_or(if action == "right_click" { "right" } else { "left" }).to_lowercase().as_str() {
