            other => panic!("unexpected: {other:?}"),
        }
        // «Останови» — не то же самое, что «пауза»: трек уходит в начало.
        for (raw, expected) in [
            ("Останови", "stop"),
            ("стоп", "stop"),
            ("выключи музыку", "stop"),
            ("продолжи", "play"),
            ("дальше", "next"),
