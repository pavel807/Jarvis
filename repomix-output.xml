<file path="app/src/components/ArcReactor.svelte">
<script lang="ts">
  import { onMount } from "svelte";

  /**
   * Живая масса — центральный элемент главного экрана.
   *
   * Механики больше нет: вместо реактора с рамой и кольцами остаётся
   * только жидкая плазменная масса, собранная так, как раньше собиралось
   * нутро ядра:
   *  - белое смещённое ядро-зрачок внутри багровой плазмы с латунью;
   *  - тёмные завихрения и сгустки, которые медленно дрейфуют по орбитам;
   *  - капли и усики поверхностного натяжения: отрываются от края
   *    и снова втягиваются в массу;
   *  - двойной удар сердца раз в 3,2 секунды, расходящийся волной.
   *
   * Масса живёт: в покое дышит и переливается, на голос отвечает
   * вспышками капель и амплитудой жидкости, при озвучке наливается светом.
   */
  let {
    state = "idle",
    level = 0,
    thinking = false,
    speaking = false,
  }: {
    state?: "disconnected" | "idle" | "active";
    /// Уровень звука 0..1 с микрофона или TTS.
    level?: number;
    /// LLM обрабатывает запрос: по рёбрам идёт сканирующая волна.
    thinking?: boolean;
    /// Джарвис озвучивает ответ: масса наливается светом, даже когда нет уровня TTS.
    speaking?: boolean;
  } = $props();

  let canvas: HTMLCanvasElement | null = null;

  // Сглаженные уровни — та же модель, что была у спектрограммы: быстрая
  // атака, медленное затухание, короткая задержка пика.
  let liveLevel = 0;
  let attackLevel = 0;
  let targetLevel = 0;
  let peakLevel = 0;
  let peakTime = 0;
  let thinkLevel = 0;
  let speakLevel = 0;
  let lastEventTime = 0;

  const VOICE_GATE = 0.03;
  const EVENT_TIMEOUT_MS = 220;
  const PEAK_HOLD_MS = 260;

  $effect(() => {
    const v = level;
    lastEventTime = performance.now();

    if (v < VOICE_GATE) {
      targetLevel = 0;
      peakLevel = 0;
      return;
    }
    const norm = Math.max(0, Math.min(1, (v - VOICE_GATE) * 11));
    targetLevel = norm;

    if (norm > peakLevel) {
      peakLevel = norm;
      peakTime = lastEventTime;
    }
  });

  const STATE_INTENSITY: Record<string, number> = {
    disconnected: 0.3,
    idle: 0.62,
    active: 1,
  };

  /** Значение CSS-токена с запасным вариантом: тема может ещё не примениться. */
  function cssColor(el: Element, token: string, fallback: string): string {
    const value = getComputedStyle(el).getPropertyValue(token).trim();
    return value || fallback;
  }

  /** CSS-цвет с прозрачностью: canvas принимает rgba, токены — hex. */
  function hexAlpha(color: string, alpha: number): string {
    const a = Math.max(0, Math.min(1, alpha));
    const hex = color.trim();
    if (!hex.startsWith("#") || hex.length !== 7) {
      return `rgba(240, 56, 68, ${a})`;
    }
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r}, ${g}, ${b}, ${a})`;
  }

  function circlePath(ctx: CanvasRenderingContext2D, x: number, y: number, r: number) {
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
  }

  /**
   * Жидкий контур ядра. Три несоизмеримые гармоники дают не «круг с
   * вырезами», а настоящее поверхностное натяжение: край всё время
   * перетекает, ни одна точка не повторяет предыдущий кадр.
   */
  function fluidPath(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    radius: number,
    time: number,
    wobble: number,
    points = 72,
  ) {
    ctx.beginPath();
    for (let i = 0; i <= points; i++) {
      const a = (i / points) * Math.PI * 2;
      const wave =
        Math.sin(a * 3 + time * 1.45) * 0.52 +
        Math.sin(a * 5 - time * 1.1 + 1.7) * 0.28 +
        Math.sin(a * 7 + time * 0.72 + 4.1) * 0.14;
      const r = radius * (1 + wave * wobble);
      const px = x + Math.cos(a) * r;
      const py = y + Math.sin(a) * r;
      if (i === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.closePath();
  }

  onMount(() => {
    const el = canvas;
    if (!el) return;

    const ctx = el.getContext("2d");
    if (!ctx) return;

    const wrap = el.parentElement;
    if (!wrap) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let W = 0;
    let H = 0;
    let dpr = 1;

    const resize = () => {
      W = wrap.clientWidth;
      H = wrap.clientHeight;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      el.width = Math.round(W * dpr);
      el.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(wrap);

    // Палитра из токенов темы: реактор не живёт своей жизнью отдельно от неё.
    const accent = cssColor(el, "--accent", "#f03844");
    const accentStrong = cssColor(el, "--accent-strong", "#ffb08f");
    const coreColor = cssColor(el, "--core", "#fff9ef");
    const gold = cssColor(el, "--gold", "#e8b65e");
    const goldStrong = cssColor(el, "--gold-strong", "#ffdc95");
    const deep = cssColor(el, "--accent-deep", "#6c0b15");

    const clock = { t0: performance.now() };
    let raf = 0;
    let currentIntensity = STATE_INTENSITY[state] ?? 0.62;

    const draw = () => {
      const now = performance.now();
      const t = (now - clock.t0) / 1000;
      // При «уменьшить движение» замирает только механика колец;
      // реакция на голос остаётся — это обратная связь, а не декор.
      const spin = reduceMotion ? 0 : t;

      // ===== Детектор затишья =====
      const sinceLast = now - lastEventTime;
      if (sinceLast > EVENT_TIMEOUT_MS) {
        targetLevel = 0;
        peakLevel = 0;
      }
      const sincePeak = now - peakTime;
      const heldFloor =
        targetLevel > 0 && sincePeak < PEAK_HOLD_MS ? peakLevel * 0.3 : 0;
      if (sincePeak >= PEAK_HOLD_MS && peakLevel > 0) peakLevel = 0;

      const effectiveTarget = Math.max(targetLevel, heldFloor);
      const kLive = effectiveTarget > liveLevel ? 0.55 : 0.16;
      liveLevel += (effectiveTarget - liveLevel) * kLive;
      if (liveLevel < 0.015) liveLevel = 0;

      const rise = Math.max(0, effectiveTarget - liveLevel);
      attackLevel = Math.max(attackLevel * 0.78, Math.min(1, rise * 16));
      if (attackLevel < 0.015) attackLevel = 0;

      thinkLevel += ((thinking ? 1 : 0) - thinkLevel) * (thinking ? 0.14 : 0.05);

      const ti = STATE_INTENSITY[state] ?? 0.62;
      currentIntensity += (ti - currentIntensity) * 0.07;

      const act = currentIntensity;
      const voice = Math.min(1, liveLevel * 1.9 + attackLevel * 0.8);

      // Озвучка подтягивает массу даже без уровня TTS: тёплый медленный подъём.
      speakLevel +=
        ((speaking ? 0.8 : 0) - speakLevel) * (speaking ? 0.09 : 0.06);

      if (W === 0 || H === 0) {
        raf = requestAnimationFrame(draw);
        return;
      }

      const cx = W / 2;
      const cy = H / 2;
      const R = Math.max(24, Math.min(W, H) / 2 - 8);

      const breathe = 1 + Math.sin(t * 1.35) * 0.02 + voice * 0.045 + thinkLevel * 0.02;

      ctx.clearRect(0, 0, W, H);

      // ===== Атмосфера: реактор освещает сцену =====
      const amb = ctx.createRadialGradient(cx, cy, R * 0.05, cx, cy, R * 1.7);
      amb.addColorStop(0, hexAlpha(accent, 0.16 * act + 0.18 * voice));
      amb.addColorStop(0.42, hexAlpha(accent, 0.055 * act + 0.06 * voice));
      amb.addColorStop(0.76, hexAlpha(gold, 0.018 + 0.02 * act));
      amb.addColorStop(1, hexAlpha(gold, 0));
      ctx.fillStyle = amb;
      ctx.fillRect(0, 0, W, H);

      // ===== Масса: весь реактор, целиком жидкий =====
      // Двойной удар раз в 3,2 секунды — сердце, а не метроном.
      const beatPeriod = 3.2;
      const beatPhase = (t % beatPeriod) / beatPeriod;
      const beat =
        Math.exp(-Math.pow((beatPhase - 0.03) / 0.035, 2)) +
        0.55 * Math.exp(-Math.pow((beatPhase - 0.14) / 0.05, 2));
      const beatKick = beat * (0.25 + 0.75 * act) * (reduceMotion ? 0.35 : 1);

      const corePulse = breathe + beatKick * 0.032;
      // Масса — почти вся сцена: дыханию оставлен запас под капли и усики.
      const coreR = R * 0.8 * corePulse;
      // Жидкость всегда течёт; голос и мысль меняют натяжение поверхности.
      const wobble =
        (0.045 + 0.055 * voice + 0.02 * thinkLevel + 0.03 * speakLevel + 0.028 * beatKick) *
        (reduceMotion ? 0.38 : 1);

      // Ореол: багровое тепло у поверхности, латунная дымка — дальше.
      const haloR = coreR * (1.35 + 0.12 * voice);
      const halo = ctx.createRadialGradient(cx, cy, coreR * 0.35, cx, cy, haloR);
      halo.addColorStop(0, hexAlpha(accent, 0.13 + 0.16 * act + 0.12 * voice));
      halo.addColorStop(0.34, hexAlpha(accent, 0.065 + 0.06 * act + 0.05 * voice));
      halo.addColorStop(0.7, hexAlpha(gold, 0.025 + 0.018 * act));
      halo.addColorStop(1, hexAlpha(gold, 0));
      circlePath(ctx, cx, cy, haloR);
      ctx.fillStyle = halo;
      ctx.fill();

      // Вязкая оболочка: даже в покое край массы неровный и чуть светится.
      fluidPath(ctx, cx, cy, coreR * 1.13, t * 0.72, wobble * 1.5, 76);
      const skin = ctx.createRadialGradient(
        cx,
        cy,
        coreR * 0.62,
        cx,
        cy,
        coreR * 1.2,
      );
      skin.addColorStop(0, hexAlpha(accent, 0));
      skin.addColorStop(0.68, hexAlpha(accent, 0.018 + 0.025 * act));
      skin.addColorStop(0.92, hexAlpha(gold, 0.03 + 0.035 * (voice + 0.6 * speakLevel)));
      skin.addColorStop(1, hexAlpha(gold, 0));
      ctx.fillStyle = skin;
      ctx.fill();

      // Капли, которые жидкость выбрасывает за край. Они рождаются,
      // отлетают и снова втягиваются — поэтому ядро не «пульсирует», а живёт.
      for (let k = 0; k < 11; k++) {
        const life = (spin * 0.11 + k * 0.173) % 1;
        const a =
          k * 2.399 + spin * (0.1 + k * 0.012) + Math.sin(spin * 0.6 + k) * 0.22;
        const dist = coreR * (1.03 + life * (0.16 + 0.1 * voice));
        const size =
          coreR * (0.015 + 0.012 * (0.5 + 0.5 * Math.sin(k * 2.1 + spin * 1.4))) *
          (1 - life * 0.55);
        const dropColor =
          k % 3 === 0 ? goldStrong : k % 3 === 1 ? coreColor : accentStrong;
        const dropAlpha =
          Math.pow(1 - life, 1.7) * (0.18 + 0.35 * voice + 0.24 * act);
        if (size <= 0.25 || dropAlpha <= 0.015) continue;
        ctx.fillStyle = hexAlpha(dropColor, dropAlpha);
        circlePath(
          ctx,
          cx + Math.cos(a) * dist,
          cy + Math.sin(a) * dist,
          size,
        );
        ctx.fill();
      }

      // Жидкие усики: поверхностное натяжение тянется к эмиттерному кольцу.
      ctx.save();
      ctx.lineCap = "round";
      for (let k = 0; k < 5; k++) {
        const a =
          spin * (0.1 + k * 0.014) + k * 1.256 + Math.sin(spin * 0.5 + k * 1.7) * 0.2;
        const edge = coreR * (1.01 + 0.03 * Math.sin(spin * 1.3 + k));
        const len =
          coreR * (0.05 + 0.13 * voice + 0.07 * attackLevel + 0.05 * beatKick);
        const swing = 0.22 + 0.12 * Math.sin(spin * 0.7 + k * 2.1);
        const tipA = a + swing * 0.34;
        const alpha = (0.08 + 0.2 * voice + 0.1 * act) * (0.5 + 0.5 * Math.sin(k * 1.9));

        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(a) * edge, cy + Math.sin(a) * edge);
        ctx.quadraticCurveTo(
          cx + Math.cos(a + swing) * (edge + len * 1.35),
          cy + Math.sin(a + swing) * (edge + len * 1.35),
          cx + Math.cos(tipA) * (edge + len),
          cy + Math.sin(tipA) * (edge + len),
        );
        ctx.strokeStyle = hexAlpha(k === 2 ? goldStrong : accentStrong, alpha);
        ctx.lineWidth = 1.1 + 2.2 * voice + 0.5 * beatKick;
        ctx.stroke();

        // Белая сердцевина усика: жидкость, а не пламя.
        ctx.strokeStyle = hexAlpha(coreColor, alpha * 0.45);
        ctx.lineWidth = 0.55;
        ctx.stroke();
      }
      ctx.restore();

      // Жидкое тело ядра: волнистая граница, смещённый белый зрачок,
      // багровый край. Тень даёт ореол, не размывая форму.
      ctx.save();
      fluidPath(ctx, cx, cy, coreR, t * 1.08, wobble, 84);
      const coreG = ctx.createRadialGradient(
        cx - coreR * 0.2,
        cy - coreR * 0.24,
        coreR * 0.02,
        cx,
        cy,
        coreR * 1.08,
      );
      coreG.addColorStop(0, `rgba(255, 255, 255, ${0.34 + 0.62 * act})`);
      coreG.addColorStop(0.14, hexAlpha(coreColor, 0.42 + 0.53 * act + 0.1 * voice));
      coreG.addColorStop(0.38, hexAlpha(accentStrong, 0.3 + 0.4 * act + 0.12 * voice));
      coreG.addColorStop(0.64, hexAlpha(accent, 0.18 + 0.25 * act + 0.08 * voice));
      coreG.addColorStop(0.88, hexAlpha(deep, 0.45 + 0.12 * act));
      coreG.addColorStop(1, hexAlpha(deep, 0.32));
      ctx.fillStyle = coreG;
      ctx.shadowColor = hexAlpha(accent, 0.38 + 0.32 * voice + 0.1 * act);
      ctx.shadowBlur = 20 + 20 * voice + 10 * speakLevel + 8 * act + 6 * beatKick;
      ctx.fill();
      ctx.restore();

      // Латунная кромка и белый блик: жидкость собирает свет в верхней дуге.
      fluidPath(ctx, cx, cy, coreR, t * 1.08, wobble, 84);
      const rim = ctx.createLinearGradient(
        cx - coreR,
        cy - coreR,
        cx + coreR,
        cy + coreR,
      );
      rim.addColorStop(0, hexAlpha(coreColor, 0.62 + 0.18 * act));
      rim.addColorStop(0.3, hexAlpha(goldStrong, 0.4 + 0.2 * act));
      rim.addColorStop(0.62, hexAlpha(accentStrong, 0.2 + 0.16 * voice));
      rim.addColorStop(1, hexAlpha(accent, 0.08));
      ctx.strokeStyle = rim;
      ctx.lineWidth = 1.5 + 0.4 * voice;
      ctx.stroke();

      // Внутренность: плазма, завихрения, пузырьки и блик влажной поверхности.
      ctx.save();
      fluidPath(ctx, cx, cy, coreR, t * 1.08, wobble, 84);
      ctx.clip();

      // Тёмные завихрения дают глубину: масса не залита одним красным.
      for (let k = 0; k < 3; k++) {
        const ea = -spin * (0.17 + k * 0.045) + k * 2.2;
        const er = coreR * (0.28 + k * 0.09);
        const ex = cx + Math.cos(ea) * er * (0.45 + 0.2 * Math.sin(spin * 0.7 + k));
        const ey = cy + Math.sin(ea) * er * (0.45 + 0.2 * Math.cos(spin * 0.6 + k));
        const eddy = ctx.createRadialGradient(ex, ey, 0, ex, ey, coreR * (0.3 + k * 0.07));
        eddy.addColorStop(0, hexAlpha(deep, 0.16 + 0.06 * k));
        eddy.addColorStop(0.65, hexAlpha(deep, 0.06));
        eddy.addColorStop(1, hexAlpha(deep, 0));
        ctx.fillStyle = eddy;
        ctx.fillRect(cx - coreR, cy - coreR, coreR * 2, coreR * 2);
      }

      ctx.globalCompositeOperation = "lighter";

      // Мягкий блик сверху слева — главный признак жидкости.
      const caustic = ctx.createRadialGradient(
        cx - coreR * 0.3,
        cy - coreR * 0.36,
        coreR * 0.02,
        cx - coreR * 0.3,
        cy - coreR * 0.36,
        coreR * 0.9,
      );
      caustic.addColorStop(0, `rgba(255, 255, 255, ${0.1 + 0.12 * act})`);
      caustic.addColorStop(0.35, hexAlpha(coreColor, 0.06 + 0.06 * act));
      caustic.addColorStop(1, hexAlpha(coreColor, 0));
      ctx.fillStyle = caustic;
      ctx.fillRect(cx - coreR, cy - coreR, coreR * 2, coreR * 2);

      // Шесть сгустков плазмы на разных орбитах, один из них латунный.
      for (let k = 0; k < 6; k++) {
        const direction = k % 2 === 0 ? 1 : -1;
        const a =
          spin * direction * (0.24 + k * 0.038) + k * 1.73 + Math.sin(spin * 0.4 + k) * 0.3;
        const rad = coreR * (0.12 + 0.28 * (0.5 + 0.5 * Math.sin(spin * 0.55 + k * 1.8)));
        const lx = cx + Math.cos(a) * rad;
        const ly = cy + Math.sin(a) * rad;
        const lobeR =
          coreR * (0.34 + 0.16 * (0.5 + 0.5 * Math.sin(spin * 0.8 + k * 1.1))) *
          (1 + 0.14 * voice);
        const bloom =
          (0.14 + 0.22 * voice + 0.1 * speakLevel + 0.08 * beatKick) *
          (0.35 + 0.65 * act);
        const lobeColor = k === 3 ? goldStrong : k === 5 ? coreColor : accentStrong;
        const lobe = ctx.createRadialGradient(lx, ly, 0, lx, ly, lobeR);
        lobe.addColorStop(0, hexAlpha(coreColor, bloom * 0.9));
        lobe.addColorStop(0.3, hexAlpha(lobeColor, bloom * 0.62));
        lobe.addColorStop(0.7, hexAlpha(accent, bloom * 0.2));
        lobe.addColorStop(1, hexAlpha(accent, 0));
        ctx.fillStyle = lobe;
        ctx.fillRect(cx - coreR, cy - coreR, coreR * 2, coreR * 2);
      }

      // Влажные блики на поверхности: короткие дуги, которые ловят свет.
      for (let k = 0; k < 3; k++) {
        const ha = spin * (0.2 + k * 0.06) * (k % 2 === 0 ? 1 : -1) + k * 2.4;
        const hr = coreR * (0.52 + 0.12 * k + 0.03 * Math.sin(spin * 0.8 + k));
        const span = 0.42 + 0.26 * Math.sin(spin * 0.6 + k * 1.7);
        ctx.strokeStyle = hexAlpha(
          k === 1 ? goldStrong : coreColor,
          (0.08 + 0.16 * act + 0.09 * voice) * (0.6 + 0.4 * Math.sin(k + spin)),
        );
        ctx.lineWidth = 1.8 + 1.1 * voice;
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.arc(cx, cy, hr, ha, ha + span);
        ctx.stroke();
      }

      // Спиральные волокна: след того, как жидкость закручивается внутрь.
      for (let k = 0; k < 4; k++) {
        const dir = k % 2 === 0 ? 1 : -1;
        const start = spin * dir * (0.4 + k * 0.1) + k * 1.9;
        const points = 22;
        ctx.beginPath();
        for (let j = 0; j <= points; j++) {
          const q = j / points;
          const rr = coreR * (0.06 + q * (0.78 + 0.035 * k));
          const aa = start + q * (1.15 + 0.2 * k) + Math.sin(spin * 0.9 + k) * 0.16;
          const px = cx + Math.cos(aa) * rr;
          const py = cy + Math.sin(aa) * rr;
          if (j === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = hexAlpha(
          k === 0 ? coreColor : k === 2 ? goldStrong : accentStrong,
          (0.09 + 0.15 * voice + 0.07 * thinkLevel) * (0.35 + 0.65 * act),
        );
        ctx.lineWidth = 0.8 + 0.5 * voice;
        ctx.stroke();
      }

      // Пузырьки пара: маленькие, тёплые, вспыхивают на голосе.
      for (let k = 0; k < 10; k++) {
        const a = -spin * (0.18 + k * 0.012) + k * 2.37;
        const rr = coreR * (0.16 + ((k * 37) % 100) / 155);
        const twinkle = 0.35 + 0.65 * Math.abs(Math.sin(spin * 2.1 + k * 3.3));
        const size = coreR * (0.009 + 0.014 * ((k * 53) % 100) / 100) * (0.8 + 0.5 * twinkle);
        ctx.fillStyle = hexAlpha(
          k % 4 === 0 ? goldStrong : coreColor,
          (0.05 + 0.3 * twinkle) * (0.2 + 0.8 * act + 0.15 * voice),
        );
        circlePath(ctx, cx + Math.cos(a) * rr, cy + Math.sin(a) * rr, size);
        ctx.fill();
      }

      // Белый зрачок смещён от центра: горячая точка жидкости, не иллюстрация.
      const pupilX = cx - coreR * 0.08 + Math.cos(spin * 0.7) * coreR * 0.045;
      const pupilY = cy - coreR * 0.1 + Math.sin(spin * 0.6) * coreR * 0.04;
      const pupil = ctx.createRadialGradient(pupilX, pupilY, 0, pupilX, pupilY, coreR * 0.28);
      pupil.addColorStop(0, `rgba(255, 255, 255, ${0.75 + 0.22 * act})`);
      pupil.addColorStop(0.28, hexAlpha(coreColor, 0.55 + 0.3 * act));
      pupil.addColorStop(1, hexAlpha(coreColor, 0));
      ctx.fillStyle = pupil;
      ctx.fillRect(cx - coreR, cy - coreR, coreR * 2, coreR * 2);

      ctx.restore();

      // Раскалённая точка в центре: не заливка, а источник.
      ctx.save();
      ctx.shadowColor = hexAlpha(coreColor, 0.95);
      ctx.shadowBlur = 10 + 24 * act + 30 * voice + 10 * thinkLevel + 8 * beatKick;
      circlePath(
        ctx,
        cx - coreR * 0.04,
        cy - coreR * 0.05,
        coreR * (0.08 + 0.018 * voice) * (1 + 0.08 * beatKick),
      );
      ctx.fillStyle = hexAlpha(coreColor, 0.3 + 0.7 * act);
      ctx.fill();
      ctx.restore();

      // Удар сердца расходится по жидкости волнистым кольцом.
      if (!reduceMotion && beatPhase < 0.24) {
        const ripple = beatPhase / 0.24;
        fluidPath(ctx, cx, cy, coreR * (0.14 + ripple * 0.8), t * 0.8, wobble * 0.35, 56);
        ctx.strokeStyle = hexAlpha(coreColor, (1 - ripple) * 0.32 * (0.3 + 0.7 * act));
        ctx.lineWidth = 1.1;
        ctx.stroke();
      }

      // На каждом ударе кромка вспыхивает латунью — коротко, как отблеск.
      if (!reduceMotion && beatPhase < 0.2) {
        const flash = Math.pow(1 - beatPhase / 0.2, 2);
        fluidPath(ctx, cx, cy, coreR, t * 1.08, wobble, 84);
        ctx.strokeStyle = hexAlpha(goldStrong, flash * (0.12 + 0.25 * act));
        ctx.lineWidth = 2.2;
        ctx.stroke();
      }

      raf = requestAnimationFrame(draw);
    };

    raf = requestAnimationFrame(draw);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
    };
  });
</script>

<div class="reactor-wrap">
  <canvas bind:this={canvas} class="reactor-canvas"></canvas>
</div>

<style>
  .reactor-wrap {
    width: 100%;
    height: 100%;
    position: relative;
    background: transparent;
  }

  .reactor-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
