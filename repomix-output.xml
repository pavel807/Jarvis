/// Падеж для порядковых числительных (мужской род, единственное число).
#[derive(Clone, Copy)]
pub enum GramCase {
    Nom,
    Gen,
    Dat,
    Instr,
    Prep,
}

impl GramCase {
    fn idx(self) -> usize {
        match self {
            GramCase::Nom => 0,
            GramCase::Gen => 1,
            GramCase::Dat => 2,
            GramCase::Instr => 3,
            GramCase::Prep => 4,
        }
    }
}

