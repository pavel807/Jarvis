<file path="crates/jarvis-core/examples/wake_enroll.rs">
//! Дефолтный дикторонезависимый эталон «Джарвис» (.jref) по архитектуре
//! Few-Shot Metric Learning: позитивы — фраза разными дикторами Silero
//! (разные тембры и темпы), негативы — похожие по звучанию слова и тишина.
//! Готовый .jref выкладывается в релиз jarvis-models и качается движком;
//! после записи своих сэмплов эталон стоит переобучить в приложении.
//! Запуск: cargo run -p jarvis-core --example wake_enroll

use anyhow::{Context, Result};
use rustpotter::{EmbeddingConfig, EmbeddingDetector, FrameEmbedder};

const WINDOW_SAMPLES: usize = 16_000 * 12 / 10; // 1.2 с, как в боевом детекторе

fn read_window(path: &std::path::Path) -> anyhow::Result<Vec<f32>> {
    let mut reader = hound::WavReader::open(path)?;
    let spec = reader.spec();
    let raw: Vec<f32> = reader
        .samples::<i32>()
        .map(|s| s.unwrap() as f32 / (1 << (spec.bits_per_sample - 1)) as f32)
        .collect();
    let mono: Vec<f32> = if spec.channels == 1 {
        raw
    } else {
        raw.chunks(spec.channels as usize)
            .map(|c| c.iter().sum::<f32>() / spec.channels as f32)
            .collect()
    };
    let mono = jarvis_core::audio::resample_audio(&mono, spec.sample_rate as usize, 16_000);
    let window = 16_000 * 12 / 10;
    match mono.len().cmp(&window) {
        std::cmp::Ordering::Equal => Ok(mono),
        std::cmp::Ordering::Greater => {
            let extra = mono.len() - window;
            Ok(mono[extra / 2..extra / 2 + window].to_vec())
        }
        std::cmp::Ordering::Less => {
            let mut out = vec![0_f32; window];
            let start = (window - mono.len()) / 2;
            out[start..start + mono.len()].copy_from_slice(&mono);
            Ok(out)
        }
    }
}

fn main() -> Result<()> {
    jarvis_core::init_tuning();
    let engine = jarvis_core::tts_silero::SileroEngine::new_no_stress("ru_eduard")?;

    let write_window = |dir: &std::path::Path, name: &str, audio: &[f32]| -> Result<Vec<f32>> {
        std::fs::create_dir_all(dir)?;
        let mono = jarvis_core::audio::resample_audio(audio, 48_000, 16_000);
        // Пауза вокруг фразы — фраза живёт в середине боевого окна 1.2 с.
        let mut window = vec![0_f32; WINDOW_SAMPLES];
        let start = (WINDOW_SAMPLES - mono.len().min(WINDOW_SAMPLES / 2)) / 2;
        for (i, s) in mono.iter().take(WINDOW_SAMPLES - start).enumerate() {
            window[start + i] = *s;
        }
        let path = dir.join(format!("{name}.wav"));
        let spec = hound::WavSpec {
            channels: 1,
            sample_rate: 16_000,
            bits_per_sample: 16,
            sample_format: hound::SampleFormat::Int,
        };
        let mut writer = hound::WavWriter::create(&path, spec)?;
        for s in &window {
            writer.write_sample((s.clamp(-1.0, 1.0) * i16::MAX as f32) as i16)?;
        }
        writer.finalize()?;
        println!("🎙️ {name}: {}", path.display());
        Ok(window)
    };

    let train = jarvis_core::wake_train::sample_dirs().0;

    // --- Позитивы: «Джарвис» всеми дикторами Silero в трёх темпах ---
    // Чем шире покрытие тембров, тем выше шанс, что живой голос пользователя
    // ложится на ближайший эталон (счёт — максимум по позитивам).
    let voices: &[&str] = &[
        "ru_aigul",
        "ru_albina",
        "ru_alexandr",
        "ru_alfia",
        "ru_bogdan",
        "ru_dmitriy",
        "ru_eduard",
        "ru_ekaterina",
        "ru_gamat",
        "ru_igor",
        "ru_karina",
        "ru_kejilgan",
        "ru_kermen",
        "ru_marat",
        "ru_miyau",
        // ru_sibday исключён: не-русское произношение «Джарвис» ломает
        // шаблон (скор 0.51) — это кураторство данных, а не порог.
        "ru_nurgul",
        "ru_oksana",
        "ru_onaoy",
        "ru_ramilia",
        "ru_roman",
        "ru_safarhuja",
        "ru_saida",
        "ru_vika",
        "ru_zara",
        "ru_zhadyra",
        "ru_zhazira",
        "ru_zinaida",
    ];
    let tempos = [0.95_f32, 1.0, 1.05];
    const HOLD_OUT: usize = 4; // последних кураторских голосов — верификация
    let mut skipped = 0;
    // voice → его окна (до кураторства).
    let mut per_voice: Vec<(&str, Vec<Vec<f32>>)> = Vec::new();
    for voice in voices {
        let mut windows = Vec::new();
        for (k, speed) in tempos.iter().enumerate() {
            let Ok(audio) = engine.synthesize_with(voice, "Джарвис", *speed) else {
                skipped += 1;
                continue;
            };
            let window = write_window(&train, &format!("[jarvis]_default_{voice}_{k}"), &audio)?;
            windows.push(window);
        }
        if !windows.is_empty() {
            per_voice.push((voice, windows));
        }
    }

    // --- Кураторство: голос-аутсайдер (чьё «Джарвис» не похоже на
    // остальные) портит LOO-зазор — такой голос не в эталон. Похожество
    // голоса = max косинус его среднего (центрированного по словам) к
    // средним остальных голосов.
    let stt_probe = std::sync::Arc::new(std::sync::Mutex::new(jarvis_core::stt::Stt::load(
        &jarvis_core::paths::models_dir(),
    )?));
    // Размерность эмбеддинга берём из энкодера: хардкод 512 молча обрезал
    // бы средние через zip при любой другой модели (тихо, без ошибки).
    let dims =
        jarvis_core::wake::FastConformerEmbedder::new(std::sync::Arc::clone(&stt_probe)).dims();
    let voice_means: Vec<Vec<f32>> = per_voice
        .iter()
        .map(|(_, windows)| {
            let mut acc = vec![0_f32; dims];
            for w in windows {
                let mut e = jarvis_core::wake::FastConformerEmbedder::new(std::sync::Arc::clone(
                    &stt_probe,
                ))
                .embed(w)
                .expect("embed");
                rustpotter::l2_normalize(&mut e);
                for (a, x) in acc.iter_mut().zip(&e) {
                    *a += x;
                }
            }
            let n = windows.len() as f32;
            for x in acc.iter_mut() {
                *x /= n;
            }
            rustpotter::l2_normalize(&mut acc);
            acc
        })
        .collect();
    // Среднее направление слов-негативов для центрирования при кураторстве:
    // слова синтезируем здесь же (те же, что пойдут в негативы).
    let mut bg_mean = vec![0_f32; dims];
    let bg_words = [
        "сервис",
        "запись",
        "нравится",
        "привет",
        "музыка",
        "джаз",
        "джазовый",
        "джазист",
        "жарко",
        "завтрак",
        "джинсы",
        "сверстник",
        "университет",
        "маркетинг",
    ];
    let mut bg_count = 0;
    for text in bg_words {
        let Ok(audio) = engine.synthesize_with("ru_eduard", text, 1.0) else {
            continue;
        };
        let mono = jarvis_core::audio::resample_audio(&audio, 48_000, 16_000);
        let mut w = vec![0_f32; 16_000 * 12 / 10];
        let start = (w.len() - mono.len().min(w.len() / 2)) / 2;
        for (i, s) in mono.iter().take(w.len() - start).enumerate() {
            w[start + i] = *s;
        }
        let mut e =
            jarvis_core::wake::FastConformerEmbedder::new(std::sync::Arc::clone(&stt_probe))
                .embed(&w)
                .expect("embed");
        rustpotter::l2_normalize(&mut e);
        for (a, x) in bg_mean.iter_mut().zip(&e) {
            *a += x;
        }
        bg_count += 1;
    }
    if bg_count == 0 {
        anyhow::bail!(
            "ни одного фонового слова не синтезировалось — нечем центрировать эмбеддинги"
        );
    }
    for x in bg_mean.iter_mut() {
        *x /= bg_count as f32;
    }
    rustpotter::l2_normalize(&mut bg_mean);

    let voice_sim = |i: usize| -> f32 {
        let mut best = f32::NEG_INFINITY;
        for (j, m) in voice_means.iter().enumerate() {
            if j == i {
                continue;
            }
            // Центрированные голосовые средние: убираем общий фон слов.
            let mut a: Vec<f32> = voice_means[i]
                .iter()
                .zip(&bg_mean)
                .map(|(x, m)| x - m)
                .collect();
            let mut b: Vec<f32> = m.iter().zip(&bg_mean).map(|(x, m)| x - m).collect();
            rustpotter::l2_normalize(&mut a);
            rustpotter::l2_normalize(&mut b);
            best = best.max(a.iter().zip(&b).map(|(x, y)| x * y).sum::<f32>());
        }
        best
    };
    let sim_before: Vec<(String, f32)> = per_voice
        .iter()
        .enumerate()
        .map(|(i, (v, _))| (v.to_string(), voice_sim(i)))
        .collect();
    for (v, sim) in &sim_before {
        println!("🎙️ голос {v}: похожесть на остальные {sim:.3}");
    }
    const MIN_VOICE_SIM: f32 = 0.5;
    let kept: Vec<usize> = (0..per_voice.len())
        .filter(|&i| voice_sim(i) >= MIN_VOICE_SIM)
        .collect();
    let dropped: Vec<&str> = per_voice
        .iter()
        .enumerate()
        .filter(|(i, _)| voice_sim(*i) < MIN_VOICE_SIM)
        .map(|(_, (v, _))| *v)
        .collect();
    if !dropped.is_empty() {
        println!(
            "🗑️ Голоса-аутсайдеры (похожесть < {MIN_VOICE_SIM}): {}",
            dropped.join(", ")
        );
    }
    assert!(
        kept.len() >= 8,
        "после кураторства осталось {} голосов — нужно ≥ 8",
        kept.len()
    );
    let enrolled_count = kept.len().saturating_sub(HOLD_OUT);

    let mut positives = Vec::new();
    for (order, &vi) in kept.iter().enumerate() {
        let windows = &per_voice[vi].1;
        for window in windows {
            // Hold-out голоса идут в файлы для верификации, но НЕ в эталон:
            // их счёты — честная оценка на невиданных голосах.
            if order < enrolled_count {
                positives.push(window.clone());
            }
        }
    }
    println!(
        "🎙️ Позитивов в эталоне: {} (голосов {}, hold-out голосов: {HOLD_OUT}, пропущено: {skipped})",
        positives.len(),
        enrolled_count,
    );

    // --- Негативы: похожие по звучанию слова, шум, тишина ---
    let mut negatives = Vec::new();
    for (i, text) in [
        "сервис",
        "запись",
        "нравится",
        "привет",
        "музыка",
        "джаз",
        "джазовый",
        "джазист",
        "жарко",
        "завтрак",
        "джинсы",
        "сверстник",
        "университет",
        "маркетинг",
    ]
    .into_iter()
    .enumerate()
    {
        let audio = engine.synthesize_with("ru_eduard", text, 1.0)?;
        let window = write_window(&train, &format!("[none]_neg_{i}_{text}"), &audio)?;
        negatives.push(window);
    }
    // Тишина и гул не добавляем: нулевой/низкочастотный эмбеддинг после
    // центрирования даёт фантомные направления (см. embedding.rs guard).

    // --- Детектор: настоящий энкодер FastConformer ---
    let stt = std::sync::Arc::new(std::sync::Mutex::new(jarvis_core::stt::Stt::load(
        &jarvis_core::paths::models_dir(),
    )?));
    let embedder = jarvis_core::wake::FastConformerEmbedder::new(std::sync::Arc::clone(&stt));
    println!("🧠 Размерность эмбеддинга: {}", embedder.dims());

    // negative_weight 0.3: при w=1.0 жёсткие негативы подавляют и
    // позитивы (ближайший негатив «сервис» лежит в ~0.4 от любого
    // «Джарвиса» — фонетическое родство), мин-скор позитивов падал до
    // 0.58. 0.3 держит позитивы ≥ 0.78 и негативы ≤ 0.3. Вес замораживается
    // в эталоне — боевой счёт использует тот же.
    let mut detector = EmbeddingDetector::new(
        embedder,
        EmbeddingConfig {
            negative_weight: 0.3,
            ..EmbeddingConfig::default()
        },
    )
    .expect("конфиг детектора");

    // Замер цены окна в установившемся режиме — должен укладываться в hop.
    {
        let mut embedder_probe =
            jarvis_core::wake::FastConformerEmbedder::new(std::sync::Arc::clone(&stt));
        for i in 0..2 {
            let started = std::time::Instant::now();
            let _ = embedder_probe.embed(&positives[i % positives.len()]);
            println!("⏱ Эмбеддинг окна 1.2 с ({}): {:.0?}", i, started.elapsed());
        }
        // Раскладка цены: mel vs энкодер vs декодер (через полный transcribe).
        if let Ok(t) = stt
            .lock()
            .unwrap_or_else(|e| e.into_inner())
            .model()
            .transcribe(&positives[0])
        {
            println!(
                "⏱ transcribe 1.2 с: mel {:.0} мс, encoder {:.0} мс, decode {:.0} мс",
                t.mel_ms, t.encoder_ms, t.decode_ms
            );
        }
    }

    let reference = detector
        .enroll(&positives, &negatives)
        .map_err(|e| anyhow::anyhow!("{e}"))?;
    // Сохраняем ДО самопроверки: score_reference читает эталон с диска.
    let out = jarvis_core::paths::models_dir().join(jarvis_core::wake::EMBEDDING_REFERENCE);
    detector
        .save_reference(&out)
        .map_err(|e| anyhow::anyhow!("{e}"))
        .with_context(|| format!("сохранение {}", out.display()))?;

    // Самопроверка: score_reference — та же семантика, что у боевого
    // детектора (центрирование + max по позитивам).
    let score = |w: &[f32]| -> f32 { jarvis_core::wake::score_reference(&stt, w).expect("score") };
    println!("— счёты позитивов:");
    let mut min_pos = f32::MAX;
    for (i, p) in positives.iter().enumerate() {
        let s = score(p);
        min_pos = min_pos.min(s);
        println!("   {i}: {s:.3}");
    }
    println!("— счёты негативов:");
    let mut max_neg = f32::MIN;
    for (i, n) in negatives.iter().enumerate() {
        let s = score(n);
        max_neg = max_neg.max(s);
        println!("   {i}: {s:.3}");
    }
    println!(
        "✅ Зазор: позитив ≥ {min_pos:.3}, негатив ≤ {max_neg:.3}; порог в эталоне {stored:.4}",
        stored = reference.threshold
    );

    // Калибровка порога по hold-out голосам: само-совпадение записей
    // регистрации завышает min_pos (они внутри эталона), из-за чего порог
    // оказывался выше счёта живого голоса. Считаем невиданные голоса
    // уже сохранённым эталоном — и опускаем порог в середину их зазора.
    let mut holdout_scores: Vec<f32> = Vec::new();
    for entry in std::fs::read_dir(&train)?.flatten() {
        let path = entry.path();
        let name = path
            .file_name()
            .unwrap_or_default()
            .to_string_lossy()
            .to_string();
        if !name.ends_with(".wav") || !name.contains("[jarvis]") {
            continue;
        }
        // Hold-out — файлы голосов из хвоста кураторского списка.
        let enrolled = kept[..enrolled_count]
            .iter()
            .any(|&vi| name.contains(per_voice[vi].0));
        if enrolled {
            continue;
        }
        if let Some(score) = jarvis_core::wake::score_reference(&stt, &read_window(&path)?) {
            holdout_scores.push(score);
        }
    }
    if let Some(&worst_holdout) = holdout_scores
        .iter()
        .min_by(|a, b| a.partial_cmp(b).unwrap())
    {
        let mut reference = rustpotter::EmbeddingReference::load_reference_only(&out)
            .map_err(|e| anyhow::anyhow!("{e}"))?;
        // Порог: существенно ниже худшего невиданного TTS-голоса — живой
        // голос в эмбеддинг-пространстве сидит ниже синтетики, и запас
        // должен покрывать этот сдвиг. Негативы (≤ 0.34) остаются далеко
        // снизу; шумовые аугментации позитивов слегка проседают — учтено.
        let calibrated = (worst_holdout - 0.25)
            .max(0.0)
            .max(reference.threshold * 0.3);
        if (calibrated - reference.threshold).abs() > f32::EPSILON {
            reference.set_threshold(calibrated);
            println!(
                "📊 Калибровка по hold-out: {} невиданных голосов, худший счёт {worst_holdout:.3} → порог {calibrated:.3} (был {:.3})",
                holdout_scores.len(),
                reference.threshold
            );
            // Сохраняем ИЗМЕНЁННУЮ копию: detector.save_reference перезаписал
            // бы файл своей устаревшей копией (баг перекалибровки).
            reference
                .save_to_file(&out)
                .map_err(|e| anyhow::anyhow!("{e}"))?;
        } else {
            println!(
                "📊 Калибровка не требуется: худший hold-out {worst_holdout:.3} выше порога {:.3}",
                reference.threshold
            );
        }
    }
    println!("✅ Эталон сохранён: {}", out.display());
    Ok(())
}
</file>

<file path="crates/jarvis-core/src/stress.rs">
//! Нейросетевая расстановка ударений для русского (ядро RUAccent,
//! Apache-2.0; модели из TigreGotico/stressonnx-models и ruaccent/accentuator).
//!
//! «Интеллектуальная функция» перед фонемизацией:
//! 1. словарь е→ё (85,5 тыс. слов) — «еще» → «ещё» (ё всегда ударная);
//! 2. словарь ударений (110,8 тыс. слов) — «аб+а» → ударная гласная;
//! 3. для незнакомых слов — char-level RoFormer (0,5 млн параметров)
//!    предсказывает ударную гласную.
//!
//! Результат — порядковый номер ударной гласной слова, по нему движок
//! ставит знак «+» перед ударной гласной.
//!
//! Инференс — на candle (`crate::nn::roformer`): веса де-квантованы из ONNX
//! скриптом `scripts/export_stress_models.py`. Контекстные омографы
//! (замок/стоит/дела) разбирает отдельный модуль `crate::omograph`.

use crate::nn::roformer::{RoFormer, RoFormerConfig};
use anyhow::{Context, Result};
use candle_core::Device;
use serde::Deserialize;
use std::collections::HashMap;
use std::io::Read;
use std::path::{Path, PathBuf};

/// Гласные русского текста (для подсчёта порядкового номера).
const RU_VOWELS: &str = "аеёиоуыэюя";

/// Публичная проверка гласной (нужна движкам для расстановки «+»).
pub fn is_ru_vowel(c: char) -> bool {
    RU_VOWELS.contains(c)
}

const STRESS_OVERRIDES: &[(&str, &str)] = &[
    ("дела", "д+ела"),
    ("какая", "как+ая"),
    ("какие", "как+ие"),
    ("какое", "как+ое"),
    ("такая", "так+ая"),
    ("такие", "так+ие"),
    ("такое", "так+ое"),
];

const UNK_ID: i64 = 1;
const BOS_ID: i64 = 2;
const EOS_ID: i64 = 3;
/// Порог уверенности нейросети (как в stressonnx).
const MIN_CONFIDENCE: f32 = 0.55;
/// Максимальная длина входа нейросети (max_length из config.json).
const MAX_TOKENS: usize = 40;

#[derive(Deserialize)]
struct AccentConfig {
    id2label: HashMap<String, String>,
}

pub struct RuStress {
    model: RoFormer,
    char_vocab: HashMap<char, i64>,
    id2label: HashMap<String, String>,
    /// Словарь ударений (110 тыс. слов) — первый эшелон, точный.
    accents: HashMap<String, String>,
    yo_words: HashMap<String, String>,
}

/// Распаковывает и скачивает файлы ударителя в models/stress-ru/.
fn ensure_files() -> Result<PathBuf> {
    let dir = crate::paths::models_dir().join("stress-ru");
    std::fs::create_dir_all(&dir)?;

    // Словари и алфавит нужны всегда.
    let files = [
        ("ru_ruaccent/nn_accent/vocab.txt", "vocab.txt"),
        ("ru_ruaccent/nn_accent/config.json", "config.json"),
        (
            "ru_ruaccent/dictionary/accents_nn.json.gz",
            "accents_nn.json.gz",
        ),
        (
            "ru_ruaccent/dictionary/yo_words.json.gz",
            "yo_words.json.gz",
        ),
    ];

    let client = hf_hub::HFClientSync::new().context("Не удалось создать HuggingFace-клиент")?;
    let repo = client.model("TigreGotico".to_string(), "stressonnx-models".to_string());

    for (remote, local_name) in files {
        let dest = dir.join(local_name);
        if dest.exists() {
            continue;
        }
        println!("📥 Загрузка ударителя ({local_name})...");
        let downloaded = repo
            .download_file()
            .filename(remote.to_string())
            .send()
            .with_context(|| format!("Не удалось скачать {remote}"))?;
        std::fs::copy(&downloaded, &dest)
            .with_context(|| format!("Не удалось сохранить {local_name}"))?;
    }

    // Веса для candle. ONNX нужен только чтобы собрать их скриптом
    // (int8 -> f32); когда safetensors уже есть, ONNX не скачиваем.
    let weights = dir.join("accent.safetensors");
    if !weights.exists() {
        let onnx = dir.join("accent.onnx");
        if !onnx.exists() {
            println!("📥 Загрузка ударителя (accent.onnx)...");
            let downloaded = repo
                .download_file()
                .filename("ru_ruaccent/nn_accent/model.onnx".to_string())
                .send()
                .context("Не удалось скачать accent.onnx")?;
            std::fs::copy(&downloaded, &onnx).context("Не удалось сохранить accent.onnx")?;
        }
        crate::nn::ensure_safetensors(&weights)?;
    }
    Ok(dir)
}

fn read_gzip_json(path: &Path) -> Result<HashMap<String, String>> {
    let raw = std::fs::read(path)?;
    let mut decoder = flate2::read::GzDecoder::new(&raw[..]);
    let mut json = String::new();
    decoder.read_to_string(&mut json)?;
    serde_json::from_str(&json).with_context(|| format!("Ошибка парсинга {:?}", path))
}

impl RuStress {
    /// Загружает ударитель (скачивает ~2 МБ при первом запуске).
    pub fn load() -> Result<Self> {
        let started = std::time::Instant::now();
        let dir = ensure_files()?;

        let mut char_vocab = HashMap::new();
        for (id, line) in std::fs::read_to_string(dir.join("vocab.txt"))?
            .lines()
            .enumerate()
        {
            if let Some(c) = line.chars().next() {
                char_vocab.insert(c, id as i64);
            }
        }

        let config: AccentConfig =
            serde_json::from_str(&std::fs::read_to_string(dir.join("config.json"))?)?;

        let accents = read_gzip_json(&dir.join("accents_nn.json.gz"))?;
        let yo_words = read_gzip_json(&dir.join("yo_words.json.gz"))?;

        let model = RoFormer::load(
            &dir.join("accent.safetensors"),
            RoFormerConfig::default(),
            &Device::Cpu,
        )
        .context("Не удалось загрузить модель ударений")?;

        println!(
            "✅ Ударитель готов (словарь {}, ё {}, нейросеть OOV, candle) за {:.1?}",
            accents.len(),
            yo_words.len(),
            started.elapsed()
        );

        Ok(Self {
            model,
            char_vocab,
            id2label: config.id2label,
            accents,
            yo_words,
        })
    }

    /// Восстанавливает ё по словарю (ё всегда ударная).
    pub fn yo_restore(&self, word: &str) -> String {
        if !word.contains('е') && !word.contains('Е') {
            return word.to_string();
        }
        let lower = word.to_lowercase();
        match self.yo_words.get(&lower) {
            Some(restored) => {
                // Сохраняем регистр первой буквы.
                let mut chars = restored.chars();
                match chars.next() {
                    Some(first) => {
                        let upper = word.chars().next().is_some_and(|c| c.is_uppercase());
                        let head = if upper {
                            first.to_uppercase().to_string()
                        } else {
                            first.to_string()
                        };
                        format!("{head}{}", chars.as_str())
                    }
                    None => word.to_string(),
                }
            }
            None => word.to_string(),
        }
    }

    /// Токены нейросети для слова (отладка и сверка реализаций).
    pub fn debug_ids(&self, word: &str) -> Vec<i64> {
        let lower = word.to_lowercase();
        let mut ids: Vec<i64> = Vec::with_capacity(lower.chars().count() + 2);
        ids.push(BOS_ID);
        for c in lower.chars() {
            ids.push(self.char_vocab.get(&c).copied().unwrap_or(UNK_ID));
        }
        ids.push(EOS_ID);
        ids
    }

    /// Порядковый номер ударной гласной слова (1-based). Эшелоны:
    /// переопределения -> словарь (110 тыс., точный) -> нейросеть (любое
    /// новое слово). ё всегда ударная; служебные слова не акцентируем.
    /// None — ни один эшелон не сработал, ударение не ставим.
    pub fn stressed_vowel_ordinal(&self, word: &str) -> Option<usize> {
        let lower = word.to_lowercase();

        // Служебные слова и не-слова не акцентируем.
        if lower.chars().any(|c| !(c.is_alphabetic() || c == '-')) {
            return None;
        }
        let vowel_count = lower.chars().filter(|c| RU_VOWELS.contains(*c)).count();
        if vowel_count < 2 {
            return None;
        }

        // ё всегда ударная.
        if let Some(ord) = vowel_ordinal(&lower, |c| c == 'ё') {
            return Some(ord);
        }

        // Переопределения, затем словарь, затем нейросеть.
        if let Some((_, forced)) = STRESS_OVERRIDES.iter().find(|(w, _)| *w == lower) {
            return Self::plus_notation_ordinal(forced);
        }
        if let Some(stressed) = self.accents.get(&lower) {
            return Self::plus_notation_ordinal(stressed);
        }

        self.nn_stressed_vowel_ordinal(&lower)
    }

    /// Нотация «аб+а» -> порядковый номер ударной гласной (1-based).
    /// Несколько '+' (варианты) не разбираем — вернём None, возьмёт NN.
    fn plus_notation_ordinal(stressed: &str) -> Option<usize> {
        let mut pluses = 0usize;
        for (i, c) in stressed.char_indices() {
            if c == '+' {
                let after: String = stressed[i + 1..].to_string();
                if let Some(first) = after.chars().next()
                    && RU_VOWELS.contains(first)
                {
                    let before = &stressed[..i];
                    let idx = before.chars().filter(|c| RU_VOWELS.contains(*c)).count();
                    return Some(idx + 1);
                }
                pluses += 1;
                if pluses > 1 {
                    return None;
                }
            }
        }
        None
    }

    /// Нейросеть: char-level RoFormer -> метка STRESS_PRIMARY на гласной.
    fn nn_stressed_vowel_ordinal(&self, lower: &str) -> Option<usize> {
        let chars: Vec<char> = lower.chars().collect();
        if chars.len() + 2 > MAX_TOKENS {
            return None;
        }

        let ids: Vec<u32> = self
            .debug_ids(lower)
            .into_iter()
            .map(|v| v as u32)
            .collect();
        let token_types = vec![0u32; ids.len()];
        let attention = vec![1u32; ids.len()];
        let logits = self.model.logits(&ids, &token_types, &attention).ok()?;

        // Берём гласную с максимальной вероятностью STRESS_PRIMARY среди
        // всех позиций слова (а не первую прошедшую порог): у «окно» модель
        // даёт близкие вероятности на обоих «о», и выбор первого попавшегося
        // зависит от шума квантования.
        let mut best: Option<(usize, f32)> = None;
        for i in 1..=chars.len() {
            let row: &[f32] = logits.get(i)?;
            let max = row.iter().cloned().fold(f32::NEG_INFINITY, f32::max);
            let exps: Vec<f32> = row.iter().map(|v| (v - max).exp()).collect();
            let sum: f32 = exps.iter().sum();
            let argmax = exps
                .iter()
                .enumerate()
                .max_by(|a, b| a.1.total_cmp(b.1))
                .map(|(k, _)| k)?;
            let confidence = exps[argmax] / sum;
            if confidence < MIN_CONFIDENCE {
                continue;
            }
            let label = self.id2label.get(&argmax.to_string())?;
            if label != "STRESS_PRIMARY" {
                continue;
            }
            // Позиция i в логитах соответствует символу chars[i - 1].
            if !RU_VOWELS.contains(chars[i - 1]) {
                continue;
            }
            if best.is_none_or(|(_, p)| confidence > p) {
                best = Some((i, confidence));
            }
        }

        // Порядковый номер ударной гласной = гласные в chars[..pos].
        let (pos, _) = best?;
        Some(
            lower
                .chars()
                .take(pos)
                .filter(|c| RU_VOWELS.contains(*c))
                .count(),
        )
    }
}

/// Порядковый номер первой гласной, удовлетворяющей предикату (1-based).
fn vowel_ordinal(word: &str, pred: impl Fn(char) -> bool) -> Option<usize> {
    let mut seen = 0usize;
    for c in word.chars() {
        if RU_VOWELS.contains(c) {
            seen += 1;
            if pred(c) {
                return Some(seen);
            }
        }
    }
    None
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn plus_ordinal() {
        assert_eq!(RuStress::plus_notation_ordinal("аб+а"), Some(2));
        assert_eq!(RuStress::plus_notation_ordinal("д+ела"), Some(1));
        assert_eq!(RuStress::plus_notation_ordinal("как+ая"), Some(2));
    }

    #[test]
    fn vowel_ordinal_basics() {
        assert_eq!(vowel_ordinal("замок", |c| c == 'о'), Some(2));
        assert_eq!(vowel_ordinal("замок", |c| c == 'а'), Some(1));
        assert_eq!(vowel_ordinal("ещё", |c| c == 'ё'), Some(2));
        assert_eq!(vowel_ordinal("въезд", |c| c == 'ё'), None);
    }
}
</file>

<file path="app/src/store.svelte.ts">
import { listen } from "@tauri-apps/api/event";
import { invoke } from "@tauri-apps/api/core";

/**
 * Состояние приложения.
 *
 * Три слоя:
 *  - `store` — то, что приходит от движка: статус, события, история диалога;
 *  - `settings` — то, что пользователь меняет сам;
 *  - `ui` — навигация и прочее локальное состояние интерфейса.
 *
 * События движка переводятся в человеческие фразы сразу при получении:
 * страницам не нужно знать про `llm_status` и `audio_level`.
 *
 * Файл называется `.svelte.ts`, чтобы Svelte 5 скомпилировал руны.
 */

export interface EngineEvent {
  type: string;
  [key: string]: unknown;
}

export interface EngineStatus {
  engineRunning: boolean;
  paused: boolean;
  llmStatus: string;
  ttsReady: boolean;
  /** Рабочая папка агента: от неё считаются пути файловых инструментов. */
  cwd: string;
}

export interface Settings {
  // Детекция фразы (в интерфейсе не показывается — правится в settings.toml)
  silence_rms_threshold: number;
  silence_timeout_secs: number;
  min_command_duration_secs: number;
  max_command_duration_secs: number;
  followup_window_secs: number;
  // Wake word
  wake_threshold: number;
  wakeword_model: string;
  /** Детектор wake word: "ctc" — по фразе (любая, дикторонезависимо),
   *  "metric" — по эталону .jref. */
  wake_detector: string;
  /** Фраза-активация для CTC-детектора. */
  wake_word: string;
  /** Длина окна детектора, мс: должна накрывать фразу целиком. */
  wake_window_ms: number;
  // Ответы
  llm_enabled: boolean;
  /** Имя ассистента (в интерфейсе и разговоре); фраза-активация отдельно. */
  assistant_name: string;
  /** Бэкенд LLM: "uzu" (Metal, модели каталога Mirai) или "candle". */
  llm_backend: string;
  /** Модель LLM (имя меняет смысл в зависимости от бэкенда). */
  llm_model: string;
  llm_temperature: number;
  /** Страховочный лимит длины ответа в токенах; 0 — без лимита. */
  llm_max_tokens: number;
  // Голос
  tts_voice: string;
  tts_speed: number;
  // Отклик
  ack_before_llm: boolean;
  /** Перебивание: микрофон слушает, пока Джарвис говорит. */
  barge_in: boolean;
  /** Фильтр говорящего: в ответы идёт только голос владельца. */
  speaker_filter: boolean;
  /** Порог косинусного сходства с голосовым профилем владельца. */
  speaker_threshold: number;
  // Telegram
  /** Токен бота (BotFather). Пусто — канал не запускается. */
  telegram_bot_token: string;
  /** Чаты: id через запятую (группа — с минусом). */
  telegram_chat_ids: string;
  /** Telegram может выполнять команды Джарвиса. */
  telegram_execute: boolean;

  // --- Облачные модели (OpenAI-совместимый API) ---
  /** Мастер первого запуска пройден (иначе показывается онбординг). */
  setup_done: boolean;
  /** Пресет провайдера: "yandex" | "openai". */
  api_preset: string;
  /** Базовый адрес API (OpenAI-совместимый). */
  api_base_url: string;
  /** API-ключ. */
  api_key: string;
  /** Имя модели у провайдера. */
  api_model: string;
  /** Идентификатор каталога (только Яндекс). */
  api_folder_id: string;
}

export interface Toast {
  id: number;
  text: string;
  kind: "info" | "ok" | "err";
}

/** Реплика в общей истории диалога на главной. */
export interface Turn {
  id: number;
  /** user — сказал человек; assistant — ответил Джарвис; note — служебная пометка. */
  role: "user" | "assistant" | "note";
  text: string;
  /** Откуда реплика: голос, клавиатура или итог выполненного действия. */
  source: "voice" | "text" | "action";
  /** Ответ ещё печатается: показываем каретку, реплику можно перебить. */
  streaming?: boolean;
  /** Неудача: ошибка движка вместо ответа. */
  error?: boolean;
}

let ids = 0;

export const store = $state({
  page: "home" as string,
  /** Страница, с которой пришли в подраздел — для кнопки «назад». */
  pageBack: "more" as string,
  /** Боковая панель свернута пользователем (иконки без подписей). */
  sidebarCompact: false as boolean,
  /**
   * Идёт сборка реактора на запуске: интерфейс скрыт до розжига.
   * Снимает флаг сам реактор (ArcReactor), страховка — таймер в App.
   */
  booting: true as boolean,
  /**
   * Просьба «проиграй анимацию реактора» в уже запущенном интерфейсе.
   * Флаг поднимает событие движка, снимает его реактор на розжиге.
   */
  introRequest: false as boolean,
  status: {
    engineRunning: false,
    paused: false,
    llmStatus: "loading",
    ttsReady: false,
    cwd: "",
  } as EngineStatus,
  /** Что делает движок: wake_word | listening | processing. */
  engineState: "wake_word" as string,
  /**
   * Движок распознаёт сказанное. Отдельный флаг, потому что состояние
   * «processing» появилось в движке позже: если его нет, флаг поднимает
   * приход расшифровки — так интерфейс не остаётся без сигнала.
   */
  processing: false as boolean,
  transcript: "" as string,
  wakeScore: 0 as number,
  audioLevel: 0 as number,
  /**
   * Диктант для профиля голоса: "idle" | "recording" | "checking" и итог
   * последней проверки (совпадение + расшифровка).
   */
  voiceTrain: {
    state: "idle" as "idle" | "recording" | "checking",
    lastOk: null as boolean | null,
    overlap: 0 as number,
    transcript: "",
  },
  /**
   * Откуда пришёл уровень звука: «mic» — говорит пользователь, «tts» — сам
   * Джарвис. Без этого индикатор одинаково реагировал бы на свою же речь.
   */
  audioSource: "mic" as string,
  /** Джарвис сейчас озвучивает ответ. В этой фазе его можно перебить. */
  speaking: false as boolean,
  /** Команда, которую движок распознал дословно. */
  matchedCommand: "" as string,
  chat: {
    question: "" as string,
    streaming: "" as string,
    done: "" as string,
    busy: false,
    /** Последняя ошибка движка во время ожидания ответа. */
    error: "" as string,
  },
  /**
   * Единая история диалога: голос, клавиатура, итоги действий.
   * Живёт до закрытия окна, очищается кнопкой на главной.
   */
  history: [] as Turn[],
  /** Момент последней реплики в диалоге — для телеметрии на главной. */
  lastActivity: 0 as number,
  trainProgress: { epoch: 0, total: 0 } as { epoch: number; total: number },
  /** Загрузка модели: что качается и сколько готово (null — ничего не идёт). */
  download: null as null | { what: string; percent: number },
  recording: false,
  /**
   * Доступ к микрофону: false — движок ждёт разрешения (показываем меню),
   * true — получено (меню закрывается), null — вопросов нет.
   */
  micPermission: null as boolean | null,
  toasts: [] as Toast[],
});

export function toast(text: string, kind: Toast["kind"] = "info", ms = 2800) {
  const item: Toast = { id: ++ids, text, kind };
  store.toasts.push(item);
  setTimeout(() => {
    const i = store.toasts.findIndex((t) => t.id === item.id);
    if (i !== -1) store.toasts.splice(i, 1);
  }, ms);
}

/** Вторичные экраны: открываются из разделов и требуют кнопку «назад». */
export const SUB_PAGES = ["commands", "voice", "voicetrain", "wakeword", "help"];

/** Четыре раздела нижней навигации. */
export const NAV_PAGES = ["home", "memory", "settings"];

export function go(page: string) {
  // Запоминаем раздел, откуда ушли, чтобы «назад» вела именно туда.
  if (!SUB_PAGES.includes(page)) store.pageBack = page;
  store.page = page;
}

// ---------- История диалога ----------

/** Добавляет реплику в историю (используют и события движка, и чат UI). */
export function pushTurn(turn: Omit<Turn, "id">): Turn {
  const item: Turn = { id: ++ids, ...turn };
  store.history.push(item);
  store.lastActivity = Date.now();
  if (store.history.length > 200) store.history.splice(0, store.history.length - 200);
  return item;
}

function noteTurn(text: string) {
  pushTurn({ role: "note", text, source: "action" });
}

/**
 * Финальный ответ ассистента: если ответ уже печатался (стриминг),
 * обновляем его, иначе добавляем реплику.
 */
function completeReply(text: string, source: Turn["source"] = "voice") {
  if (!text) return;
  store.lastActivity = Date.now();
  const last = store.history[store.history.length - 1];
  if (last && last.role === "assistant" && last.streaming) {
    last.text = text;
    last.streaming = false;
    return;
  }
  pushTurn({ role: "assistant", text, source, streaming: false });
}

function clearHistory() {
  store.history.length = 0;
  store.matchedCommand = "";
  store.transcript = "";
  store.chat.question = "";
  store.chat.streaming = "";
  store.chat.done = "";
  store.chat.error = "";
}

// ---------- Настройки ----------

export const settings = $state<Settings>({
  silence_rms_threshold: 0.018,
  silence_timeout_secs: 0.7,
  min_command_duration_secs: 0.5,
  max_command_duration_secs: 8,
  followup_window_secs: 8,
  wake_threshold: 0.6,
  wakeword_model: "jarvis_model_2.rpw",
  wake_detector: "ctc",
  wake_word: "Джарвис",
  wake_window_ms: 1200,
  llm_enabled: true,
  assistant_name: "Джарвис",
  llm_backend: "uzu",
  llm_model: "qwen3.5-2b-mirai-m",
  llm_temperature: 0.6,
  llm_max_tokens: 0,
  tts_voice: "ru_dmitriy",
  tts_speed: 1.0,
  ack_before_llm: false,
  barge_in: true,
  speaker_filter: true,
  speaker_threshold: 0.6,
  telegram_bot_token: "",
  telegram_chat_ids: "",
  telegram_execute: true,
  setup_done: false,
  api_preset: "yandex",
  api_base_url: "https://llm.api.cloud.yandex.net/v1",
  api_key: "",
  api_model: "yandexgpt-lite",
  api_folder_id: "",
});

export async function loadSettings() {
  try {
    Object.assign(settings, await invoke<Settings>("get_settings"));
  } catch {
    // Движок ещё не поднят — остаются значения по умолчанию.
  }
}

/**
 * Меняет настройки и сразу сохраняет. Бэкенд ждёт структуру целиком, поэтому
 * отправляем весь объект: поля, которых нет в интерфейсе, сохраняются как есть.
 */
export async function patchSettings(patch: Partial<Settings>) {
  const previous = { ...settings };
  Object.assign(settings, patch);
  try {
    await invoke("save_settings", { settings: { ...settings } });
  } catch (e) {
    Object.assign(settings, previous);
    toast(`Не удалось сохранить: ${e}`, "err");
  }
}

// ---------- Инициализация ----------

export async function initEvents() {
  await listen<EngineEvent>("engine-event", (event) => {
    const ev = event.payload;
    switch (ev.type) {
      case "state_changed": {
        const state = (ev.state as string) ?? "wake_word";
        store.engineState = state;
        if (state === "processing") store.processing = true;
        else if (state === "wake_word" || state === "listening") store.processing = false;
        break;
      }
      case "wake_word_detected":
        store.wakeScore = (ev.score as number) ?? 0;
        store.transcript = "";
        store.processing = false;
        break;
      case "transcript":
        // Расшифровка приходит один раз на фразу — это финальный текст.
        store.transcript = (ev.text as string) ?? "";
        if (store.transcript.trim()) {
          pushTurn({ role: "user", text: store.transcript, source: "voice" });
        }
        store.processing = true;
        break;
      case "topic_resumed":
        noteTurn(`Вернулись к теме: ${((ev.topic as string) ?? "").trim()}`);
        break;
      case "action_result": {
        const summary = ((ev.summary as string) ?? "").slice(0, 300);
        store.matchedCommand = "";
        // Итог действия Джарвис проговаривает — показываем ту же фразу.
        if (summary) {
          pushTurn({ role: "assistant", text: summary, source: "action" });
        }
        break;
      }
      case "command_matched":
        // Дословное совпадение: без этой пометки казалось, что Джарвис
        // молча проигнорировал просьбу.
        store.matchedCommand = (ev.name as string) ?? "";
        noteTurn(`Команда «${store.matchedCommand}»`);
        break;
      case "reactor_intro":
        // Реактор живёт только на главной: без возврата просьба осталась бы
        // невыполненной, если пользователь был в другом разделе.
        store.introRequest = true;
        store.booting = true;
        go("home");
        break;
      case "llm_status":
        if ((ev.status as string) === "thinking") store.chat.busy = true;
        void refreshStatus();
        break;
      case "llm_chunk": {
        // Приходят нарастающие фрагменты: печатаем каретку на конце.
        const text = (ev.text as string) ?? "";
        store.chat.streaming = text;
        store.chat.busy = true;
        store.chat.error = "";
        store.lastActivity = Date.now();
        const last = store.history[store.history.length - 1];
        if (last && last.role === "assistant" && last.streaming) {
          last.text = text;
        } else {
          pushTurn({ role: "assistant", text, source: "voice", streaming: true });
        }
        break;
      }
      case "llm_done":
        store.chat.done = (ev.text as string) ?? "";
        store.chat.streaming = "";
        store.chat.busy = false;
        store.chat.error = "";
        store.processing = false;
        completeReply(store.chat.done);
        break;
      case "audio_level":
        store.audioLevel = (ev.level as number) ?? 0;
        store.audioSource = (ev.source as string) ?? "mic";
        break;
      case "train_progress":
        store.trainProgress = {
          epoch: (ev.epoch as number) ?? 0,
          total: (ev.total as number) ?? 0,
        };
        break;
      case "train_done":
        store.trainProgress = { epoch: 0, total: 0 };
        break;
      case "download_progress": {
        const percent = Number((ev.percent as number) ?? 0);
        if (percent >= 100) {
          store.download = null;
        } else {
          store.download = {
            what: (ev.what as string) ?? "",
            percent: Math.max(0, Math.min(99, percent)),
          };
        }
        break;
      }
      case "record_saved":
        store.recording = false;
        break;
      case "voice_check": {
        const ok = (ev.ok as boolean) ?? false;
        store.voiceTrain = {
          state: "idle",
          lastOk: ok,
          overlap: (ev.overlap as number) ?? 0,
          transcript: ((ev.transcript as string) ?? "").slice(0, 300),
        };
        break;
      }
      case "mic_permission":
        store.micPermission = (ev.granted as boolean) ?? false;
        if (store.micPermission) toast("Микрофон подключён", "ok");
        break;
      case "error": {
        const message = (ev.message as string) ?? "Неизвестная ошибка";
        const wasChatPending = store.chat.busy || Boolean(store.chat.question);
        store.recording = false;
        store.chat.busy = false;
        store.processing = false;
        // Чат ждал ответ — вместо вечно крутящегося спиннера покажем ошибку.
        if (wasChatPending) store.chat.error = message;
        // Ошибка прерывает и печатающийся ответ: реплика не должна висеть
        // с кареткой навсегда.
        const last = store.history[store.history.length - 1];
        if (last && last.role === "assistant" && last.streaming && !last.text) {
          store.history.pop();
        } else if (last && last.role === "assistant" && last.streaming) {
          last.streaming = false;
        }
        if (wasChatPending) {
          pushTurn({ role: "assistant", text: `Не получилось: ${message}`, source: "text", error: true });
        }
        toast(message, "err", 5000);
        break;
      }
      default:
        break;
    }
  });

  // Фаза «говорит» отдельным событием: у движка нет для неё состояния, а без
  // неё в статусе было «Готов», пока Джарвис ещё договаривал фразу.
  await listen<{ speaking: boolean }>("speech", (event) => {
    store.speaking = Boolean(event.payload?.speaking);
    // Озвучка закончилась — печатающийся ответ, если он ещё висит, закрыт.
    if (!store.speaking) {
      const last = store.history[store.history.length - 1];
      if (last && last.role === "assistant" && last.streaming && !store.chat.busy) {
        last.streaming = false;
      }
    }
  });

  setInterval(refreshStatus, 2000);
  await Promise.all([refreshStatus(), loadSettings()]);
}

export async function refreshStatus() {
  try {
    store.status = await invoke<EngineStatus>("status");
  } catch {
    // движок ещё не поднят
  }
}

export { clearHistory, noteTurn };
</file>

<file path="crates/jarvis-core/src/model_fetch.rs">
//! Загрузка моделей, у которых нет внешнего источника (HF/Mirai).
//!
//! silero (TTS, сконвертирован вручную) и Qwen3.5-0.8B (бэкенд candle) лежат
//! в отдельном релизе GitHub — по умолчанию `pavel807/jarvis-models`, тег
//! `models-v1`. Базовый URL можно переопределить переменной окружения
//! `JARVIS_MODELS_BASE_URL`.
//!
//! Архивы — обычные `tar.gz`, распаковываются в каталог `models/`, поэтому
//! внутри должны лежать пути относительно него (`silero/…`, `qwen3.5-0.8b/…`).

use anyhow::{Context, Result, bail};
use std::path::Path;
use std::time::{Duration, Instant};

const DEFAULT_BASE_URL: &str =
    "https://github.com/pavel807/jarvis-models/releases/download/models-v1";

/// Как часто сообщать о прогрессе при скачивании, мс.
const PROGRESS_STEP: Duration = Duration::from_millis(500);

/// Базовый URL релиза с моделями (без имени ассета).
pub fn base_url() -> String {
    std::env::var("JARVIS_MODELS_BASE_URL").unwrap_or_else(|_| DEFAULT_BASE_URL.to_string())
}

/// Гарантирует, что файлы Silero v5 есть в `models/silero/`, иначе качает
/// `silero.tar.gz` из релиза.
pub fn ensure_silero() -> Result<()> {
    ensure_silero_with_progress(&mut |_| {})
}

/// Как [`ensure_silero`], но с отчётом о прогрессе (0..=100).
pub fn ensure_silero_with_progress(progress: &mut dyn FnMut(u8)) -> Result<()> {
    let dir = crate::paths::models_dir().join("silero");
    if silero_ready(&dir) {
        progress(100);
        return Ok(());
    }
    ensure_archive("silero.tar.gz", progress)?;
    if silero_ready(&dir) {
        Ok(())
    } else {
        bail!(
            "После загрузки silero в {:?} нет v5_cis_base.safetensors/alphabet.json",
            dir
        )
    }
}

/// Докачать файл вакворда из релиза (jarvis_model_2.rpw, jarvis_model.jref):
/// маленький файл, прогресс не важен. Ошибка — честная (ассет может быть
/// ещё не выложен), вызывающий решает сам.
pub fn ensure_wakeword(name: &str) -> Result<()> {
    let dest = crate::paths::wakeword_model_file(name);
    if dest.exists() {
        return Ok(());
    }
    let dir = dest.parent().context("нет родителя у пути модели")?;
    std::fs::create_dir_all(dir).with_context(|| format!("не создать {}", dir.display()))?;
    let url = format!("{}/{}", base_url(), name);
    // Ассет может быть не выложен (опциональная модель) — это не ошибка:
    // движок умеет жить без него (метрический эталон или обучение в приложении).
    let expected = remote_size(&url);
    if expected == 0 {
        println!("ℹ️ В релизе нет «{name}» — пропускаю докачку");
        return Ok(());
    }
    println!("📥 Загрузка модели вакворда: {url}");
    download(&url, &dest, expected, &mut |_| {})
        .with_context(|| format!("не удалось скачать {name}"))
}

/// Гарантирует наличие файлов Qwen3.5-0.8B в `dir` (config, tokenizer, веса),
/// иначе качает `qwen3.5-0.8b.tar.gz` из релиза.
pub fn ensure_qwen35(dir: &Path) -> Result<()> {
    let mut noop = |_pct: u8| {};
    ensure_qwen35_with_progress(dir, &mut noop)
}

/// То же, что [`ensure_qwen35`], но с отчётом о прогрессе (0..100).
pub fn ensure_qwen35_with_progress(dir: &Path, progress: &mut dyn FnMut(u8)) -> Result<()> {
    if qwen35_ready(dir) {
        progress(100);
        return Ok(());
    }
    ensure_archive("qwen3.5-0.8b.tar.gz", progress)?;
    if qwen35_ready(dir) {
        Ok(())
    } else {
        bail!(
            "После загрузки Qwen3.5 в {:?} не хватает файлов модели",
            dir
        )
    }
}

/// Гарантирует файлы FastConformer-Hybrid Large RU в `models/fastconformer/`.
///
/// Источник один: архив `fastconformer.tar.gz` (~460 МБ) из GitHub-релиза —
/// модель распознавания речи встроена в программу, настройка не нужна.
pub fn ensure_fastconformer() -> Result<()> {
    let dir = crate::paths::models_dir().join("fastconformer");
    if fastconformer_ready(&dir) {
        return Ok(());
    }
    ensure_archive("fastconformer.tar.gz", &mut |_| {})?;
    if fastconformer_ready(&dir) {
        Ok(())
    } else {
        bail!(
            "После загрузки FastConformer в {:?} нет model.safetensors/config.json/tokenizer.vocab",
            dir
        )
    }
}

/// Размер файлов FastConformer, если модель на месте; иначе `None`.
pub fn fastconformer_status() -> Option<u64> {
    let dir = crate::paths::models_dir().join("fastconformer");
    fastconformer_ready(&dir).then(|| dir_size(&dir))
}

fn fastconformer_ready(dir: &Path) -> bool {
    dir.join("model.safetensors").is_file()
        && dir.join("config.json").is_file()
        && dir.join("tokenizer.vocab").is_file()
}

/// Размер файлов Qwen3.5 в `dir`, если модель на месте; иначе `None`.
pub fn qwen35_status(dir: &Path) -> Option<u64> {
    qwen35_ready(dir).then(|| dir_size(dir))
}

/// Удаляет каталог модели (для повторной загрузки).
pub fn qwen35_remove(dir: &Path) -> Result<()> {
    if dir.exists() {
        std::fs::remove_dir_all(dir)
            .with_context(|| format!("Не удалось удалить {}", dir.display()))?;
    }
    Ok(())
}

fn silero_ready(dir: &Path) -> bool {
    dir.join("v5_cis_base.safetensors").is_file() && dir.join("alphabet.json").is_file()
}

pub fn qwen35_ready(dir: &Path) -> bool {
    if !dir.join("config.json").is_file() || !dir.join("tokenizer.json").is_file() {
        return false;
    }
    has_safetensors(dir)
}

fn has_safetensors(dir: &Path) -> bool {
    let Ok(entries) = std::fs::read_dir(dir) else {
        return false;
    };
    entries.flatten().any(|e| {
        let name = e.file_name();
        let name = name.to_string_lossy();
        name.starts_with("model.safetensors") && name.ends_with(".safetensors")
    })
}

/// Скачивает `asset` из релиза и распаковывает его в `models/`.
fn ensure_archive(asset: &str, progress: &mut dyn FnMut(u8)) -> Result<()> {
    let models = crate::paths::models_dir();
    std::fs::create_dir_all(&models)
        .with_context(|| format!("Не удалось создать {}", models.display()))?;

    let url = format!("{}/{}", base_url(), asset);
    let tmp = std::env::temp_dir().join(format!("jarvis-{asset}"));
    let expected = remote_size(&url);

    println!("📥 Загрузка модели: {url}");
    let started = Instant::now();
    download(&url, &tmp, expected, progress)?;
    extract(&tmp, &models)?;
    let _ = std::fs::remove_file(&tmp);
    println!("✅ Модель получена за {:.1?}", started.elapsed());
    Ok(())
}

/// Качает `url` в `dest`, дёргая `progress(pct)` по мере роста файла.
/// `expected` — ожидаемый размер в байтах (0, если неизвестен).
fn download(url: &str, dest: &Path, expected: u64, progress: &mut dyn FnMut(u8)) -> Result<()> {
    let mut child = std::process::Command::new(curl_bin())
        .args(["-fL", "--retry", "3", "--connect-timeout", "20", "-o"])
        .arg(dest)
        .arg(url)
        .spawn()
        .context("Не удалось запустить curl")?;

    let mut last = 0u8;
    loop {
        match child.try_wait().context("curl: ошибка ожидания")? {
            Some(status) => {
                if !status.success() {
                    bail!("curl завершился с кодом {status}");
                }
                break;
            }
            None => {
                if expected > 0 {
                    let cur = std::fs::metadata(dest).map(|m| m.len()).unwrap_or(0);
                    let pct = ((cur.min(expected) as f64 / expected as f64) * 100.0) as u8;
                    if pct != last {
                        last = pct;
                        progress(pct.min(99));
                    }
                }
                std::thread::sleep(PROGRESS_STEP);
            }
        }
    }
    progress(100);
    Ok(())
}

/// Размер ассета в релизе через `Content-Length` (0, если не удалось узнать).
fn remote_size(url: &str) -> u64 {
    let out = std::process::Command::new(curl_bin())
        .args([
            "-sIL",
            "--connect-timeout",
            "20",
            "-o",
            "/dev/null",
            "-w",
            "%{http_code}",
        ])
        .arg(url)
        .output();
    let Ok(out) = out else {
        return 0;
    };
    let status = String::from_utf8_lossy(&out.stdout);
    // Ассета может не быть в релизе (например, .rpw давно не выкладывается):
    // это не ошибка, а отсутствие опционального файла. Без проверки кода
    // curl отдавал бы длину страницы 404, движок пробовал скачать её и
    // печатал «curl: (22) ... 404» при каждом старте.
    if status.trim() != "200" {
        return 0;
    }
    // Content-Length берём вторым запросом: -o /dev/null съел заголовки.
    let out = std::process::Command::new(curl_bin())
        .args(["-sIL", "--connect-timeout", "20"])
        .arg(url)
        .output();
    let Ok(out) = out else {
        return 0;
    };
    parse_content_length(&String::from_utf8_lossy(&out.stdout))
}

/// Последний `Content-Length` из заголовков (после редиректов — итоговый).
fn parse_content_length(headers: &str) -> u64 {
    headers
        .lines()
        .filter_map(|line| {
            let (name, value) = line.split_once(':')?;
            if name.trim().eq_ignore_ascii_case("content-length") {
                value.trim().parse::<u64>().ok()
            } else {
                None
            }
        })
        .last()
        .unwrap_or(0)
}

fn extract(archive: &Path, dest: &Path) -> Result<()> {
    let status = std::process::Command::new("tar")
        .arg("-xzf")
        .arg(archive)
        .arg("-C")
        .arg(dest)
        .status()
        .context("Не удалось запустить tar")?;
    if !status.success() {
        bail!("tar завершился с кодом {status}");
    }
    Ok(())
}

/// Суммарный размер файлов в каталоге (рекурсивно).
fn dir_size(dir: &Path) -> u64 {
    let Ok(entries) = std::fs::read_dir(dir) else {
        return 0;
    };
    entries
        .flatten()
        .map(|e| match e.file_type() {
            Ok(t) if t.is_dir() => dir_size(&e.path()),
            Ok(t) if t.is_file() => e.metadata().map(|m| m.len()).unwrap_or(0),
            _ => 0,
        })
        .sum()
}

/// Первый существующий curl, иначе полагаемся на PATH.
fn curl_bin() -> &'static str {
    for p in [
        "/usr/bin/curl",
        "/opt/homebrew/bin/curl",
        "/usr/local/bin/curl",
    ] {
        if Path::new(p).exists() {
            return p;
        }
    }
    "curl"
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn content_length_takes_last_header() {
        let headers = "HTTP/2 302\r\ncontent-length: 10\r\nHTTP/2 200\r\nContent-Length: 42\r\n";
        assert_eq!(parse_content_length(headers), 42);
    }

    #[test]
    fn content_length_missing_is_zero() {
        assert_eq!(parse_content_length("HTTP/2 200\r\n"), 0);
    }
}
