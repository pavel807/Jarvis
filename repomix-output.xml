/// Путь из конфигов (относительные пути отсчитываются от корня данных).
pub fn resolve_data_path(path: &str) -> PathBuf {
    let p = PathBuf::from(path);
    if p.is_absolute() {
        p
    } else {
        base_dir().join(p)
    }
}
