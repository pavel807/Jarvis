/// Быстрый путь утилит: «открой календарь», «секундомер», «поставь таймер»
/// без цифр — открываем окно утилит Джарвиса (не Calendar.app и не LLM).
/// Просьбы с цифрами («таймер на 5 минут») — None: это set_timer.
pub fn utils_tab_for_prompt(prompt: &str) -> Option<&'static str> {
    let t = prompt.to_lowercase();
    if t.contains("секундомер") {
        return Some("stopwatch");
    }
    if t.contains("календар") {
        return Some("calendar");
    }
    if t.contains("таймер") {
        // «таймер на двадцать секунд / на 5 минут / на полчаса» — это
        // set_timer, а не окно: числа-слова STT пишет словами, цифры тоже.
        let has_digit = t.chars().any(|c| c.is_ascii_digit());
        let has_unit = ["секунд", "минут", "час", "полминуты", "полчаса"]
            .iter()
            .any(|w| t.contains(w));
        let has_number_word = [
            "двадцат",
            "тридцат",
            "сорок",
            "пятнадцат",
            "десят",
            "пят",
            "шест",
            "сем",
            "восем",
            "девят",
            "двенадцат",
            "тринадцат",
            "четырнадцат",
            "сто ",
        ]
        .iter()
        .any(|w| t.contains(w));
        if has_digit || has_unit || has_number_word {
            return None;
        }
        return Some("timer");
    }
    None
}

/// Быстрый путь команд окна: «сверни окно сафари», «разверни окно зума»,
/// «закрой окно джарвиса», «сверни приложение рио» — применяем сразу, без
/// лотереи tool-вызовов модели (2B то вызывает не тот инструмент, то пишет
/// «Сafari» кириллицей, то копирует пример из промпта и подставляет чужое
/// имя). Возвращает (действие, приложение) или None — пусть решает LLM.
pub fn window_request_from_prompt(prompt: &str) -> Option<(String, Option<String>)> {
    let t = prompt.to_lowercase();
    let action = if t.contains("сверни") || t.contains("свернуть") {
        "minimize"
    } else if t.contains("разверни") || t.contains("развернуть") {
        "maximize"
    } else if t.contains("полный экран") || t.contains("фулскрин") {
        "fullscreen"
    } else if t.contains("закрой окно") || t.contains("закрыть окно") {
        "close"
    } else if t.contains("верни окно") {
        "restore"
    } else {
        return None;
    };
    // Речь должна быть про окно или приложение: «закрой джарвис» — это
    // выход, не окно. «Сверни приложение рио» — тоже просьба про окно,
    // просто названное «приложением»: без этой ветки фраза уходила к LLM,
    // а та из-за примера в промпте подставляла чужое имя (живой случай).
    if !t.contains("окно")
        && !t.contains("окошко")
        && !t.contains("приложен")
        && !t.contains("программ")
    {
        return None;
    }
    if t.chars().any(|c| c.is_ascii_digit()) {
        return None;
    }

    // Приложение: слова после «окно/окошко/приложение/программу». Особые
    // слова — активное окно. «Сверни приложение» без имени — не гадаем,
    // пусть решает модель; «сверни окно» без имени сохраняет прежний смысл —
    // окно Джарвиса.
    let words: Vec<&str> = prompt.split_whitespace().collect();
    let mut app_words: Vec<&str> = Vec::new();
    let mut seen = false;
    let mut needs_name = false;
    for w in &words {
        let wl = w.to_lowercase();
        let bare = wl.trim_matches(|c: char| !c.is_alphanumeric());
        if bare == "окно" || bare == "окошко" {
            seen = true;
            needs_name = false;
            app_words.clear();
            continue;
        }
        if bare.starts_with("приложен") || bare.starts_with("программ") {
            seen = true;
            needs_name = true;
            app_words.clear();
            continue;
        }
        if seen {
            app_words.push(w);
        }
    }
    if needs_name && app_words.is_empty() {
        return None;
    }
    let app = if app_words.is_empty() {
        None
    } else {
        let app = app_words.join(" ");
        let special = ["активное", "активную", "активный", "это", "текущее"];
        if special.contains(&app.to_lowercase().as_str()) {
            Some("активное".to_string())
        } else {
            Some(app)
        }
    };
    Some((action.to_string(), app))
}

