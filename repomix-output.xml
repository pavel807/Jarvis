/// Блокируем только реально разрушительные команды. Всё остальное — на
/// усмотрение модели и пользователя.
const DANGEROUS: &[&str] = &[
    "rm -rf /",
    "rm -rf /*",
    "rm -rf ~",
    "rm -rf $HOME",
    "rm -rf ~/*",
    "rm -rf $HOME/*",
    "mkfs.",
    "mkfs ",
    "fdisk",
    "diskutil erasedisk",
    "diskutil zerodisk",
    "diskutil reformat",
    "dd if=/dev/zero",
    "dd if=/dev/random",
    "dd of=/dev/",
    "dd of=/dev/disk",
    "> /dev/disk",
    "> /dev/sda",
    ":(){:|:&};:",
    "chmod -r 777 /",
    "chown -r /",
    "passwd -d root",
    "format c:",
    "del /f /s /q c:\\",
    "rd /s /q c:\\",
];

fn is_dangerous(s: &str) -> bool {
    let lower = s.to_lowercase();
    DANGEROUS.iter().any(|d| lower.contains(d))
}

/// Возвращает имя ОС для использования в системном промпте.
pub fn os_name() -> &'static str {
    if cfg!(target_os = "macos") {
        "macOS"
    } else if cfg!(target_os = "windows") {
        "Windows"
    } else if cfg!(target_os = "linux") {
        "Linux"
    } else {
        "Unknown"
    }
}

