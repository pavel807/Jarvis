        let apps = parse_start_apps(out);
        assert_eq!(apps.len(), 2);
        assert_eq!(apps[0].0, "Google Chrome");
        assert_eq!(apps[1].1, "Microsoft.WindowsCalculator_8wekyb3d8bbwe!App");
    }

    #[test]
