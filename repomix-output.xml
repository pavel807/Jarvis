      <textarea bind:value={testText} class="textarea" rows="2" aria-label="Проверочная фраза"></textarea>
      <button class="btn btn--secondary btn--sm" style="margin-top: 10px" onclick={playTest}>
        <AppIcon name="play" size={14} />
