<script lang="ts">
  import type { Snippet } from "svelte";
  import AppIcon from "./AppIcon.svelte";

  let {
    title,
    onclose,
    children,
    headActions,
    foot,
  }: {
    title: string;
    onclose: () => void;
    children?: Snippet;
    headActions?: Snippet;
    foot?: Snippet;
  } = $props();

  function onKey(event: KeyboardEvent) {
    if (event.key === "Escape") onclose();
  }

  /**
   * Шторка уезжает в body: внутри страницы она попадает в контекст наложения
   * `.content` и оказывается под нижней навигацией — кнопки внизу шторки
   * пропадали за панелью вкладок.
   */
  function portal(node: HTMLElement) {
    document.body.appendChild(node);
    return {
      destroy() {
        node.remove();
      },
    };
  }
</script>

<svelte:window onkeydown={onKey} />

<div
  class="sheet-backdrop"
  use:portal
  role="presentation"
  onclick={(event) => {
    if (event.target === event.currentTarget) onclose();
