  border-radius: 50%;
  background: var(--text-3);
  flex-shrink: 0;
}

.header__link.is-on {
  color: var(--cyan);
  border-color: rgba(75, 203, 255, 0.3);
}

.header__link.is-on .dot {
  background: var(--cyan);
}


/* ---------- Тело ---------- */

.app-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.page {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 16px 16px 28px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.page-head {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 14px;
}

.page-head__body {
  flex: 1;
  min-width: 0;
}

.page-title {
  font-size: 17px;
  font-weight: 650;
  letter-spacing: -0.01em;
  line-height: 1.3;
}

.page-sub {
  color: var(--text-2);
  font-size: 12.5px;
  margin-top: 2px;
  line-height: 1.45;
}

.section-title {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--text-3);
  margin: 18px 2px 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Метка с линией: заголовок секции в приборном стиле */
.section-title::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--border);
}

.section-title:first-child {
  margin-top: 2px;
}

.page-hint {
  color: var(--text-2);
  font-size: 12.5px;
  line-height: 1.5;
  margin-bottom: 14px;
}

/* ============================================================
   Карточки и строки
   ============================================================ */

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: 14px;
  margin-bottom: 10px;
}

.card--flush {
  padding: 2px 12px;
}

.card__title {
  font-size: 13.5px;
  font-weight: 600;
  margin-bottom: 3px;
}

.card__hint {
  font-size: 12px;
  color: var(--text-3);
