//! Небольшие нейросети на candle, портированные из ONNX-моделей ударителя.

pub mod distilbert;
pub mod roformer;

use anyhow::{Result, bail};
use std::path::Path;
use std::process::Command;

/// Проверяет, что safetensors на месте. Если его нет — пытается собрать
/// веса из ONNX скриптом `scripts/export_stress_models.py` (нужен python3
/// с onnx/numpy/torch/safetensors). В готовой сборке файлы уже лежат рядом,
/// так что шаг нужен только при первом запуске из исходников.
pub fn ensure_safetensors(path: &Path) -> Result<()> {
    if path.exists() {
        return Ok(());
    }
    let root = Path::new(env!("CARGO_MANIFEST_DIR"))
        .parent()
        .and_then(|p| p.parent())
        .map(|p| p.to_path_buf())
        .unwrap_or_else(|| Path::new(".").to_path_buf());
    let script = root.join("scripts/export_stress_models.py");
    if !script.exists() {
        bail!(
            "Нет {path:?} и нет {:?} — соберите веса: python3 scripts/export_stress_models.py",
            script
        );
    }
    println!(
        "🔧 Собираю веса ударителя из ONNX ({})...",
        script.display()
    );
    let status = Command::new("python3")
        .arg(&script)
        .current_dir(&root)
        .status();
    match status {
        Ok(s) if s.success() && path.exists() => Ok(()),
        Ok(s) => bail!("Скрипт экспорта весов завершился с кодом {s}; ожидался {path:?}"),
        Err(e) => bail!(
            "Не удалось запустить python3 для экспорта весов ({e}); \
             соберите вручную: python3 scripts/export_stress_models.py"
        ),
    }
}
</file>

<file path=".mimosa/hook-state/sess_f4d9521f-bd6b-4ffd-91a9-c40430846317.mv4sqnce-76916-82c4d723f3.baseline/7dfefc7ff4a6c5a836bd399618049a1ee3b23f120bdd0da9e08709ca505d7fc0.source">
import { reactive } from "vue";
import { listen } from "@tauri-apps/api/event";
import { invoke } from "@tauri-apps/api/core";

/**
 * Состояние приложения.
 *
 * Здесь два независимых слоя:
 *  - `store` — то, что приходит от движка: статус, события, лента действий;
 *  - `settings` — то, что пользователь меняет сам.
 *
 * События движка переводятся в человеческие фразы сразу при получении:
 * страницам не нужно знать про `llm_status` и `audio_level`.
 */

export interface EngineEvent {
  type: string;
  [key: string]: unknown;
}

export interface Settings {
  // Детекция фразы (в интерфейсе не показывается — правится в settings.toml)
  silence_rms_threshold: number;
  silence_timeout_secs: number;
  min_command_duration_secs: number;
  max_command_duration_secs: number;
  followup_window_secs: number;
  // Wake word
  wake_threshold: number;
  wakeword_model: string;
  // Ответы
  llm_enabled: boolean;
  /** Бэкенд LLM: "uzu" (Metal, модели каталога Mirai) или "candle". */
  llm_backend: string;
  /** Модель LLM (имя меняет смысл в зависимости от бэкенда). */
  llm_model: string;
  web_search_auto: boolean;
  llm_normalize: boolean;
  llm_temperature: number;
  llm_max_tokens: number;
  // Голос
  tts_voice: string;
  tts_speed: number;
  // Отклик
  ack_before_llm: boolean;
  /** Помнить темы, от которых разговор ушёл в сторону. */
  topic_memory: boolean;
}

export interface Toast {
  id: number;
  text: string;
  kind: "info" | "ok" | "err";
}

function now(): string {
  return new Date().toLocaleTimeString("ru-RU", { hour: "2-digit", minute: "2-digit" });
}

let ids = 0;

export const store = reactive({
  page: "dashboard" as string,
  /** Страница, с которой пришли в подраздел — для кнопки «назад». */
  pageBack: "more" as string,
  status: {
    engineRunning: false,
    paused: false,
    llmStatus: "loading",
    ttsReady: false,
    /** Рабочая папка агента: от неё считаются пути файловых инструментов. */
    cwd: "",
  },
  /** Что делает движок: wake_word | listening | processing. */
  engineState: "wake_word" as string,
  /**
   * Движок распознаёт сказанное. Отдельный флаг, потому что состояние
   * «processing» появилось в движке позже: если его нет, флаг поднимает
   * приход расшифровки — так интерфейс не остаётся без сигнала.
   */
  processing: false as boolean,
  transcript: "" as string,
  /**
   * Тема, к которой Джарвис только что вернулся по просьбе «мы это забыли».
   * Показывается в чате, чтобы возврат был виден, а не выглядел случайным
   * ответом на пустое место.
   */
  resumedTopic: "" as string,
  wakeScore: 0 as number,
  audioLevel: 0 as number,
  /**
   * Откуда пришёл уровень звука: «mic» — говорит пользователь, «tts» — сам
   * Джарвис. Без этого сфера одинаково реагировала на свою же речь.
   */
  audioSource: "mic" as string,
  /** Джарвис сейчас озвучивает ответ. В этой фазе его можно перебить. */
  speaking: false as boolean,
  /** Команда, которую движок распознал дословно. */
  matchedCommand: "" as string,
  chat: {
    question: "" as string,
    streaming: "" as string,
    done: "" as string,
    busy: false,
  },
  /**
   * Последний обмен репликами для главного экрана: там видно, что услышал
   * Джарвис, что он отвечает и что ответил. Раньше распознанный текст не
   * показывался нигде — интерфейс молчал, даже когда всё работало.
   */
  dialog: {
    heard: "" as string,
    reply: "" as string,
    /** Ответ появился по итогу действия, а не как текст модели. */
    fromAction: false as boolean,
  },
  trainProgress: { epoch: 0, total: 0 } as { epoch: number; total: number },
  recording: false,
  /**
   * Доступ к микрофону: false — движок ждёт разрешения (показываем меню),
   * true — получено (меню закрывается), null — вопросов нет.
   */
  micPermission: null as boolean | null,
  /** Технический журнал — целиком показывается только в «Помощи». */
  logs: [] as string[],
  toasts: [] as Toast[],
});

export function toast(text: string, kind: Toast["kind"] = "info", ms = 2800) {
  const item: Toast = { id: ++ids, text, kind };
  store.toasts.push(item);
  setTimeout(() => {
    const i = store.toasts.findIndex((t) => t.id === item.id);
    if (i !== -1) store.toasts.splice(i, 1);
  }, ms);
}

/** Разделы, которые открываются из «Ещё» и требуют кнопку «назад». */
export const SUB_PAGES = ["chat", "wakeword", "help"];

export function go(page: string) {
  // Запоминаем раздел, откуда ушли, чтобы «назад» вела именно туда.
  if (!SUB_PAGES.includes(page)) store.pageBack = page;
  store.page = page;
}

// ---------- Настройки ----------

export const settings = reactive<Settings>({
  silence_rms_threshold: 0.018,
  silence_timeout_secs: 0.7,
  min_command_duration_secs: 0.5,
  max_command_duration_secs: 8,
  followup_window_secs: 8,
  wake_threshold: 0.6,
  wakeword_model: "jarvis_model_2.rpw",
  llm_enabled: true,
  llm_backend: "uzu",
  llm_model: "qwen3.5-2b-mirai-m",
  web_search_auto: true,
  llm_normalize: true,
  llm_temperature: 0.6,
  llm_max_tokens: 256,
  tts_voice: "ru_dmitriy",
  tts_speed: 1.0,
  ack_before_llm: false,
  topic_memory: true,
});

export async function loadSettings() {
  try {
    Object.assign(settings, await invoke<Settings>("get_settings"));
  } catch {
    // Движок ещё не поднят — остаются значения по умолчанию.
  }
}

/**
 * Меняет настройки и сразу сохраняет. Бэкенд ждёт структуру целиком, поэтому
 * отправляем весь объект: поля, которых нет в интерфейсе, сохраняются как есть.
 */
export async function patchSettings(patch: Partial<Settings>) {
  const previous = { ...settings };
  Object.assign(settings, patch);
  try {
    await invoke("save_settings", { settings: { ...settings } });
  } catch (e) {
    Object.assign(settings, previous);
    toast(`Не удалось сохранить: ${e}`, "err");
  }
}

// ---------- Инициализация ----------

export async function initEvents() {
  await listen<EngineEvent>("engine-event", (event) => {
    const ev = event.payload;
    switch (ev.type) {
      case "state_changed": {
        const state = (ev.state as string) ?? "wake_word";
        store.engineState = state;
        // Фраза принята в обработку или, наоборот, движок вернулся к ожиданию.
        if (state === "processing") store.processing = true;
        else if (state === "wake_word" || state === "listening") store.processing = false;
        break;
      }
      case "wake_word_detected":
        store.wakeScore = (ev.score as number) ?? 0;
        store.transcript = "";
        store.processing = false;
        // Новый вызов — прошлый обмен уходит в историю журнала, а не в hero.
        store.dialog.reply = "";
        store.dialog.fromAction = false;
        break;
      case "transcript":
        store.transcript = (ev.text as string) ?? "";
        store.dialog.heard = store.transcript;
        store.dialog.reply = "";
        store.dialog.fromAction = false;
        // Запасной сигнал для движка без состояния «processing».
        if (store.transcript) store.processing = true;
        break;
      case "topic_resumed":
        store.resumedTopic = (ev.topic as string) ?? "";
        store.logs.unshift(`${now()}  🧠 Возврат к теме: ${store.resumedTopic}`);
        break;
      case "action_started": {
        const summary = ((ev.summary as string) ?? "").slice(0, 120);
        store.logs.unshift(`${now()}  🔧 ${(ev.tool as string) ?? ""} ${summary}`);
        if (store.logs.length > 300) store.logs.length = 300;
        break;
      }
      case "action_result": {
        const mark = (ev.ok as boolean) ? "✅" : "❗";
        const summary = ((ev.summary as string) ?? "").slice(0, 160);
        store.matchedCommand = "";
        // Итог действия Джарвис проговаривает — показываем ту же фразу.
        if (summary && store.dialog.heard) {
          store.dialog.reply = summary;
          store.dialog.fromAction = true;
        }
        store.logs.unshift(`${now()}  ${mark} ${summary}`);
        if (store.logs.length > 300) store.logs.length = 300;
        break;
      }
      case "command_matched":
        // Дословное совпадение команды раньше нигде не было видно: казалось,
        // что Джарвис молча проигнорировал просьбу.
        store.matchedCommand = (ev.name as string) ?? "";
        store.logs.unshift(`${now()}  ⚡ Команда: ${store.matchedCommand}`);
        break;
      case "command_not_found":
        store.logs.unshift(`${now()}  ❓ Команда не найдена: ${(ev.text as string) ?? ""}`);
        break;
      case "llm_status":
        if ((ev.status as string) === "thinking") store.chat.busy = true;
        refreshStatus();
        break;
      case "llm_chunk":
        store.chat.streaming = (ev.text as string) ?? "";
        store.chat.busy = true;
        break;
      case "llm_done":
        store.chat.done = (ev.text as string) ?? "";
        store.chat.streaming = "";
        store.chat.busy = false;
        store.processing = false;
        // Ответ на главный экран: у текстовых ответов движок шлёт llm_done.
        if (store.dialog.heard && store.chat.done) {
          store.dialog.reply = store.chat.done;
        }
        break;
      case "audio_level":
        store.audioLevel = (ev.level as number) ?? 0;
        store.audioSource = (ev.source as string) ?? "mic";
        break;
      case "train_progress":
        store.trainProgress = {
          epoch: (ev.epoch as number) ?? 0,
          total: (ev.total as number) ?? 0,
        };
        break;
      case "train_done":
        store.trainProgress = { epoch: 0, total: 0 };
        break;
      case "record_saved":
        store.recording = false;
        break;
      case "mic_permission":
        store.micPermission = (ev.granted as boolean) ?? false;
        if (store.micPermission) toast("Микрофон подключён", "ok");
        break;
      case "log":
        store.logs.unshift(`${now()}  ${(ev.message as string) ?? ""}`);
        if (store.logs.length > 300) store.logs.length = 300;
        break;
      case "error": {
        const message = (ev.message as string) ?? "Неизвестная ошибка";
        store.recording = false;
        store.chat.busy = false;
        store.processing = false;
        store.logs.unshift(`${now()}  ❗ ${message}`);
        toast(message, "err", 5000);
        break;
      }
      default:
        break;
    }
  });

  // Фаза «говорит» отдельным событием: у движка нет для неё состояния, а без
  // неё в шапке было «Готов», пока Джарвис ещё договаривал фразу.
  await listen<{ speaking: boolean }>("speech", (event) => {
    store.speaking = Boolean(event.payload?.speaking);
  });

  setInterval(refreshStatus, 2000);
  await Promise.all([refreshStatus(), loadSettings()]);
}

export async function refreshStatus() {
  try {
    store.status = await invoke("status");
  } catch {
    // движок ещё не поднят
  }
}
</file>

<file path=".mimosa/hook-state/sess_f4d9521f-bd6b-4ffd-91a9-c40430846317.mv4sqnce-76916-82c4d723f3.baseline/8be0056ed4ebff4324b2e60158bdc02c6a04fdcb39b8d710e79234ce4b434691.source">
//! Candle-бэкенд LLM: MiniCPM5-1B-ru и Qwen3.5-0.8B, реализации архитектур
//! на чистом candle + Metal. Был единственным движком `LlmEngine`, теперь
//! стоит за диспетчером в `mod.rs` (второй бэкенд — uzu на macOS).

use super::config::{self, ModelConfig};
use super::streaming::{MAX_SENTENCE_CHARS, find_chunk_end, speakable, strip_think};
use super::template;
use anyhow::{Context, Result};
use candle_core::{DType, Device, IndexOp};
use std::sync::atomic::{AtomicBool, Ordering};
use std::time::Instant;
use tokenizers::Tokenizer;

/// Терминаторы ответа: добавляются к eos из конфига, если есть в словаре.
const EXTRA_STOP_TOKENS: &[&str] = &["<|eot_id|>", "<|im_end|>", "<|endoftext|>"];

fn pick_device() -> Device {
    match Device::new_metal(0) {
        Ok(d) => {
            println!("✅ LLM: устройство Metal");
            d
        }
        Err(e) => {
            eprintln!("⚠️ Metal недоступен ({e}), LLM будет работать на CPU");
            Device::Cpu
        }
    }
}

/// Загруженная модель вместе с её (модельно-специфичным) кэшем.
enum CandleModel {
    /// MiniCPM5-1B-ru (Llama-архитектура, KV-кэш на каждый слой).
    Llama {
        model: super::model::LlamaModel,
        caches: Vec<super::model::KvCache>,
    },
    /// Qwen3.5-0.8B (гибрид Gated DeltaNet + gated attention).
    Qwen35 {
        model: super::qwen35::Qwen35Model,
        cache: super::qwen35::Qwen35Cache,
    },
}

impl CandleModel {
    fn forward(&mut self, ids: &[u32], start_pos: usize) -> Result<candle_core::Tensor> {
        match self {
            Self::Llama { model, caches } => model.forward(ids, start_pos, caches),
            Self::Qwen35 { model, cache } => model.forward(ids, start_pos, cache),
        }
    }

    fn rope_len(&self) -> usize {
        match self {
            Self::Llama { model, .. } => model.rope_len(),
            Self::Qwen35 { model, .. } => model.rope_len(),
        }
    }

    fn num_hidden_layers(&self) -> usize {
        match self {
            Self::Llama { model, .. } => model.config().num_hidden_layers,
            Self::Qwen35 { model, .. } => model.config.num_hidden_layers,
        }
    }

    fn vocab_size(&self) -> usize {
        match self {
            Self::Llama { model, .. } => model.config().vocab_size,
            Self::Qwen35 { model, .. } => model.config.vocab_size,
        }
    }

    fn reset_caches(&mut self) {
        match self {
            Self::Llama { caches, .. } => {
                for c in caches {
                    c.reset();
                }
            }
            Self::Qwen35 { model, cache } => {
                *cache = model.new_cache();
            }
        }
    }
}

/// Загружает модель из каталога по её config.json (qwen3_5_text → Qwen3.5,
/// иначе — Llama-семейство: MiniCPM5).
fn load_model_dir(
    models_dir: &std::path::Path,
) -> Result<(CandleModel, Tokenizer, Vec<u32>, bool, &'static str)> {
    let dir = models_dir.join(config::model_name());
    if super::qwen35::Qwen35Config::is_qwen35_config(&dir.join("config.json")) {
        let device = pick_device();
        let model = super::qwen35::Qwen35Model::load(&dir, &device)
            .with_context(|| format!("Не удалось загрузить Qwen3.5 из {}", dir.display()))?;
        let tokenizer = Tokenizer::from_file(dir.join("tokenizer.json"))
            .map_err(|e| anyhow::anyhow!("Не удалось загрузить токенизатор: {e}"))?;
        let mut eos_ids = model.config.eos_ids.clone();
        for stop in EXTRA_STOP_TOKENS {
            if let Some(id) = tokenizer.token_to_id(stop)
                && !eos_ids.contains(&id)
            {
                eos_ids.push(id);
            }
        }
        println!(
            "   LLM: модель {}/qwen3_5, eos_ids={:?}",
            config::model_name(),
            eos_ids
        );
        let cache = model.new_cache();
        Ok((
            CandleModel::Qwen35 { model, cache },
            tokenizer,
            eos_ids,
            false,
            template::QWEN_ASSISTANT_PREFIX,
        ))
    } else {
        let started = Instant::now();
        let files = config::ensure_model_downloaded(models_dir)?;
        let cfg = ModelConfig::load(&files.config)?;
        let eos_ids = cfg.eos_ids();
        let bos_id = cfg.bos_id();
        let prompt_bos = cfg.use_bos_in_template();

        let device = pick_device();
        let model = super::model::LlamaModel::load(&files, cfg, &device)
            .context("Не удалось загрузить веса MiniCPM5-1B")?;

        let tokenizer = Tokenizer::from_file(&files.tokenizer)
            .map_err(|e| anyhow::anyhow!("Не удалось загрузить токенизатор: {e}"))?;
        let mut eos_ids = eos_ids;
        for stop in EXTRA_STOP_TOKENS {
            if let Some(id) = tokenizer.token_to_id(stop)
                && !eos_ids.contains(&id)
            {
                eos_ids.push(id);
            }
        }
        println!(
            "   LLM: bos_id={:?}, eos_ids={:?}, слоёв={}, vocab={}",
            bos_id,
            eos_ids,
            model.config().num_hidden_layers,
            model.config().vocab_size
        );
        println!("✅ MiniCPM5-1B загружена за {:.1?}", started.elapsed());
        let caches = vec![super::model::KvCache::new(); model.config().num_hidden_layers];
        Ok((
            CandleModel::Llama { model, caches },
            tokenizer,
            eos_ids,
            prompt_bos,
            "",
        ))
    }
}

pub struct CandleEngine {
    engine: CandleModel,
    tokenizer: Tokenizer,
    eos_ids: Vec<u32>,
    prompt_bos: bool,
    /// Дописка после `<|im_start|>assistant\n`: у Qwen3.5 — принудительно
    /// закрытый блок рассуждений, у MiniCPM5 — пустая строка.
    assistant_prefix: &'static str,
    /// Токены, уже лежащие в KV-кэше (префикс последнего промпта + ответа).
    /// Следующий вызов с тем же префиксом префиллится только с дельты.
    prefix_cache: Vec<u32>,
}

impl CandleEngine {
    /// Загрузка модели из `models/` (каталог задаёт `llm_model` в settings.toml).
    pub fn load(models_dir: &std::path::Path) -> Result<Self> {
        let started = Instant::now();
        let (engine, tokenizer, eos_ids, prompt_bos, assistant_prefix) =
            load_model_dir(models_dir)?;

        println!(
            "   LLM: слоёв={}, vocab={}, потолок контекста={}",
            engine.num_hidden_layers(),
            engine.vocab_size(),
            engine.rope_len()
        );
        println!("✅ LLM загружена за {:.1?}", started.elapsed());

        Ok(Self {
            engine,
            tokenizer,
            eos_ids,
            prompt_bos,
            assistant_prefix,
            prefix_cache: Vec::new(),
        })
    }

    fn reset(&mut self) {
        self.engine.reset_caches();
        self.prefix_cache.clear();
    }

    pub fn generate_streaming(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        cancel: &AtomicBool,
        on_sentence: impl FnMut(&str),
        on_progress: impl FnMut(&str),
    ) -> Result<String> {
        self.generate_streaming_with_params(
            system,
            history,
            user,
            None,
            cancel,
            on_sentence,
            on_progress,
        )
    }

    #[allow(clippy::too_many_arguments)]
    pub fn generate_streaming_with_params(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        params_override: Option<config::GenerationParams>,
        cancel: &AtomicBool,
        on_sentence: impl FnMut(&str),
        on_progress: impl FnMut(&str),
    ) -> Result<String> {
        self.generate_streaming_inner(
            system,
            history,
            user,
            params_override,
            cancel,
            None,
            on_sentence,
            on_progress,
        )
    }

    /// Генерация с «вставленным началом ответа ассистента»: `prefill`
    /// дописывается в промпт сразу после заголовка `assistant`, и модель
    /// продолжает только его. Так она не тратит токены на рассуждения
    /// и не может выдать кривой JSON.
    #[allow(clippy::too_many_arguments)]
    pub fn generate_streaming_with_prefill(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        params_override: Option<config::GenerationParams>,
        cancel: &AtomicBool,
        prefill: &str,
        on_sentence: impl FnMut(&str),
        on_progress: impl FnMut(&str),
    ) -> Result<String> {
        self.generate_streaming_inner(
            system,
            history,
            user,
            params_override,
            cancel,
            Some(prefill),
            on_sentence,
            on_progress,
        )
    }

    #[allow(clippy::too_many_arguments)]
    pub(crate) fn generate_streaming_inner(
        &mut self,
        system: &str,
        history: &[template::ChatTurn],
        user: &str,
        params_override: Option<config::GenerationParams>,
        cancel: &AtomicBool,
        prefill: Option<&str>,
        mut on_sentence: impl FnMut(&str),
        mut on_progress: impl FnMut(&str),
    ) -> Result<String> {
        let mut prompt = template::build_chat_prompt(
            system,
            history,
            user,
            if self.prompt_bos {
                Some(template::MINICPM_BOS)
            } else {
                None
            },
            self.assistant_prefix,
        );
        if let Some(prefix) = prefill {
            prompt.push_str(prefix);
        }
        let encoding = self
            .tokenizer
            .encode(prompt, false)
            .map_err(|e| anyhow::anyhow!("Ошибка токенизации промпта: {e}"))?;
        let mut context: Vec<u32> = encoding.get_ids().to_vec();
        if context.is_empty() {
            anyhow::bail!("Промпт не дал токенов");
        }

        let params = params_override.unwrap_or_else(|| {
            config::generation_params()
                .read()
                .unwrap_or_else(|e| e.into_inner())
                .clone()
        });
        if context.len() + params.max_tokens >= self.engine.rope_len() {
            anyhow::bail!("Промпт слишком длинный: {} токенов", context.len());
        }

        // Префиксный кэш: если начало промпта уже посчитано в KV-кэше
        // (системный промпт + история + прошлые ходы агентного цикла),
        // префиллим только дельту.
        let cached_len = self.prefix_cache.len();
        let reusable = cached_len > 0
            && cached_len < context.len()
            && context[..cached_len] == self.prefix_cache[..];
        let prefill_from = if reusable {
            if context.len() - cached_len > 1 {
                println!(
                    "   LLM: префикс {} ток. в кэше, допрефилл {} ток.",
                    cached_len,
                    context.len() - cached_len
                );
            }
            cached_len
        } else {
            self.reset();
            0
        };
        let mut rng = rand::thread_rng();
        let prompt_len = context.len();
        let mut suppress_think = false;
        let mut loop_hits = 0u32;
        const LOOP_WINDOW: usize = 10;
        const LOOP_MAX_HITS: u32 = 3;

        let t_prefill = Instant::now();
        let mut logits = self
            .engine
            .forward(&context[prefill_from..], prefill_from)?;
        let mut next_pos = context.len();
        let t_prefill = t_prefill.elapsed();
        let t_decode = Instant::now();
        let mut text = String::new();
        let mut buf = String::new();

        // Флаг tool-call: если ответ начинается с <tool>, весь текст идёт
        // только в буфер, минуя TTS.
        let mut is_tool_call: Option<bool> = None;
        let mut tool_probe = String::new();
        if let Some(prefix) = prefill {
            text.push_str(prefix);
            tool_probe.push_str(prefix);
            is_tool_call = Some(prefix.trim_start().starts_with("<tool>"));
        }

        loop {
            if cancel.load(Ordering::SeqCst) {
                break;
            }

            let last = logits.dim(0)? - 1;
            let mut row: Vec<f32> = logits
                .i((last, ..))?
                .to_dtype(DType::F32)?
                .flatten_all()?
                .to_vec1()?;

            let penalty = params.repeat_penalty + 0.6 * loop_hits as f32;
            super::sampler::apply_repeat_penalty(&mut row, penalty, &context, params.repeat_window);

            let tok =
                super::sampler::sample_top_p(&row, params.temperature, params.top_p, &mut rng);
            if self.eos_ids.contains(&tok) {
                break;
            }

            context.push(tok);

            let generated = &context[prompt_len..];
            if generated.len() >= LOOP_WINDOW * 2
                && generated[generated.len() - LOOP_WINDOW..]
                    == generated[generated.len() - 2 * LOOP_WINDOW..generated.len() - LOOP_WINDOW]
            {
                loop_hits += 1;
                if loop_hits >= LOOP_MAX_HITS {
                    println!("🛑 LLM зациклилась — останавливаю генерацию");
                    break;
                }
            }

            let piece = self
                .tokenizer
                .decode(&[tok], true)
                .map_err(|e| anyhow::anyhow!("Ошибка декодирования токена: {e}"))?;

            let piece = strip_think(&piece, &mut suppress_think);
            if piece.is_empty() {
                if context.len() - prompt_len >= params.max_tokens {
                    break;
                }
                logits = self.engine.forward(&[tok], next_pos)?;
                next_pos += 1;
                continue;
            }

            text.push_str(&piece);

            if is_tool_call.is_none() {
                tool_probe.push_str(&piece);
                if tool_probe.trim_start().len() >= 6 {
                    let trimmed = tool_probe.trim_start();
                    is_tool_call = Some(trimmed.starts_with("<tool>"));
                }
            }

            // JSON инструмента уже валиден — продолжать незачем.
            if is_tool_call == Some(true) && crate::tools::tool_json_complete(&text) {
                println!("   ⏹ tool-JSON закрыт — генерация остановлена");
                break;
            }

            if is_tool_call == Some(true) {
                if context.len() - prompt_len >= params.max_tokens {
                    break;
                }
                logits = self.engine.forward(&[tok], next_pos)?;
                next_pos += 1;
                continue;
            }

            buf.push_str(&piece);

            while let Some(pos) = find_chunk_end(&buf) {
                let sentence: String = buf.drain(..pos).collect();
                if sentence.contains("<tool>") || sentence.contains("</tool>") {
                    continue;
                }
                if speakable(&sentence) {
                    on_sentence(&sentence);
                    on_progress(&text);
                }
            }

            if buf.chars().count() > MAX_SENTENCE_CHARS
                && let Some(pos) = buf.rfind(' ')
            {
                let piece_flush: String = buf.drain(..pos + 1).collect();
                if !piece_flush.contains("<tool>")
                    && !piece_flush.contains("</tool>")
                    && speakable(&piece_flush)
                {
                    on_sentence(&piece_flush);
                    on_progress(&text);
                }
            }

            if context.len() - prompt_len >= params.max_tokens {
                break;
            }
            if cancel.load(Ordering::SeqCst) {
                break;
            }

            logits = self.engine.forward(&[tok], next_pos)?;
            next_pos += 1;
        }

        if is_tool_call != Some(true) && !cancel.load(Ordering::SeqCst) {
            let tail = std::mem::take(&mut buf);
            if !tail.contains("<tool>") && !tail.contains("</tool>") && speakable(&tail) {
                on_sentence(&tail);
            }
        }

        let decoded = context.len() - prompt_len;
        let decode_ms = t_decode.elapsed().as_millis() as f64;
        println!(
            "   LLM: префилл {} ток. за {:.0?}, декод {} ток. за {:.0?} ({:.1} мс/ток.)",
            prompt_len,
            t_prefill,
            decoded,
            decode_ms,
            if decoded > 0 {
                decode_ms / decoded as f64
            } else {
                0.0
            }
        );

        self.prefix_cache = context[..next_pos.min(context.len())].to_vec();

        Ok(text)
    }
}
