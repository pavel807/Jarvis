<file path="app/src/store.svelte.ts">
import { listen } from "@tauri-apps/api/event";
import { invoke } from "@tauri-apps/api/core";

/**
 * Состояние приложения.
 *
 * Здесь два независимых слоя:
 *  - `store` — то, что приходит от движка: статус, события, лента действий;
 *  - `settings` — то, что пользователь меняет сам.
 *
 * События движка переводятся в человеческие фразы сразу при получении:
 * страницам не нужно знать про `llm_status` и `audio_level`.
 *
 * Файл называется `.svelte.ts`, чтобы Svelte 5 скомпилировал руны.
 */

export interface EngineEvent {
  type: string;
  [key: string]: unknown;
}

export interface EngineStatus {
  engineRunning: boolean;
  paused: boolean;
  llmStatus: string;
  ttsReady: boolean;
  /** Рабочая папка агента: от неё считаются пути файловых инструментов. */
  cwd: string;
}

export interface Settings {
  // Детекция фразы (в интерфейсе не показывается — правится в settings.toml)
  silence_rms_threshold: number;
  silence_timeout_secs: number;
  min_command_duration_secs: number;
  max_command_duration_secs: number;
  followup_window_secs: number;
  // Wake word
  wake_threshold: number;
  wakeword_model: string;
  // Ответы
  llm_enabled: boolean;
  /** Бэкенд LLM: "uzu" (Metal, модели каталога Mirai) или "candle". */
  llm_backend: string;
  /** Модель LLM (имя меняет смысл в зависимости от бэкенда). */
  llm_model: string;
  web_search_auto: boolean;
  llm_normalize: boolean;
  llm_temperature: number;
  /** Страховочный лимит длины ответа в токенах; 0 — без лимита. */
  llm_max_tokens: number;
  // Голос
  tts_voice: string;
  tts_speed: number;
  // Отклик
  ack_before_llm: boolean;
  /** Помнить темы, от которых разговор ушёл в сторону. */
  topic_memory: boolean;
}

export interface Toast {
  id: number;
  text: string;
  kind: "info" | "ok" | "err";
}

function now(): string {
  return new Date().toLocaleTimeString("ru-RU", { hour: "2-digit", minute: "2-digit" });
}

let ids = 0;

export const store = $state({
  page: "dashboard" as string,
  /** Страница, с которой пришли в подраздел — для кнопки «назад». */
  pageBack: "more" as string,
  status: {
    engineRunning: false,
    paused: false,
    llmStatus: "loading",
    ttsReady: false,
    /** Рабочая папка агента: от неё считаются пути файловых инструментов. */
    cwd: "",
  } as EngineStatus,
  /** Что делает движок: wake_word | listening | processing. */
  engineState: "wake_word" as string,
  /**
   * Движок распознаёт сказанное. Отдельный флаг, потому что состояние
   * «processing» появилось в движке позже: если его нет, флаг поднимает
   * приход расшифровки — так интерфейс не остаётся без сигнала.
   */
  processing: false as boolean,
  transcript: "" as string,
  /**
   * Тема, к которой Джарвис только что вернулся по просьбе «мы это забыли».
   * Показывается в чате, чтобы возврат был виден, а не выглядел случайным
   * ответом на пустое место.
   */
  resumedTopic: "" as string,
  wakeScore: 0 as number,
  audioLevel: 0 as number,
  /**
   * Откуда пришёл уровень звука: «mic» — говорит пользователь, «tts» — сам
   * Джарвис. Без этого сфера одинаково реагировала на свою же речь.
   */
  audioSource: "mic" as string,
  /** Джарвис сейчас озвучивает ответ. В этой фазе его можно перебить. */
  speaking: false as boolean,
  /** Команда, которую движок распознал дословно. */
  matchedCommand: "" as string,
  chat: {
    question: "" as string,
    streaming: "" as string,
    done: "" as string,
    busy: false,
    /** Последняя ошибка движка во время ожидания ответа: чат показывает её. */
    error: "" as string,
  },
  /**
   * Последний обмен репликами для главного экрана: там видно, что услышал
   * Джарвис, что он отвечает и что ответил. Раньше распознанный текст не
   * показывался нигде — интерфейс молчал, даже когда всё работало.
   */
  dialog: {
    heard: "" as string,
    reply: "" as string,
    /** Ответ появился по итогу действия, а не как текст модели. */
    fromAction: false as boolean,
  },
  trainProgress: { epoch: 0, total: 0 } as { epoch: number; total: number },
  recording: false,
  /**
   * Доступ к микрофону: false — движок ждёт разрешения (показываем меню),
   * true — получено (меню закрывается), null — вопросов нет.
   */
  micPermission: null as boolean | null,
  /** Технический журнал — целиком показывается только в «Помощи». */
  logs: [] as string[],
  toasts: [] as Toast[],
});

export function toast(text: string, kind: Toast["kind"] = "info", ms = 2800) {
  const item: Toast = { id: ++ids, text, kind };
  store.toasts.push(item);
  setTimeout(() => {
    const i = store.toasts.findIndex((t) => t.id === item.id);
    if (i !== -1) store.toasts.splice(i, 1);
  }, ms);
}

/** Разделы, которые открываются из «Ещё» и требуют кнопку «назад». */
export const SUB_PAGES = ["chat", "wakeword", "help"];

export function go(page: string) {
  // Запоминаем раздел, откуда ушли, чтобы «назад» вела именно туда.
  if (!SUB_PAGES.includes(page)) store.pageBack = page;
  store.page = page;
}

// ---------- Настройки ----------

export const settings = $state<Settings>({
  silence_rms_threshold: 0.018,
  silence_timeout_secs: 0.7,
  min_command_duration_secs: 0.5,
  max_command_duration_secs: 8,
  followup_window_secs: 8,
  wake_threshold: 0.6,
  wakeword_model: "jarvis_model_2.rpw",
  llm_enabled: true,
  llm_backend: "uzu",
  llm_model: "qwen3.5-2b-mirai-m",
  web_search_auto: true,
  llm_normalize: true,
  llm_temperature: 0.6,
  llm_max_tokens: 0,
  tts_voice: "ru_dmitriy",
  tts_speed: 1.0,
  ack_before_llm: false,
  topic_memory: true,
});

export async function loadSettings() {
  try {
    Object.assign(settings, await invoke<Settings>("get_settings"));
  } catch {
    // Движок ещё не поднят — остаются значения по умолчанию.
  }
}

/**
 * Меняет настройки и сразу сохраняет. Бэкенд ждёт структуру целиком, поэтому
 * отправляем весь объект: поля, которых нет в интерфейсе, сохраняются как есть.
 */
export async function patchSettings(patch: Partial<Settings>) {
  const previous = { ...settings };
  Object.assign(settings, patch);
  try {
    await invoke("save_settings", { settings: { ...settings } });
  } catch (e) {
    Object.assign(settings, previous);
    toast(`Не удалось сохранить: ${e}`, "err");
  }
}

// ---------- Инициализация ----------

export async function initEvents() {
  await listen<EngineEvent>("engine-event", (event) => {
    const ev = event.payload;
    switch (ev.type) {
      case "state_changed": {
        const state = (ev.state as string) ?? "wake_word";
        store.engineState = state;
        // Фраза принята в обработку или, наоборот, движок вернулся к ожиданию.
        if (state === "processing") store.processing = true;
        else if (state === "wake_word" || state === "listening") store.processing = false;
        break;
      }
      case "wake_word_detected":
        store.wakeScore = (ev.score as number) ?? 0;
        store.transcript = "";
        store.processing = false;
        // Новый вызов — прошлый обмен уходит в историю журнала, а не в hero.
        store.dialog.reply = "";
        store.dialog.fromAction = false;
        break;
      case "transcript":
        store.transcript = (ev.text as string) ?? "";
        store.dialog.heard = store.transcript;
        store.dialog.reply = "";
        store.dialog.fromAction = false;
        // Запасной сигнал для движка без состояния «processing».
        if (store.transcript) store.processing = true;
        break;
      case "topic_resumed":
        store.resumedTopic = (ev.topic as string) ?? "";
        store.logs.unshift(`${now()}  🧠 Возврат к теме: ${store.resumedTopic}`);
        break;
      case "action_started": {
        const summary = ((ev.summary as string) ?? "").slice(0, 120);
        store.logs.unshift(`${now()}  🔧 ${(ev.tool as string) ?? ""} ${summary}`);
        if (store.logs.length > 300) store.logs.length = 300;
        break;
      }
      case "action_result": {
        const mark = (ev.ok as boolean) ? "✅" : "❗";
        const summary = ((ev.summary as string) ?? "").slice(0, 160);
        store.matchedCommand = "";
        // Итог действия Джарвис проговаривает — показываем ту же фразу.
        if (summary && store.dialog.heard) {
          store.dialog.reply = summary;
          store.dialog.fromAction = true;
        }
        store.logs.unshift(`${now()}  ${mark} ${summary}`);
        if (store.logs.length > 300) store.logs.length = 300;
        break;
      }
      case "command_matched":
        // Дословное совпадение команды раньше нигде не было видно: казалось,
        // что Джарвис молча проигнорировал просьбу.
        store.matchedCommand = (ev.name as string) ?? "";
        store.logs.unshift(`${now()}  ⚡ Команда: ${store.matchedCommand}`);
        break;
      case "command_not_found":
        store.logs.unshift(`${now()}  ❓ Команда не найдена: ${(ev.text as string) ?? ""}`);
        break;
      case "llm_status":
        if ((ev.status as string) === "thinking") store.chat.busy = true;
        void refreshStatus();
        break;
      case "llm_chunk":
        store.chat.streaming = (ev.text as string) ?? "";
        store.chat.busy = true;
        store.chat.error = "";
        break;
      case "llm_done":
        store.chat.done = (ev.text as string) ?? "";
        store.chat.streaming = "";
        store.chat.busy = false;
        store.chat.error = "";
        store.processing = false;
        // Ответ на главный экран: у текстовых ответов движок шлёт llm_done.
        if (store.dialog.heard && store.chat.done) {
          store.dialog.reply = store.chat.done;
        }
        break;
      case "audio_level":
        store.audioLevel = (ev.level as number) ?? 0;
        store.audioSource = (ev.source as string) ?? "mic";
        break;
      case "train_progress":
        store.trainProgress = {
          epoch: (ev.epoch as number) ?? 0,
          total: (ev.total as number) ?? 0,
        };
        break;
      case "train_done":
        store.trainProgress = { epoch: 0, total: 0 };
        break;
      case "record_saved":
        store.recording = false;
        break;
      case "mic_permission":
        store.micPermission = (ev.granted as boolean) ?? false;
        if (store.micPermission) toast("Микрофон подключён", "ok");
        break;
      case "log":
        store.logs.unshift(`${now()}  ${(ev.message as string) ?? ""}`);
        if (store.logs.length > 300) store.logs.length = 300;
        break;
      case "error": {
        const message = (ev.message as string) ?? "Неизвестная ошибка";
        const wasChatPending = store.chat.busy || Boolean(store.chat.question);
        store.recording = false;
        store.chat.busy = false;
        store.processing = false;
        // Чат ждал ответ — вместо вечно крутящегося спиннера покажем ошибку.
        if (wasChatPending) store.chat.error = message;
        store.logs.unshift(`${now()}  ❗ ${message}`);
        toast(message, "err", 5000);
        break;
      }
      default:
        break;
    }
  });

  // Фаза «говорит» отдельным событием: у движка нет для неё состояния, а без
  // неё в шапке было «Готов», пока Джарвис ещё договаривал фразу.
  await listen<{ speaking: boolean }>("speech", (event) => {
    store.speaking = Boolean(event.payload?.speaking);
  });

  setInterval(refreshStatus, 2000);
  await Promise.all([refreshStatus(), loadSettings()]);
}

export async function refreshStatus() {
  try {
    store.status = await invoke<EngineStatus>("status");
  } catch {
    // движок ещё не поднят
  }
}
</file>

<file path="app/src/UtilsWindow.svelte">
<script lang="ts">
  import { onDestroy, onMount } from "svelte";
  import { invoke } from "@tauri-apps/api/core";
  import { listen } from "@tauri-apps/api/event";
  import AppIcon from "./components/AppIcon.svelte";

  /** Окно «Утилиты»: таймеры, секундомер, календарь. Открывается голосом
   * («поставь таймер на 5 минут», «открой календарь») или кнопкой вручную. */

  const TABS = [
    { key: "timer", title: "Таймер", icon: "stop" },
    { key: "stopwatch", title: "Секундомер", icon: "play" },
    { key: "calendar", title: "Календарь", icon: "grid" },
  ] as const;

  let tab = $state<string>("timer");

  // ---------- Таймеры ----------
  interface UtilTimer {
    id: number;
    label: string;
    endsAt: number;
    total: number;
    kind: "timer" | "alarm";
    fired?: boolean;
  }
  let timers = $state<UtilTimer[]>([]);
  let now = $state(Date.now());
  let ticker: number | undefined;

  let manualLabel = $state("");
  let manualMinutes = $state(5);
  let manualBusy = $state(false);

  async function closeWindow() {
    try {
      await invoke("utils_close");
    } catch (e) {
      console.error(e);
    }
  }

  async function startManual() {
    if (manualBusy || manualMinutes <= 0) return;
    manualBusy = true;
    try {
      await invoke("timer_start", {
        label: manualLabel,
        seconds: Math.round(manualMinutes * 60),
      });
      manualLabel = "";
    } catch (e) {
      console.error(e);
    } finally {
      manualBusy = false;
    }
  }

  async function stopTimer(id: number) {
    try {
      await invoke("timer_cancel", { id });
    } catch {
      // уже сработал и сам ушёл из списка
      timers = timers.filter((t) => t.id !== id);
    }
  }

  function fmtRemaining(endsAt: number): string {
    const secs = Math.max(0, Math.ceil((endsAt - now) / 1000));
    const m = Math.floor(secs / 60);
    const s = secs % 60;
    return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
  }

  function pctDone(t: UtilTimer): number {
    const passed = now - (t.endsAt - t.total * 1000);
    return Math.min(100, Math.max(0, (passed / (t.total * 1000)) * 100));
  }

  // ---------- Секундомер ----------
  let swRunning = $state(false);
  let swStartedAt = $state(0);
  let swAccumulated = $state(0);
  let swNow = $state(Date.now());
  const swElapsed = $derived.by(() => {
    const live = swRunning ? swNow - swStartedAt : 0;
    return swAccumulated + live;
  });
  function swToggle() {
    if (swRunning) {
      swAccumulated += Date.now() - swStartedAt;
      swRunning = false;
    } else {
      swStartedAt = Date.now();
      swRunning = true;
    }
  }
  function swReset() {
    swRunning = false;
    swAccumulated = 0;
  }
  function fmtMs(ms: number): string {
    const total = Math.floor(ms / 10);
    const cs = total % 100;
    const s = Math.floor(total / 100) % 60;
    const m = Math.floor(total / 6000);
    return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}.${String(cs).padStart(2, "0")}`;
  }

  // ---------- Календарь ----------
  const WEEKDAYS = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
  const MONTHS = [
    "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь",
    "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь",
  ];
  const today = new Date();
  let viewYear = $state(today.getFullYear());
  let viewMonth = $state(today.getMonth());

  const calendarCells = $derived.by(() => {
    const first = new Date(viewYear, viewMonth, 1);
    const offset = (first.getDay() + 6) % 7; // неделя с понедельника
    const days = new Date(viewYear, viewMonth + 1, 0).getDate();
    const cells: { day: number; current: boolean }[] = [];
    for (let i = 0; i < offset; i++) cells.push({ day: 0, current: false });
    for (let d = 1; d <= days; d++) cells.push({ day: d, current: true });
    while (cells.length % 7 !== 0) cells.push({ day: 0, current: false });
    return cells;
  });
  const isToday = (day: number) =>
    day === today.getDate() &&
    viewMonth === today.getMonth() &&
    viewYear === today.getFullYear();
  function shiftMonth(delta: number) {
    const m = viewMonth + delta;
    viewMonth = ((m % 12) + 12) % 12;
    viewYear += Math.floor(m / 12);
  }

  let unlisteners: (() => void)[] = [];

  onMount(async () => {
    unlisteners.push(
      await listen("engine-event", (e: { payload: any }) => {
        const ev = e.payload ?? {};
        if (ev.type === "timer_started") {
          timers.push({
            id: ev.id as number,
            label: (ev.label as string) ?? "",
            endsAt: Date.now() + (ev.seconds as number) * 1000,
            total: ev.seconds as number,
            kind: (ev.kind as "timer" | "alarm") ?? "timer",
          });
          tab = "timer";
        } else if (ev.type === "timer_fired") {
          // Сигнал звенит, пока не остановят голосом или кнопкой — из списка
          // не убираем, чтобы кнопка «Остановить сигнал» осталась доступной.
          const existing = timers.find((x) => x.id === ev.id);
          if (existing) {
            existing.fired = true;
            existing.endsAt = Date.now();
          } else {
            timers.push({
              id: ev.id as number,
              label: (ev.label as string) ?? "",
              endsAt: Date.now(),
              total: (ev.seconds as number) ?? 0,
              kind: (ev.kind as "timer" | "alarm") ?? "timer",
              fired: true,
            });
          }
          tab = "timer";
        } else if (ev.type === "timer_stopped") {
          timers = timers.filter((x) => x.id !== ev.id);
        }
      }),
    );
    unlisteners.push(
      await listen("utils-tab", (e: { payload: string }) => {
        tab = e.payload;
      }),
    );
    ticker = window.setInterval(() => {
      now = Date.now();
      swNow = Date.now();
    }, 200);
  });

  onDestroy(() => {
    if (ticker) clearInterval(ticker);
    unlisteners.forEach((u) => u());
    unlisteners = [];
  });
</script>

<div class="utils">
  <div class="utils__head">
    <span class="utils__title">Утилиты</span>
    <button class="utils__close" title="Закрыть" onclick={closeWindow}>×</button>
  </div>
  <div class="utils__tabs">
    {#each TABS as t (t.key)}
      <button
        class="utils__tab"
        class:is-active={tab === t.key}
        onclick={() => (tab = t.key)}
      >
        <AppIcon name={t.icon} size={15} />
        {t.title}
      </button>
    {/each}
  </div>

  <!-- Таймеры -->
  {#if tab === "timer"}
    <div class="utils__body">
      {#if timers.length === 0}
        <div class="utils__empty">
          Активных таймеров нет. Скажи «поставь таймер на 5 минут» или поставь вручную.
        </div>
      {/if}
      {#each timers as t (t.id)}
        <div class="util-timer" class:is-fired={t.fired}>
          <div class="util-timer__time">
            {t.fired ? (t.kind === "alarm" ? "Будильник!" : "Время вышло!") : fmtRemaining(t.endsAt)}
          </div>
          {#if t.label}
            <div class="util-timer__label">{t.label}</div>
          {/if}
          <div class="util-timer__bar"><span style={`width: ${pctDone(t)}%`}></span></div>
          <button class="util-timer__stop" onclick={() => stopTimer(t.id)}>
            {t.fired ? "Остановить сигнал" : "Остановить"}
          </button>
        </div>
      {/each}

      <div class="util-manual">
        <input
          bind:value={manualLabel}
          class="util-manual__label"
          placeholder="Что напомнить (не обязательно)"
        />
        <div class="util-manual__row">
          <input bind:value={manualMinutes} type="number" min="1" max="600" />
          <span>мин</span>
          <button class="btn btn--primary" disabled={manualBusy} onclick={startManual}>
            Поставить
          </button>
        </div>
      </div>
    </div>

    <!-- Секундомер -->
  {:else if tab === "stopwatch"}
    <div class="utils__body utils__body--center">
      <div class="util-stopwatch" class:is-running={swRunning}>
        {fmtMs(swElapsed)}
      </div>
      <div class="util-stopwatch__controls">
        <button class="btn btn--primary" onclick={swToggle}>
          {swRunning ? "Пауза" : "Старт"}
        </button>
        <button class="btn btn--ghost" onclick={swReset}>Сброс</button>
      </div>
    </div>

    <!-- Календарь -->
  {:else}
    <div class="utils__body">
      <div class="util-cal__head">
        <button class="util-cal__nav" onclick={() => shiftMonth(-1)}>‹</button>
        <span class="util-cal__month">{MONTHS[viewMonth]} {viewYear}</span>
        <button class="util-cal__nav" onclick={() => shiftMonth(1)}>›</button>
      </div>
      <div class="util-cal__grid">
        {#each WEEKDAYS as w (w)}
          <span class="util-cal__weekday">{w}</span>
        {/each}
        {#each calendarCells as c, i (i)}
          <span
            class="util-cal__day"
            class:is-today={c.current && isToday(c.day)}
            class:is-empty={!c.current}
          >
            {c.current ? c.day : ""}
          </span>
        {/each}
      </div>
    </div>
  {/if}
</div>
</file>

