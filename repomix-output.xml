/* ============================================================
   J.A.R.V.I.S — дизайн-система STARK INDUSTRIES MARK V.

   Тёмная инженерная среда, титан и циановая энергия.
   Центральный элемент — треугольный реактор Mark V.

   Правила:
   1. Циан — энергия системы: активность, связь, фокус.
      Никаких посторонних акцентов.
   2. Технические метки — моноширинные, строчные буквы не капсом
      без нужды; читаемость важнее «футуристичности».
   3. Свечение — только у энергии: реактор, активные состояния,
      фокус. Поверхности остаются матовыми.
   4. Движение — плавное, с естественным замедлением; уважаем
      prefers-reduced-motion.
   ============================================================ */

:root {
  color-scheme: dark;

  /* Фон и поверхности — тёмная сталь */
  --bg: #0a1523;
  --bg-2: #0e1c2e;
  --surface: #101923;
  --surface-2: #15212d;
  --surface-3: #1a2936;
  --hover: rgba(75, 203, 255, 0.07);

  /* Границы и металл */
  --border: #1a2936;
  --border-strong: #263747;
  --titanium: #aebbc6;
  --silver: #d8e2ea;

  /* Текст */
  --text: #f4fcff;
  --text-2: #aebbc6;
  --text-3: #758b9d;

  /* Энергия */
  --cyan: #4bcbff;
  --cyan-deep: #168dcc;
  --energy: #b9f0ff;
  --cyan-soft: rgba(75, 203, 255, 0.12);
  --cyan-ring: rgba(75, 203, 255, 0.45);
  --cyan-glow: rgba(75, 203, 255, 0.35);

  /* Статусы */
  --ok: #65d6a3;
  --ok-soft: rgba(101, 214, 163, 0.12);
  --warn: #f0b75b;
  --warn-soft: rgba(240, 183, 91, 0.12);
  --danger: #f06b70;
  --danger-soft: rgba(240, 107, 112, 0.14);

  --on-accent: #071018;

  --mono: ui-monospace, "SF Mono", Menlo, monospace;

  --r-lg: 14px;
  --r-md: 10px;
  --r-sm: 8px;

  --shadow-pop: 0 24px 64px -16px rgba(0, 0, 0, 0.7);
  --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.4);

  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body,
#app {
  height: 100%;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Inter,
    "Helvetica Neue", sans-serif;
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  user-select: none;
  overscroll-behavior: none;
}

::selection {
  background: var(--cyan-deep);
  color: var(--text);
}

::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(75, 203, 255, 0.16);
  border-radius: 5px;
  border: 3px solid transparent;
  background-clip: content-box;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(75, 203, 255, 0.32);
  background-clip: content-box;
}

:where(button, [href], input, select, textarea, [tabindex]):focus-visible {
  outline: 2px solid var(--cyan);
  outline-offset: 2px;
  border-radius: var(--r-sm);
}

/* Техническая метка: моноширинная, строчная, спокойная */
.tech-label {
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--text-3);
}

/* ============================================================
   Каркас: вертикальная композиция
   ============================================================ */

.app {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  /* Свой контекст наслаивания: холст реактора с z-index: -1 остаётся поверх
     фона приложения, но под полупрозрачными панелями интерфейса. */
  isolation: isolate;
  /* Нейтральное затемнение к низу — глубина без цветных пятен. */
  background:
    radial-gradient(140% 60% at 50% 118%, rgba(10, 21, 35, 0) 40%, #060f1b 100%),
    var(--bg);
}

/* ---------- Шапка ---------- */

.header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px 10px;
  border-bottom: 1px solid var(--border);
  background: rgba(16, 25, 35, 0.35);
}

.header__id {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.header__wordmark {
  font-family: var(--mono);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.24em;
  color: var(--text);
  white-space: nowrap;
}

.header__corp {
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.22em;
  color: var(--text-3);
  white-space: nowrap;
}

.header__spacer {
  flex: 1;
}

/* Индикатор связи с движком в шапке */
.header__link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 22px;
  padding: 0 9px 0 8px;
  border-radius: 999px;
