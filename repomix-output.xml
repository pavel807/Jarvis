      </span>
    </span>
    <span class="row-item__chevron"><AppIcon name="mic" size={16} /></span>
  </button>
  <button class="row-item" onclick={openMicSettings}>
    <span class="row-item__text">
      <span class="row-item__title">Открыть Системные настройки</span>
