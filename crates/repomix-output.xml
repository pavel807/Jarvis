<file path="jarvis-core/examples/tool_probe.rs">
//! Проверка одного инструмента на живой машине: разбирает tool-блок и
//! выполняет его, печатая итог так, как его услышит пользователь.
//!
//! Нужно, чтобы проверять действия без голоса и без моделей:
//!
//! ```text
//! JARVIS_HOME=. cargo run --release -p jarvis-core --example tool_probe -- \
//!   '<tool>{"name":"music_control","args":{"action":"pause"}}</tool>'
//! ```

use std::sync::mpsc::channel;

fn main() {
    let arg = std::env::args().nth(1).unwrap_or_default();
    if arg.trim().is_empty() {
        eprintln!("Использование: tool_probe '<tool>{{...}}</tool>'");
        std::process::exit(1);
    }

    match jarvis_core::tools::parse_lenient(&arg) {
        jarvis_core::tools::ToolParse::Call(call) => {
            let (audio_tx, audio_rx) = channel();
            let (events, _events_rx) = channel();
            let outcome = jarvis_core::tools::execute(call, &audio_tx, &events);
            println!("ок:      {}", outcome.ok);
            println!("скажет:  {}", outcome.speech);
            if !outcome.detail.trim().is_empty() {
                println!("детали:  {}", outcome.detail.replace('\n', " ⏎ "));
            }
            // Аудио в этом режиме не проигрываем: пробуем инструмент, а не голос.
            let _ = audio_rx.try_recv();
        }
        jarvis_core::tools::ToolParse::Failed(reason) => {
            eprintln!("вызов не разобран: {reason}");
            std::process::exit(2);
        }
        jarvis_core::tools::ToolParse::None => {
            eprintln!("в аргументе нет tool-блока");
            std::process::exit(2);
        }
    }
}
</file>

<file path="jarvis-core/examples/voice_compare.rs">
//! Сравнение мужских голосов Silero v5 для профиля «Джарвис»: одинаковые
//! фразы для каждого голоса, мужской тембр, спокойная подача.
//!
//! Кандидаты — все мужские голоса набора v5_cis_base; для финального выбора
//! прослушать сгенерированные WAV. Профиль Jarvis: скорость 0.9 (умеренно
//! медленно), ударения и омографы включены.
//!
//! Запуск: cargo run --release --example voice_compare -p jarvis-core
//! Результат: build/voice_compare/<voice>.wav

use jarvis_core::tts_silero::{SAMPLE_RATE, SileroEngine};

/// Фразы покрывают типовые роли голоса: приветствие, статус, числа,
/// технические названия (Premiere Pro), вопрос, спокойное завершение.
const PHRASES: &str = "Слушаю вас, Павел. Все системы в норме: процессор загружен на тридцать процентов, \
оперативной памяти свободно двенадцать гигабайт. Открываю премьер про. \
Похоже, сегодня будет дождь — взять с собой зонт? До связи.";

/// Мужские голоса v5.
const CANDIDATES: &[&str] = &[
    "ru_eduard",
    "ru_dmitriy",
    "ru_alexandr",
    "ru_bogdan",
    "ru_igor",
    "ru_marat",
    "ru_roman",
    "ru_gamat",
];

/// Скорость профиля Jarvis: умеренно медленная, уверенная подача.
const JARVIS_SPEED: f32 = 0.9;

fn write_wav(path: &str, samples: &[f32]) -> Result<(), Box<dyn std::error::Error>> {
    let spec = hound::WavSpec {
        channels: 1,
        sample_rate: SAMPLE_RATE,
        bits_per_sample: 16,
        sample_format: hound::SampleFormat::Int,
    };
    let mut w = hound::WavWriter::create(path, spec)?;
    for &s in samples {
        let v = (s.clamp(-1.0, 1.0) * 32767.0) as i16;
        w.write_sample(v)?;
    }
    w.finalize()?;
    Ok(())
}

fn main() -> Result<(), Box<dyn std::error::Error>> {
    std::fs::create_dir_all("build/voice_compare")?;
    for voice in CANDIDATES {
        let engine = SileroEngine::new(voice)?;
        let started = std::time::Instant::now();
        let samples = engine.synthesize(PHRASES, JARVIS_SPEED)?;
        let path = format!("build/voice_compare/{voice}.wav");
        write_wav(&path, &samples)?;
        println!(
            "🎙 {voice}: {:.1} с речи за {:.1?} синтеза → {path}",
            samples.len() as f32 / SAMPLE_RATE as f32,
            started.elapsed()
        );
    }
    println!("Прослушай build/voice_compare/ и выбери голос в settings.toml (tts_voice).");
    Ok(())
}
</file>

<file path="jarvis-core/examples/web_bench.rs">
//! Замер скорости поиска: «как было» (новый агент на каждый запрос, без
//! прогрева и кэша) против текущей реализации.
//!
//! Запуск: cargo run --release --example web_bench -p jarvis-core

use anyhow::Result;
use std::time::{Duration, Instant};

const SEARCH_URL: &str = "https://lite.duckduckgo.com/lite/";
const USER_AGENT: &str = "JarvisVoiceAssistant/2.0 (personal assistant)";

/// Старое поведение: свежий агент и таймаут 6 с на каждый запрос.
fn legacy_search(query: &str) -> Result<usize> {
    let agent = ureq::Agent::config_builder()
        .timeout_global(Some(Duration::from_secs(6)))
        .build()
        .new_agent();
    let url = format!("{}?q={}", SEARCH_URL, urlencoding::encode(query));
    let response = agent
        .get(&url)
        .header("User-Agent", USER_AGENT)
        .header("Accept-Language", "ru-RU,ru;q=0.9,en;q=0.8")
        .call()?;
    let html = response.into_body().read_to_string()?;
    Ok(html.len())
}

fn main() -> Result<()> {
    let query = "какая сегодня погода в москве";

    println!("--- старое поведение (новый агент каждый раз) ---");
    for i in 1..=3 {
        let t = Instant::now();
        let n = legacy_search(query)?;
        println!("  запрос {i}: {:.0?} ({} байт HTML)", t.elapsed(), n);
    }

    println!("\n--- прогрев ---");
    let t = Instant::now();
    jarvis_core::web::warm_up();
    std::thread::sleep(Duration::from_millis(1200));
    println!("  warm_up вызван за {:.0?} (фон)", t.elapsed());

    println!("\n--- новое поведение ---");
    for i in 1..=3 {
        let t = Instant::now();
        let hits = jarvis_core::web::search(query, 5)?;
        println!(
            "  запрос {i}: {:.0?} ({} результатов)",
            t.elapsed(),
            hits.len()
        );
    }

    // Другой запрос — проверяем, что кэш не мешает свежим
    let t = Instant::now();
    let hits = jarvis_core::web::search("курс доллара к рублю", 5)?;
    println!(
        "\n  новый запрос: {:.0?} ({} результатов)",
        t.elapsed(),
        hits.len()
    );
    Ok(())
}
</file>

<file path="jarvis-core/src/asr/attention.rs">
//! Multi-Head Self-Attention с относительной позиционной кодировкой (rel_pos)
//! — порт espnet-стиля RelPositionMultiHeadAttention из NeMo, снят с графа
//! ONNX-эталона.
//!
//! Схема:
//! - q = W_q·x + pos_bias_u (сдвиг добавлен ДО matmul, по головам);
//! - k = W_k·x, v = W_v·x;
//! - p = W_pos·pos_emb (линейная проекция таблицы относительных позиций,
//!   без bias);
//! - matrix_ac = q_u·kᵀ, matrix_bd = q_v·pᵀ [B, H, T, 2T-1];
//! - relative_shift(matrix_bd) — та же последовательность операций, что в
//!   эталоне (cat нулевой колонки → reshape [B,H,2T,T] → срез → reshape);
//! - scores = (ac + bd) / sqrt(head_dim) → softmax → ·v → W_out.

use anyhow::Result;
use candle_core::{Device, Tensor, D};
use candle_nn::{linear_no_bias, Linear, Module, VarBuilder};

/// Синусоидальная таблица относительных позиций NeMo RelPositionalEncoding.
///
/// Строки — позиции от +(max_len-1) до 0 до -(max_len-1) (всего 2*max_len-1);
/// столбцы чередуются: sin(pos·div_k), cos(pos·div_k), …, где
/// div_k = exp(-2k·ln(10000)/d_model). Формула сверина с константой,
/// константно-свёрнутой в ONNX-эталоне (макс. расхождение — шум float32).
pub fn build_pos_table(max_len: usize, d_model: usize, device: &Device) -> Result<Tensor> {
    let half = d_model / 2;
    let total = 2 * max_len - 1;
    let mut table = vec![0f32; total * d_model];
    // div_term в f64, как в NeMo (torch.exp в f32 после умножения на позицию).
    let div_term: Vec<f64> = (0..half)
        .map(|k| (-2.0 * (k as f64) * (10000f64).ln() / d_model as f64).exp())
        .collect();
    for (row, value) in table.chunks_mut(d_model).enumerate() {
        // Позиция строки: +(max_len-1-r) для r < max_len, иначе -(r-max_len+1).
        let pos = if row < max_len {
            (max_len - 1 - row) as f64
        } else {
            -((row - max_len + 1) as f64)
        };
        for (k, dv) in div_term.iter().enumerate() {
            let angle = (pos * *dv) as f32;
            value[2 * k] = angle.sin();
            value[2 * k + 1] = angle.cos();
        }
    }
    Ok(Tensor::from_vec(table, (total, d_model), device)?)
}

/// Нарезка таблицы для длины T: строки [max_len-T .. max_len+T-2] =
/// позиции +(T-1)…0…-(T-1), всего 2T-1.
pub fn slice_pos_emb(table: &Tensor, max_len: usize, t: usize) -> Result<Tensor> {
    let start = max_len - t;
    Ok(table.narrow(0, start, 2 * t - 1)?)
}

pub struct RelPosAttention {
    q_proj: Linear,
    k_proj: Linear,
    v_proj: Linear,
    out_proj: Linear,
    /// W_pos — проекция позиционной таблицы, без bias.
    pos_proj: Linear,
    /// pos_bias_u [n_heads, head_dim] — добавляется к q перед matmul с k.
    pos_bias_u: Tensor,
    /// pos_bias_v [n_heads, head_dim] — добавляется к q перед matmul с p.
    pos_bias_v: Tensor,
    n_heads: usize,
    head_dim: usize,
}

impl RelPosAttention {
    pub fn load(vb: VarBuilder, d_model: usize, n_heads: usize) -> Result<Self> {
        let head_dim = d_model / n_heads;
        Ok(Self {
            q_proj: candle_nn::linear(d_model, d_model, vb.pp("linear_q"))?,
            k_proj: candle_nn::linear(d_model, d_model, vb.pp("linear_k"))?,
            v_proj: candle_nn::linear(d_model, d_model, vb.pp("linear_v"))?,
            out_proj: candle_nn::linear(d_model, d_model, vb.pp("linear_out"))?,
            pos_proj: linear_no_bias(d_model, d_model, vb.pp("linear_pos"))?,
            pos_bias_u: vb.get((n_heads, head_dim), "pos_bias_u")?,
            pos_bias_v: vb.get((n_heads, head_dim), "pos_bias_v")?,
            n_heads,
            head_dim,
        })
    }

    /// x: [B, T, d_model]; pos_emb: [2T-1, d_model] (нарезка таблицы);
    /// mask — маска кадров при T > валидной длины ([`super::conformer::FrameMask`]);
    /// None, когда все кадры валидны.
    pub fn forward(&self, x: &Tensor, pos_emb: &Tensor, mask: Option<&super::conformer::FrameMask>) -> Result<Tensor> {
        let (b, t, _d) = x.dims3()?;
        let h = self.n_heads;
        let dh = self.head_dim;

        let q = self.q_proj.forward(x)?; // [B, T, D]
        let k = self.k_proj.forward(x)?;
        let v = self.v_proj.forward(x)?;

        // q + bias_u: [B, T, H, Dh] -> [B, H, T, Dh]; bias [H, Dh] -> [1, 1, H, Dh]
        // contiguous после транспонирования: Metal-batched matmul
        // отвергает стрided-представления.
        let q = q.reshape((b, t, h, dh))?;
        let bu = self.pos_bias_u.unsqueeze(0)?.unsqueeze(0)?; // [1,1,H,Dh]
        let bv = self.pos_bias_v.unsqueeze(0)?.unsqueeze(0)?;
        let q_u = q.broadcast_add(&bu)?.transpose(1, 2)?.contiguous()?;
        let q_v = q.broadcast_add(&bv)?.transpose(1, 2)?.contiguous()?;
        let k = k
            .reshape((b, t, h, dh))?
            .transpose(1, 2)?
            .contiguous()?; // [B, H, T, Dh]
        let v = v
            .reshape((b, t, h, dh))?
            .transpose(1, 2)?
            .contiguous()?;

        // p: [2T-1, D] -> [2T-1, H, Dh] -> [H, 2T-1, Dh] -> [1, H, 2T-1, Dh]
        let p = self.pos_proj.forward(pos_emb)?; // [2T-1, D]
        let p = p
            .reshape((p.dim(0)?, h, dh))?
            .transpose(0, 1)? // [H, 2T-1, Dh]
            .contiguous()?
            .unsqueeze(0)?; // [1, H, 2T-1, Dh]

        // matrix_ac: q_u · kᵀ -> [B, H, T, T]
        let ac = q_u.matmul(&k.transpose(D::Minus2, D::Minus1)?)?;
        // matrix_bd: q_v · pᵀ -> [B, H, T, 2T-1]
        let bd_raw = q_v.matmul(&p.transpose(D::Minus2, D::Minus1)?)?;

        let bd = relative_shift(&bd_raw)?; // [B, H, T, T]

        let scores = ((ac + bd)?.affine(1.0 / (dh as f64).sqrt(), 0.0))?;
        // Маска кадров, как в ONNX-эталоне: аддитивная -10000 у невалидных
        // колонок-ключей и целиком у невалидных строк-запросов до softmax.
        // Строки после softmax НЕ обнуляются: эталон оставляет невалидную
        // строку uniform (Where_1 гасит только позиции маски, а они и так
        // ~0 после -10000).
        let attn = match mask {
            // Metal не поддерживает where_cond на F32: аддитивная маска
            // тождественна Where до softmax, обнуление строк — умножением.
            Some(m) => {
                let masked = scores.broadcast_add(&m.attn_add)?;
                let a = candle_nn::ops::softmax(&masked, D::Minus1)?;
                a.broadcast_mul(&m.attn_row_zero)?
            }
            None => candle_nn::ops::softmax(&scores, D::Minus1)?,
        };
        let out = attn.matmul(&v)?; // [B, H, T, Dh]
        let out_h = out.transpose(1, 2)?; // [B, T, H, Dh]
        let out = out_h.contiguous()?.reshape((b, t, h * dh))?;
        Ok(self.out_proj.forward(&out)?)
    }

    /// Полная трассировка для стенда верификации (fc_debug).
    pub fn forward_trace(
        &self,
        x: &Tensor,
        pos_emb: &Tensor,
        mask: Option<&super::conformer::FrameMask>,
    ) -> Result<AttentionTrace> {
        let (b, t, _d) = x.dims3()?;
        let h = self.n_heads;
        let dh = self.head_dim;

        let q = self.q_proj.forward(x)?;
        let k = self.k_proj.forward(x)?;
        let v = self.v_proj.forward(x)?;

        let q = q.reshape((b, t, h, dh))?;
        let bu = self.pos_bias_u.unsqueeze(0)?.unsqueeze(0)?;
        let bv = self.pos_bias_v.unsqueeze(0)?.unsqueeze(0)?;
        let q_u = q.broadcast_add(&bu)?.transpose(1, 2)?.contiguous()?;
        let q_v = q.broadcast_add(&bv)?.transpose(1, 2)?.contiguous()?;
        let k = k.reshape((b, t, h, dh))?.transpose(1, 2)?.contiguous()?;
        let v = v.reshape((b, t, h, dh))?.transpose(1, 2)?.contiguous()?;

        let p = self.pos_proj.forward(pos_emb)?;
        let p = p
            .reshape((p.dim(0)?, h, dh))?
            .transpose(0, 1)?
            .contiguous()?
            .unsqueeze(0)?;

        let bd_raw = q_v.matmul(&p.transpose(D::Minus2, D::Minus1)?)?;
        let bd = relative_shift(&bd_raw)?;
        let ac = q_u.matmul(&k.transpose(D::Minus2, D::Minus1)?)?;
        let scores = ac.broadcast_add(&bd)?.affine(1.0 / (dh as f64).sqrt(), 0.0)?;
        let attn = match mask {
            Some(m) => {
                let masked = scores.broadcast_add(&m.attn_add)?;
                let a = candle_nn::ops::softmax(&masked, D::Minus1)?;
                a.broadcast_mul(&m.attn_row_zero)?
            }
            None => candle_nn::ops::softmax(&scores, D::Minus1)?,
        };
        let attn_v = attn.matmul(&v)?;
        let out_h = attn_v.transpose(1, 2)?;
        let out = out_h.contiguous()?.reshape((b, t, h * dh))?;
        let out_proj = self.out_proj.forward(&out)?;
        Ok(AttentionTrace {
            bd_raw,
            bd_shifted: bd,
            ac,
            scores,
            attn,
            attn_v,
            out_proj,
            q_v: q_v.clone(),
            p_t: p.transpose(D::Minus2, D::Minus1)?.contiguous()?,
        })
    }
}

/// Снимок промежуточных стадий attention для верификации.
pub struct AttentionTrace {
    pub bd_raw: Tensor,
    pub bd_shifted: Tensor,
    pub ac: Tensor,
    pub scores: Tensor,
    pub attn: Tensor,
    pub attn_v: Tensor,
    pub out_proj: Tensor,
    /// Входы matmul'а bd — для изоляции расхождений.
    pub q_v: Tensor,
    pub p_t: Tensor,
}

/// Relative shift — точная последовательность операций из графа ONNX-эталона
/// (узлы Pad → Reshape → Slice → Reshape → Slice):
/// 1. Pad: один ноль в НАЧАЛО последней оси [B,H,T,2T-1] → [B,H,T,2T];
/// 2. reshape [B,H,T,2T] → [B,H,2T,T];
/// 3. срез строк 1.. → [B,H,2T-1,T];
/// 4. reshape назад → [B,H,T,2T-1];
/// 5. срез последней оси до T → [B,H,T,T].
/// Семантика результата: bd_shifted[i][j] = bd_raw[i][T-1+(j-i)] —
/// выравнивание таблицы относительных позиций по диагонали.
fn relative_shift(bd: &Tensor) -> Result<Tensor> {
    let (b, h, t, k2) = bd.dims4()?; // k2 = 2T-1
    let zero = Tensor::zeros((b, h, t, 1), bd.dtype(), bd.device())?;
    let padded = Tensor::cat(&[&zero, bd], D::Minus1)?; // [B,H,T,2T]
    let reshaped = padded.reshape((b, h, 2 * t, t))?; // [B,H,2T,T]
    let sliced = reshaped.narrow(2, 1, k2)?; // [B,H,2T-1,T]
    let back = sliced.contiguous()?.reshape((b, h, t, k2))?; // [B,H,T,2T-1]
    Ok(back.narrow(D::Minus1, 0, t)?) // [B,H,T,T]
}
</file>

<file path="jarvis-core/src/asr/config.rs">
//! Конфигурация FastConformer — читается из `config.json` (полный копия
//! `model_config.yaml` из чекпоинта, см. `tools/convert_fastconformer.py`).
//!
//! Приоритет всегда у конфигурации конкретного checkpoint; значения,
//! которых в нём нет (preemph, log guard), берутся из эталонного
//! препроцессора onnx-asr (istupakov), с которым проведена численная
//! верификация.

use anyhow::{Context, Result};
use serde::Deserialize;
use std::path::Path;

#[derive(Debug, Clone, Copy)]
pub struct PreprocessorConfig {
    pub sample_rate: usize,
    /// Число mel-полос (features).
    pub n_mels: usize,
    pub n_fft: usize,
    /// Длина окна в семплах (window_size * sample_rate = 0.025 * 16000 = 400).
    pub win_length: usize,
    /// Шаг окна в семплах (window_stride * sample_rate = 0.01 * 16000 = 160).
    pub hop_length: usize,
    /// Предыскажение сигнала.
    pub preemph: f32,
    /// Слагаемое внутри log(x + guard) — защита от log(0).
    pub log_guard: f32,
}

impl Default for PreprocessorConfig {
    fn default() -> Self {
        Self {
            sample_rate: 16_000,
            n_mels: 80,
            n_fft: 512,
            win_length: 400,
            hop_length: 160,
            preemph: 0.97,
            // 2**-24: значение из эталонного препроцессора onnx-asr.
            log_guard: 2f32.powi(-24),
        }
    }
}

#[derive(Debug, Clone, Copy)]
pub struct EncoderConfig {
    pub d_model: usize,
    pub n_layers: usize,
    pub n_heads: usize,
    pub feat_in: usize,
    /// Коэффициент сжатия pre-encode (8× = три свёртки stride 2).
    pub subsampling_factor: usize,
    /// Расширение FFN (ff_expansion_factor * d_model = 2048).
    pub ff_dim: usize,
    /// Ядро свёрточного модуля (9).
    pub conv_kernel_size: usize,
    /// Максимальная длина относительной позиционной таблицы (2*5000-1 = 9999).
    pub pos_emb_max_len: usize,
}

#[derive(Debug, Clone, Copy)]
pub struct DecoderConfig {
    /// Размер словаря SentencePiece (1024) без blank.
    pub vocab_size: usize,
    /// Скрытый размер prediction network (640).
    pub pred_hidden: usize,
    /// Число рекуррентных слоёв prediction network.
    pub pred_rnn_layers: usize,
    /// Скрытый размер joint network (640).
    pub joint_hidden: usize,
    /// Максимальное число токенов на один шаг времени RNNT.
    pub max_symbols_per_step: usize,
}

/// Полная конфигурация модели. Blank-токен всегда последний: id = vocab_size.
#[derive(Debug, Clone, Copy)]
pub struct FastConformerConfig {
    pub preprocessor: PreprocessorConfig,
    pub encoder: EncoderConfig,
    pub decoder: DecoderConfig,
    pub blank_id: usize,
}

impl Default for FastConformerConfig {
    fn default() -> Self {
        Self {
            preprocessor: PreprocessorConfig::default(),
            encoder: EncoderConfig {
                d_model: 512,
                n_layers: 17,
                n_heads: 8,
                feat_in: 80,
                subsampling_factor: 8,
                ff_dim: 2048,
                conv_kernel_size: 9,
                pos_emb_max_len: 5000,
            },
            decoder: DecoderConfig {
                vocab_size: 1024,
                pred_hidden: 640,
                pred_rnn_layers: 1,
                joint_hidden: 640,
                max_symbols_per_step: 10,
            },
            blank_id: 1024,
        }
    }
}

// Поля config.json, которые реально читаем; остальное игнорируется.
#[derive(Debug, Deserialize)]
struct RawConfig {
    preprocessor: Option<RawPreprocessor>,
    encoder: Option<RawEncoder>,
    #[serde(rename = "decoder")]
    rnnt_decoder: Option<RawRnntDecoder>,
}

#[derive(Debug, Deserialize)]
struct RawPreprocessor {
    sample_rate: Option<usize>,
    features: Option<usize>,
    n_fft: Option<usize>,
    window_size: Option<f64>,
    window_stride: Option<f64>,
}

#[derive(Debug, Deserialize)]
struct RawEncoder {
    d_model: Option<usize>,
    n_layers: Option<usize>,
    n_heads: Option<usize>,
    feat_in: Option<usize>,
    subsampling_factor: Option<usize>,
    ff_expansion_factor: Option<usize>,
    conv_kernel_size: Option<usize>,
    pos_emb_max_len: Option<usize>,
}

#[derive(Debug, Deserialize)]
struct RawRnntDecoder {
    #[allow(dead_code)]
    #[serde(rename = "_target_")]
    target: Option<String>,
    vocab_size: Option<usize>,
    prednet: Option<RawPrednet>,
    #[serde(rename = "jointnet")]
    jointnet: Option<RawJointnet>,
}

#[derive(Debug, Deserialize)]
struct RawPrednet {
    pred_hidden: Option<usize>,
    pred_rnn_layers: Option<usize>,
}

#[derive(Debug, Deserialize)]
struct RawJointnet {
    joint_hidden: Option<usize>,
}

/// Загружает конфигурацию из `config.json`. Отсутствующие поля — дефолты
/// (зафиксированы для stt_ru_fastconformer_hybrid_large_pc).
pub fn load(path: &Path) -> Result<FastConformerConfig> {
    let raw: RawConfig = serde_json::from_str(
        &std::fs::read_to_string(path)
            .with_context(|| format!("Не удалось прочитать {path:?}"))?,
    )
    .with_context(|| format!("Не удалось разобрать {path:?}"))?;

    let mut cfg = FastConformerConfig::default();
    if let Some(p) = &raw.preprocessor {
        let prep = &mut cfg.preprocessor;
        if let Some(v) = p.sample_rate {
            prep.sample_rate = v;
        }
        if let Some(v) = p.features {
            prep.n_mels = v;
        }
        if let Some(v) = p.n_fft {
            prep.n_fft = v;
        }
        if let Some(v) = p.window_size {
            prep.win_length = (v * prep.sample_rate as f64).round() as usize;
        }
        if let Some(v) = p.window_stride {
            prep.hop_length = (v * prep.sample_rate as f64).round() as usize;
        }
    }
    if let Some(e) = &raw.encoder {
        let enc = &mut cfg.encoder;
        if let Some(v) = e.d_model {
            enc.d_model = v;
        }
        if let Some(v) = e.n_layers {
            enc.n_layers = v;
        }
        if let Some(v) = e.n_heads {
            enc.n_heads = v;
        }
        if let Some(v) = e.feat_in {
            enc.feat_in = v;
        }
        if let Some(v) = e.subsampling_factor {
            enc.subsampling_factor = v;
        }
        if let Some(v) = e.ff_expansion_factor {
            enc.ff_dim = v * enc.d_model;
        }
        if let Some(v) = e.conv_kernel_size {
            enc.conv_kernel_size = v;
        }
        if let Some(v) = e.pos_emb_max_len {
            enc.pos_emb_max_len = v;
        }
    }
    if let Some(d) = &raw.rnnt_decoder {
        let dec = &mut cfg.decoder;
        if let Some(v) = d.vocab_size {
            dec.vocab_size = v;
        }
        if let Some(pn) = &d.prednet {
            if let Some(v) = pn.pred_hidden {
                dec.pred_hidden = v;
            }
            if let Some(v) = pn.pred_rnn_layers {
                dec.pred_rnn_layers = v;
            }
        }
        if let Some(jn) = &d.jointnet {
            if let Some(v) = jn.joint_hidden {
                dec.joint_hidden = v;
            }
        }
    }
    cfg.blank_id = cfg.decoder.vocab_size;
    Ok(cfg)
}
