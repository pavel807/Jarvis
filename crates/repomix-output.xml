<file path="examples/web_bench.rs">
//! Замер скорости поиска: «как было» (новый агент на каждый запрос, без
//! прогрева и кэша) против текущей реализации.
//!
//! Запуск: cargo run --release --example web_bench -p jarvis-core

use anyhow::Result;
use std::time::{Duration, Instant};

const SEARCH_URL: &str = "https://lite.duckduckgo.com/lite/";
const USER_AGENT: &str = "JarvisVoiceAssistant/2.0 (personal assistant)";

/// Старое поведение: свежий агент и таймаут 6 с на каждый запрос.
fn legacy_search(query: &str) -> Result<usize> {
    let agent = ureq::Agent::config_builder()
        .timeout_global(Some(Duration::from_secs(6)))
        .build()
        .new_agent();
    let url = format!("{}?q={}", SEARCH_URL, urlencoding::encode(query));
    let response = agent
        .get(&url)
        .header("User-Agent", USER_AGENT)
        .header("Accept-Language", "ru-RU,ru;q=0.9,en;q=0.8")
        .call()?;
    let html = response.into_body().read_to_string()?;
    Ok(html.len())
}

fn main() -> Result<()> {
    let query = "какая сегодня погода в москве";

    println!("--- старое поведение (новый агент каждый раз) ---");
    for i in 1..=3 {
        let t = Instant::now();
        let n = legacy_search(query)?;
        println!("  запрос {i}: {:.0?} ({} байт HTML)", t.elapsed(), n);
    }

    println!("\n--- прогрев ---");
    let t = Instant::now();
    jarvis_core::web::warm_up();
    std::thread::sleep(Duration::from_millis(1200));
    println!("  warm_up вызван за {:.0?} (фон)", t.elapsed());

    println!("\n--- новое поведение ---");
    for i in 1..=3 {
        let t = Instant::now();
        let hits = jarvis_core::web::search(query, 5)?;
        println!(
            "  запрос {i}: {:.0?} ({} результатов)",
            t.elapsed(),
            hits.len()
        );
    }

    // Другой запрос — проверяем, что кэш не мешает свежим
    let t = Instant::now();
    let hits = jarvis_core::web::search("курс доллара к рублю", 5)?;
    println!(
        "\n  новый запрос: {:.0?} ({} результатов)",
        t.elapsed(),
        hits.len()
    );
    Ok(())
}
</file>

<file path="src/asr/config.rs">
//! Конфигурация FastConformer — читается из `config.json` (полный копия
//! `model_config.yaml` из чекпоинта, см. `tools/convert_fastconformer.py`).
//!
//! Приоритет всегда у конфигурации конкретного checkpoint; значения,
//! которых в нём нет (preemph, log guard), берутся из эталонного
//! препроцессора onnx-asr (istupakov), с которым проведена численная
//! верификация.

use anyhow::{Context, Result};
use serde::Deserialize;
use std::path::Path;

#[derive(Debug, Clone, Copy)]
pub struct PreprocessorConfig {
    pub sample_rate: usize,
    /// Число mel-полос (features).
    pub n_mels: usize,
    pub n_fft: usize,
    /// Длина окна в семплах (window_size * sample_rate = 0.025 * 16000 = 400).
    pub win_length: usize,
    /// Шаг окна в семплах (window_stride * sample_rate = 0.01 * 16000 = 160).
    pub hop_length: usize,
    /// Предыскажение сигнала.
    pub preemph: f32,
    /// Слагаемое внутри log(x + guard) — защита от log(0).
    pub log_guard: f32,
}

impl Default for PreprocessorConfig {
    fn default() -> Self {
        Self {
            sample_rate: 16_000,
            n_mels: 80,
            n_fft: 512,
            win_length: 400,
            hop_length: 160,
            preemph: 0.97,
            // 2**-24: значение из эталонного препроцессора onnx-asr.
            log_guard: 2f32.powi(-24),
        }
    }
}

#[derive(Debug, Clone, Copy)]
pub struct EncoderConfig {
    pub d_model: usize,
    pub n_layers: usize,
    pub n_heads: usize,
    pub feat_in: usize,
    /// Коэффициент сжатия pre-encode (8× = три свёртки stride 2).
    pub subsampling_factor: usize,
    /// Расширение FFN (ff_expansion_factor * d_model = 2048).
    pub ff_dim: usize,
    /// Ядро свёрточного модуля (9).
    pub conv_kernel_size: usize,
    /// Максимальная длина относительной позиционной таблицы (2*5000-1 = 9999).
    pub pos_emb_max_len: usize,
}

#[derive(Debug, Clone, Copy)]
pub struct DecoderConfig {
    /// Размер словаря SentencePiece (1024) без blank.
    pub vocab_size: usize,
    /// Скрытый размер prediction network (640).
    pub pred_hidden: usize,
    /// Число рекуррентных слоёв prediction network.
    pub pred_rnn_layers: usize,
    /// Скрытый размер joint network (640).
    pub joint_hidden: usize,
    /// Максимальное число токенов на один шаг времени RNNT.
    pub max_symbols_per_step: usize,
}

/// Полная конфигурация модели. Blank-токен всегда последний: id = vocab_size.
#[derive(Debug, Clone, Copy)]
pub struct FastConformerConfig {
    pub preprocessor: PreprocessorConfig,
    pub encoder: EncoderConfig,
    pub decoder: DecoderConfig,
    pub blank_id: usize,
}

impl Default for FastConformerConfig {
    fn default() -> Self {
        Self {
            preprocessor: PreprocessorConfig::default(),
            encoder: EncoderConfig {
                d_model: 512,
                n_layers: 17,
                n_heads: 8,
                feat_in: 80,
                subsampling_factor: 8,
                ff_dim: 2048,
                conv_kernel_size: 9,
                pos_emb_max_len: 5000,
            },
            decoder: DecoderConfig {
                vocab_size: 1024,
                pred_hidden: 640,
                pred_rnn_layers: 1,
                joint_hidden: 640,
                max_symbols_per_step: 10,
            },
            blank_id: 1024,
        }
    }
}

// Поля config.json, которые реально читаем; остальное игнорируется.
#[derive(Debug, Deserialize)]
struct RawConfig {
    preprocessor: Option<RawPreprocessor>,
    encoder: Option<RawEncoder>,
    #[serde(rename = "decoder")]
    rnnt_decoder: Option<RawRnntDecoder>,
}

#[derive(Debug, Deserialize)]
struct RawPreprocessor {
    sample_rate: Option<usize>,
    features: Option<usize>,
    n_fft: Option<usize>,
    window_size: Option<f64>,
    window_stride: Option<f64>,
}

#[derive(Debug, Deserialize)]
struct RawEncoder {
    d_model: Option<usize>,
    n_layers: Option<usize>,
    n_heads: Option<usize>,
    feat_in: Option<usize>,
    subsampling_factor: Option<usize>,
    ff_expansion_factor: Option<usize>,
    conv_kernel_size: Option<usize>,
    pos_emb_max_len: Option<usize>,
}

#[derive(Debug, Deserialize)]
struct RawRnntDecoder {
    #[allow(dead_code)]
    #[serde(rename = "_target_")]
    target: Option<String>,
    vocab_size: Option<usize>,
    prednet: Option<RawPrednet>,
    #[serde(rename = "jointnet")]
    jointnet: Option<RawJointnet>,
}

#[derive(Debug, Deserialize)]
struct RawPrednet {
    pred_hidden: Option<usize>,
    pred_rnn_layers: Option<usize>,
}

#[derive(Debug, Deserialize)]
struct RawJointnet {
    joint_hidden: Option<usize>,
}

/// Загружает конфигурацию из `config.json`. Отсутствующие поля — дефолты
/// (зафиксированы для stt_ru_fastconformer_hybrid_large_pc).
pub fn load(path: &Path) -> Result<FastConformerConfig> {
    let raw: RawConfig = serde_json::from_str(
        &std::fs::read_to_string(path)
            .with_context(|| format!("Не удалось прочитать {path:?}"))?,
    )
    .with_context(|| format!("Не удалось разобрать {path:?}"))?;

    let mut cfg = FastConformerConfig::default();
    if let Some(p) = &raw.preprocessor {
        let prep = &mut cfg.preprocessor;
        if let Some(v) = p.sample_rate {
            prep.sample_rate = v;
        }
        if let Some(v) = p.features {
            prep.n_mels = v;
        }
        if let Some(v) = p.n_fft {
            prep.n_fft = v;
        }
        if let Some(v) = p.window_size {
            prep.win_length = (v * prep.sample_rate as f64).round() as usize;
        }
        if let Some(v) = p.window_stride {
            prep.hop_length = (v * prep.sample_rate as f64).round() as usize;
        }
    }
    if let Some(e) = &raw.encoder {
        let enc = &mut cfg.encoder;
        if let Some(v) = e.d_model {
            enc.d_model = v;
        }
        if let Some(v) = e.n_layers {
            enc.n_layers = v;
        }
        if let Some(v) = e.n_heads {
            enc.n_heads = v;
        }
        if let Some(v) = e.feat_in {
            enc.feat_in = v;
        }
        if let Some(v) = e.subsampling_factor {
            enc.subsampling_factor = v;
        }
        if let Some(v) = e.ff_expansion_factor {
            enc.ff_dim = v * enc.d_model;
        }
        if let Some(v) = e.conv_kernel_size {
            enc.conv_kernel_size = v;
        }
        if let Some(v) = e.pos_emb_max_len {
            enc.pos_emb_max_len = v;
        }
    }
    if let Some(d) = &raw.rnnt_decoder {
        let dec = &mut cfg.decoder;
        if let Some(v) = d.vocab_size {
            dec.vocab_size = v;
        }
        if let Some(pn) = &d.prednet {
            if let Some(v) = pn.pred_hidden {
                dec.pred_hidden = v;
            }
            if let Some(v) = pn.pred_rnn_layers {
                dec.pred_rnn_layers = v;
            }
        }
        if let Some(jn) = &d.jointnet {
            if let Some(v) = jn.joint_hidden {
                dec.joint_hidden = v;
            }
        }
    }
    cfg.blank_id = cfg.decoder.vocab_size;
    Ok(cfg)
}
</file>

<file path="src/asr/frontend.rs">
//! Mel-фронтенд FastConformer: preemph → STFT → power → mel → log →
//! per-feature нормализация.
//!
//! Формулы сняты с эталонного препроцессора onnx-asr (istupakov), с которым
//! проведена побайтовая сверка на тестовых записях (пример `fc_verify`):
//! - preemph 0.97, первый семпл не изменяется;
//! - окно Hann 400 семплов (из весов чекпоинта), нулевое дополнение до 512
//!   по центру (56 с каждой стороны), нулевой паддинг сигнала на 256 семпла
//!   с обеих сторон;
//! - спектр мощности через ДПФ (матричная форма: окно × cos/sin базис —
//!   эквивалент прямого ДПФ, выполняется на GPU одним matmul);
//! - mel-фильтрбанк берётся ИЗ ВЕСОВ чекпоинта (`preprocessor.featurizer.fb`),
//!   поэтому расхождения фильтров исключены;
//! - log(x + 2**-24);
//! - per-feature нормализация: по каждому mel-каналу mean и несмещённая
//!   дисперсия (деление на len-1) по валидным кадрам, y = (x-mean)/(std+1e-5),
//!   кадры за пределами length обнуляются.

use super::config::PreprocessorConfig;
use anyhow::Result;
use candle_core::{DType, Device, Tensor};

pub struct MelFrontend {
    cfg: PreprocessorConfig,
    /// Окно Hann из весов, дополненное нулями до n_fft: [n_fft].
    window: Vec<f32>,
    /// cos-базис ДПФ: [n_fft/2+1, n_fft] на целевом устройстве.
    cos: Tensor,
    /// sin-базис ДПФ: [n_fft/2+1, n_fft].
    sin: Tensor,
    /// Mel-фильтрбанк из весов: [n_fft/2+1, n_mels].
    fb: Tensor,
}

impl MelFrontend {
    /// window — тензор окна из safetensors [400]; fb — [1, n_mels, n_fft/2+1].
    pub fn load(
        cfg: PreprocessorConfig,
        window: &Tensor,
        fb: &Tensor,
        device: &Device,
    ) -> Result<Self> {
        let n_fft = cfg.n_fft;
        let win_length = cfg.win_length;
        let mut w = vec![0f32; n_fft];
        let win_vec = window.flatten_all()?.to_vec1::<f32>()?;
        let left = (n_fft - win_length) / 2;
        for (i, v) in win_vec.into_iter().take(win_length).enumerate() {
            w[left + i] = v;
        }

        // Базис ДПФ: X[k] = sum_n x[n] * e^{-2πikn/N}; мощность = Xr² + Xi².
        let bins = n_fft / 2 + 1;
        let mut cos = vec![0f32; bins * n_fft];
        let mut sin = vec![0f32; bins * n_fft];
        for k in 0..bins {
            for n in 0..n_fft {
                let angle = -2.0 * std::f32::consts::PI * (k as f64 * n as f64) / n_fft as f64;
                cos[k * n_fft + n] = angle.cos() as f32;
                sin[k * n_fft + n] = angle.sin() as f32;
            }
        }
        let fb = fb.squeeze(0)?.t()?.to_device(device)?; // [1,80,257] -> [257,80]

        Ok(Self {
            cfg,
            window: w,
            cos: Tensor::from_vec(cos, (bins, n_fft), device)?,
            sin: Tensor::from_vec(sin, (bins, n_fft), device)?,
            fb,
        })
    }

    pub fn config(&self) -> &PreprocessorConfig {
        &self.cfg
    }

    /// Распознавание готового буфера 16 кГц mono f32.
    ///
    /// Возвращает (mel [n_mels, frames] на `device`, число валидных кадров).
    /// Кадров всегда floor(N/hop)+1; валидных — floor(N/hop), последний
    /// частичный кадр обнуляется (так же делает эталонный препроцессор).
    pub fn compute(&self, samples: &[f32], device: &Device) -> Result<(Tensor, usize)> {
        let cfg = &self.cfg;
        let n = samples.len();
        let hop = cfg.hop_length;
        let frames = n / hop + 1;
        let length = n / hop;

        // preemph: x[i] -= preemph * x[i-1], первый семпл не трогаем.
        let mut padded = vec![0f32; cfg.n_fft + n];
        if n > 0 {
            padded[cfg.n_fft] = samples[0];
        }
        for i in 1..n {
            padded[cfg.n_fft + i] = samples[i] - cfg.preemph * samples[i - 1];
        }

        // Окно: frame[t] = padded[t*hop .. t*hop + n_fft] * window.
        let mut windowed = vec![0f32; frames * cfg.n_fft];
        for (t, row) in windowed.chunks_mut(cfg.n_fft).enumerate() {
            let base = t * hop;
            for (j, cell) in row.iter_mut().enumerate() {
                *cell = padded[base + j] * self.window[j];
            }
        }
        let x = Tensor::from_vec(windowed, (frames, cfg.n_fft), &Device::Cpu)?.to_device(device)?;

        // Спектр мощности: |X[k]|² = (x·cos)² + (x·sin)², затем mel и log.
        let xr = x.matmul(&self.cos)?; // [frames, bins]
        let xi = x.matmul(&self.sin)?;
        let power = (xr.sqr()? + xi.sqr()?)?; // [frames, bins]
        let mel = power.matmul(&self.fb)?; // [frames, n_mels]
        let log_mel = (mel + cfg.log_guard)?.log()?; // [frames, n_mels]
        let mut values = log_mel.to_dtype(DType::F32)?.to_vec2::<f32>()?; // [frames, n_mels]

        // per-feature нормализация по валидным кадрам; остальное — нули.
        for bin in values.iter_mut() {
            for frame in bin.iter_mut().skip(length) {
                *frame = 0.0;
            }
        }
        if length > 1 {
            for bin in values.iter_mut() {
                let mut sum = 0f64;
                for v in &bin[..length] {
                    sum += *v as f64;
                }
                let mean = (sum / length as f64) as f32;
                let mut var = 0f64;
                for v in &bin[..length] {
                    let d = *v as f64 - mean as f64;
                    var += d * d;
                }
                let std = (var / (length - 1) as f64).sqrt() as f32 + 1e-5;
                for v in bin[..length].iter_mut() {
                    *v = (*v - mean) / std;
                }
            }
        } else if length == 1 {
            // Дисперсия не определена: эталон даёт (x-mean)/inf = 0.
            for bin in values.iter_mut() {
                for frame in bin.iter_mut().take(length) {
                    *frame = 0.0;
                }
            }
        }

        let mel = Tensor::from_vec(
            values.into_iter().flatten().collect::<Vec<f32>>(),
            (cfg.n_mels, frames),
            device,
        )?;
        Ok((mel, length))
    }
}

/// Длина выходных кадров энкодера: floor((len-1)/2)+1 на каждую свёртку
/// stride 2 (последовательность снята с графа ONNX-эталона).
pub fn calc_length(len: usize, subsampling_factor: usize) -> usize {
    let mut l = len;
    let convs = subsampling_factor.trailing_zeros().max(1) as usize;
    for _ in 0..convs {
        if l == 0 {
            return 0;
        }
        l = (l - 1) / 2 + 1;
    }
    l
}
</file>

