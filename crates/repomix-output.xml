        assert_eq!(extract_topic_resume("расскажи про погоду"), None);
    }

    #[test]
    fn tts_text_cleanup() {
        assert_eq!(
            clean_tts_text("**Заголовок**\n\n- пункт"),
            "Заголовок - пункт"
        );
    }
}

