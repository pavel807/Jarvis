        assert_eq!(cfg.num_key_value_heads, 2);
        assert_eq!(cfg.head_dim, 256);
        assert_eq!(cfg.linear_num_heads, 16);
        assert_eq!(cfg.rotary_dim(), 64);
        assert_eq!(cfg.rope_theta, 10_000_000.0);
