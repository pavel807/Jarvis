//! Запуск AppleScript внутри процесса приложения.
//!
//! Раньше каждый скрипт уходил в отдельный `osascript`, порождённый из `sh`.
//! Это давало две проблемы:
//!
//! 1. Разрешение на автоматизацию macOS привязано к тому, кто спрашивает.
//!    Порождённому `osascript` система отвечает «privilege violation»
//!    (-10004) без всякого диалога, и пользователю оставалось самому искать
//!    нужный пункт в Системных настройках, не понимая, что искать.
//! 2. На каждый скрипт поднимался новый процесс.
//!
//! `NSAppleScript` выполняется в процессе Джарвиса: системный запрос приходит
//! от его имени («Джарвис хочет управлять „Музыкой“»), и выданное разрешение
//! действует на все последующие скрипты. Для приложения, живущего в трее,
//! это ещё и важно потому, что идентичность берётся у самого бандла.

#[cfg(target_os = "macos")]
mod imp {
    use objc2::rc::autoreleasepool;
    use objc2::runtime::AnyObject;
    use objc2::{AnyThread, msg_send};
    use objc2_foundation::{
        NSAppleEventDescriptor, NSAppleScript, NSAppleScriptErrorNumber, NSDictionary, NSString,
    };

    /// Номера ошибок AppleScript, по которым нужно объяснять причину словами,
    /// а не показывать пользователю сырой код.
    const ERR_AUTOMATION_DENIED: i64 = -1743;
    const ERR_PRIVILEGE_VIOLATION: i64 = -10004;
    const ERR_APP_NOT_RUNNING: i64 = -600;

    fn error_number(info: &NSDictionary<NSString, AnyObject>) -> Option<i64> {
        let value = info.objectForKey(unsafe { NSAppleScriptErrorNumber })?;
        // Номер приходит как NSNumber: читаем integerValue, а не Debug-строку,
        // иначе в сообщении оказывается адрес объекта.
        let responds: bool =
            unsafe { msg_send![&*value, respondsToSelector: objc2::sel!(integerValue)] };
        if !responds {
            return None;
        }
        Some(unsafe { msg_send![&*value, integerValue] })
    }

    /// Человеческая причина вместо сырого кода AppleScript.
    ///
    /// Отказ в автоматизации — самый частый случай, и он требует не «ошибка
    /// AppleScript», а конкретного шага: разрешение выдаётся тому приложению,
    /// которое спросило. Если Джарвис запущен как обычный бинарник (CLI), в
    /// списке Автоматизации он не появится — тогда честно говорим об этом.
    pub(super) fn describe_script_error(number: Option<i64>, text: &str) -> String {
        let hint = "macOS не даёт Джарвису управлять другими приложениями. \
                    Системные настройки → Конфиденциальность и безопасность → Автоматизация — \
                    включи нужные приложения для Jarvis";
        match number {
            Some(ERR_AUTOMATION_DENIED) | Some(ERR_PRIVILEGE_VIOLATION) => {
                if is_own_bundle() {
                    hint.to_string()
                } else {
                    format!(
                        "{hint}. Запускать нужно приложение Jarvis из .app: у консольной \
                         сборки система не показывает запрос автоматизации"
                    )
                }
            }
            Some(ERR_APP_NOT_RUNNING) => "Приложение не запущено".to_string(),
            Some(code) if !text.is_empty() => format!("{text} (код {code})"),
            Some(code) => format!("AppleScript не выполнился (код {code})"),
            None if !text.is_empty() => text.to_string(),
            None => "AppleScript не выполнился".to_string(),
        }
    }

    /// Запущен ли код внутри собранного .app с именем Jarvis: только тогда
    /// система показывает диалог автоматизации от его имени.
    fn is_own_bundle() -> bool {
        std::env::current_exe()
            .ok()
            .map(|p| p.to_string_lossy().contains(".app/Contents/MacOS/"))
            .unwrap_or(false)
    }

    /// Выполняет AppleScript в текущем процессе.
    ///
    /// `Ok(text)` — результат скрипта (пустая строка, если он ничего не вернул).
    /// `Err` — текст ошибки AppleScript без служебной позиции «12:34:».
    ///
    /// `None` — in-process путь выключен переменной `JARVIS_APPLESCRIPT=osascript`.
    /// Это нужно для отладки: сравнивать поведение разрешений удобнее с
    /// внешним процессом.
    pub fn run(script: &str) -> Option<Result<String, String>> {
        if std::env::var("JARVIS_APPLESCRIPT").is_ok_and(|v| v == "osascript") {
            return None;
        }

        // Пул обязателен: NSAppleScript создаёт объекты на время вызова.
        autoreleasepool(|_| {
            let source = NSString::from_str(script);
            let Some(script_obj) = NSAppleScript::initWithSource(NSAppleScript::alloc(), &source)
            else {
                return Some(Err("не удалось собрать AppleScript".into()));
            };

            // Готовую обёртку objc2 здесь использовать нельзя: при отказе в
            // автоматизации система возвращает NULL, а обёртка на это паникует
            // («unexpected NULL returned from -[NSAppleScript
            // executeAndReturnError:]») — приложение падало вместо честного
            // сообщения. Поэтому вызываем селектор сами и NULL обрабатываем.
            let mut error: *mut NSDictionary<NSString, AnyObject> = std::ptr::null_mut();
            let descriptor: *mut NSAppleEventDescriptor = unsafe {
                msg_send![
                    &*script_obj,
                    executeAndReturnError: &mut error as *mut *mut NSDictionary<NSString, AnyObject>
                ]
            };

            if !error.is_null() {
                // В словаре ошибки лежит номер: -1743 — отказ в автоматизации,
                // -10004 — нарушение прав доступа. Без номера текст бесполезен.
                let info: &NSDictionary<NSString, AnyObject> = unsafe { &*error };
                let number = error_number(info);
                let text = if descriptor.is_null() {
                    String::new()
                } else {
                    let d: &NSAppleEventDescriptor = unsafe { &*descriptor };
                    d.stringValue().map(|s| s.to_string()).unwrap_or_default()
                };
                return Some(Err(describe_script_error(number, &text)));
            }

            if descriptor.is_null() {
                return Some(Err("AppleScript вернул пустой ответ".into()));
            }
            let d: &NSAppleEventDescriptor = unsafe { &*descriptor };
            Some(Ok(d
                .stringValue()
                .map(|s| s.to_string())
                .unwrap_or_default()))
        })
    }
}

#[cfg(not(target_os = "macos"))]
mod imp {
    pub fn run(_script: &str) -> Option<Result<String, String>> {
        None
    }
}

pub use imp::run;

#[cfg(test)]
mod tests {
    /// In-process AppleScript должен отдавать тот же текст, что osascript.
    /// Проверка мягкая: в песочнице разрешений может не быть, и тогда это
    /// не ошибка кода, а запрет системы.
    #[cfg(target_os = "macos")]
    #[test]
    fn in_process_applescript_returns_text() {
        match super::run(r#"return "проверка""#) {
            Some(Ok(value)) => assert_eq!(value.trim(), "проверка"),
            Some(Err(e)) => eprintln!("⚠️ AppleScript недоступен в этом окружении: {e}"),
            None => eprintln!("⚠️ in-process путь выключен переменной окружения"),
        }
    }

    /// Отказ в автоматизации раньше приводил к панике objc2 на NULL и ронял
    /// приложение. Теперь это честная ошибка: проверяем, что вызов вообще
    /// возвращается и не теряет причину.
    #[cfg(target_os = "macos")]
    #[test]
    fn permission_denial_is_an_error_not_a_crash() {
        // Скрипт обращается к чужому приложению — в тестовом окружении это
        // почти всегда отказ. Падение здесь означает, что NULL не обработан.
        match super::run(r#"tell application "Music" to get player state as text"#) {
            Some(Ok(state)) => eprintln!("⚠️ разрешение выдано, состояние: {}", state.trim()),
            Some(Err(e)) => {
                assert!(!e.trim().is_empty(), "причина ошибки не должна теряться");
                eprintln!("отказ получен корректно: {e}");
            }
            None => eprintln!("⚠️ in-process путь выключен"),
        }
    }

    /// Номера ошибок должны превращаться в понятные шаги, а не в сырой код.
    #[cfg(target_os = "macos")]
    #[test]
    fn error_numbers_become_advice() {
        let denied = super::imp::describe_script_error(Some(-1743), "");
        assert!(denied.contains("Автоматизация"), "{denied}");
        assert!(
            !denied.contains("-1743"),
            "сырой код не должен показываться: {denied}"
        );
        let privilege = super::imp::describe_script_error(Some(-10004), "");
        assert!(privilege.contains("Автоматизация"), "{privilege}");
        let not_running = super::imp::describe_script_error(Some(-600), "");
        assert!(not_running.contains("не запущено"), "{not_running}");
        // Неизвестный код оставляем как есть: лучше код, чем пустота.
        let other = super::imp::describe_script_error(Some(-1234), "что-то пошло не так");
        assert!(
            other.contains("-1234") && other.contains("что-то"),
            "{other}"
        );
    }
}
