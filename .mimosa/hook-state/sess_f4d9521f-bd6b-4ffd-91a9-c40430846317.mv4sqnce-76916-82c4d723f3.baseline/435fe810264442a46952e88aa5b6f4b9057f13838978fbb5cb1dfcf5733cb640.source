/// Просьбы, которые звучат как команда, но выполняются ответом, а не
/// инструментом: перевод, объяснение, пересказ.
const ANSWER_PHRASES: &[&str] = &[
    "переведи",
    "перевести",
    "перевод",
    "объясни",
    "объяснить",
    "как будет",
