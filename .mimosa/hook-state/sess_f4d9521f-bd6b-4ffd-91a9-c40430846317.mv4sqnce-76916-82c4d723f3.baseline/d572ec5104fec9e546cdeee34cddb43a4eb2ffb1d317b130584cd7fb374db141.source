/// напоминания — по нему оно убирается из списка, когда время вышло.
#[cfg(target_os = "macos")]

/// Ставит системное напоминание и возвращает его id. Ошибка — короткая
/// человеческая причина (нет доступа автоматизации, Reminders недоступны).
#[cfg(target_os = "macos")]

/// Что сказать вслух, когда системный таймер/будильник сработал.
#[cfg(target_os = "macos")]

/// Сработал системный таймер: убираем напоминание из списка Напоминаний
/// (дело сделано) и озвучиваем, если Джарвис ещё запущен. Штатное уведомление
/// при этом приходит от самой системы в любом случае.
#[cfg(target_os = "macos")]

// =========================================================================
// Скриншот
// =========================================================================

fn screenshot_impl() -> Option<String> {
    let path = temp_path("jarvis_screenshot.png");

    #[cfg(target_os = "macos")]
    {
        let ok = Command::new("screencapture")
            .args(["-x", &path])
            .status()
            .map(|s| s.success())
            .unwrap_or(false);
        ok.then_some(path)
    }
}

// =========================================================================
// Блокировка экрана
// =========================================================================

fn lock_screen_impl() -> bool {
    #[cfg(target_os = "macos")]
    {
        Command::new("pmset")
            .args(["displaysleepnow"])
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }
}

// =========================================================================
// Sleep
// =========================================================================

fn sleep_impl() -> bool {
    #[cfg(target_os = "macos")]
    {
        Command::new("pmset")
            .args(["sleepnow"])
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }
}

// =========================================================================
// Уведомления
// =========================================================================

pub(crate) fn notify_impl(title: &str, body: &str) -> bool {
    #[cfg(target_os = "macos")]
    {
        let script = format!(
            "display notification \"{}\" with title \"{}\"",
            body.replace('"', "\\\""),
            title.replace('"', "\\\""),
        );
        Command::new("osascript")
            .args(["-e", &script])
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }
}

// =========================================================================
// Буфер обмена
// =========================================================================

fn clipboard_read_impl() -> Option<String> {
    #[cfg(target_os = "macos")]
    {
        if let Ok(out) = Command::new("pbpaste").output() {
            return Some(String::from_utf8_lossy(&out.stdout).to_string());
        }
        None
    }
}

fn clipboard_write_impl(text: &str) -> bool {
    #[cfg(target_os = "macos")]
    {
        use std::io::Write;
        if let Ok(mut child) = Command::new("pbcopy")
            .stdin(std::process::Stdio::piped())
            .spawn()
        {
            if let Some(stdin) = child.stdin.as_mut() {
                let _ = stdin.write_all(text.as_bytes());
            }
            return child.wait().map(|s| s.success()).unwrap_or(false);
        }
        false
    }
}

