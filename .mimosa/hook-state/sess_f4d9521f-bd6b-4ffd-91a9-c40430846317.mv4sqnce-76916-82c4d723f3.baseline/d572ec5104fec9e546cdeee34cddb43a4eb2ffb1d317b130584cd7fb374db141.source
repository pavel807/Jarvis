/// Обобщённые имена, для которых инструмент определяется по аргументам:
/// `{"name":"open","args":{"url":"..."}}` → open_url, `{"name":"run",
/// "args":{"cmd":"..."}}` → shell и т.д.
const GENERIC_NAMES: &[&str] = &[
    "open",
    "open_it",
    "launch",
    "start",
    "run",
    "execute",
    "do",
    "action",
    "tool",
    "browser",
    "открыть",
    "запустить",
    "перейти",
    "выполнить_команду",
];

fn lookup_alias(norm: &str) -> Option<&'static str> {
    ALIASES.iter().find(|(a, _)| *a == norm).map(|(_, c)| *c)
}

/// Извлекает объект аргументов. Поддерживает:
/// * `{"name":..,"args":{..}}` — канонический вид;
/// * `{"name":..,"arguments":{..}}` / `input` / `parameters`;
/// * `{"name":..,"args":"{..}"}` — args как строка с JSON;
/// * `{"name":"open_url","url":".."}` — аргументы в плоском виде.
fn extract_args(v: &Value) -> Value {
    let mut out = serde_json::Map::new();

    // Плоские аргументы на верхнем уровне (кроме служебных полей).
    if let Value::Object(map) = v {
        for (k, val) in map {
            let nk = normalize_name(k);
            if matches!(
                nk.as_str(),
                "name" | "tool" | "arguments" | "input" | "parameters" | "args"
            ) {
                continue;
            }
            out.insert(nk, val.clone());
        }
    }

    // Вложенные аргументы имеют приоритет.
    let nested = ["args", "arguments", "input", "parameters"]
        .iter()
        .find_map(|k| v.get(*k));
    if let Some(val) = nested {
        let obj = match val {
            Value::Object(m) => Some(m.clone()),
            Value::String(s) => serde_json::from_str::<Value>(s)
                .ok()
                .and_then(|p| p.as_object().cloned()),
            _ => None,
        };
        if let Some(m) = obj {
            for (k, val) in &m {
                out.insert(normalize_name(k), val.clone());
            }
        }
    }

    Value::Object(out)
}

fn arg_str<'a>(args: &'a Value, keys: &[&str]) -> Option<&'a str> {
    keys.iter()
        .find_map(|k| args.get(*k))
        .and_then(|x| x.as_str())
        .map(str::trim)
        .filter(|s| !s.is_empty())
}

/// Число из числа или из строки-числа (`"50"` → 50).
fn arg_bool(args: &Value, keys: &[&str]) -> bool {
    keys.iter()
        .find_map(|k| args.get(*k))
        .is_some_and(|x| match x {
            Value::Bool(b) => *b,
            Value::Number(n) => n.as_u64().is_some_and(|v| v != 0),
            Value::String(s) => {
                matches!(
                    s.trim().to_lowercase().as_str(),
                    "true" | "1" | "yes" | "да"
                )
            }
            _ => false,
        })
}

fn arg_u64(args: &Value, keys: &[&str]) -> Option<u64> {
    keys.iter()
        .find_map(|k| args.get(*k))
        .and_then(|x| match x {
            Value::Number(n) => n.as_u64().or_else(|| {
                n.as_f64().and_then(|f| {
                    if f >= 0.0 && f.fract() == 0.0 {
                        Some(f as u64)
                    } else {
                        None
                    }
                })
            }),
            Value::String(s) => {
                let t = s.trim();
                t.parse::<u64>()
                    .ok()
                    .or_else(|| t.parse::<f64>().ok().map(|f| f as u64))
            }
            Value::Bool(b) => Some(*b as u64),
            _ => None,
        })
}

/// Секунды: принимает `seconds`/`sec`/`time`/`duration`, а также `minutes`.
fn arg_seconds(args: &Value) -> Option<u64> {
    if let Some(s) = arg_u64(
        args,
        &[
            "seconds",
            "second",
            "secs",
            "sec",
            "time",
            "duration",
            "delay",
            "timeout",
            "in_seconds",
            "секунд",
            "секунды",
            "секунда",
        ],
    ) {
        return Some(s);
    }
    arg_u64(
        args,
        &[
            "minutes",
            "minute",
            "mins",
            "min",
            "минут",
            "минуты",
            "минута",
        ],
    )
    .map(|m| m * 60)
}

/// Определяет канонический инструмент по имени и аргументам.
fn resolve_tool(name: &str, args: &Value) -> Option<&'static str> {
    let norm = normalize_name(name);
    if norm.is_empty() {
        return None;
    }
    if let Some(canonical) = lookup_alias(&norm) {
        return Some(canonical);
    }
    if !GENERIC_NAMES.contains(&norm.as_str()) {
        return None;
    }
    if arg_str(
        args,
        &["url", "link", "website", "site", "href", "адрес", "ссылка"],
    )
    .is_some()
    {
        Some("open_url")
    } else if arg_str(
        args,
        &["cmd", "command", "shell", "shell_command", "команда"],
    )
    .is_some()
    {
        Some("shell")
    } else if arg_str(
        args,
        &["app", "app_name", "application", "программа", "приложение"],
    )
    .is_some()
    {
        Some("open_app")
    } else if arg_str(args, &["path", "folder", "dir", "directory", "папка"]).is_some() {
        Some("open_path")
    } else if arg_str(args, &["name", "title", "имя"]).is_some() {
        Some("open_app")
    } else {
        None
    }
}

/// Разбирает ответ модели. Неизвестные/битые аргументы больше не приводят к
/// молчаливому `None`: возвращается `Failed` с причиной.
pub fn parse(text: &str) -> ToolParse {
    let inner = match extract_tool_inner(text) {
        Ok(inner) => inner,
        Err(reason) => {
            // Нет `<tool>` вообще — это обычный текст, а не ошибка.
            if !text.contains("<tool>") {
                return ToolParse::None;
            }
            return ToolParse::Failed(reason);
        }
    };

    let v: Value = match serde_json::from_str(inner) {
        Ok(v) => v,
        Err(e) => return ToolParse::Failed(format!("битый JSON в tool-блоке: {e}")),
    };

    // Имя может быть в "name" или в "tool".
    let raw_name = ["name", "tool", "function", "action"]
        .iter()
        .find_map(|k| v.get(*k))
        .and_then(|x| x.as_str());
    let Some(raw_name) = raw_name else {
        return ToolParse::Failed("в tool-блоке нет поля name".into());
    };

    let args = extract_args(&v);
    let Some(name) = resolve_tool(raw_name, &args) else {
        return ToolParse::Failed(format!("неизвестный инструмент «{raw_name}», args: {args}"));
    };

    match build_call(name, &args) {
        Some(Ok(call)) => ToolParse::Call(call),
        Some(Err(reason)) => {
            ToolParse::Failed(format!("инструмент {name}: {reason}, args: {args}"))
        }
        None => ToolParse::Failed(format!("инструмент {name} не поддерживается, args: {args}")),
    }
}

/// Достаёт JSON из tool-блока. Закрывающий `</tool>` необязателен: генерация
/// часто останавливается ровно на `}}`, и токен может оборвать тег на `</`.
/// Поэтому при отсутствии тега берём первый сбалансированный JSON-объект.
fn extract_tool_inner(text: &str) -> Result<&str, String> {
    let Some(start) = text.find("<tool>") else {
        return Err("нет tool-блока".into());
    };
    let after = &text[start + "<tool>".len()..];
    if let Some(end) = after.find("</tool>") {
        return Ok(after[..end].trim());
    }
    if let Some(json) = balanced_json(after) {
        return Ok(json.trim());
    }
    Err("tool-блок не закрыт </tool> (ответ обрезан)".into())
}

/// Возвращает первый сбалансированный JSON-объект в строке (с учётом строк и
/// экранирования), либо `None`, если объект не закрыт.
fn balanced_json(s: &str) -> Option<&str> {
    let brace = s.find('{')?;
    let json = &s[brace..];
    let mut depth = 0i32;
    let mut in_str = false;
    let mut escaped = false;
    for (idx, c) in json.char_indices() {
        if in_str {
            if escaped {
                escaped = false;
            } else if c == '\\' {
                escaped = true;
            } else if c == '"' {
                in_str = false;
            }
            continue;
        }
        match c {
            '"' => in_str = true,
            '{' => depth += 1,
            '}' => {
                depth -= 1;
                if depth == 0 {
                    return Some(&json[..idx + c.len_utf8()]);
                }
            }
            _ => {}
        }
    }
    None
}

/// Проверяет, что JSON внутри tool-блока уже закрыт и разбирается.
///
/// Используется для ранней остановки генерации: как только `{"name":...,
/// "args":{...}}` дописан, ждать конца ответа не нужно.
pub fn tool_json_complete(text: &str) -> bool {
    let Some(start) = text.find("<tool>") else {
        return false;
    };
    let after = &text[start + "<tool>".len()..];
    match balanced_json(after) {
        Some(json) => serde_json::from_str::<Value>(json).is_ok(),
        None => false,
    }
}

/// Разбор с починкой: если генерация оборвалась на середине JSON (например по
/// лимиту токенов), закрываем скобки и тег, и только потом разбираем.
pub fn parse_lenient(text: &str) -> ToolParse {
    let first = parse(text);
    if !matches!(first, ToolParse::Failed(_)) {
        return first;
    }
    // Незакрытый тег уже обрабатывается в extract_tool_inner, здесь чиним
    // именно недописанный JSON: строку и скобки.
    let base = strip_dangling_close(text);
    for suffix in [
        "}",
        "}}",
        "\"}}",
        "}}}",
        "\"}}}",
        "</tool>",
        "}}</tool>",
        "\"}}</tool>",
        "\",\"args\":{}}</tool>",
    ] {
        let repaired = format!("{base}{suffix}");
        match parse(&repaired) {
            ToolParse::Failed(_) => continue,
            other => return other,
        }
    }
    first
}

/// Убирает хвостовой обрывок закрывающего тега (`<`, `</`, `</t`, …, `</tool`).
fn strip_dangling_close(text: &str) -> &str {
    const TAG: &str = "</tool>";
    for len in (1..TAG.len()).rev() {
        if text.ends_with(&TAG[..len]) {
            return &text[..text.len() - len];
        }
    }
    text
}

/// Срезает все tool-блоки из текстового ответа.
///
/// Модель 2B иногда прикладывает к обычному текстовому ответу выдуманный
/// или битый `<tool>`-блок (даже когда вопрос не про действие) — в чате и
/// озвучке сырой JSON не нужен. Незакрытый блок режется вместе с хвостом.
pub fn strip_tool_blocks(text: &str) -> String {
    let mut out = String::with_capacity(text.len());
    let mut rest = text;
    while let Some(start) = rest.find("<tool>") {
        out.push_str(&rest[..start]);
        rest = &rest[start + "<tool>".len()..];
        match rest.find("</tool>") {
            Some(end) => rest = &rest[end + "</tool>".len()..],
            None => {
                rest = "";
            }
        }
    }
    out.push_str(rest);
    let out = strip_dangling_close(&out);
    out.trim().to_string()
}

/// Канонические имена, которые умеет исполнять движок.
const SUPPORTED: &[&str] = &[
    "shell",
    "open_app",
    "open_url",
    "open_path",
    "set_timer",
    "set_alarm",
    "timer_stop",
    "set_volume",
    "set_brightness",
    "screenshot",
    "lock_screen",
    "sleep",
    "notify",
    "clipboard_read",
    "clipboard_write",
    "applescript",
    "system_info",
    "file_read",
    "file_write",
    "file_append",
    "file_edit",
    "file_list",
    "file_search",
    "file_glob",
    "task_add",
    "task_list",
    "task_done",
    "task_remove",
    "task_run",
    "task_open",
    "web_search",
    "window",
    "run_command",
    "send_message",
    "add_note",
    "create_event",
    "music_control",
];

/// Строит `ToolCall` по каноническому имени. `None` — имени нет в движке,
/// `Some(Err)` — имя есть, но аргументы не распознаны.
fn build_call(name: &str, args: &Value) -> Option<Result<ToolCall, String>> {
    if !SUPPORTED.contains(&name) {
        return None;
    }
    Some(build(name, args))
}

fn build(name: &str, args: &Value) -> Result<ToolCall, String> {
    let get_str = |keys: &[&str]| -> Result<String, String> {
        match arg_str(args, keys) {
            Some(s) => Ok(s.to_string()),
            None => Err(format!("нет поля {}", keys.join("/"))),
        }
    };
    let get_seconds = || -> Result<u64, String> {
        match arg_seconds(args) {
            Some(s) => Ok(s),
            None => Err("нет поля seconds/minutes".into()),
        }
    };
    let get_percent = || -> Result<u8, String> {
        match arg_u64(
            args,
            &[
                "percent",
                "value",
                "level",
                "volume",
                "brightness",
                "процент",
            ],
        ) {
            Some(p) => Ok(p.min(100) as u8),
            None => Err("нет поля percent".into()),
        }
    };
    let get_label =
        || arg_str(args, &["label", "text", "note", "message", "комментарий"]).map(String::from);

    Ok(match name {
        "shell" => {
            let cmd = get_str(&["cmd", "command", "command_line", "команда", "script"])?;
            if is_dangerous(&cmd) {
                eprintln!("⚠️ Опасная shell-команда заблокирована: {cmd}");
                return Err("опасная команда заблокирована".into());
            }
            ToolCall::Shell { cmd }
        }
        "open_app" => ToolCall::OpenApp {
            name: get_str(&[
                "name",
                "app",
                "app_name",
                "application",
                "программа",
                "приложение",
            ])?,
        },
        "open_url" => ToolCall::OpenUrl {
            url: get_str(&["url", "link", "website", "site", "href", "адрес", "ссылка"])?,
        },
        "timer_stop" => ToolCall::TimerStop,
        "web_search" => ToolCall::WebSearch {
            query: get_str(&[
                "query",
                "q",
                "text",
                "search",
                "запрос",
                "поиск",
                "что_найти",
            ])?,
        },
        "open_path" => ToolCall::OpenPath {
            path: get_str(&["path", "folder", "dir", "directory", "папка"])?,
        },
        "set_timer" => ToolCall::SetTimer {
            seconds: get_seconds()?,
            label: get_label(),
        },
        "set_alarm" => ToolCall::SetAlarm {
            seconds_from_now: get_seconds()?,
            label: get_label(),
        },
        "set_volume" => ToolCall::SetVolume {
            percent: get_percent()?,
        },
        "set_brightness" => ToolCall::SetBrightness {
            percent: get_percent()?,
        },
        "screenshot" => ToolCall::Screenshot,
        "lock_screen" => ToolCall::LockScreen,
        "sleep" => ToolCall::Sleep,
        "notify" => ToolCall::Notify {
            title: get_str(&["title", "heading", "заголовок"])?,
            body: get_str(&["body", "message", "text", "текст", "content"])?,
        },
        "clipboard_read" => ToolCall::ClipboardRead,
        "clipboard_write" => ToolCall::ClipboardWrite {
            text: get_str(&["text", "content", "data", "string", "текст"])?,
        },
        "applescript" => {
            let script = get_str(&["script", "code", "source", "команда"])?;
            if is_dangerous(&script) {
                return Err("опасный скрипт заблокирован".into());
            }
            ToolCall::AppleScript { script }
        }
        "system_info" => ToolCall::SystemInfo,
        "file_read" => {
            let limit =
                arg_u64(args, &["limit", "lines", "count", "сколько", "строк"]).map(|v| v as usize);
            let offset = arg_u64(args, &["offset", "from", "start", "line", "строка", "с"])
                .map(|v| v as usize);
            ToolCall::FileRead {
                path: get_str(&["path", "file", "filename", "файл"])?,
                offset,
                limit,
            }
        }
        "file_write" => ToolCall::FileWrite {
            path: get_str(&["path", "file", "filename", "файл"])?,
            content: get_str(&["content", "text", "data", "body", "содержимое"])?,
        },
        "file_append" => ToolCall::FileAppend {
            path: get_str(&["path", "file", "filename", "файл"])?,
            content: get_str(&["content", "text", "data", "body", "содержимое"])?,
        },
        "file_edit" => ToolCall::FileEdit {
            path: get_str(&["path", "file", "filename", "файл"])?,
            old: get_str(&["old", "old_string", "find", "from", "было", "найти"])?,
            new: arg_str(
                args,
                &["new", "new_string", "replace", "to", "стало", "заменить"],
            )
            .unwrap_or("")
            .to_string(),
            all: arg_bool(args, &["all", "replace_all", "everywhere", "все"]),
        },
        "file_list" => ToolCall::FileList {
            path: arg_str(args, &["path", "dir", "directory", "folder", "папка"])
                .map(str::to_string)
                .unwrap_or_else(|| ".".to_string()),
        },
        "file_search" => ToolCall::FileSearch {
            query: get_str(&["query", "text", "pattern", "что", "найти", "search"])?,
            path: arg_str(args, &["path", "dir", "in", "где", "папка"]).map(str::to_string),
            context: arg_u64(args, &["context", "around", "контекст"]).map(|v| v as usize),
        },
        "file_glob" => ToolCall::FileGlob {
            pattern: get_str(&["pattern", "mask", "glob", "маска", "имя"])?,
            path: arg_str(args, &["path", "dir", "in", "где", "папка"]).map(str::to_string),
        },
        "task_add" => ToolCall::TaskAdd {
            text: get_str(&[
                "text",
                "task",
                "todo",
                "задача",
                "заметка",
                "content",
                "body",
            ])?,
        },
        "task_list" => ToolCall::TaskList,
        "task_done" => ToolCall::TaskDone {
            id: arg_u64(args, &["id", "number", "num", "index", "номер", "задача"]).unwrap_or(1)
                as usize,
        },
        "task_remove" => ToolCall::TaskRemove {
            id: arg_u64(args, &["id", "number", "num", "index", "номер", "задача"]).unwrap_or(1)
                as usize,
        },
        "task_run" => ToolCall::TaskRun {
            id: arg_u64(args, &["id", "number", "num", "index", "номер", "задача"])
                .map(|n| n as usize),
        },
        "task_open" => ToolCall::TaskOpen,
        "window" => ToolCall::Window {
            action: normalize_action(&get_str(&[
                "action",
                "op",
                "mode",
                "what",
                "команда",
                "действие",
                "операция",
            ])?),
            app: arg_str(
                args,
                &[
                    "app",
                    "name",
                    "application",
                    "program",
                    "target",
                    "приложение",
                    "программа",
                ],
            )
            .map(|a| fix_lookalikes(&a)),
        },
        "run_command" => {
            let name = get_str(&["name", "command_name", "id", "название", "имя"])?;
            // Параметры команды: вложенный объект args/params/arguments.
            // Значения приводим к строкам — подставляются в {плейсхолдеры}.
            let call_args = args
                .get("args")
                .or_else(|| args.get("params"))
                .or_else(|| args.get("arguments"))
                .and_then(|v| v.as_object())
                .map(|obj| {
                    obj.iter()
                        .filter_map(|(k, v)| {
                            let val = match v {
                                Value::String(s) => s.clone(),
                                Value::Number(n) => n.to_string(),
                                Value::Bool(b) => b.to_string(),
                                _ => return None,
                            };
                            Some((k.clone(), val))
                        })
                        .collect::<std::collections::HashMap<String, String>>()
                })
                .unwrap_or_default();
            ToolCall::RunCommand {
                name,
                args: call_args,
            }
        }
        "send_message" => ToolCall::SendMessage {
            to: get_str(&["to", "contact", "recipient", "кому", "адресат"])?,
            text: get_str(&["text", "message", "body", "сообщение", "текст"])?,
        },
        "add_note" => ToolCall::AddNote {
            title: get_str(&["title", "name", "заголовок", "название"])?,
            body: arg_str(args, &["body", "text", "content", "текст", "содержимое"])
                .unwrap_or_default()
                .to_string(),
        },
        "create_event" => ToolCall::CreateEvent {
            title: get_str(&["title", "name", "название", "событие"])?,
            date: arg_str(args, &["date", "дата", "day"])
                .unwrap_or_default()
                .to_string(),
            time: arg_str(args, &["time", "время", "hour"])
                .unwrap_or_default()
                .to_string(),
        },
        "music_control" => ToolCall::MusicControl {
            action: normalize_music_action(&get_str(&["action", "what", "op", "действие"])?),
        },
        other => return Err(format!("инструмент {other} не поддерживается")),
    })
}

/// Приводит действие над плеером к каноническому виду.
fn normalize_music_action(raw: &str) -> String {
    let compact: String = raw
        .trim()
        .to_lowercase()
        .chars()
        .filter(|c| c.is_alphanumeric())
        .collect();
    match compact.as_str() {
        "play"
        | "playmusic"
        | "включи"
        | "включимузыку"
        | "играть"
        | "запуск"
        | "продолжи"
        | "продолжить"
        | "возобнови"
        | "дальшеиграй" => "play".into(),
        // «Останови» и «стоп» — это не то же, что пауза: трек уходит в начало.
        "stop" | "останови" | "стоп" | "выключи" | "выключимузыку" | "замолчи" => {
            "stop".into()
        }
        "pause" | "пауза" | "приостанови" | "напаузу" => "pause".into(),
        "next" | "nexttrack" | "дальше" | "следующий" | "следующая" | "вперед" => {
            "next".into()
        }
        "previous" | "previoustrack" | "назад" | "предыдущий" | "предыдущая" => {
            "previous".into()
        }
        _ => raw.trim().to_lowercase(),
    }
}

/// Приводит действие над окном к каноническому виду.
///
/// Модель пишет «на весь экран», «разверни», «fullscreen» — смысл один, а
/// строки разные. Без нормализации половина просьб уходила бы в ошибку.
fn normalize_action(raw: &str) -> String {
    let raw = raw.trim().to_lowercase();
    let compact: String = raw.chars().filter(|c| c.is_alphanumeric()).collect();
    match compact.as_str() {
        "развернуть"
        | "навесьмаксимум"
        | "навесьэкран"
        | "развернутьокно"
        | "навсеэкран"
        | "навеськрана"
        | "maximize"
        | "zoom"
        | "expand" => "maximize",
        "наполныйэкран"
        | "полныйэкран"
        | "полноэкранный"
        | "фуллскрин"
        | "fullscreen"
        | "fullscreenокно"
        | "наполныйэкранрежим" => "fullscreen",
        "свернуть"
        | "свернутьокно"
        | "минимизировать"
        | "минимизироватьокно"
        | "minimize"
        | "свернутьвдок" => "minimize",
        "восстановить"
        | "вернутьразмер"
        | "развернутьобратно"
        | "восстановитьокно"
        | "restore"
        | "unmaximize"
        | "нормальныйразмер" => "restore",
        "закрыть" | "закрытьокно" | "закрытьприложение" | "close" | "quit" => {
            "close"
        }
        "список"
        | "показать"
        | "показатьокна"
        | "какиеокна"
        | "списококон"
        | "list"
        | "listwindows"
        | "windows" => "list",
        "наперед" | "напереднийплан" | "вперед" | "focus" | "активировать" => {
            "focus"
        }
        _ => return raw,
    }
    .to_string()
}

/// Убирает tool-блок из текста, чтобы не озвучивать сырой JSON.
fn strip_tool_block(text: &str) -> String {
    let mut out = String::with_capacity(text.len());
    let mut rest = text;
    while let Some(s) = rest.find("<tool>") {
        out.push_str(&rest[..s]);
        let after = &rest[s + "<tool>".len()..];
        match after.find("</tool>") {
            Some(e) => rest = &after[e + "</tool>".len()..],
            None => {
                rest = "";
                break;
            }
        }
    }
    out.push_str(rest);
    out.replace("<tool>", " ")
        .replace("</tool>", " ")
        .split_whitespace()
        .collect::<Vec<_>>()
        .join(" ")
}

/// Что сказать вслух, когда tool-блок не разобрался. Сырой JSON пользователю
/// не озвучиваем: либо произносим оставшийся текст, либо короткое объяснение.
pub fn failure_speech(text: &str, reason: &str) -> String {
    let leftover = strip_tool_block(text);
    if leftover.chars().count() >= 3 {
        return leftover;
    }
    let short: String = reason.chars().take(120).collect();
    format!("Не смог разобрать команду: {short}")
}

/// Результат инструмента с честным статусом. `speech` — фраза для
/// пользователя, `detail` — данные для модели (вывод команды, список файлов).
/// Никаких «Открываю X» без факта выполнения: не получилось — `ok: false`.
pub struct ToolOutcome {
    pub ok: bool,
    pub speech: String,
    pub detail: String,
}

impl ToolOutcome {
    pub fn ok(speech: impl Into<String>) -> Self {
        let speech = speech.into();
        Self {
            ok: true,
            speech: speech.clone(),
            detail: speech,
        }
    }

    pub fn with_detail(speech: impl Into<String>, detail: impl Into<String>) -> Self {
        Self {
            ok: true,
            speech: speech.into(),
            detail: detail.into(),
        }
    }

    pub fn fail(speech: impl Into<String>) -> Self {
        let speech = speech.into();
        Self {
            ok: false,
            speech: speech.clone(),
            detail: speech,
        }
    }

    pub fn fail_with_detail(speech: impl Into<String>, detail: impl Into<String>) -> Self {
        Self {
            ok: false,
            speech: speech.into(),
            detail: detail.into(),
        }
    }
}

/// Короткое имя инструмента для события ActionStarted.
fn tool_name(call: &ToolCall) -> &'static str {
    match call {
        ToolCall::Shell { .. } => "shell",
        ToolCall::OpenApp { .. } => "open_app",
        ToolCall::OpenUrl { .. } => "open_url",
        ToolCall::OpenPath { .. } => "open_path",
        ToolCall::WebSearch { .. } => "web_search",
        ToolCall::TimerStop => "timer_stop",
        ToolCall::SetTimer { .. } => "set_timer",
        ToolCall::SetAlarm { .. } => "set_alarm",
        ToolCall::SetVolume { .. } => "set_volume",
        ToolCall::SetBrightness { .. } => "set_brightness",
        ToolCall::Screenshot => "screenshot",
        ToolCall::LockScreen => "lock_screen",
        ToolCall::Sleep => "sleep",
        ToolCall::Notify { .. } => "notify",
        ToolCall::ClipboardRead => "clipboard_read",
        ToolCall::ClipboardWrite { .. } => "clipboard_write",
        ToolCall::AppleScript { .. } => "applescript",
        ToolCall::SystemInfo => "system_info",
        ToolCall::Window { .. } => "window",
        ToolCall::FileRead { .. } => "file_read",
        ToolCall::FileWrite { .. } => "file_write",
        ToolCall::FileAppend { .. } => "file_append",
        ToolCall::FileEdit { .. } => "file_edit",
        ToolCall::FileList { .. } => "file_list",
        ToolCall::FileSearch { .. } => "file_search",
        ToolCall::FileGlob { .. } => "file_glob",
        ToolCall::TaskAdd { .. } => "task_add",
        ToolCall::TaskList => "task_list",
        ToolCall::TaskDone { .. } => "task_done",
        ToolCall::TaskRemove { .. } => "task_remove",
        ToolCall::TaskRun { .. } => "task_run",
        ToolCall::TaskOpen => "task_open",
        ToolCall::RunCommand { .. } => "run_command",
        ToolCall::SendMessage { .. } => "send_message",
        ToolCall::AddNote { .. } => "add_note",
        ToolCall::CreateEvent { .. } => "create_event",
        ToolCall::MusicControl { .. } => "music_control",
    }
}

/// Человекочитаемая сводка вызова для события ActionStarted.
fn tool_summary(call: &ToolCall) -> String {
    match call {
        ToolCall::Shell { cmd } => cmd.chars().take(120).collect(),
        ToolCall::OpenApp { name } => name.clone(),
        ToolCall::OpenUrl { url } => url.chars().take(120).collect(),
        ToolCall::OpenPath { path } => path.clone(),
        ToolCall::WebSearch { query } => query.chars().take(120).collect(),
        ToolCall::TimerStop => "остановить таймер".to_string(),
        ToolCall::SetTimer { seconds, label } => match label {
            Some(l) => format!("{seconds} с — {l}"),
            None => format!("{seconds} с"),
        },
        ToolCall::SetAlarm {
            seconds_from_now,
            label,
        } => match label {
            Some(l) => format!("через {seconds_from_now} с — {l}"),
            None => format!("через {seconds_from_now} с"),
        },
        ToolCall::SetVolume { percent } => format!("{percent}%"),
        ToolCall::SetBrightness { percent } => format!("{percent}%"),
        ToolCall::Screenshot | ToolCall::LockScreen | ToolCall::Sleep | ToolCall::SystemInfo => {
            String::new()
        }
        ToolCall::Notify { title, body } => format!("{title}: {body}"),
        ToolCall::ClipboardRead => String::new(),
        ToolCall::ClipboardWrite { text } => text.chars().take(120).collect(),
        ToolCall::AppleScript { script } => script.chars().take(120).collect(),
        ToolCall::Window { action, app } => app
            .as_deref()
            .map(|a| format!("{action} {a}"))
            .unwrap_or_else(|| action.clone()),
        ToolCall::FileRead { path, .. }
        | ToolCall::FileWrite { path, .. }
        | ToolCall::FileAppend { path, .. }
        | ToolCall::FileEdit { path, .. }
        | ToolCall::FileList { path } => path.clone(),
        ToolCall::FileSearch { query, path, .. } => match path {
            Some(p) => format!("{query} в {p}"),
            None => query.chars().take(120).collect(),
        },
        ToolCall::FileGlob { pattern, path } => match path {
            Some(p) => format!("{pattern} в {p}"),
            None => pattern.clone(),
        },
        ToolCall::TaskAdd { text } => text.chars().take(120).collect(),
        ToolCall::TaskList | ToolCall::TaskOpen => String::new(),
        ToolCall::TaskDone { id } | ToolCall::TaskRemove { id } => id.to_string(),
        ToolCall::TaskRun { id } => id
            .map(|n| format!("задача {n}"))
            .unwrap_or_else(|| "следующая".into()),
        ToolCall::RunCommand { name, args } => {
            if args.is_empty() {
                name.clone()
            } else {
                let mut keys: Vec<&String> = args.keys().collect();
                keys.sort();
                let list: Vec<String> = keys
                    .iter()
                    .filter_map(|k| args.get(*k).map(|v| format!("{k}={v}")))
                    .collect();
                format!("{name} ({})", list.join(", "))
            }
        }
        ToolCall::SendMessage { to, text } => {
            format!("{}: {}", to, text.chars().take(80).collect::<String>())
        }
        ToolCall::AddNote { title, body } => {
            format!("{title}: {}", body.chars().take(80).collect::<String>())
        }
        ToolCall::CreateEvent { title, date, time } => {
            if date.is_empty() && time.is_empty() {
                title.clone()
            } else if time.is_empty() {
                format!("{title} — {date}")
            } else {
                format!("{title} — {date} {time}")
            }
        }
        ToolCall::MusicControl { action } => action.clone(),
    }
}

fn short_err(s: &str, limit: usize) -> String {
    let one_line = s.trim().replace('\n', " ");
    one_line.chars().take(limit).collect()
}

impl ToolCall {
    /// Выполнить инструмент — обёртка над [`execute`] для вызова из
    /// других модулей (например, run_command переиспользует url/app/shell).
    pub fn execute(self, audio_tx: &Sender<AudioMessage>, events: &EventTx) -> ToolOutcome {
        execute(self, audio_tx, events)
    }
}

pub fn execute(call: ToolCall, audio_tx: &Sender<AudioMessage>, events: &EventTx) -> ToolOutcome {
    let log = |msg: String| {
        let _ = events.send(JarvisEvent::Log { message: msg });
    };

    let _ = events.send(JarvisEvent::ActionStarted {
        tool: tool_name(&call).into(),
        summary: tool_summary(&call),
    });

    let outcome = match call {
        ToolCall::Shell { cmd } => {
            println!("🔧 shell: {cmd}");
            log(format!("🔧 shell: {cmd}"));
            match run_shell(&cmd) {
                Ok(out) => {
                    // `cd` внутри команды меняет рабочую директорию для
                    // следующих шагов: иначе цепочка «зайди в проект и собери»
                    // не собирается — оболочка живёт только один вызов.
                    if let Some(dir) = parse_cd_target(&cmd)
                        && std::path::Path::new(&dir).is_dir()
                    {
                        let now = set_cwd(&dir);
                        println!("   рабочая директория: {now}");
                    }
                    let trimmed = out.trim();
                    if trimmed.is_empty() {
                        ToolOutcome::with_detail("Готово", "команда выполнена, вывода нет")
                    } else {
                        let detail: String = trimmed.chars().take(800).collect();
                        ToolOutcome::with_detail("Готово", detail)
                    }
                }
                Err(e) => {
                    ToolOutcome::fail_with_detail(format!("Не удалось: {}", short_err(&e, 160)), e)
                }
            }
        }

        ToolCall::OpenApp { name } => {
            println!("🔧 open_app: {name}");
            log(format!("🔧 open_app: {name}"));
            open_app_impl(&name)
        }

        ToolCall::OpenUrl { url } => {
            println!("🔧 open_url: {url}");
            log(format!("🔧 open_url: {url}"));
            // В браузер пускаем только http(s) с настоящим доменом: модель
            // иногда выдаёт мусор без схемы или localhost.
            let sanitized = sanitize_open_url(&url);
            if sanitized.is_empty() {
                ToolOutcome::fail(format!("Не похоже на адрес сайта: {url}"))
            } else {
                match open::that(&sanitized) {
                    Ok(_) => ToolOutcome::ok("Открываю"),
                    Err(e) => ToolOutcome::fail(format!("Не удалось открыть {sanitized}: {e}")),
                }
            }
        }

        ToolCall::OpenPath { path } => {
            println!("🔧 open_path: {path}");
            log(format!("🔧 open_path: {path}"));
            let p = resolve_path(&path);
            if !Path::new(&p).exists() {
                ToolOutcome::fail(format!("Путь не найден: {p}"))
            } else {
                match open::that(&p) {
                    Ok(_) => ToolOutcome::ok("Открываю папку"),
                    Err(e) => ToolOutcome::fail(format!("Не удалось открыть {p}: {e}")),
                }
            }
        }

        ToolCall::WebSearch { query } => {
            println!("🔎 web_search: {query}");
            log(format!("🔎 web_search: {query}"));
            match crate::web::search(&query, 5) {
                Ok(hits) if hits.is_empty() => ToolOutcome::fail("Ничего не нашлось в интернете"),
                Ok(hits) => {
                    // Тот же формат, что в обычном веб-флоу (build_summary_prompt):
                    // заголовки + сниппеты. Голые домены и заголовки модель
                    // превращает в выдумку по названию.
                    let count = hits.len();
                    let detail = crate::web::build_summary_prompt(&query, &hits)
                        .unwrap_or_else(|| "Поиск вернул пустой результат.".to_string());
                    ToolOutcome::with_detail(format!("Нашёл {count} результатов"), detail)
                }
                Err(e) => ToolOutcome::fail(format!("Поиск не удался: {e}")),
            }
        }

        ToolCall::SetTimer { seconds, label } => {
            println!("🔧 set_timer: {seconds}s");
            log(format!("🔧 set_timer: {seconds}s"));
            let human = humanize_seconds(seconds);
            let label_text = label.as_deref().unwrap_or("").to_string();
            let with_label = |base: String| {
                if label_text.is_empty() {
                    base
                } else {
                    format!("{base} — {label_text}")
                }
            };
            // Встроенный таймер: окно «Утилиты» тикает, по завершении Джарвис
            // говорит и шлёт уведомление. Полный контроль у ассистента.
            crate::timers::start(events, audio_tx, &label_text, seconds);
            ToolOutcome::ok(with_label(format!("Поставил таймер на {human}")))
        }

        ToolCall::TimerStop => {
            println!("🔧 timer_stop");
            log("🔧 timer_stop".to_string());
            match crate::timers::cancel(events, None) {
                Some(timer) => {
                    let left = humanize_seconds(timer.remaining_secs);
                    ToolOutcome::ok(format!(
                        "Остановил таймер «{}» (осталось было {left})",
                        timer.label
                    ))
                }
                None => ToolOutcome::fail("Активных таймеров нет"),
            }
        }

        ToolCall::SetAlarm {
            seconds_from_now,
            label,
        } => {
            println!("🔧 set_alarm: {seconds_from_now}s");
            log(format!("🔧 set_alarm: {seconds_from_now}s"));
            let human = humanize_seconds(seconds_from_now);
            let label_text = label.as_deref().unwrap_or("").to_string();
            let with_label = |base: String| {
                if label_text.is_empty() {
                    base
                } else {
                    format!("{base} — {label_text}")
                }
            };
            // Будильник = тот же встроенный таймер (окно + голос + уведомление).
            crate::timers::start(events, audio_tx, &label_text, seconds_from_now);
            ToolOutcome::ok(with_label(format!("Поставил будильник через {human}")))
        }

        ToolCall::SetVolume { percent } => {
            println!("🔧 set_volume: {percent}");
            log(format!("🔧 set_volume: {percent}"));
            if set_volume_impl(percent) {
                ToolOutcome::ok(format!("Громкость {percent} процентов"))
            } else {
                ToolOutcome::fail("Не удалось изменить громкость")
            }
        }

        ToolCall::SetBrightness { percent } => {
            println!("🔧 set_brightness: {percent}");
            log(format!("🔧 set_brightness: {percent}"));
            if set_brightness_impl(percent) {
                ToolOutcome::ok(format!("Яркость {percent} процентов"))
            } else {
                ToolOutcome::fail("Не удалось изменить яркость")
            }
        }

        ToolCall::Screenshot => {
            println!("🔧 screenshot");
            log("🔧 screenshot".into());
            match screenshot_impl() {
                Some(p) => ToolOutcome::with_detail(format!("Скриншот сохранён в {p}"), p),
                None => ToolOutcome::fail("Не удалось сделать скриншот"),
            }
        }

        ToolCall::LockScreen => {
            println!("🔧 lock_screen");
            log("🔧 lock_screen".into());
            if lock_screen_impl() {
                ToolOutcome::ok("Экран заблокирован")
            } else {
                ToolOutcome::fail("Не удалось заблокировать экран")
            }
        }

        ToolCall::Sleep => {
            println!("🔧 sleep");
            log("🔧 sleep".into());
            if sleep_impl() {
                ToolOutcome::ok("Усыпаю")
            } else {
                ToolOutcome::fail("Не удалось усыпить компьютер")
            }
        }

        ToolCall::Notify { title, body } => {
            println!("🔧 notify: {title}");
            log(format!("🔧 notify: {title}"));
            if notify_impl(&title, &body) {
                ToolOutcome::ok(format!("{title}: {body}"))
            } else {
                ToolOutcome::fail("Не удалось показать уведомление")
            }
        }

        ToolCall::ClipboardRead => {
            println!("🔧 clipboard_read");
            log("🔧 clipboard_read".into());
            match clipboard_read_impl() {
                Some(text) => {
                    let short: String = text.trim().chars().take(300).collect();
                    if short.is_empty() {
                        ToolOutcome::ok("Буфер пуст")
                    } else {
                        ToolOutcome::with_detail("Читаю буфер обмена", short)
                    }
                }
                None => ToolOutcome::fail("Не удалось прочитать буфер обмена"),
            }
        }

        ToolCall::ClipboardWrite { text } => {
            println!("🔧 clipboard_write");
            log("🔧 clipboard_write".to_string());
            if clipboard_write_impl(&text) {
                ToolOutcome::ok("Скопировано")
            } else {
                ToolOutcome::fail("Не удалось записать в буфер обмена")
            }
        }

        ToolCall::AppleScript { script } => {
            println!("🔧 applescript");
            log(format!(
                "🔧 applescript: {}",
                &script[..script.len().min(80)]
            ));

            #[cfg(target_os = "macos")]
            {
                match Command::new("osascript").args(["-e", &script]).output() {
                    Ok(out) if out.status.success() => {
                        let stdout = String::from_utf8_lossy(&out.stdout).trim().to_string();
                        if stdout.is_empty() {
                            ToolOutcome::ok("Готово")
                        } else {
                            let short: String = stdout.chars().take(300).collect();
                            ToolOutcome::with_detail("Готово", short)
                        }
                    }
                    Ok(out) => {
                        let err = String::from_utf8_lossy(&out.stderr).trim().to_string();
                        ToolOutcome::fail(format!(
                            "AppleScript не выполнился: {}",
                            short_err(&err, 160)
                        ))
                    }
                    Err(e) => ToolOutcome::fail(format!("Ошибка: {e}")),
                }
            }
        }

        ToolCall::SystemInfo => {
            println!("🔧 system_info");
            log("🔧 system_info".into());
            ToolOutcome::ok(system_info_impl())
        }

        ToolCall::Window { action, app } => {
            println!(
                "🔧 window: {action} {}",
                app.as_deref().unwrap_or("(активное)")
            );
            log(format!(
                "🔧 window: {action} {}",
                app.as_deref().unwrap_or("(активное)")
            ));
            let text = window_impl(&action, app.as_deref());
            // window_impl сигнализирует неудачу строкой — превращаем в статус.
            let lower = text.to_lowercase();
            let failed = [
                "не удалось",
                "не нашла",
                "не нашёл",
                "не найден",
                "ошибка",
                "не могу",
                "нет окон",
            ]
            .iter()
            .any(|p| lower.contains(p));
            if failed {
                ToolOutcome::fail(text)
            } else {
                ToolOutcome::ok(text)
            }
        }

        ToolCall::FileRead {
            path,
            offset,
            limit,
        } => {
            let p = resolve_path(&path);
            println!("🔧 file_read: {p}");
            log(format!("🔧 file_read: {p}"));
            match std::fs::read_to_string(&p) {
                Ok(content) => ToolOutcome::with_detail(
                    format!("Прочитал {p}"),
                    read_lines(&content, offset, limit),
                ),
                Err(e) => ToolOutcome::fail(format!("Не могу прочитать {p}: {e}")),
            }
        }

        ToolCall::FileWrite { path, content } => {
            let p = resolve_path(&path);
            println!("🔧 file_write: {p}");
            log(format!("🔧 file_write: {p}"));
            if let Some(parent) = Path::new(&p).parent() {
                let _ = std::fs::create_dir_all(parent);
            }
            let existed = Path::new(&p).exists();
            match std::fs::write(&p, content) {
                Ok(_) => ToolOutcome::ok(if existed {
                    format!("Перезаписал {p}")
                } else {
                    format!("Записал {p}")
                }),
                Err(e) => ToolOutcome::fail(format!("Ошибка записи {p}: {e}")),
            }
        }

        ToolCall::FileAppend { path, content } => {
            let p = resolve_path(&path);
            println!("🔧 file_append: {p}");
            log(format!("🔧 file_append: {p}"));
            if let Some(parent) = Path::new(&p).parent() {
                let _ = std::fs::create_dir_all(parent);
            }
            match append_to_file(&p, &content) {
                Ok(()) => ToolOutcome::ok(format!("Дописал в {p}")),
                Err(e) => ToolOutcome::fail(format!("Ошибка записи {p}: {e}")),
            }
        }

        ToolCall::FileEdit {
            path,
            old,
            new,
            all,
        } => {
            let p = resolve_path(&path);
            println!("🔧 file_edit: {p}");
            log(format!("🔧 file_edit: {p}"));
            match std::fs::read_to_string(&p) {
                Ok(content) => match apply_edit(&content, &old, &new, all) {
                    Ok((updated, count)) => match std::fs::write(&p, updated) {
                        Ok(_) => ToolOutcome::ok(format!("Изменил {p}: замен {count}")),
                        Err(e) => ToolOutcome::fail(format!("Ошибка записи {p}: {e}")),
                    },
                    Err(reason) => ToolOutcome::fail(reason),
                },
                Err(e) => ToolOutcome::fail(format!("Не могу прочитать {p}: {e}")),
            }
        }

        ToolCall::FileList { path } => {
            let p = resolve_path(&path);
            println!("🔧 file_list: {p}");
            log(format!("🔧 file_list: {p}"));
            match list_dir(&p) {
                Ok(list) => ToolOutcome::with_detail(format!("Содержимое {p}"), list),
                Err(e) => ToolOutcome::fail(format!("Ошибка: {e}")),
            }
        }

        ToolCall::FileSearch {
            query,
            path,
            context,
        } => {
            let root = resolve_path(path.as_deref().unwrap_or("."));
            println!("🔧 file_search: {query} в {root}");
            log(format!("🔧 file_search: {query} в {root}"));
            match search_in_path(&root, &query, context.unwrap_or(0)) {
                Ok(report) => {
                    if report.trim().is_empty() {
                        ToolOutcome::fail(format!("«{query}» не найдено в {root}"))
                    } else {
                        ToolOutcome::with_detail(format!("Нашёл «{query}» в {root}"), report)
                    }
                }
                Err(e) => ToolOutcome::fail(format!("Поиск не удался: {e}")),
            }
        }

        ToolCall::FileGlob { pattern, path } => {
            let root = resolve_path(path.as_deref().unwrap_or("."));
            println!("🔧 file_glob: {pattern} в {root}");
            log(format!("🔧 file_glob: {pattern} в {root}"));
            match glob_in_path(&root, &pattern) {
                Ok(report) => {
                    if report.trim().is_empty() {
                        ToolOutcome::fail(format!("По маске «{pattern}» ничего нет в {root}"))
                    } else {
                        ToolOutcome::with_detail(
                            format!("Нашёл по маске «{pattern}» в {root}"),
                            report,
                        )
                    }
                }
                Err(e) => ToolOutcome::fail(format!("Поиск не удался: {e}")),
            }
        }

        ToolCall::TaskAdd { text } => {
            println!("📝 task_add: {text}");
            log(format!("📝 task_add: {text}"));
            match crate::tasks::add(&text) {
                Ok(t) => ToolOutcome::ok(format!("Записал в задачник задачу {}: {}", t.id, t.text)),
                Err(e) => ToolOutcome::fail(format!("Не смог записать задачу: {e}")),
            }
        }

        ToolCall::TaskList => {
            println!("🗒 task_list");
            log("🗒 task_list".into());
            ToolOutcome::ok(crate::tasks::speak_list(5))
        }

        ToolCall::TaskDone { id } => {
            println!("✅ task_done: {id}");
            log(format!("✅ task_done: {id}"));
            match crate::tasks::set_done(id, true) {
                Some(t) => ToolOutcome::ok(format!("Закрыл задачу {}: {}", t.id, t.text)),
                None => ToolOutcome::fail(format!("Задачи {} нет", id)),
            }
        }

        ToolCall::TaskRemove { id } => {
            println!("🗑 task_remove: {id}");
            log(format!("🗑 task_remove: {id}"));
            match crate::tasks::remove(id) {
                Some(t) => ToolOutcome::ok(format!("Удалил задачу {}: {}", t.id, t.text)),
                None => ToolOutcome::fail(format!("Задачи {} нет", id)),
            }
        }

        // Реальную работу делает цикл агента в llm::run_action: он переспрашивает
        // модель с текстом задачи. Здесь только подтверждение для лога.
        ToolCall::TaskRun { id } => {
            let label = id
                .map(|n| format!("задача {n}"))
                .unwrap_or_else(|| "следующая задача".to_string());
            println!("▶️ task_run: {label}");
            log(format!("▶️ task_run: {label}"));
            ToolOutcome::ok(format!("Беру {label}"))
        }

        ToolCall::TaskOpen => {
            let path = crate::tasks::path();
            let p = path.to_string_lossy().to_string();
            println!("🗒 task_open: {p}");
            log(format!("🗒 task_open: {p}"));
            match open::that(&p) {
                Ok(_) => ToolOutcome::ok(format!("Открыл задачник: {p}")),
                Err(e) => ToolOutcome::fail(format!("Не удалось открыть задачник: {e}")),
            }
        }

        ToolCall::RunCommand { name, args } => {
            println!("🔧 run_command: {name}");
            log(format!("🔧 run_command: {name}"));
            crate::commands::run_command_tool(&name, &args, audio_tx, events)
        }

        ToolCall::SendMessage { to, text } => {
            println!("💬 send_message: {to}");
            log(format!("💬 send_message: {to}"));
            send_message_impl(&to, &text)
        }

        ToolCall::AddNote { title, body } => {
            println!("📝 add_note: {title}");
            log(format!("📝 add_note: {title}"));
            add_note_impl(&title, &body)
        }

        ToolCall::CreateEvent { title, date, time } => {
            println!("📅 create_event: {title} {date} {time}");
            log(format!("📅 create_event: {title} {date} {time}"));
            create_event_impl(&title, &date, &time)
        }

        ToolCall::MusicControl { action } => {
            println!("🎵 music_control: {action}");
            log(format!("🎵 music_control: {action}"));
            music_control_impl(&action)
        }
    };

    let _ = events.send(JarvisEvent::ActionResult {
        ok: outcome.ok,
        summary: outcome.speech.clone(),
    });
    outcome
}

// =========================================================================
// Нативные приложения macOS: Сообщения, Заметки, Календарь, Музыка
// =========================================================================

/// Экранирование строки для AppleScript-литерала.
#[cfg(target_os = "macos")]
fn applescript_escape(s: &str) -> String {
    s.replace('\\', "\\\\").replace('"', "\\\"")
}

/// Отправить сообщение через «Сообщения» (iMessage). Адресат — имя контакта,
/// email или телефон Apple ID. Отказы честные: нет аккаунта iMessage, нет
/// доступа к контакту, нет разрешения на автоматизацию.
#[cfg(target_os = "macos")]
fn send_message_impl(to: &str, text: &str) -> ToolOutcome {
    let (to_e, text_e) = (applescript_escape(to), applescript_escape(text));
    let script = format!(
        r#"tell application "Messages"
set svc to 1st service whose service type = iMessage
set p to participant "{to_e}" of svc
send "{text_e}" to p
end tell"#
    );
    match osascript(&script) {
        Ok(_) => ToolOutcome::ok(format!("Отправил сообщение {to}")),
        Err(e) => {
            let lower = e.to_lowercase();
            if lower.contains("can't get") || lower.contains("participant") {
                ToolOutcome::fail(format!(
                    "Не нашёл «{to}» в Сообщениях: нужен email/телефон Apple ID или точное имя контакта"
                ))
            } else {
                ToolOutcome::fail(format!(
                    "Не удалось отправить: {}",
                    friendly_access_error(&e)
                ))
            }
        }
    }
}

/// Новая заметка в «Заметках».
#[cfg(target_os = "macos")]
fn add_note_impl(title: &str, body: &str) -> ToolOutcome {
    let script = format!(
        r#"tell application "Notes" to make new note with properties {{name:"{}", body:"{}"}}"#,
        applescript_escape(title),
        applescript_escape(body),
    );
    match osascript(&script) {
        Ok(_) => ToolOutcome::ok(format!("Записал заметку «{title}»")),
        Err(e) => ToolOutcome::fail(format!(
            "Не удалось создать заметку: {}",
            friendly_access_error(&e)
        )),
    }
}

/// «ГГГГ-ММ-ДД» от модели → (год, месяц, день). Пусто или мусор — None.
#[cfg(target_os = "macos")]
fn parse_iso_date(date: &str) -> Option<(i64, u32, u32)> {
    let parts: Vec<&str> = date.trim().split('-').collect();
    if parts.len() != 3 {
        return None;
    }
    let year = parts[0].trim().parse::<i64>().ok()?;
    let month = parts[1].trim().parse::<u32>().ok()?;
    let day = parts[2].trim().parse::<u32>().ok()?;
    if !(1..=12).contains(&month) || !(1..=31).contains(&day) || !(1970..=3000).contains(&year) {
        return None;
    }
    Some((year, month, day))
}

/// «ЧЧ:ММ» от модели → (часы, минуты). Пусто или мусор — None.
#[cfg(target_os = "macos")]
fn parse_iso_time(time: &str) -> Option<(u32, u32)> {
    let parts: Vec<&str> = time.trim().split(':').collect();
    if parts.len() != 2 {
        return None;
    }
    let h = parts[0].trim().parse::<u32>().ok()?;
    let m = parts[1].trim().parse::<u32>().ok()?;
    if h > 23 || m > 59 {
        return None;
    }
    Some((h, m))
}

/// Событие в «Календаре»: сегодня/указанная дата, указанное время или
/// ближайший круглый час, длительность час. Дата не проверяется на
/// существование (31 февраля) — Calendar сам нормализует.
#[cfg(target_os = "macos")]
fn create_event_impl(title: &str, date: &str, time: &str) -> ToolOutcome {
    // Дата: из модели или сегодня. «Сегодня» достаём из AppleScript, чтобы
    // не тянуть в рантайм работу с часовыми поясами.
    let date_setup = match parse_iso_date(date) {
        Some((y, m, d)) => {
            // День ставим первым: иначе 31-е число «перекатывает» месяц.
            format!(
                "set day of sd to 1\nset year of sd to {y}\nset month of sd to {m}\nset day of sd to {d}\n"
            )
        }
        None => String::new(),
    };
    let time_setup = match parse_iso_time(time) {
        Some((h, min)) => format!("set hours of sd to {h}\nset minutes of sd to {min}\n"),
        None => String::new(), // останется текущее время — сдвигаем на час ниже
    };
    let script = format!(
        r#"tell application "Calendar"
set sd to current date
{date_setup}{time_setup}set seconds of sd to 0
if {time_given} then
-- время задано явно, ничего не двигаем
else
set sd to sd + 3600 - (minutes of sd) * 60
end if
set ed to sd + 3600
tell calendar 1 to make new event with properties {{summary:"{title_e}", start date:sd, end date:ed}}
end tell"#,
        time_given = parse_iso_time(time).is_some(),
        title_e = applescript_escape(title),
    );
    match osascript(&script) {
        Ok(_) => ToolOutcome::ok(format!("Создал событие «{title}» в Календаре")),
        Err(e) => ToolOutcome::fail(format!(
            "Не удалось создать событие: {}",
            friendly_access_error(&e)
        )),
    }
}

/// Действие над плеером «Музыка». play запускает приложение, остальные
/// действия требуют запущенного плеера — иначе честная неудача.
#[cfg(target_os = "macos")]
/// Какое приложение реально играет музыку: нативная «Музыка» или браузер.
///
/// Раньше управление шло только в «Музыку», и это давало молчаливую ложь:
/// `tell application "Music" to pause` завершается успешно, даже когда трек
/// не играет, поэтому Джарвис бодро отвечал «Поставил на паузу», а в браузере
/// (Яндекс Музыка, YouTube) музыка продолжала играть.
#[derive(Clone, Copy, PartialEq, Debug)]
enum MusicTarget {
    MusicApp,
    /// Браузер, в котором нашлось играющее медиа.
    BrowserTab(Browser),
}

#[derive(Clone, Copy, PartialEq, Debug)]
enum Browser {
    Chrome,
    Safari,
    Edge,
    Brave,
    Arc,
    Yandex,
    Firefox,
}

impl Browser {
    /// Имя процесса для pgrep.
    fn process(self) -> &'static str {
        match self {
            Browser::Chrome => "Google Chrome",
            Browser::Safari => "Safari",
            Browser::Edge => "Microsoft Edge",
            Browser::Brave => "Brave Browser",
            Browser::Arc => "Arc",
            Browser::Yandex => "Yandex",
            Browser::Firefox => "firefox",
        }
    }

    fn title(self) -> &'static str {
        match self {
            Browser::Chrome => "Chrome",
            Browser::Safari => "Safari",
            Browser::Edge => "Edge",
            Browser::Brave => "Brave",
            Browser::Arc => "Arc",
            Browser::Yandex => "Яндекс Браузер",
            Browser::Firefox => "Firefox",
        }
    }

    /// AppleScript, который отдаёт число играющих элементов медиа на активной
    /// вкладке. `execute ... javascript` поддерживают только WebKit/Chromium;
    /// Firefox так управлять нельзя, поэтому он только для честного отказа.
    fn script(self, js: &str) -> String {
        let js = js.replace('\\', "\\\\").replace('"', "\\\"");
        match self {
            Browser::Chrome => format!(
                r#"tell application "Google Chrome" to execute front window's active tab javascript "{js}""#
            ),
            Browser::Edge => format!(
                r#"tell application "Microsoft Edge" to execute front window's active tab javascript "{js}""#
            ),
            Browser::Brave => format!(
                r#"tell application "Brave Browser" to execute front window's active tab javascript "{js}""#
            ),
            Browser::Arc => format!(
                r#"tell application "Arc" to execute front window's active tab javascript "{js}""#
            ),
            Browser::Yandex => format!(
                r#"tell application "Yandex" to execute front window's active tab javascript "{js}""#
            ),
            // Safari отвечает объектом, а osascript ждёт текст — приводим к строке.
            Browser::Safari => format!(
                r#"tell application "Safari" to do JavaScript "{js}" in front document as text"#
            ),
            Browser::Firefox => String::new(),
        }
    }
}

/// Сколько элементов медиа сейчас играют в указанном браузере.
fn media_playing_count(browser: Browser) -> Option<usize> {
    if browser == Browser::Firefox || !is_app_running(browser.process()) {
        return None;
    }
    let out = osascript(&browser.script(
        "(function(){var m=document.querySelectorAll('video,audio');var n=0;\
         for(var i=0;i<m.length;i++){if(!m[i].paused&&!m[i].ended)n++}return n})()",
    ))
    .ok()?;
    out.trim().parse().ok()
}

/// Управляет медиа в браузере. `Some(Ok(count))` — сработало, вернулось число
/// переключённых элементов. `Some(Err)` — браузер нашёлся, но управление не
/// разрешено (нужна автоматизация или JavaScript из AppleScript).
fn control_browser_media(browser: Browser, verb: &str) -> Option<Result<usize, String>> {
    if browser == Browser::Firefox || !is_app_running(browser.process()) {
        return None;
    }
    let js = match verb {
        "pause" => {
            "(function(){var m=document.querySelectorAll('video,audio');var n=0;\
                  for(var i=0;i<m.length;i++){if(!m[i].paused&&!m[i].ended){m[i].pause();n++}}return n})()"
        }
        "stop" => {
            "(function(){var m=document.querySelectorAll('video,audio');var n=0;\
                  for(var i=0;i<m.length;i++){m[i].pause();try{m[i].currentTime=0}catch(e){}n++}return n})()"
        }
        _ => {
            "(function(){var m=document.querySelectorAll('video,audio');var n=0;\
              for(var i=0;i<m.length;i++){m[i].play();n++}return n})()"
        }
    };
    match osascript(&browser.script(js)) {
        Ok(out) => Some(
            out.trim()
                .parse()
                .map_err(|_| format!("ответ браузера: {out}")),
        ),
        Err(e) => Some(Err(friendly_access_error(&e))),
    }
}

/// Отказ в автоматизации: одинаков для любого приложения, поэтому винить
/// конкретный браузер в нём нельзя — иначе пользователь пойдёт искать музыку
/// не там, где она играет.
fn is_permission_error(err: &str) -> bool {
    let lower = err.to_lowercase();
    lower.contains("privilege violation")
        || lower.contains("-10004")
        || lower.contains("not authorized")
        || lower.contains("-1743")
}

/// Что играет прямо сейчас: играющая вкладка браузера или нативная «Музыка».
///
/// Браузеры проверяем первыми и только у запущенных: Яндекс Музыка и YouTube
/// живут там, а «Музыка» с невыбранным треком — не источник звука. `Err` —
/// источник есть, но прочитать его не вышло: эта причина важнее общей фразы
/// «останавливать нечего».
fn current_music_target() -> Result<Option<MusicTarget>, String> {
    let mut blocked: Option<String> = None;
    for browser in [
        Browser::Chrome,
        Browser::Safari,
        Browser::Edge,
        Browser::Brave,
        Browser::Arc,
        Browser::Yandex,
    ] {
        if !is_app_running(browser.process()) {
            continue;
        }
        match media_playing_count(browser) {
            Some(0) => {}
            Some(_) => return Ok(Some(MusicTarget::BrowserTab(browser))),
            None => {
                // Причину неудачи читаем отдельным запросом: она решает, что
                // именно сказать пользователю.
                let reason = match osascript(&browser.script("1")) {
                    Ok(_) => format!(
                        "не удалось прочитать состояние вкладки в {}",
                        browser.title()
                    ),
                    Err(e) if is_permission_error(&e) => permission_hint(),
                    Err(e) => friendly_access_error(&e),
                };
                if blocked.is_none() {
                    blocked = Some(reason);
                }
            }
        }
    }

    if is_app_running("Music") {
        match osascript(r#"tell application "Music" to get player state as text"#) {
            Ok(state) => {
                let state = state.trim().to_string();
                if matches!(state.as_str(), "playing" | "paused") {
                    return Ok(Some(MusicTarget::MusicApp));
                }
                // Приложение открыто, но трека нет: это не источник, и
                // сообщать о нём как о музыке нельзя.
            }
            Err(e) => {
                let reason = if is_permission_error(&e) {
                    permission_hint()
                } else {
                    friendly_access_error(&e)
                };
                if blocked.is_none() {
                    blocked = Some(reason);
                }
            }
        }
    }

    match blocked {
        Some(reason) => Err(format!(
            "Музыка может играть в браузере или в «Музыке», но управлять не вышло: {reason}"
        )),
        None => Ok(None),
    }
}

/// Общая подсказка про автоматизацию: одна причина — одно объяснение.
fn permission_hint() -> String {
    "macOS не даёт Jarvis управлять другими приложениями. Системные настройки → \
     Конфиденциальность и безопасность → Автоматизация — разреши Jarvis нужные \
     приложения (браузер и «Музыку»)"
        .to_string()
}

fn music_control_impl(action: &str) -> ToolOutcome {
    // «Стоп» — это пауза, но с начала трека: для просьбы «выключи музыку»
    // пауза и остановка означают одно и то же.
    let pause_like = matches!(action, "pause" | "stop");
    let verb = match action {
        "play" => "play",
        "pause" | "stop" => "pause",
        "next" => "next",
        "previous" => "previous",
        other => return ToolOutcome::fail(format!("Не понимаю действие плеера: {other}")),
    };

    // Смотрим состояние ДО действия: иначе получается ложный успех, когда
    // плеер и так стоял, а пользователь ждал, что музыка замолчит.
    let target = match current_music_target() {
        Ok(target) => target,
        // Источник есть, но прочитать его не дали — говорим именно это,
        // а не «останавливать нечего».
        Err(reason) => return ToolOutcome::fail(reason),
    };
    let music_state = if is_app_running("Music") {
        osascript(r#"tell application "Music" to get player state as text"#)
            .ok()
            .map(|s| s.trim().to_string())
    } else {
        None
    };

    match target {
        Some(MusicTarget::MusicApp) => {
            if pause_like && music_state.as_deref() == Some("paused") {
                return ToolOutcome::fail("Музыка уже на паузе");
            }
            if action == "play" && music_state.as_deref() == Some("playing") {
                return ToolOutcome::fail("Музыка уже играет");
            }
            let script = format!(r#"tell application "Music" to {verb}"#);
            match osascript(&script) {
                // Читаем состояние после команды: успешный osascript ещё не
                // значит, что плеер действительно остановился.
                Ok(_) => {
                    let after =
                        osascript(r#"tell application "Music" to get player state as text"#)
                            .ok()
                            .map(|s| s.trim().to_string());
                    let changed = after.as_deref() != music_state.as_deref();
                    if !changed {
                        return ToolOutcome::fail(format!(
                            "Команда ушла в «Музыку», но состояние не изменилось ({})",
                            after.as_deref().unwrap_or("неизвестно")
                        ));
                    }
                    let said = match action {
                        "play" => "Включаю музыку",
                        "pause" => "Поставил на паузу",
                        "stop" => "Остановил музыку",
                        "next" => "Следующий трек",
                        _ => "Предыдущий трек",
                    };
                    ToolOutcome::ok(said)
                }
                Err(e) => ToolOutcome::fail(format!(
                    "Не удалось управлять Музыкой: {}",
                    friendly_access_error(&e)
                )),
            }
        }

        Some(MusicTarget::BrowserTab(browser)) => {
            let name = browser.title();
            match control_browser_media(browser, verb) {
                Some(Ok(n)) if n > 0 => {
                    let said = match action {
                        "play" => format!("Включаю музыку в {name}"),
                        "pause" | "stop" => format!("Поставил на паузу в {name}"),
                        "next" => format!("Переключаю трек в {name}"),
                        _ => format!("Предыдущий трек в {name}"),
                    };
                    ToolOutcome::ok(said)
                }
                Some(Ok(_)) => {
                    ToolOutcome::fail(format!("В {name} ничего не играет — останавливать нечего"))
                }
                Some(Err(e)) => ToolOutcome::fail(format!(
                    "Музыка играет в {name}, но macOS не даёт им управлять: {e}. \
                     Системные настройки → Конфиденциальность → Автоматизация: разреши Jarvis \
                     управлять {name}; в самом браузере — «Вид → Разработка → Разрешить \
                     JavaScript из AppleScript»"
                )),
                None => ToolOutcome::fail(format!(
                    "«Музыка» запущена, но трек в ней не выбран, а управлять {name} не вышло"
                )),
            }
        }

        None => {
            // Ничего не играет. Если приложение открыто — говорим прямо, что
            // останавливать нечего, вместо бодрого «Поставил на паузу».
            let hint = if is_app_running("Music") {
                "В «Музыке» не выбран трек и в браузере ничего не играет"
            } else {
                "Ни «Музыка», ни браузер сейчас ничего не играют"
            };
            ToolOutcome::fail(format!("{hint} — останавливать нечего"))
        }
    }
}

#[cfg(not(target_os = "macos"))]
fn send_message_impl(to: &str, _text: &str) -> ToolOutcome {
    ToolOutcome::fail(format!(
        "Отправка сообщений не поддерживается на этой ОС ({to})"
    ))
}

#[cfg(not(target_os = "macos"))]
fn add_note_impl(title: &str, _body: &str) -> ToolOutcome {
    ToolOutcome::fail(format!("Заметки доступны только на macOS ({title})"))
}

#[cfg(not(target_os = "macos"))]
fn create_event_impl(title: &str, _date: &str, _time: &str) -> ToolOutcome {
    ToolOutcome::fail(format!("Календарь доступен только на macOS ({title})"))
}

#[cfg(not(target_os = "macos"))]
fn music_control_impl(_action: &str) -> ToolOutcome {
    ToolOutcome::fail("Управление Музыкой доступно только на macOS")
}

// =========================================================================
// Shell
// =========================================================================

fn run_shell(cmd: &str) -> Result<String, String> {
    use std::process::Stdio;

    let mut child = Command::new("sh")
        .arg("-c")
        .arg(cmd)
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .spawn()
        .map_err(|e| e.to_string())?;

    // Ждём до 30 сек — защита от вечных команд вроде `ping` или `yes`.
    let deadline = std::time::Instant::now() + Duration::from_secs(30);

    loop {
        match child.try_wait() {
            Ok(Some(status)) => {
                let out = child.wait_with_output().map_err(|e| e.to_string())?;
                let stdout = String::from_utf8_lossy(&out.stdout).to_string();
                let stderr = String::from_utf8_lossy(&out.stderr).to_string();

                if status.success() {
                    return Ok(stdout);
                }
                // Не-нулевой код выхода — это неудача, даже если stderr пуст:
                // раньше такой случай молча выдавали за успех («Готово»).
                let code = status.code().unwrap_or(-1);
                if stderr.is_empty() {
                    if stdout.trim().is_empty() {
                        return Err(format!("команда завершилась с кодом {code}, вывода нет"));
                    }
                    return Err(format!(
                        "команда завершилась с кодом {code}, вывод: {}",
                        stdout.trim().chars().take(200).collect::<String>()
                    ));
                }
                return Err(format!("код {code}: {}", stderr.trim()));
            }
            Ok(None) => {
                if std::time::Instant::now() > deadline {
                    let _ = child.kill();
                    return Err("команда выполнялась дольше 30 сек, прервано".into());
                }
                std::thread::sleep(Duration::from_millis(50));
            }
            Err(e) => return Err(e.to_string()),
        }
    }
}

// =========================================================================
// Сопоставление русских названий приложений с системными
// =========================================================================

/// Частые русские названия → фрагмент настоящего имени приложения/процесса.
/// Пользователь говорит «сверни хром», а процесс называется «Google Chrome».
/// Остальное покрывает транслитерация («телеграм» → «telegram»).
#[cfg(target_os = "macos")]
const APP_ALIASES: &[(&str, &str)] = &[
    ("гуглхром", "Google Chrome"),
    ("хром", "Google Chrome"),
    ("браузер", "Safari"),
    ("сафари", "Safari"),
    ("телеграм", "Telegram"),
    ("телега", "Telegram"),
    ("ватсап", "WhatsApp"),
    ("зум", "Zoom"),
    ("слак", "Slack"),
    ("дискорд", "Discord"),
    ("нотион", "Notion"),
    ("фигма", "Figma"),
    ("спотифай", "Spotify"),
    ("музыка", "Music"),
    ("почта", "Mail"),
    ("мессенджер", "Messages"),
    ("сообщения", "Messages"),
    ("зед", "Zed"),
    ("вскод", "Code"),
    ("код", "Code"),
    ("икскод", "Xcode"),
    ("итерминал", "iTerm"),
    ("эксель", "Excel"),
    ("ворд", "Word"),
    ("пауэрпоинт", "PowerPoint"),
    ("фотошоп", "Photoshop"),
    ("иллюстратор", "Illustrator"),
    ("премьер", "Premiere"),
    ("афтерэффекты", "After Effects"),
    ("дэвинсинк", "DaVinci Resolve"),
    ("калькулятор", "Calculator"),
    ("календарь", "Calendar"),
    ("заметки", "Notes"),
    ("карты", "Maps"),
    ("часы", "Clock"),
    ("напоминания", "Reminders"),
];

/// Совпадает ли имя приложения/процесса с просьбой: компактно и через
/// транслитерацию, чтобы «Zed» ↔ «зед» и «Telegram» ↔ «телеграм» сходились.
#[cfg(target_os = "macos")]
fn process_matches(candidate: &str, want: &str) -> bool {
    let wc = crate::text::compact_name(want);
    let cc = crate::text::compact_name(candidate);
    if wc.is_empty() || cc.is_empty() {
        return false;
    }
    if cc == wc || cc.contains(&wc) {
        return true;
    }
    let ct = crate::text::compact_name(&crate::text::translit_ru(candidate));
    let wt = crate::text::compact_name(&crate::text::translit_ru(want));
    ct == wt || ct.contains(&wt)
}

/// Русское название из просьбы → фрагмент настоящего имени, если он есть
/// в словаре («гугл хром» → «Google Chrome»).
#[cfg(target_os = "macos")]
fn app_alias(want: &str) -> Option<&'static str> {
    let wc = crate::text::compact_name(want);
    if wc.is_empty() {
        return None;
    }
    APP_ALIASES
        .iter()
        .find(|(alias, _)| wc == *alias || wc.starts_with(alias) || wc.ends_with(alias))
        .map(|(_, target)| *target)
}

// =========================================================================
// Открытие приложений
// =========================================================================

/// Запущено ли приложение: pgrep по имени процесса, затем по пути бандла —
/// у части приложений имя процесса не совпадает с названием
/// («Code» vs «Visual Studio Code»).
#[cfg(target_os = "macos")]
fn is_app_running(name: &str) -> bool {
    let exact = Command::new("pgrep")
        .args(["-x", name])
        .output()
        .map(|o| o.status.success())
        .unwrap_or(false);
    if exact {
        return true;
    }
    Command::new("pgrep")
        .args(["-f", &format!("{name}.app")])
        .output()
        .map(|o| o.status.success())
        .unwrap_or(false)
}

/// Настоящее имя приложения по русской/приблизительной просьбе: ищем по
/// каталогам приложений («хром» → «Google Chrome»). Ничего не нашлось —
/// возвращаем как есть: `open -a` честно сообщит, что приложения нет.
#[cfg(target_os = "macos")]
fn resolve_app_name(name: &str) -> String {
    let want = name.trim();
    if want.is_empty() {
        return want.to_string();
    }

    let mut bundles: Vec<String> = Vec::new();
    let mut roots: Vec<std::path::PathBuf> =
        vec!["/Applications".into(), "/System/Applications".into()];
    if let Some(home) = std::env::var_os("HOME") {
        roots.push(std::path::PathBuf::from(home).join("Applications"));
    }
    for root in &roots {
        if let Ok(entries) = std::fs::read_dir(root) {
            for entry in entries.flatten() {
                let file = entry.file_name();
                if let Some(stem) = file.to_string_lossy().strip_suffix(".app") {
                    bundles.push(stem.to_string());
                }
            }
        }
    }

    let find = |pred: &dyn Fn(&String) -> bool| -> Option<String> {
        bundles.iter().find(|b| pred(b)).cloned()
    };
    let hit = find(&|b| b.to_lowercase() == want.to_lowercase())
        .or_else(|| find(&|b| process_matches(b, want)))
        .or_else(|| app_alias(want).and_then(|target| find(&|b| process_matches(b, target))))
        // Нечёткий подбор последним: «энкубик слайсер некст» →
        // AnycubicSlicerNext. Точное вхождение транслита тут не работает —
        // слова просьбы и имя бандла различаются буквами (slaiser/slicer).
        .or_else(|| fuzzy_app_match(want, &bundles));
    match hit {
        Some(b) => b,
        None => want.to_string(),
    }
}

/// Режет имя бандла на слова: пробелы, дефисы и границы camelCase.
/// «AnycubicSlicerNext» → [anycubic, slicer, next], «VSCode» → [vs, code].
/// Акронимы держим целиком: «Arduino IDE» → [arduino, ide] — иначе «IDE»
/// распадается на i/d/e и «электронный дневник» совпадает с ним по первым
/// буквам (реальный баг: дневник открывал Arduino IDE).
fn app_name_tokens(name: &str) -> Vec<String> {
    let chars: Vec<char> = name.chars().collect();
    let mut tokens: Vec<String> = Vec::new();
    let mut cur = String::new();
    for (i, &c) in chars.iter().enumerate() {
        if c.is_whitespace() || c == '-' || c == '_' || c == '.' {
            if !cur.is_empty() {
                tokens.push(std::mem::take(&mut cur));
            }
            continue;
        }
        let prev = if i > 0 { chars[i - 1] } else { c };
        let next_lower = chars.get(i + 1).copied().is_some_and(char::is_lowercase);
        // Граница слова: строчная → Заглавная или Заглавная-Заглавная → строчная.
        let starts_new = c.is_uppercase()
            && !cur.is_empty()
            && (prev.is_lowercase() || (prev.is_uppercase() && next_lower));
        if starts_new {
            tokens.push(std::mem::take(&mut cur));
        }
        cur.extend(c.to_lowercase());
    }
    if !cur.is_empty() {
        tokens.push(cur);
    }
    tokens
}

/// Нечёткий подбор приложения: токены просьбы (транслит) сверяем с токенами
/// имени бандла через word_similarity. Уверенность — минимум два совпавших
/// слова с порогом 0.6 («энкубик слайсер некст» → slaiser≈slicer 0.71,
/// nekst≈next 0.6) либо одно очень близкое (0.8) для однословных просьб.
#[cfg(target_os = "macos")]
fn fuzzy_app_match(want: &str, bundles: &[String]) -> Option<String> {
    let want_tokens: Vec<String> = want
        .split_whitespace()
        .map(|w| crate::text::compact_name(&crate::text::translit_ru(w)))
        .filter(|w| w.chars().count() >= 4)
        .collect();
    if want_tokens.is_empty() {
        return None;
    }

    let single_strong = |app_tokens: &[String]| {
        want_tokens.len() == 1
            && app_tokens
                .iter()
                .any(|at| crate::text::word_similarity(&want_tokens[0], at) >= 0.8)
    };
    let mut best: Option<(usize, &String)> = None;
    for bundle in bundles {
        let app_tokens = app_name_tokens(bundle);
        let hits = want_tokens
            .iter()
            .filter(|wt| {
                app_tokens
                    .iter()
                    .filter(|at| at.chars().count() >= 2)
                    .any(|at| {
                        // 0.6 достаточно: уверенность даёт минимум ДВА совпавших
                        // слова («nekst»/«next» — 0.6, «slaiser»/«slicer» — 0.71).
                        // Для однословных просьб порог строже (0.8) в single_strong.
                        crate::text::word_similarity(wt, at) >= 0.6
                            || (wt.len() >= 4
                                && (at.starts_with(wt.as_str()) || wt.starts_with(at.as_str())))
                    })
            })
            .count();
        let confident = hits >= 2 || (hits >= 1 && single_strong(&app_tokens));
        if confident && best.is_none_or(|(n, _)| hits > n) {
            best = Some((hits, bundle));
        }
    }
    best.map(|(_, b)| b.clone())
}

/// Санитизация адреса для браузера: добавляем схему и пускаем только
/// http/https с доменом (не localhost, не loopback, не IP без точки).
fn sanitize_open_url(url: &str) -> String {
    let t = url.trim();
    if t.is_empty() {
        return String::new();
    }
    let with_scheme = if t.starts_with("http://") || t.starts_with("https://") {
        t.to_string()
    } else {
        format!("https://{t}")
    };
    let host = with_scheme
        .strip_prefix("https://")
        .or_else(|| with_scheme.strip_prefix("http://"))
        .unwrap_or("")
        .split(['/', '?', '#'])
        .next()
        .unwrap_or("");
    let host_ok = host.contains('.')
        && !host.starts_with("localhost")
        && !host.starts_with("127.")
        && !host.starts_with("0.")
        && !host.starts_with("10.")
        && !host.starts_with("192.168.")
        && host != "[::1]";
    if host_ok { with_scheme } else { String::new() }
}

fn open_app_impl(name: &str) -> ToolOutcome {
    #[cfg(target_os = "macos")]
    {
        let name = &resolve_app_name(name);
        if is_app_running(name) {
            return ToolOutcome::ok(format!("{name} уже открыт"));
        }
        // `open -a` завершается ошибкой, если приложения нет, — статус честный.
        match Command::new("open").args(["-a", name]).status() {
            Ok(s) if s.success() => {
                // Статус «ок» ещё не гарантия: ждём появления процесса до 3 сек.
                for _ in 0..6 {
                    if is_app_running(name) {
                        return ToolOutcome::ok(format!("Открыл {name}"));
                    }
                    std::thread::sleep(Duration::from_millis(500));
                }
                ToolOutcome::fail(format!(
                    "Не удалось открыть {name}: приложение не запустилось"
                ))
            }
            Ok(_) => ToolOutcome::fail(format!("Не удалось открыть {name}: приложение не найдено")),
            Err(e) => ToolOutcome::fail(format!("Не удалось открыть {name}: {e}")),
        }
    }
}

/// Быстрый путь утилит: «открой календарь», «секундомер», «поставь таймер»
/// без цифр — открываем окно утилит Джарвиса (не Calendar.app и не LLM).
/// Просьбы с цифрами («таймер на 5 минут») — None: это set_timer.
pub fn utils_tab_for_prompt(prompt: &str) -> Option<&'static str> {
    let t = prompt.to_lowercase();
    if t.contains("секундомер") {
        return Some("stopwatch");
    }
    if t.contains("календар") {
        return Some("calendar");
    }
    if t.contains("таймер") {
        // «таймер на двадцать секунд / на 5 минут / на полчаса» — это
        // set_timer, а не окно: числа-слова STT пишет словами, цифры тоже.
        let has_digit = t.chars().any(|c| c.is_ascii_digit());
        let has_unit = ["секунд", "минут", "час", "полминуты", "полчаса"]
            .iter()
            .any(|w| t.contains(w));
        let has_number_word = [
            "двадцат",
            "тридцат",
            "сорок",
            "пятнадцат",
            "десят",
            "пят",
            "шест",
            "сем",
            "восем",
            "девят",
            "двенадцат",
            "тринадцат",
            "четырнадцат",
            "сто ",
        ]
        .iter()
        .any(|w| t.contains(w));
        if has_digit || has_unit || has_number_word {
            return None;
        }
        return Some("timer");
    }
    None
}

/// Быстрый путь команд окна: «сверни окно сафари», «разверни окно зума»,
/// «закрой окно джарвиса» — применяем сразу, без лотереи tool-вызовов
/// модели (2B то вызывает не тот инструмент, то пишет «Сafari» кириллицей).
/// Возвращает (действие, приложение) или None — пусть решает LLM.
pub fn window_request_from_prompt(prompt: &str) -> Option<(String, Option<String>)> {
    let t = prompt.to_lowercase();
    let action = if t.contains("сверни") || t.contains("свернуть") {
        "minimize"
    } else if t.contains("разверни") || t.contains("развернуть") {
        "maximize"
    } else if t.contains("полный экран") || t.contains("фулскрин") {
        "fullscreen"
    } else if t.contains("закрой окно") || t.contains("закрыть окно") {
        "close"
    } else if t.contains("верни окно") {
        "restore"
    } else {
        return None;
    };
    // Речь должна быть про окно: «закрой джарвис» — это выход, не окно.
    if !t.contains("окно") && !t.contains("окошко") {
        return None;
    }
    if t.chars().any(|c| c.is_ascii_digit()) {
        return None;
    }

    // Приложение: слова после «окно/окошко» (или до, для «сверни сафари»
    // — нет, без «окно» мы уже вышли). Особые слова — активное окно.
    let words: Vec<&str> = prompt.split_whitespace().collect();
    let mut app_words: Vec<&str> = Vec::new();
    let mut seen = false;
    for w in &words {
        let wl = w.to_lowercase();
        if wl.trim_matches(|c: char| !c.is_alphanumeric()) == "окно"
            || wl.trim_matches(|c: char| !c.is_alphanumeric()) == "окошко"
        {
            seen = true;
            app_words.clear();
            continue;
        }
        if seen {
            app_words.push(w);
        }
    }
    let app = if app_words.is_empty() {
        None
    } else {
        let app = app_words.join(" ");
        let special = ["активное", "активную", "активный", "это", "текущее"];
        if special.contains(&app.to_lowercase().as_str()) {
            Some("активное".to_string())
        } else {
            Some(app)
        }
    };
    Some((action.to_string(), app))
}

/// Публичная обёртка управления окном для быстрого пути (llm::ask).
#[cfg(target_os = "macos")]
pub fn window_control(action: &str, app: Option<&str>) -> String {
    window_impl(action, app)
}

/// Публичная обёртка для быстрого пути запуска (llm::ask).
pub fn open_app_by_name(name: &str) -> ToolOutcome {
    open_app_impl(name)
}

/// Быстрый путь «открой X»: после триггера остаётся имя, которое разрешается
/// в установленное приложение? Тогда открываем сразу, без лотереи tool-вызовов
/// модели (2B умудрялся открыть App Store вместо слайсера).
/// None — пусть решает LLM.
#[cfg(target_os = "macos")]
pub fn try_open_app_from_prompt(prompt: &str) -> Option<String> {
    let words: Vec<&str> = prompt.split_whitespace().collect();
    let triggers = [
        "открой",
        "открыть",
        "запусти",
        "запустить",
        "включи",
        "включить",
        "open",
        "launch",
    ];
    let Some(first) = words.first() else {
        return None;
    };
    if !triggers.contains(&first.to_lowercase().as_str()) {
        return None;
    }
    let fillers = ["приложение", "программу", "app"];
    let mut rest: Vec<&str> = words[1..].to_vec();
    if rest.is_empty() {
        return None;
    }
    if fillers.contains(&rest[0].to_lowercase().as_str()) {
        rest.remove(0);
    }
    // Таймеры/будильники — это инструменты, а не приложения; цифры выдают
    // «запусти таймер на 5 минут». Такие просьбы идут мимо быстрого пути.
    if rest.is_empty()
        || rest.iter().any(|w| {
            w.chars().any(|c| c.is_ascii_digit()) || w.contains("таймер") || w.contains("будильник")
        })
    {
        return None;
    }
    let rest = rest.join(" ");
    let resolved = resolve_app_name(&rest);
    // resolve_app_name возвращает вход без изменений, если ничего не нашёл.
    if resolved.eq_ignore_ascii_case(&rest) {
        return None;
    }
    Some(resolved)
}

// =========================================================================
// Громкость
// =========================================================================

fn set_volume_impl(percent: u8) -> bool {
    #[cfg(target_os = "macos")]
    {
        Command::new("osascript")
            .args(["-e", &format!("set volume output volume {percent}")])
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }
}

// =========================================================================
// Яркость
// =========================================================================

fn set_brightness_impl(percent: u8) -> bool {
    #[cfg(target_os = "macos")]
    {
        let v = (percent as f32 / 100.0).clamp(0.0, 1.0);
        Command::new("brightness")
            .arg(format!("{v}"))
            .status()
            .map(|s| s.success())
            .unwrap_or(false)
    }
}

