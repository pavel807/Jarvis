    #[test]
    fn parse_generic_name_by_args() {
        assert!(matches!(
            call(r#"<tool>{"name":"open","args":{"name":"Safari"}}</tool>"#),
            Some(ToolCall::OpenApp { .. })
        ));
        assert!(matches!(
