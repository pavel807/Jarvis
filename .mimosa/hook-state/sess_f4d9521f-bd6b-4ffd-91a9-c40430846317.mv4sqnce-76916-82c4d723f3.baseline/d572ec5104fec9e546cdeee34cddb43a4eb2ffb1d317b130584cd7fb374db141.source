// =========================================================================
// Управление окнами
// =========================================================================

/// Найти процесс по имени. Модель пишет «терминал», а процесс называется
/// `Terminal`, пользователь говорит «хром», а процесс — `Google Chrome`:
/// сначала точное совпадение, затем вхождение, затем словарь русских
/// названий и транслитерация.
#[cfg(target_os = "macos")]
fn find_process(name: &str) -> Option<String> {
    let want = name.trim();
    if want.is_empty() {
        return None;
    }
    let script = r#"tell application "System Events" to get name of every application process whose background only is false"#;
    let out = osascript(script).ok()?;
    let names: Vec<String> = out
        .split(',')
        .map(|s| s.trim().to_string())
        .filter(|s| !s.is_empty())
        .collect();

    let find = |pred: &dyn Fn(&String) -> bool| names.iter().find(|n| pred(n)).cloned();
    // Точное совпадение важнее вхождения: «Safari» и «Safari Technology
    // Preview» — разные приложения, и пользователь просил первое.
    find(&|n| n.to_lowercase() == want.to_lowercase())
        .or_else(|| find(&|n| n.to_lowercase().contains(&want.to_lowercase())))
        .or_else(|| app_alias(want).and_then(|target| find(&|n| process_matches(n, target))))
        .or_else(|| find(&|n| process_matches(n, want)))
}

#[cfg(target_os = "macos")]
fn active_process() -> Option<String> {
    let out = osascript(
        r#"tell application "System Events" to get name of first application process whose frontmost is true"#,
    )
    .ok()?;
    let name = out.trim().to_string();
    (!name.is_empty() && name != "System Events").then_some(name)
}

#[cfg(target_os = "macos")]
fn osascript(script: &str) -> Result<String, String> {
    // 1. Прямой путь: NSAppleScript в процессе Джарвиса. Системный запрос на
    //    автоматизацию приходит от самого приложения — его можно выдать один
    //    раз, и он действует на все последующие скрипты.
    if let Some(result) = crate::applescript::run(script) {
        return result.map(|out| out.trim().to_string());
    }

    // 2. Запасной путь: внешний osascript. Нужен на не-macOS, а также когда
    //    in-process режим отключён переменной окружения для отладки.
    match Command::new("osascript").args(["-e", script]).output() {
        Ok(out) if out.status.success() => {
            Ok(String::from_utf8_lossy(&out.stdout).trim().to_string())
        }
        Ok(out) => {
            let err = String::from_utf8_lossy(&out.stderr).trim().to_string();
            Err(if err.is_empty() {
                format!(
                    "osascript завершился с кодом {}",
                    out.status.code().unwrap_or(-1)
                )
            } else {
                // В сообщении AppleScript первая строка — сам текст ошибки,
                // позиция вроде «36:82:» только мешает.
                let line = err.lines().next().unwrap_or(&err);
                match line.split_once(": ") {
                    Some((_, msg)) if !msg.is_empty() => msg.to_string(),
                    _ => line.to_string(),
                }
            })
        }
        Err(e) => Err(e.to_string()),
    }
}

/// Отказ macOS на управление приложением почти всегда означает отсутствие
/// разрешения, а не поломку. Переводим типовые случаи на человеческий и
/// сразу подсказываем, где включить.
#[cfg(target_os = "macos")]
fn friendly_access_error(err: &str) -> String {
    let lower = err.to_lowercase();
    if lower.contains("assistive access") || lower.contains("assistiveaccess") {
        "macOS не разрешает управлять окнами. Системные настройки → Конфиденциальность и безопасность → Универсальный доступ — включи Jarvis".into()
    } else if lower.contains("send keystrokes") || lower.contains("not allowed to send") {
        "macOS не разрешает нажимать клавиши. Системные настройки → Конфиденциальность и безопасность → Универсальный доступ — включи Jarvis".into()
    } else if lower.contains("not authorized") || lower.contains("-1743") {
        "macOS не разрешает автоматизацию этого приложения. Системные настройки → Конфиденциальность и безопасность → Автоматизация — разреши Jarvis".into()
    } else if lower.contains("privilege violation") || lower.contains("-10004") {
        "macOS не даёт доступ к этому приложению. Системные настройки → Конфиденциальность и безопасность → Автоматизация — разреши Jarvis".into()
    } else if lower.contains("javascript")
        || lower.contains("applescript") && lower.contains("allow")
    {
        "В браузере выключен JavaScript из AppleScript: «Вид → Разработка → Разрешить JavaScript из AppleScript»".into()
    } else if lower.contains("application isn't running") || lower.contains("-600") {
        "Приложение не запущено".into()
    } else {
        err.to_string()
    }
}

/// Рабочая область экрана — для «развернуть на весь экран».
#[cfg(target_os = "macos")]
fn screen_bounds() -> Option<(i32, i32, i32, i32)> {
    let out = osascript(r#"tell application "Finder" to get bounds of window of desktop"#).ok()?;
    let nums: Vec<i32> = out
        .split(',')
        .filter_map(|s| s.trim().parse().ok())
        .collect();
    match nums.as_slice() {
        [x1, y1, x2, y2] => Some((*x1, *y1, *x2, *y2)),
        _ => None,
    }
}

/// Имя процесса самого Джарвиса (jarvis-app / jarvis-cli).
#[cfg(target_os = "macos")]
fn own_process_name() -> Option<String> {
    let exe = std::env::current_exe().ok()?;
    exe.file_stem()?.to_str().map(|s| s.to_string())
}

/// Действие над окном приложения.
///
/// `app = None` — окно самого Джарвиса: активным почти всегда является
/// приложение, которым человек прямо сейчас пользуется, и «сверни окно»,
/// применённое к нему, сворачивает Chrome посреди работы — неприятный
/// сюрприз. Явное «активное» адресует активное приложение.
#[cfg(target_os = "macos")]
fn window_impl(action: &str, app: Option<&str>) -> String {
    // Список окон не требует конкретного приложения: показываем все.
    if action == "list" {
        return window_list_impl();
    }

    match app {
        Some(wanted)
            if [
                "активное",
                "активную",
                "активный",
                "это",
                "текущее",
                "active",
            ]
            .contains(&wanted.trim().to_lowercase().as_str()) =>
        {
            match active_process() {
                Some(p) => window_run(&format!("\"{p}\""), &p, action),
                None => "Не нашёл активное приложение с окном".to_string(),
            }
        }
        Some(wanted) => match find_process(wanted) {
            Some(process) => {
                let quoted = format!("\"{process}\"");
                window_run(&quoted, &process, action)
            }
            None => format!("Приложение {wanted} не найдено среди открытых"),
        },
        None => match own_process_name().and_then(|me| find_process(&me)) {
            Some(me) => window_run(&format!("\"{me}\""), "Джарвис", action),
            None => "Моё окно не запущено — я в фоне. Скажи, чьё окно свернуть".to_string(),
        },
    }
}

/// `target` — готовое обращение к процессу для AppleScript: либо имя
/// (`"Terminal"`), либо выражение для активного окна. Отдельное имя нужно
/// только для текста ответа.
#[cfg(target_os = "macos")]
fn window_run(target: &str, name: &str, action: &str) -> String {
    let p = target.replace('\\', "\\\\").replace('"', "\\\"");
    let tell =
        format!(r#"tell application "System Events" to tell process {p} to frontmost to true"#);
    let _ = osascript(&tell);

    match action {
        "maximize" => {
            // Растягиваем на рабочую область экрана, но не включаем
            // полноэкранный режим: так остаётся видна панель меню и Dock —
            // обычно именно это и просят, говоря «разверни».
            let Some((x1, y1, x2, y2)) = screen_bounds() else {
                return "Не удалось узнать размер экрана".to_string();
            };
            let script = format!(
                r#"tell application "System Events" to tell process {p}
if (count of windows) = 0 then return "нет окон"
set value of attribute "AXFullScreen" of window 1 to false
set value of attribute "AXMinimized" of window 1 to false
set bounds of window 1 to {{{x1}, {y1}, {x2}, {y2}}}
return "готово"
end tell"#
            );
            run_window_script(&script, name, "развернул")
        }
        "fullscreen" => {
            let script = format!(
                r#"tell application "System Events" to tell process {p}
if (count of windows) = 0 then return "нет окон"
set value of attribute "AXFullScreen" of window 1 to true
return "готово"
end tell"#
            );
            run_window_script(&script, name, "включил полный экран")
        }
        "minimize" => {
            let script = format!(
                r#"tell application "System Events" to tell process {p}
if (count of windows) = 0 then return "нет окон"
set value of attribute "AXMinimized" of window 1 to true
return "готово"
end tell"#
            );
            run_window_script(&script, name, "свернул")
        }
        "restore" => {
            let script = format!(
                r#"tell application "System Events" to tell process {p}
if (count of windows) = 0 then return "нет окон"
set value of attribute "AXFullScreen" of window 1 to false
return "готово"
end tell"#
            );
            run_window_script(&script, name, "вернул обычный размер")
        }
        "close" => {
            let script = format!(
                r#"tell application "System Events" to tell process {p}
if (count of windows) = 0 then return "нет окон"
close window 1
return "готово"
end tell"#
            );
            run_window_script(&script, name, "закрыл окно")
        }
        "focus" => match osascript(&tell) {
            Ok(_) => format!("Переключился на {name}"),
            Err(e) => format!("Ошибка: {}", friendly_access_error(&e)),
        },
        other => format!("Не понимаю действие с окном: {other}"),
    }
}

/// Выполнить скрипт над окном и превратить ответ в человеческую фразу.
#[cfg(target_os = "macos")]
fn run_window_script(script: &str, process: &str, done: &str) -> String {
    match osascript(script) {
        Ok(out) if out.contains("нет окон") => format!("У {process} нет открытых окон"),
        Ok(_) => format!("{done} окно {process}"),
        Err(e) => format!("Ошибка: {}", friendly_access_error(&e)),
    }
}

#[cfg(target_os = "macos")]
fn window_list_impl() -> String {
    let script = r#"tell application "System Events"
set out to ""
repeat with p in (every application process whose background only is false)
try
set wn to name of windows of p
if (count of wn) > 0 then set out to out & (name of p) & ": " & (my joinList(wn)) & linefeed
end try
end repeat
return out
end tell

on joinList(lst)
set AppleScript's text item delimiters to ", "
set s to lst as text
set AppleScript's text item delimiters to ""
return s
end joinList"#;
    match osascript(script) {
        Ok(out) if out.trim().is_empty() => "Открытых окон не нашёл".to_string(),
        Ok(out) => out
            .lines()
            .filter(|l| !l.trim().is_empty())
            .take(12)
            .collect::<Vec<_>>()
            .join("; "),
        Err(e) => format!("Ошибка: {e}"),
    }
}

#[cfg(not(target_os = "macos"))]
fn window_impl(action: &str, _app: Option<&str>) -> String {
    let _ = action;
    "Управление окнами доступно только на macOS".to_string()
}

fn system_info_impl() -> String {
    #[cfg(target_os = "macos")]
    {
        let mut info = Vec::new();
        if let Ok(out) = Command::new("sw_vers").output() {
            let s = String::from_utf8_lossy(&out.stdout);
            for line in s.lines() {
                if let Some((k, v)) = line.split_once(':') {
                    info.push(format!("{}:{}", k.trim(), v.trim()));
                }
            }
        }
        if let Ok(out) = Command::new("uname").arg("-m").output() {
            info.push(format!(
                "Arch:{}",
                String::from_utf8_lossy(&out.stdout).trim()
            ));
        }
        if info.is_empty() {
            "Информация недоступна".to_string()
        } else {
            info.join(", ")
        }
    }
}

// =========================================================================
// Утилиты
// =========================================================================

pub fn expand_path(path: &str) -> String {
    if path.starts_with("~/") || path == "~" {
        let home = home_dir();
        if let Some(h) = home {
            if path == "~" {
                return h;
            }
            let rest = &path[2..];
            return format!("{h}/{rest}");
        }
    }
    path.to_string()
}

/// Рабочая директория ассистента.
///
/// Раньше её не было: `file_read` и `shell` смотрели в каталог запуска
/// процесса, поэтому «прочитай README» из приложения не находил ничего, а
/// цепочку `cd проект && ls` нельзя было собрать. Теперь директория одна на
/// весь агентный цикл: `cd` в shell её меняет, а относительные пути всех
/// файловых инструментов считаются от неё.
fn cwd_cell() -> &'static std::sync::Mutex<Option<std::path::PathBuf>> {
    static CWD: std::sync::OnceLock<std::sync::Mutex<Option<std::path::PathBuf>>> =
        std::sync::OnceLock::new();
    CWD.get_or_init(|| std::sync::Mutex::new(None))
}

/// Текущая рабочая директория. По умолчанию — корень данных Джарвиса.
pub fn cwd() -> String {
    let guard = cwd_cell().lock().unwrap_or_else(|e| e.into_inner());
    match guard.as_ref() {
        Some(p) => p.to_string_lossy().to_string(),
        None => paths::base_dir().to_string_lossy().to_string(),
    }
}

/// Задать рабочую директорию. Пустая строка или несуществующий путь — сброс
/// на корень данных. Возвращает то, что реально применилось.
pub fn set_cwd(path: &str) -> String {
    let candidate = expand_path(path.trim());
    let resolved = if candidate.is_empty() {
        None
    } else {
        let p = std::path::PathBuf::from(&candidate);
        p.is_dir().then(|| p.canonicalize().unwrap_or(p))
    };
    let mut guard = cwd_cell().lock().unwrap_or_else(|e| e.into_inner());
    *guard = resolved;
    drop(guard);
    cwd()
}

/// Путь относительно рабочей директории: то, что видит модель в выводе
/// инструментов. Абсолютные пути остаются как есть.
fn display_path(path: &std::path::Path) -> String {
    let root = std::path::PathBuf::from(cwd());
    match path.strip_prefix(&root) {
        Ok(rel) if !rel.as_os_str().is_empty() => rel.to_string_lossy().to_string(),
        _ => path.to_string_lossy().to_string(),
    }
}

/// Превращает путь из аргументов инструмента в абсолютный: `~` — домашний
/// каталог, относительный — от рабочей директории.
pub fn resolve_path(path: &str) -> String {
    resolve_path_from(path, &cwd())
}

/// То же, но с явной базой: без глобального состояния, поэтому проверяемо в
/// тестах и переиспользуемо.
pub fn resolve_path_from(path: &str, base: &str) -> String {
    let expanded = expand_path(path.trim());
    let p = std::path::Path::new(&expanded);
    if p.is_absolute() {
        return expanded;
    }
    std::path::PathBuf::from(base)
        .join(p)
        .to_string_lossy()
        .to_string()
}

/// Достаёт конечную цель `cd` из команды оболочки: «ли команда меняет
/// директорию и на какую». Понимает `cd foo`, `cd "с пробелами"`, `cd ~/x`,
/// `cd A && ls`, `cd A; cd B`. `cd` без аргумента и `cd -` игнорируются.
fn parse_cd_target(cmd: &str) -> Option<String> {
    let mut target: Option<String> = None;
    for part in cmd.split(['&', ';', '|', '\n']) {
        let part = part.trim();
        let rest = match part
            .strip_prefix("cd ")
            .or_else(|| part.strip_prefix("cd\t"))
        {
            Some(r) => r.trim(),
            None => continue,
        };
        // Берём только до следующего слова-разделителя: `cd dir arg` не бывает.
        let raw = match rest.chars().next() {
            Some(q @ ('"' | '\'')) => {
                let tail = &rest[q.len_utf8()..];
                tail.split(q).next().unwrap_or("").to_string()
            }
            _ => rest.split_whitespace().next().unwrap_or("").to_string(),
        };
        let raw = raw.trim();
        if raw.is_empty() || raw == "-" || raw.starts_with('$') {
            continue;
        }
        let resolved = resolve_path(raw);
        if std::path::Path::new(&resolved).is_dir() {
            target = Some(resolved);
        }
    }
    target
}

/// Сколько строк файла максимум отдаём модели.
const READ_LINE_LIMIT: usize = 400;
/// Сколько символов в одной строке вывода.
const LINE_CHAR_LIMIT: usize = 300;
/// Потолок совпадений в поиске и по маске.
const FIND_LIMIT: usize = 200;
/// Каталоги, которые не обходим: мусор, кэши, чужие зависимости.
const SKIP_DIRS: &[&str] = &[
    ".git",
    ".hg",
    ".svn",
    "node_modules",
    "target",
    "dist",
    "build",
    ".venv",
    "venv",
    "__pycache__",
    ".next",
    ".cache",
    "Library",
    ".Trash",
];

fn should_skip_dir(name: &str) -> bool {
    SKIP_DIRS.contains(&name)
}

fn ellipsize(line: &str) -> String {
    let trimmed = line.trim_end();
    if trimmed.chars().count() <= LINE_CHAR_LIMIT {
        return trimmed.to_string();
    }
    let cut: String = trimmed.chars().take(LINE_CHAR_LIMIT).collect();
    format!("{cut}…")
}

/// Отдаёт строки файла с номерами — так модель может сослаться на место,
/// которое собирается править через `file_edit`.
pub fn read_lines(content: &str, offset: Option<usize>, limit: Option<usize>) -> String {
    let lines: Vec<&str> = content.lines().collect();
    if lines.is_empty() {
        return "Файл пустой".to_string();
    }
    let start = offset.unwrap_or(1).max(1).min(lines.len());
    let count = limit.unwrap_or(READ_LINE_LIMIT).clamp(1, READ_LINE_LIMIT);
    let end = (start - 1 + count).min(lines.len());
    let width = end.to_string().len();
    let mut out = String::new();
    for (i, line) in lines[start - 1..end].iter().enumerate() {
        let num = start + i;
        out.push_str(&format!("{num:>width$}| {}\n", ellipsize(line)));
    }
    if end < lines.len() {
        out.push_str(&format!(
            "…всего {} строк, показаны {start}–{end}. Продолжи с offset={}",
            lines.len(),
            end + 1
        ));
    }
    out.trim_end().to_string()
}

/// Заменяет фрагмент в тексте и сообщает, сколько замен сделано. `old` обязан
/// встречаться: иначе модель правила файл по памяти, а не по факту, и
/// молчаливая «успешная» правка недопустима.
pub fn apply_edit(
    content: &str,
    old: &str,
    new: &str,
    all: bool,
) -> Result<(String, usize), String> {
    if old.is_empty() {
        return Err("пустой фрагмент для замены".into());
    }
    let count = content.matches(old).count();
    if count == 0 {
        return Err(format!(
            "Фрагмент не найден: {}. Прочитай файл и возьми текст оттуда.",
            short_err(old, 80)
        ));
    }
    if count > 1 && !all {
        return Err(format!(
            "Фрагмент встречается {count} раз — уточни его или поставь all=true"
        ));
    }
    Ok(if all {
        (content.replace(old, new), count)
    } else {
        (content.replacen(old, new, 1), 1)
    })
}

/// Дописывает текст в конец файла, добавляя перевод строки при необходимости.
fn append_to_file(path: &str, content: &str) -> std::io::Result<()> {
    use std::io::Write;
    let mut file = std::fs::OpenOptions::new()
        .create(true)
        .append(true)
        .open(path)?;
    let needs_newline = std::fs::read_to_string(path)
        .map(|existing| !existing.is_empty() && !existing.ends_with('\n'))
        .unwrap_or(false);
    if needs_newline {
        file.write_all(b"\n")?;
    }
    file.write_all(content.as_bytes())?;
    if !content.ends_with('\n') {
        file.write_all(b"\n")?;
    }
    Ok(())
}

/// Содержимое каталога с типами и размерами: одни имена ничего не говорят
/// модели о том, что перед ней.
fn list_dir(path: &str) -> std::io::Result<String> {
    let root = std::path::Path::new(path);
    let mut entries: Vec<(bool, u64, String)> = Vec::new();
    for entry in std::fs::read_dir(root)? {
        let entry = entry?;
        let name = entry.file_name().to_string_lossy().to_string();
        if name.starts_with('.') {
            continue;
        }
        let meta = entry.metadata().ok();
        let is_dir = meta.as_ref().is_some_and(|m| m.is_dir());
        let size = meta.as_ref().map(|m| m.len()).unwrap_or(0);
        entries.push((is_dir, size, name));
    }
    if entries.is_empty() {
        return Ok("Пусто".to_string());
    }
    // Каталоги вперёд, дальше по имени — предсказуемый порядок.
    entries.sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.2.cmp(&b.2)));
    let total = entries.len();
    let list: Vec<String> = entries
        .iter()
        .take(FIND_LIMIT)
        .map(|(is_dir, size, name)| {
            if *is_dir {
                format!("{name}/")
            } else {
                format!("{name} ({} б)", size)
            }
        })
        .collect();
    let mut out = list.join("\n");
    if total > FIND_LIMIT {
        out.push_str(&format!("\n…всего {total} записей"));
    }
    Ok(out)
}

/// Обходит дерево и собирает только текстовые файлы разумного размера.
fn walk_files<F>(root: &std::path::Path, mut visit: F) -> std::io::Result<()>
where
    F: FnMut(&std::path::Path) -> bool,
{
    fn recurse<F>(dir: &std::path::Path, depth: usize, visit: &mut F) -> std::io::Result<()>
    where
        F: FnMut(&std::path::Path) -> bool,
    {
        if depth > 12 {
            return Ok(());
        }
        let entries = match std::fs::read_dir(dir) {
            Ok(e) => e,
            Err(_) => return Ok(()),
        };
        for entry in entries.flatten() {
            let path = entry.path();
            let name = entry.file_name().to_string_lossy().to_string();
            if name.starts_with('.') {
                continue;
            }
            let Ok(meta) = entry.metadata() else { continue };
            if meta.is_dir() {
                if should_skip_dir(&name) {
                    continue;
                }
                recurse(&path, depth + 1, visit)?;
            } else if !visit(&path) {
                return Ok(());
            }
        }
        Ok(())
    }
    recurse(root, 0, &mut visit)
}

/// Поиск подстроки в файле или дереве. Возвращает готовый отчёт для модели с
/// номерами строк: без них правка найденного места — угадывание.
pub fn search_in_path(root: &str, query: &str, context: usize) -> std::io::Result<String> {
    if query.trim().is_empty() {
        return Ok(String::new());
    }
    let root_path = std::path::Path::new(root);
    let mut out = String::new();
    let mut hits = 0usize;

    let mut scan = |file: &std::path::Path| -> bool {
        let Ok(meta) = std::fs::metadata(file) else {
            return true;
        };
        if meta.len() > 2 * 1024 * 1024 {
            return true;
        }
        let Ok(content) = std::fs::read_to_string(file) else {
            return true;
        };
        let lines: Vec<&str> = content.lines().collect();
        let mut reported: Vec<usize> = Vec::new();
        for (i, line) in lines.iter().enumerate() {
            if !line.contains(query) {
                continue;
            }
            let file_label = display_path(file);
            if reported.is_empty() && !out.is_empty() {
                out.push('\n');
            }
            let from = i.saturating_sub(context);
            let to = (i + context + 1).min(lines.len());
            for (j, ctx_line) in lines[from..to].iter().enumerate() {
                let num = from + j + 1;
                if num == i + 1 && !reported.contains(&num) {
                    out.push_str(&format!("{}:{num}: {}\n", file_label, ellipsize(ctx_line)));
                } else if num != i + 1 {
                    out.push_str(&format!("{}:{num}-  {}\n", file_label, ellipsize(ctx_line)));
                }
            }
            if !reported.contains(&(i + 1)) {
                reported.push(i + 1);
            }
            hits += 1;
            if hits >= FIND_LIMIT {
                out.push_str(&format!("…остановился на {FIND_LIMIT} совпадениях\n"));
                return false;
            }
        }
        true
    };

    if root_path.is_file() {
        scan(root_path);
    } else {
        walk_files(root_path, &mut scan)?;
    }
    Ok(out.trim_end().to_string())
}

/// Простое сопоставление маски имени: `*`, `?` и `**` как «любая глубина».
fn glob_match(pattern: &str, name: &str) -> bool {
    fn inner(p: &[u8], n: &[u8]) -> bool {
        match p.split_first() {
            None => n.is_empty(),
            Some((b'*', rest)) => {
                // `**` схлопываем: для имён файлов этого достаточно.
                let rest = if rest.first() == Some(&b'*') {
                    &rest[1..]
                } else {
                    rest
                };
                if !rest.contains(&b'*') && !rest.contains(&b'?') {
                    // Хвост без своих звёздочек: он должен быть суффиксом.
                    // Иначе «*.rs» ошибочно матчил бы «main.rss».
                    return n.ends_with(rest);
                }
                (0..=n.len()).any(|skip| inner(rest, &n[skip..]))
            }
            Some((b'?', rest)) => !n.is_empty() && inner(rest, &n[1..]),
            Some((c, rest)) => n.first() == Some(c) && inner(rest, &n[1..]),
        }
    }
    inner(pattern.as_bytes(), name.as_bytes())
}

/// Поиск файлов по маске имени.
pub fn glob_in_path(root: &str, pattern: &str) -> std::io::Result<String> {
    let root_path = std::path::Path::new(root);
    let mut names: Vec<String> = Vec::new();
    if root_path.is_file() {
        names.push(display_path(root_path));
    } else {
        walk_files(root_path, &mut |file: &std::path::Path| {
            let name = file
                .file_name()
                .map(|n| n.to_string_lossy().to_string())
                .unwrap_or_default();
            let rel = display_path(file);
            // Сначала как есть. Если ничего не нашли — второй проход без учёта
            // регистра: пользователь говорит «найди readme», а файл README.
            if glob_match(pattern, &name) || glob_match(pattern, &rel) {
                names.push(rel);
            }
            names.len() < FIND_LIMIT
        })?;
        if names.is_empty() {
            let lower = pattern.to_lowercase();
            walk_files(root_path, &mut |file: &std::path::Path| {
                let name = file
                    .file_name()
                    .map(|n| n.to_string_lossy().to_lowercase())
                    .unwrap_or_default();
                let rel = display_path(file).to_lowercase();
                if glob_match(&lower, &name) || glob_match(&lower, &rel) {
                    names.push(display_path(file));
                }
                names.len() < FIND_LIMIT
            })?;
        }
    }
    names.sort();
    Ok(names.join("\n"))
}

fn home_dir() -> Option<String> {
    std::env::var("HOME").ok()
}

fn temp_path(filename: &str) -> String {
    let dir = std::env::temp_dir();
    dir.join(filename).to_string_lossy().to_string()
}

pub(crate) fn humanize_seconds(s: u64) -> String {
    if s < 60 {
        format!("{} {}", s, plural(s, "секунду", "секунды", "секунд"))
    } else if s < 3600 {
        let m = s / 60;
        let rem = s % 60;
        if rem == 0 {
            format!("{} {}", m, plural(m, "минуту", "минуты", "минут"))
        } else {
            format!(
                "{} {} {} {}",
                m,
                plural(m, "минуту", "минуты", "минут"),
                rem,
                plural(rem, "секунду", "секунды", "секунд")
            )
        }
    } else {
        let h = s / 3600;
        let m = (s % 3600) / 60;
        if m == 0 {
            format!("{} {}", h, plural(h, "час", "часа", "часов"))
        } else {
            format!(
                "{} {} {} {}",
                h,
                plural(h, "час", "часа", "часов"),
                m,
                plural(m, "минуту", "минуты", "минут")
            )
        }
    }
}

fn plural(n: u64, one: &'static str, few: &'static str, many: &'static str) -> &'static str {
    if n % 10 == 1 && n % 100 != 11 {
        one
    } else if (2..=4).contains(&(n % 10)) && !(11..=14).contains(&(n % 100)) {
        few
    } else {
        many
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn strip_tool_blocks_cleans_answer() {
        assert_eq!(
            strip_tool_blocks("Привет. <tool>{\"name\":\"ИМЯ\",\"args\":{}}</tool>"),
            "Привет."
        );
        assert_eq!(strip_tool_blocks("<tool>{\"name\":\"ЯЗЫК_РАСТ\"}"), "");
        assert_eq!(strip_tool_blocks("Ответ </tool"), "Ответ");
        assert_eq!(strip_tool_blocks("Просто ответ."), "Просто ответ.");
    }

    fn call(text: &str) -> Option<ToolCall> {
        match parse(text) {
            ToolParse::Call(c) => Some(c),
            ToolParse::None => None,
            ToolParse::Failed(reason) => panic!("ожидался успешный разбор, получено: {reason}"),
        }
    }

    #[test]
    fn parse_open_app() {
        let text = r#"<tool>{"name":"open_app","args":{"name":"Zed"}}</tool>"#;
        match call(text) {
            Some(ToolCall::OpenApp { name }) => assert_eq!(name, "Zed"),
            other => panic!("unexpected: {other:?}"),
        }
    }

    #[test]
    fn parse_shell_blocks_dangerous() {
        let text = r#"<tool>{"name":"shell","args":{"cmd":"rm -rf /"}}</tool>"#;
        assert!(matches!(parse(text), ToolParse::Failed(_)));
    }

    #[test]
    fn parse_shell_normal() {
        let text = r#"<tool>{"name":"shell","args":{"cmd":"ls ~/Downloads"}}</tool>"#;
        assert!(matches!(call(text), Some(ToolCall::Shell { .. })));
    }

    #[test]
    fn parse_timer() {
        let text = r#"<tool>{"name":"set_timer","args":{"seconds":300,"label":"чай"}}</tool>"#;
        match call(text) {
            Some(ToolCall::SetTimer { seconds, label }) => {
                assert_eq!(seconds, 300);
                assert_eq!(label.as_deref(), Some("чай"));
            }
            other => panic!("unexpected: {other:?}"),
        }
    }

    #[test]
    fn parse_ignores_plain_text() {
        assert!(matches!(parse("Привет! Как дела?"), ToolParse::None));
    }

    #[test]
    fn parse_run_command() {
        let text = r#"<tool>{"name":"run_command","args":{"name":"youtube"}}</tool>"#;
        match call(text) {
            Some(ToolCall::RunCommand { name, args }) => {
                assert_eq!(name, "youtube");
                assert!(args.is_empty());
            }
            other => panic!("unexpected: {other:?}"),
        }
    }

    #[test]
    fn parse_run_command_with_params() {
        let text = r#"<tool>{"name":"run_command","args":{"name":"музыка","args":{"query":"лунная соната","volume":30}}}</tool>"#;
        match call(text) {
            Some(ToolCall::RunCommand { name, args }) => {
                assert_eq!(name, "музыка");
                assert_eq!(args.get("query").map(String::as_str), Some("лунная соната"));
                // Числа приводятся к строке — они подставляются в {плейсхолдеры}.
                assert_eq!(args.get("volume").map(String::as_str), Some("30"));
            }
            other => panic!("unexpected: {other:?}"),
        }
    }

    #[cfg(target_os = "macos")]
    #[test]
    fn russian_app_names_resolve() {
        assert!(process_matches("Google Chrome", "Google Chrome"));
        assert!(process_matches("Google Chrome", "chrome"));
        assert!(process_matches("Telegram", "телеграм"));
        assert!(process_matches("Zed", "зед"));
        assert!(process_matches("Adobe Premiere Pro 2026", "Premiere"));
        // «Safari» и «Safari Technology Preview» различаем по точному совпадению:
        // неточное вхождение не должно превращать сафари в превью-версию.
        assert!(!process_matches("Safari", "Safari Technology Preview"));
    }

    #[cfg(target_os = "macos")]
    #[test]
    fn app_alias_maps_common_names() {
        assert_eq!(app_alias("хром"), Some("Google Chrome"));
        assert_eq!(app_alias("гугл хром"), Some("Google Chrome"));
        assert_eq!(app_alias("браузер"), Some("Safari"));
        assert_eq!(app_alias("неизвестное приложение"), None);
    }

    #[test]
    fn app_name_tokens_split_camel_and_spaces() {
        assert_eq!(
            app_name_tokens("AnycubicSlicerNext"),
            vec!["anycubic", "slicer", "next"]
        );
        assert_eq!(app_name_tokens("Google Chrome"), vec!["google", "chrome"]);
        // Акроним не распадается на буквы — иначе «электронный дневник»
        // матчится с «IDE» по первым буквам (реальный регресс).
        assert_eq!(app_name_tokens("Arduino IDE"), vec!["arduino", "ide"]);
        assert_eq!(app_name_tokens("VSCode"), vec!["vs", "code"]);
    }

    #[cfg(target_os = "macos")]
    #[test]
    fn fuzzy_app_match_finds_slicer_by_voice_spelling() {
        let bundles = vec![
            "Google Chrome".to_string(),
            "AnycubicSlicerNext".to_string(),
            "Safari".to_string(),
        ];
        // «энкубик слайсер некст» — так STT слышит Anycubic Slicer Next:
        // точного вхождения транслита нет, но два токена сходятся.
        assert_eq!(
            fuzzy_app_match("энкубик слайсер некст", &bundles).as_deref(),
            Some("AnycubicSlicerNext")
        );
    }

    #[cfg(target_os = "macos")]
    #[test]
    fn fuzzy_app_match_requires_confidence() {
        let bundles = vec!["Mail".to_string(), "Numbers".to_string()];
        // Одно слово без близкого совпадения — не подбираем ничего.
        assert_eq!(fuzzy_app_match("почта новая", &bundles), None);
    }

    #[cfg(target_os = "macos")]
    #[test]
    fn fuzzy_app_match_rejects_school_diary() {
        let bundles = vec![
            "Arduino IDE".to_string(),
            "Google Chrome".to_string(),
            "Safari".to_string(),
        ];
        // «электронный дневник» — не приложение: раньше совпадал с токенами
        // acронима IDE по первым буквам и открывал Arduino IDE.
        assert_eq!(fuzzy_app_match("электронный дневник", &bundles), None);
    }

    #[cfg(target_os = "macos")]
    #[test]
    fn fast_app_path_skips_tool_requests() {
        // Safari есть на любой macOS — разрешается через вхождение.
        assert_eq!(
            try_open_app_from_prompt("открой сафари").as_deref(),
            Some("Safari")
        );
        // Таймер с цифрами — это set_timer, а не приложение.
        assert_eq!(try_open_app_from_prompt("запусти таймер на 5 минут"), None);
        // «Открой сайт …» — не про приложения.
        assert_eq!(try_open_app_from_prompt("открой сайт apple.com"), None);
    }

    #[test]
    fn parse_window_actions() {
        // Модель пишет по-разному: «разверни», «на весь экран», «свернуть».
        for (raw, want) in [
            ("развернуть", "maximize"),
            ("на весь экран", "maximize"),
            ("на полный экран", "fullscreen"),
            ("свернуть", "minimize"),
            ("закрыть", "close"),
            ("восстановить", "restore"),
            ("показать окна", "list"),
            ("на передний план", "focus"),
        ] {
            let text = format!(r#"<tool>{{"name":"window","args":{{"action":"{raw}"}}}}</tool>"#);
            match call(&text) {
                Some(ToolCall::Window { action, .. }) => assert_eq!(action, want, "вход: {raw}"),
                other => panic!("unexpected: {other:?}"),
            }
        }
    }

    #[test]
    fn parse_window_with_app() {
        let text =
            r#"<tool>{"name":"окно","args":{"action":"развернуть","app":"терминал"}}</tool>"#;
        match call(text) {
            Some(ToolCall::Window { action, app }) => {
                assert_eq!(action, "maximize");
                assert_eq!(app.as_deref(), Some("терминал"));
            }
            other => panic!("unexpected: {other:?}"),
        }
    }

    #[test]
    fn parse_window_no_app_means_active() {
        let text = r#"<tool>{"name":"window","args":{"action":"свернуть"}}</tool>"#;
        match call(text) {
            Some(ToolCall::Window { action, app }) => {
                assert_eq!(action, "minimize");
                assert!(app.is_none());
            }
            other => panic!("unexpected: {other:?}"),
        }
    }

    #[test]
    fn parse_native_app_tools() {
        match call(r#"<tool>{"name":"send_message","args":{"to":"Мама","text":"привет"}}</tool>"#)
        {
            Some(ToolCall::SendMessage { to, text }) => {
                assert_eq!(to, "Мама");
                assert_eq!(text, "привет");
            }
            other => panic!("unexpected: {other:?}"),
        }
        match call(r#"<tool>{"name":"add_note","args":{"title":"покупки","body":"молоко"}}</tool>"#)
        {
            Some(ToolCall::AddNote { title, body }) => {
                assert_eq!(title, "покупки");
                assert_eq!(body, "молоко");
            }
            other => panic!("unexpected: {other:?}"),
        }
        match call(
            r#"<tool>{"name":"create_event","args":{"title":"созвон","time":"15:30"}}</tool>"#,
        ) {
            Some(ToolCall::CreateEvent { title, date, time }) => {
                assert_eq!(title, "созвон");
                assert!(date.is_empty());
                assert_eq!(time, "15:30");
            }
            other => panic!("unexpected: {other:?}"),
        }
        match call(r#"<tool>{"name":"музыка","args":{"action":"Пауза"}}</tool>"#) {
            Some(ToolCall::MusicControl { action }) => assert_eq!(action, "pause"),
            other => panic!("unexpected: {other:?}"),
        }
        // «Останови» — не то же самое, что «пауза»: трек уходит в начало.
        for (raw, expected) in [
            ("Останови", "stop"),
            ("стоп", "stop"),
            ("выключи музыку", "stop"),
            ("продолжи", "play"),
            ("дальше", "next"),
        ] {
            match call(&format!(
                r#"<tool>{{"name":"music_control","args":{{"action":"{raw}"}}}}</tool>"#
            )) {
                Some(ToolCall::MusicControl { action }) => {
                    assert_eq!(action, expected, "действие «{raw}»")
                }
                other => panic!("unexpected для «{raw}»: {other:?}"),
            }
        }
        // Обрывок JSON при ранней остановке чинится в parse_lenient.
        match parse_lenient(
            r#"<tool>{"name":"send_message","args":{"to":"+79001234567","text":"готово""#,
        ) {
            ToolParse::Call(ToolCall::SendMessage { to, .. }) => {
                assert_eq!(to, "+79001234567")
            }
            other => panic!("unexpected: {other:?}"),
        }
    }

    #[cfg(target_os = "macos")]
    #[test]
    fn iso_parsers_reject_garbage() {
        assert_eq!(parse_iso_date("2026-10-04"), Some((2026, 10, 4)));
        assert_eq!(parse_iso_date("завтра"), None);
        assert_eq!(parse_iso_date("2026-13-04"), None);
        assert_eq!(parse_iso_time("9:41"), Some((9, 41)));
        assert_eq!(parse_iso_time("25:00"), None);
        assert_eq!(parse_iso_time("утром"), None);
    }

