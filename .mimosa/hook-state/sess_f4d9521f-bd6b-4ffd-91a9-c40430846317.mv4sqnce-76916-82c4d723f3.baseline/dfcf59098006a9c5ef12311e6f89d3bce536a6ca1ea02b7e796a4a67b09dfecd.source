//! Проверка точности ударителя: набор слов-ловушек с эталонным ударением.
//! Печатает вердикт по каждому слову и общую точность.
//!
//! Запуск: cargo run --release --example stress_check -p jarvis-core

use jarvis_core::stress::RuStress;

/// (слово, порядковый номер ударной гласной, ожидаемое произношение).
const CASES: &[(&str, usize, &str)] = &[
    // Жалобы пользователя
    ("дела", 1, "де́ла"),
    ("градусов", 1, "гр́адусов"),
    ("градуса", 1, "гр́адуса"),
    ("какая", 2, "каќая"),
    ("какие", 2, "каќие"),
    ("какое", 2, "каќое"),
    ("такая", 2, "таќая"),
    ("такие", 2, "таќие"),
    // Классические ловушки
    ("звонит", 2, "звон́ит"),
    ("торты", 1, "т́орты"),
    ("щавель", 2, "щав́ель"),
    ("договор", 3, "догов́ор"),
    ("каталог", 3, "катал́ог"),
    ("красивее", 2, "крас́ивее"),
    ("километр", 3, "килом́етр"),
    ("магазин", 3, "магазин́"),
    ("свёкла", 1, "св́ёкла"),
    ("жалюзи", 3, "жалюз́и"),
    ("облегчит", 3, "облегч́ит"),
    // Глаголы прошедшего времени с ударной основой (жен. род)
    ("поняла", 3, "понял́а"),
    ("приняла", 3, "принял́а"),
    ("заняла", 3, "занял́а"),
    ("отдала", 3, "отдал́а"),
    ("продала", 3, "продал́а"),
    ("начала", 2, "начал́а"),
    ("кралась", 1, "кр́алась"),
    ("клала", 2, "клал́а"), // единственный известный промах NN (слова нет в словаре)
    // Обычная речь
    ("погода", 2, "поѓода"),
    ("ассистент", 3, "ассист́ент"),
    ("голосовой", 4, "голосов́ой"),
    ("сейчас", 2, "сейч́ас"),
    ("открываю", 3, "открыв́аю"),
    ("музыка", 1, "м́узыка"),
    ("компьютер", 2, "компь́ютер"),
    ("интернет", 3, "интерн́ет"),
];

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let stress = RuStress::load()?;

    let mut ok = 0usize;
    let mut bad: Vec<String> = Vec::new();

    println!(
        "{:<18} {:>8} {:>8}  произношение",
        "слово", "ожидал", "получил"
    );
    println!("{}", "-".repeat(56));
    for (word, expected, spoken) in CASES {
        let got = stress.stressed_vowel_ordinal(word);
        let verdict = match got {
            Some(o) if o == *expected => {
                ok += 1;
                "✓".to_string()
            }
            Some(o) => {
                bad.push(format!("{word} (ожидался слог {expected}, получен {o})"));
                format!("✗ слог {o}")
            }
            None => {
                bad.push(format!("{word} (не определено)"));
                "✗ нет".to_string()
            }
        };
        println!("{word:<18} {expected:>8} {verdict:>8}  {spoken}");
    }

    let total = CASES.len();
    println!(
        "\nТочность: {ok}/{total} = {:.1}%",
        100.0 * ok as f64 / total as f64
    );
    if !bad.is_empty() {
        println!("\nОшибки:");
        for b in &bad {
            println!("  - {b}");
        }
    }

    Ok(())
}
