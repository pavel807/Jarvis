//! Сверка candle-реализаций с onnxruntime: одна и та же модель, одни входы.
//! Запуск: cargo run --release --example nn_verify -p jarvis-core

use anyhow::{Context, Result};
use candle_core::Device;
use jarvis_core::nn::distilbert::{DistilBertClassifier, DistilBertConfig};
use jarvis_core::nn::roformer::{RoFormer, RoFormerConfig};
use jarvis_core::stress::RuStress;
use ort::session::{Session, SessionInputValue, SessionInputs};
use ort::value::{Tensor, Value};
use std::borrow::Cow;
use std::path::Path;
use tokenizers::Tokenizer;

fn run_ort(session: &mut Session, inputs: Vec<(String, Vec<i64>, [usize; 2])>) -> Result<Vec<f32>> {
    let vals: Vec<(Cow<'static, str>, SessionInputValue<'static>)> = inputs
        .into_iter()
        .map(|(name, data, shape)| {
            let t = Tensor::from_array((shape, data)).unwrap();
            (Cow::Owned(name), SessionInputValue::Owned(Value::from(t)))
        })
        .collect();
    let outputs = session.run(SessionInputs::from(vals))?;
    let (_s, logits) = outputs[0].try_extract_tensor::<f32>()?;
    Ok(logits.to_vec())
}

fn max_diff(a: &[f32], b: &[f32]) -> f32 {
    a.iter()
        .zip(b)
        .map(|(x, y)| (x - y).abs())
        .fold(0.0f32, f32::max)
}

/// Скачивает ONNX, если его нет: файлы нужны только для этой сверки,
/// в рантайме движок их не читает.
fn ensure_onnx(url: &str, path: &str) -> Result<()> {
    let path = std::path::Path::new(path);
    if path.exists() {
        return Ok(());
    }
    println!("📥 {url}");
    if let Some(dir) = path.parent() {
        std::fs::create_dir_all(dir)?;
    }
    let response = ureq::get(url).call()?;
    let mut reader = response.into_body().into_reader();
    let mut file = std::fs::File::create(path)?;
    std::io::copy(&mut reader, &mut file)?;
    Ok(())
}

fn main() -> Result<()> {
    let device = Device::Cpu;
    ensure_onnx(
        "https://huggingface.co/TigreGotico/stressonnx-models/resolve/main/ru_ruaccent/nn_accent/model.onnx",
        "models/stress-ru/accent.onnx",
    )?;
    ensure_onnx(
        "https://huggingface.co/ruaccent/accentuator/resolve/main/nn/nn_omograph/tiny2/model.onnx",
        "models/stress-ru/omograph/model.onnx",
    )?;

    // ---------- омографы: DistilBERT ----------
    println!("=== омографы (DistilBERT) ===");
    let tokenizer = Tokenizer::from_file("models/stress-ru/omograph/tokenizer.json")
        .map_err(|e| anyhow::anyhow!("{e}"))?;
    let distil = DistilBertClassifier::load(
        Path::new("models/stress-ru/omograph/model.safetensors"),
        DistilBertConfig::default(),
        &device,
    )?;
    let mut ort_omo = Session::builder()?
        .commit_from_file("models/stress-ru/omograph/model.onnx")
        .context("omograph onnx")?;

    let pairs = [
        (" <w>замок</w> стоит на горе.", "з+амок"),
        (" <w>замок</w> стоит на горе.", "зам+ок"),
        ("он закрыл дверь на <w>замок</w> .", "зам+ок"),
        ("мама купила <w>муку</w> .", "мук+у"),
        ("это была настоящая <w>мука</w> .", "м+ука"),
        ("как <w>дела</w> , павел ?", "дел+а"),
        ("у меня нет <w>дела</w> до этого .", "д+ела"),
        ("сколько <w>стоит</w> эта книга ?", "ст+оит"),
        ("дом <w>стоит</w> на берегу реки .", "сто+ит"),
        ("я не <w>поняла</w> , что ты имеешь в виду .", "понял+а"),
    ];
    let mut worst = 0.0f32;
    let mut decision_match = 0;
    for (sent, hyp) in pairs {
        let enc = tokenizer
            .encode((sent, hyp), true)
            .map_err(|e| anyhow::anyhow!("{e}"))?;
        let ids: Vec<i64> = enc.get_ids().iter().map(|&x| x as i64).collect();
        let mask: Vec<i64> = enc.get_attention_mask().iter().map(|&x| x as i64).collect();
        let n = ids.len();
        let uids: Vec<u32> = ids.iter().map(|&x| x as u32).collect();
        let umask: Vec<u32> = mask.iter().map(|&x| x as u32).collect();
        let candle = distil.logits(&uids, &umask)?;
        let ort = run_ort(
            &mut ort_omo,
            vec![
                ("input_ids".into(), ids.clone(), [1, n]),
                ("attention_mask".into(), mask, [1, n]),
            ],
        )?;
        let d = max_diff(&candle, &ort);
        worst = worst.max(d);
        let c_arg = usize::from(candle[1] > candle[0]);
        let o_arg = usize::from(ort[1] > ort[0]);
        if c_arg == o_arg {
            decision_match += 1;
        }
        println!(
            "  {hyp:10} candle=[{:.4},{:.4}] ort=[{:.4},{:.4}] Δ={d:.4} {}",
            candle[0],
            candle[1],
            ort[0],
            ort[1],
            if c_arg == o_arg {
                "ok"
            } else {
                "РАСХОЖДЕНИЕ"
            }
        );
    }
    println!(
        "  худшее Δ={worst:.4}, решения совпали {decision_match}/{}",
        pairs.len()
    );

    // ---------- ударитель: RoFormer ----------
    println!("\n=== ударитель (RoFormer) ===");
    let roformer = RoFormer::load(
        Path::new("models/stress-ru/accent.safetensors"),
        RoFormerConfig::default(),
        &device,
    )?;
    let mut ort_acc = Session::builder()?
        .commit_from_file("models/stress-ru/accent.onnx")
        .context("accent onnx")?;
    let stress = RuStress::load()?;

    let words = [
        "дела",
        "стоит",
        "замок",
        "муку",
        "начала",
        "звонит",
        "щавель",
        "договор",
        "каталог",
        "красивее",
        "километр",
        "магазин",
        "поняла",
        "градусов",
        "какая",
        "сегодня",
        "погода",
        "компьютер",
        "интернет",
        "освободишься",
        "музыка",
        "клала",
        "окно",
        "окна",
        "окне",
        "стекло",
        "письмо",
        "весна",
        "страна",
        "число",
        "слово",
        "место",
        "небо",
    ];
    let mut worst = 0.0f32;
    let mut mismatch = 0;
    for w in words {
        let ids = stress.debug_ids(w);
        let n = ids.len();
        let tt: Vec<i64> = vec![0; n];
        let am: Vec<i64> = vec![1; n];
        let uids: Vec<u32> = ids.iter().map(|&x| x as u32).collect();
        let utt: Vec<u32> = tt.iter().map(|&x| x as u32).collect();
        let uam: Vec<u32> = am.iter().map(|&x| x as u32).collect();
        let candle = roformer.logits(&uids, &utt, &uam)?;
        let ort = run_ort(
            &mut ort_acc,
            vec![
                ("input_ids".into(), ids.clone(), [1, n]),
                ("attention_mask".into(), am, [1, n]),
                ("token_type_ids".into(), tt, [1, n]),
            ],
        )?;
        let ort_rows: Vec<Vec<f32>> = ort.chunks(3).map(|c| c.to_vec()).collect();
        let mut d = 0.0f32;
        for (a, b) in candle.iter().zip(&ort_rows) {
            d = d.max(max_diff(a, b));
        }
        worst = worst.max(d);
        // решение: порядковый номер ударной гласной
        // Правило как в stress.rs: гласная с максимальной вероятностью STRESS_PRIMARY.
        let pick = |rows: &Vec<Vec<f32>>| -> Option<usize> {
            let chars: Vec<char> = w.chars().collect();
            let mut best: Option<(usize, f32)> = None;
            for i in 1..=chars.len() {
                let row = rows.get(i)?;
                let max = row.iter().cloned().fold(f32::NEG_INFINITY, f32::max);
                let exps: Vec<f32> = row.iter().map(|v| (v - max).exp()).collect();
                let sum: f32 = exps.iter().sum();
                let (arg, p) = exps
                    .iter()
                    .enumerate()
                    .map(|(k, v)| (k, v / sum))
                    .max_by(|a, b| a.1.total_cmp(&b.1))?;
                if p < 0.55 || arg != 1 {
                    continue;
                }
                if !jarvis_core::stress::is_ru_vowel(chars[i - 1]) {
                    continue;
                }
                if best.is_none_or(|(_, bp)| p > bp) {
                    best = Some((i, p));
                }
            }
            let (pos, _) = best?;
            Some(
                w.chars()
                    .take(pos)
                    .filter(|c| jarvis_core::stress::is_ru_vowel(*c))
                    .count(),
            )
        };
        let c = pick(&candle);
        let o = pick(&ort_rows);
        if c != o {
            mismatch += 1;
        }
        println!(
            "  {w:14} candle={c:?} ort={o:?} Δ={d:.4} {}",
            if c == o {
                "ok"
            } else {
                "РАСХОЖДЕНИЕ"
            }
        );
    }
    println!(
        "  худшее Δ={worst:.4}, решения совпали {}/{}",
        words.len() - mismatch,
        words.len()
    );
    Ok(())
}
