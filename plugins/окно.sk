# плагин: окно
# описание: управляет окном по названию — фокус, закрыть, свернуть, развернуть или перенести на другой стол
# аргументы: действие, имя окна, номер стола (для «стол»)

действие = arg(1)
имя = arg(2)
стол = int(arg(3))
if имя == "":
    say("Скажи действие и окно: например, фокус chromium или закрыть firefox")
elif действие == "фокус":
    say(window_focus(имя))
elif действие == "закрыть":
    say(window_close(имя))
elif действие == "свернуть":
    say(window_minimize(имя))
elif действие == "развернуть":
    say(window_maximize(имя))
elif действие == "стол":
    say(window_move_desktop(имя, стол))
else:
    say("Не понял действие: фокус, закрыть, свернуть, развернуть или стол")
